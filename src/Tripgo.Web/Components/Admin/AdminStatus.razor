@if (!string.IsNullOrWhiteSpace(Message))
{
    <div class="adm-status @(IsError ? "is-error" : "is-success")" role="@(IsError ? "alert" : "status")">
        <i class="bi @(IsError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill")" aria-hidden="true"></i>
        <span>@Message</span>
    </div>
}

@code {
    [Parameter] public string? Message { get; set; }
    [Parameter] public bool IsError { get; set; }
}
