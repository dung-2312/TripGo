@page "/admin/bookings"
@attribute [Authorize(Roles = "Admin")]
@layout Tripgo.Web.Components.Layout.AdminLayout
@inherits AdminPageBase
@rendermode InteractiveServer

<PageTitle>Đơn đặt chỗ | TripGo Admin</PageTitle>

<h1 class="adm-title">Đơn đặt chỗ</h1>
<p class="adm-subtitle">Thông tin hành khách được che mặc định. Mỗi lần xem đầy đủ đều được ghi vào nhật ký. Trạng thái thanh toán không thể sửa tay.</p>
<AdminStatus Message="@StatusMessage" IsError="@StatusIsError" />

<section class="adm-card">
    <div class="adm-toolbar">
        <h2>Danh sách (@(page?.TotalCount ?? 0))</h2>
        <div class="adm-filters">
            <input aria-label="Tìm đơn" placeholder="Mã đơn, số điện thoại, tuyến..." @bind="filter.Search" @bind:after="ApplyFilterAsync" />
            <select aria-label="Trạng thái đơn" @bind="filter.Status" @bind:after="ApplyFilterAsync">
                <option value="">Mọi trạng thái</option>
                @foreach (var status in Enum.GetNames<Tripgo.Domain.Enums.BookingStatus>())
                {
                    <option value="@status">@BookingLabel(status)</option>
                }
            </select>
            <select aria-label="Trạng thái thanh toán" @bind="filter.PaymentStatus" @bind:after="ApplyFilterAsync">
                <option value="">Mọi thanh toán</option>
                @foreach (var status in Enum.GetNames<Tripgo.Domain.Enums.PaymentStatus>())
                {
                    <option value="@status">@PaymentLabel(status)</option>
                }
            </select>
        </div>
    </div>

    @if (page == null || page.Items.Count == 0)
    {
        <div class="adm-empty">@(page == null ? "Đang tải..." : "Không có đơn phù hợp.")</div>
    }
    else
    {
        <div class="adm-table-wrap">
            <table class="adm-table">
                <thead><tr><th>Mã đơn</th><th>Tuyến / Khởi hành</th><th>Hành khách</th><th>Tổng tiền</th><th>Đơn</th><th>Thanh toán</th><th></th></tr></thead>
                <tbody>
                    @foreach (var row in page.Items)
                    {
                        <tr>
                            <td><strong>@row.BookingCode</strong><small>@Vn(row.CreatedAt)</small></td>
                            <td>@row.RouteName<small>@Vn(row.DepartureTime)</small></td>
                            <td>@row.MaskedPassengerName<small>@row.MaskedPhone</small></td>
                            <td>@Money(row.TotalAmount)@if (row.IsSandbox) { <small>Sandbox</small> }</td>
                            <td><span class="adm-pill @BookingPill(row.Status)">@BookingLabel(row.Status)</span></td>
                            <td><span class="adm-pill @PaymentPill(row.PaymentStatus)">@PaymentLabel(row.PaymentStatus)</span></td>
                            <td class="adm-row-actions">
                                <button type="button" class="adm-btn small primary" disabled="@IsBusy" @onclick="() => OpenAsync(row.Id)">
                                    <i class="bi bi-eye"></i> Chi tiết
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <AdminPager Page="page.Page" TotalPages="page.TotalPages" PageChanged="ChangePageAsync" />
    }
</section>

@if (detail != null)
{
    <div class="adm-modal-backdrop" @onclick="() => detail = null">
        <div class="adm-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="modal-booking-title" @onclick:stopPropagation="true">
            <div class="adm-modal-header">
                <h2 id="modal-booking-title">
                    <span>Đơn đặt chỗ: <strong>@detail.BookingCode</strong></span>
                    <span class="adm-pill @BookingPill(detail.Status)">@BookingLabel(detail.Status)</span>
                    <span class="adm-pill @PaymentPill(detail.PaymentStatus)">@PaymentLabel(detail.PaymentStatus)</span>
                    @if (detail.IsSandbox)
                    {
                        <span class="adm-pill warn">Sandbox</span>
                    }
                </h2>
                <button type="button" class="adm-close-btn" @onclick="() => detail = null" aria-label="Đóng">&times;</button>
            </div>

            <div class="adm-modal-body">
                <h3 class="adm-section" style="margin-top:0">Thông tin hành trình</h3>
                <dl class="adm-details">
                    <div><dt>Tuyến đường</dt><dd><strong>@detail.RouteName</strong></dd></div>
                    <div><dt>Nhà xe đối tác</dt><dd>@detail.OperatorName</dd></div>
                    <div><dt>Thời gian khởi hành</dt><dd><strong>@Vn(detail.DepartureTime)</strong></dd></div>
                    <div><dt>Điểm đón khách</dt><dd>@(string.IsNullOrWhiteSpace(detail.PickupPoint) ? "Tại điểm xuất phát" : detail.PickupPoint)</dd></div>
                    <div><dt>Điểm trả khách</dt><dd>@(string.IsNullOrWhiteSpace(detail.DropoffPoint) ? "Tại điểm đến" : detail.DropoffPoint)</dd></div>
                    <div><dt>Ghế đã chọn</dt><dd><span class="adm-pill good">@string.Join(", ", detail.SeatCodes)</span></dd></div>
                    <div><dt>Số lượng hành khách</dt><dd>@detail.PassengerCount người</dd></div>
                    <div><dt>Giá vé cơ bản</dt><dd>@Money(detail.BaseAmount)</dd></div>
                    <div><dt>Phụ phí / Dịch vụ</dt><dd>@Money(detail.SurchargeAmount)</dd></div>
                    <div><dt>Tổng tiền</dt><dd><strong style="font-size:1.15rem;color:#b42318">@Money(detail.TotalAmount)</strong></dd></div>
                    <div><dt>Thời gian tạo đơn</dt><dd>@Vn(detail.CreatedAt)</dd></div>
                    @if (detail.CancelledAt.HasValue)
                    {
                        <div style="grid-column: 1 / -1; background:#fde4e2; padding:10px 14px; border-radius:8px">
                            <dt style="color:#a01c12">Đã hủy lúc</dt>
                            <dd style="color:#a01c12"><strong>@Vn(detail.CancelledAt.Value)</strong> — Lý do: @detail.CancellationReason</dd>
                        </div>
                    }
                </dl>

                <h3 class="adm-section">Thông tin liên hệ hành khách</h3>
                <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; padding:14px; margin-bottom:16px">
                    @if (detail.ContactRevealed)
                    {
                        <div class="adm-details" style="margin:0">
                            <div><dt>Họ tên</dt><dd><strong>@detail.PassengerName</strong></dd></div>
                            <div><dt>Số điện thoại</dt><dd><strong>@detail.PassengerPhone</strong></dd></div>
                            <div><dt>Email</dt><dd><strong>@detail.PassengerEmail</strong></dd></div>
                        </div>
                    }
                    else
                    {
                        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px">
                            <div class="adm-details" style="margin:0; flex:1">
                                <div><dt>Họ tên</dt><dd>@detail.MaskedPassengerName</dd></div>
                                <div><dt>Số điện thoại</dt><dd>@detail.MaskedPhone</dd></div>
                                <div><dt>Email</dt><dd>@detail.MaskedEmail</dd></div>
                            </div>
                            <button type="button" class="adm-btn small primary" @onclick="RevealAsync">
                                Xem đầy đủ (ghi nhật ký)
                            </button>
                        </div>
                    }
                </div>

                <h3 class="adm-section">Lịch sử giao dịch thanh toán</h3>
                @if (detail.Payments.Count == 0)
                {
                    <div class="adm-empty">Chưa có giao dịch thanh toán nào được ghi nhận.</div>
                }
                else
                {
                    <div class="adm-table-wrap">
                        <table class="adm-table">
                            <thead>
                                <tr>
                                    <th>Mã giao dịch</th>
                                    <th>Cổng</th>
                                    <th>Phương thức</th>
                                    <th>Số tiền</th>
                                    <th>Trạng thái</th>
                                    <th>Thời gian</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var payment in detail.Payments)
                                {
                                    <tr>
                                        <td><code>@payment.TransactionCode</code></td>
                                        <td>@payment.Provider@(payment.IsSandbox ? " (Sandbox)" : "")</td>
                                        <td>@payment.PaymentMethod</td>
                                        <td><strong>@payment.Amount.ToString("N0") @payment.Currency</strong></td>
                                        <td><span class="adm-pill @PaymentPill(payment.Status)">@PaymentLabel(payment.Status)</span></td>
                                        <td>@Vn(payment.CreatedAt)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (detail.Status is "PendingPayment" or "Confirmed")
                {
                    <div style="margin-top:24px; padding:16px; border:1px solid #fecaca; background:#fff5f5; border-radius:10px">
                        <h4 style="margin:0 0 8px; color:#b91c1c; font-size:1rem; font-weight:700">Hủy đơn đặt chỗ (Thao tác quản trị)</h4>
                        <p class="adm-hint" style="margin:0 0 12px">
                            @(detail.PaymentStatus == "Paid" ? "Đơn đã thanh toán: hệ thống sẽ xử lý hoàn tiền qua cổng thanh toán rồi mới cập nhật hủy vé." : "Đơn chưa thanh toán: ghế giữ chỗ sẽ được giải phóng ngay lập tức.")
                        </p>
                        <div class="adm-form" style="margin-bottom:8px">
                            <label class="wide">
                                Lý do hủy đơn *
                                <input @bind="cancelReason" @bind:event="oninput" maxlength="200" placeholder="Nhập lý do hủy (ít nhất 5 ký tự)..." />
                            </label>
                        </div>
                        <button type="button" class="adm-btn danger" disabled="@(IsBusy || string.IsNullOrWhiteSpace(cancelReason) || cancelReason.Trim().Length < 5)" @onclick="CancelAsync">
                            Xác nhận hủy đơn đặt chỗ
                        </button>
                    </div>
                }
            </div>

            <div class="adm-modal-footer">
                <button type="button" class="adm-btn" @onclick="() => detail = null">Đóng</button>
            </div>
        </div>
    </div>
}

@code {
    private AdminBookingFilter filter = new();
    private PagedResult<AdminBookingRowDto>? page;
    private AdminBookingDetailDto? detail;
    private string cancelReason = string.Empty;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private Task ReloadAsync() => LoadAsync(async () => page = await Admin.GetBookingsAsync(filter));

    private Task ApplyFilterAsync()
    {
        filter.Page = 1;
        return ReloadAsync();
    }

    private Task ChangePageAsync(int target)
    {
        filter.Page = target;
        return ReloadAsync();
    }

    private Task OpenAsync(long id) => LoadAsync(async () =>
    {
        cancelReason = string.Empty;
        detail = await Admin.GetBookingAsync(id);
        if (detail == null)
        {
            StatusMessage = "Không tìm thấy thông tin chi tiết đơn đặt chỗ.";
            StatusIsError = true;
        }
    });

    private Task RevealAsync() => LoadAsync(async () => detail = await Admin.GetBookingAsync(detail!.Id, revealContact: true));

    private Task CancelAsync() => RunAsync(() => Admin.CancelBookingAsync(detail!.Id, cancelReason), async () =>
    {
        detail = await Admin.GetBookingAsync(detail!.Id);
        await ReloadAsync();
    });

    private static string BookingLabel(string status) => status switch
    {
        "PendingPayment" => "Chờ thanh toán",
        "Confirmed" => "Đã xác nhận",
        "Cancelled" => "Đã hủy",
        "Completed" => "Hoàn tất",
        "Expired" => "Hết hạn",
        _ => status
    };

    private static string PaymentLabel(string status) => status switch
    {
        "Unpaid" => "Chưa thanh toán",
        "Pending" => "Đang xử lý",
        "Paid" => "Đã thanh toán",
        "Refunded" => "Đã hoàn tiền",
        "Failed" => "Thất bại",
        _ => status
    };

    private static string BookingPill(string status) => status switch
    {
        "Confirmed" or "Completed" => "good",
        "PendingPayment" => "warn",
        "Cancelled" => "bad",
        _ => "muted"
    };

    private static string PaymentPill(string status) => status switch
    {
        "Paid" => "good",
        "Failed" => "bad",
        "Pending" => "warn",
        _ => "muted"
    };
}
