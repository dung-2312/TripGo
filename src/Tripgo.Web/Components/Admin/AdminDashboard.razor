@page "/admin"
@attribute [Authorize(Roles = "Admin")]
@layout Tripgo.Web.Components.Layout.AdminLayout
@inherits AdminPageBase
@rendermode InteractiveServer

<PageTitle>Tổng quan hệ thống | TripGo Admin</PageTitle>

<div class="adm-dash-header">
    <div>
        <h1 class="adm-title" style="margin-bottom: 6px;">Trung tâm Điều hành & Quản trị TripGo</h1>
        <p class="adm-subtitle" style="margin-bottom: 0;">Số liệu tổng hợp thời gian thực từ cơ sở dữ liệu vận hành.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <div class="adm-dash-badge">
            <span class="adm-pulse-dot"></span>
            <span>Hệ thống trực tuyến (Live)</span>
        </div>
        <button type="button" class="adm-btn small" disabled="@IsBusy" @onclick="ReloadAsync" title="Làm mới dữ liệu">
            <i class="bi bi-arrow-clockwise @(IsBusy ? "spin" : "")"></i> Cập nhật
        </button>
    </div>
</div>

<AdminStatus Message="@StatusMessage" IsError="@StatusIsError" />

@if (data == null)
{
    @if (!StatusIsError)
    {
        <div class="adm-empty"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Đang tải số liệu hệ thống...</div>
    }
}
else
{
    <!-- 4 HERO KPI METRIC CARDS -->
    <div class="adm-kpi-grid">
        <!-- KPI 1: Doanh thu -->
        <div class="adm-kpi-card">
            <div class="adm-kpi-card-top">
                <span class="adm-kpi-label">Doanh thu mô phỏng Sandbox</span>
                <div class="adm-kpi-icon emerald"><i class="bi bi-cash-coin"></i></div>
            </div>
            <div class="adm-kpi-val">@(data.SandboxPaidAmount.HasValue ? Money(data.SandboxPaidAmount.Value) : "0 đ")</div>
            <div class="adm-kpi-sub">
                <i class="bi bi-check-circle-fill text-success"></i>
                <span>@data.SandboxPaidTransactions giao dịch mô phỏng hoàn tất</span>
            </div>
            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                <small class="text-muted">Cổng thật: @(data.RealPaidAmount.HasValue ? Money(data.RealPaidAmount.Value) : "Chưa có")</small>
                <span class="adm-kpi-tag">Sandbox Demo</span>
            </div>
        </div>

        <!-- KPI 2: Đơn đặt chỗ -->
        <div class="adm-kpi-card">
            <div class="adm-kpi-card-top">
                <span class="adm-kpi-label">Tổng đơn đặt chỗ</span>
                <div class="adm-kpi-icon blue"><i class="bi bi-ticket-perforated-fill"></i></div>
            </div>
            <div class="adm-kpi-val">@data.TotalBookings <span style="font-size: 1rem; font-weight:600; color:#64748b;">đơn</span></div>
            <div class="adm-kpi-sub">
                <i class="bi bi-pie-chart-fill text-primary"></i>
                <span>@data.ConfirmedBookings đã xác nhận (@GetPercentage(data.ConfirmedBookings, data.TotalBookings)%)</span>
            </div>
            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                <small class="text-muted">@data.PendingBookings chờ thanh toán</small>
                <a href="/admin/bookings" class="adm-kpi-tag text-decoration-none text-primary">Xem tất cả &rarr;</a>
            </div>
        </div>

        <!-- KPI 3: Chuyến xe vận hành -->
        <div class="adm-kpi-card">
            <div class="adm-kpi-card-top">
                <span class="adm-kpi-label">Chuyến xe sắp chạy</span>
                <div class="adm-kpi-icon purple"><i class="bi bi-bus-front-fill"></i></div>
            </div>
            <div class="adm-kpi-val">@data.UpcomingTrips <span style="font-size: 1rem; font-weight:600; color:#64748b;">chuyến</span></div>
            <div class="adm-kpi-sub">
                <i class="bi bi-truck-front text-purple"></i>
                <span>@data.ActiveBuses xe sẵn sàng hoạt động</span>
            </div>
            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                <small class="text-muted">@data.CancelledTrips chuyến đã hủy</small>
                <a href="/admin/trips" class="adm-kpi-tag text-decoration-none text-purple">Quản lý chuyến &rarr;</a>
            </div>
        </div>

        <!-- KPI 4: Mạng lưới vận tải -->
        <div class="adm-kpi-card">
            <div class="adm-kpi-card-top">
                <span class="adm-kpi-label">Mạng lưới vận chuyển</span>
                <div class="adm-kpi-icon amber"><i class="bi bi-signpost-2-fill"></i></div>
            </div>
            <div class="adm-kpi-val">@data.ActiveRoutes <span style="font-size: 1rem; font-weight:600; color:#64748b;">tuyến</span></div>
            <div class="adm-kpi-sub">
                <i class="bi bi-buildings text-warning"></i>
                <span>@data.ActiveOperators nhà xe đối tác (@data.VerifiedOperators đã xác minh)</span>
            </div>
            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                <small class="text-muted">@data.InactiveOperators nhà xe tạm ngưng</small>
                <a href="/admin/routes" class="adm-kpi-tag text-decoration-none text-warning">Xem tuyến &rarr;</a>
            </div>
        </div>
    </div>

    <!-- CHARTS & VISUAL STATS ROW -->
    <div class="adm-chart-grid">
        <!-- Chart 1: Phân bổ trạng thái đơn đặt chỗ -->
        <section class="adm-card" style="margin-bottom:0">
            <div class="adm-toolbar">
                <h2>Cơ cấu trạng thái Đơn đặt chỗ</h2>
                <span class="adm-kpi-tag">Tổng @data.TotalBookings đơn</span>
            </div>
            <p class="adm-hint" style="margin-top:0">Tỷ lệ chuyển đổi đơn hàng qua các trạng thái thanh toán và giữ chỗ.</p>

            <!-- Stacked Segmented Bar -->
            <div class="adm-progress-stacked">
                <div class="adm-progress-segment green" style="width: @(GetPercentage(data.ConfirmedBookings, data.TotalBookings))%" title="Đã xác nhận: @data.ConfirmedBookings đơn"></div>
                <div class="adm-progress-segment amber" style="width: @(GetPercentage(data.PendingBookings, data.TotalBookings))%" title="Chờ thanh toán: @data.PendingBookings đơn"></div>
                <div class="adm-progress-segment red" style="width: @(GetPercentage(data.CancelledBookings, data.TotalBookings))%" title="Đã hủy: @data.CancelledBookings đơn"></div>
                <div class="adm-progress-segment slate" style="width: @(GetPercentage(data.ExpiredBookings, data.TotalBookings))%" title="Hết hạn: @data.ExpiredBookings đơn"></div>
            </div>

            <!-- Legend Grid -->
            <div class="adm-legend-grid">
                <div class="adm-legend-item">
                    <div class="adm-legend-left">
                        <span class="adm-legend-dot green"></span>
                        <span>Đã xác nhận</span>
                    </div>
                    <div class="adm-legend-right">
                        <span>@data.ConfirmedBookings</span>
                        <span class="adm-legend-pct">(@GetPercentage(data.ConfirmedBookings, data.TotalBookings)%)</span>
                    </div>
                </div>

                <div class="adm-legend-item">
                    <div class="adm-legend-left">
                        <span class="adm-legend-dot amber"></span>
                        <span>Chờ thanh toán</span>
                    </div>
                    <div class="adm-legend-right">
                        <span>@data.PendingBookings</span>
                        <span class="adm-legend-pct">(@GetPercentage(data.PendingBookings, data.TotalBookings)%)</span>
                    </div>
                </div>

                <div class="adm-legend-item">
                    <div class="adm-legend-left">
                        <span class="adm-legend-dot red"></span>
                        <span>Đã hủy</span>
                    </div>
                    <div class="adm-legend-right">
                        <span>@data.CancelledBookings</span>
                        <span class="adm-legend-pct">(@GetPercentage(data.CancelledBookings, data.TotalBookings)%)</span>
                    </div>
                </div>

                <div class="adm-legend-item">
                    <div class="adm-legend-left">
                        <span class="adm-legend-dot slate"></span>
                        <span>Hết hạn giữ chỗ</span>
                    </div>
                    <div class="adm-legend-right">
                        <span>@data.ExpiredBookings</span>
                        <span class="adm-legend-pct">(@GetPercentage(data.ExpiredBookings, data.TotalBookings)%)</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Chart 2: Sức khỏe vận hành & Cảnh báo -->
        <section class="adm-card" style="margin-bottom:0">
            <div class="adm-toolbar">
                <h2>Chỉ số Sức khỏe Vận hành & Cảnh báo</h2>
                <a href="/admin/monitoring" class="adm-btn small">Mở trang Giám sát</a>
            </div>
            <p class="adm-hint" style="margin-top:0">Giám sát các dịch vụ nền, hàng đợi email outbox và trạng thái xác minh đối tác.</p>

            <div class="d-flex flex-column gap-3 mt-3">
                <!-- Nhà xe xác minh -->
                <div>
                    <div class="d-flex justify-content-between align-items-center small fw-bold mb-1">
                        <span>Nhà xe đối tác đã xác minh</span>
                        <span class="text-primary">@data.VerifiedOperators / @data.ActiveOperators nhà xe (@GetPercentage(data.VerifiedOperators, data.ActiveOperators)%)</span>
                    </div>
                    <div class="adm-progress-stacked" style="margin: 0; height: 10px;">
                        <div class="adm-progress-segment blue" style="width: @(GetPercentage(data.VerifiedOperators, data.ActiveOperators))%"></div>
                    </div>
                </div>

                <!-- Chuyến xe đúng lịch -->
                <div>
                    <div class="d-flex justify-content-between align-items-center small fw-bold mb-1">
                        <span>Chuyến xe sẵn sàng khởi hành</span>
                        <span class="text-success">@data.UpcomingTrips chuyến (@data.SandboxTrips sandbox, @data.ReferenceTrips tham khảo)</span>
                    </div>
                    <div class="adm-progress-stacked" style="margin: 0; height: 10px;">
                        <div class="adm-progress-segment green" style="width: 100%"></div>
                    </div>
                </div>

                <!-- Cảnh báo hệ thống -->
                <div class="adm-stats" style="grid-template-columns: repeat(3, 1fr); margin-top: 6px;">
                    <a class="adm-stat is-link" href="/admin/monitoring" style="padding: 10px 12px;">
                        <span style="font-size:0.78rem">Email chờ gửi</span>
                        <strong style="font-size:1.15rem; color:@(data.EmailsPending > 0 ? "#b06000" : "#116338")">@data.EmailsPending</strong>
                    </a>
                    <a class="adm-stat is-link" href="/admin/monitoring" style="padding: 10px 12px;">
                        <span style="font-size:0.78rem">Email gửi lỗi</span>
                        <strong style="font-size:1.15rem; color:@(data.EmailsFailed > 0 ? "#a01c12" : "#116338")">@data.EmailsFailed</strong>
                    </a>
                    <a class="adm-stat is-link" href="/admin/monitoring" style="padding: 10px 12px;">
                        <span style="font-size:0.78rem">Cần đối soát</span>
                        <strong style="font-size:1.15rem; color:@(data.PaymentEventsNeedingReview > 0 ? "#a01c12" : "#116338")">@data.PaymentEventsNeedingReview</strong>
                    </a>
                </div>
            </div>
        </section>
    </div>

    <!-- LOWER ROW: TOP ROUTES & QUICK ACTIONS -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 20px; margin-top: 20px;">
        <!-- Top Tuyến xe hot -->
        <section class="adm-card" style="margin-bottom:0">
            <div class="adm-toolbar">
                <h2>Top Tuyến đường có lượt đặt nhiều nhất</h2>
                <a href="/admin/routes" class="small text-decoration-none text-primary fw-bold">Xem tất cả tuyến &rarr;</a>
            </div>
            @if (data.TopRoutes == null || data.TopRoutes.Count == 0)
            {
                <div class="adm-empty">Chưa có dữ liệu tuyến đường được đặt vé.</div>
            }
            else
            {
                <div class="adm-table-wrap">
                    <table class="adm-table">
                        <thead>
                            <tr>
                                <th>Tuyến đường</th>
                                <th>Nhà xe</th>
                                <th style="text-align:center">Lượt đặt</th>
                                <th style="text-align:right">Doanh thu</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var route in data.TopRoutes)
                            {
                                <tr>
                                    <td><strong>@route.RouteName</strong></td>
                                    <td>@route.OperatorName</td>
                                    <td style="text-align:center"><span class="adm-pill good">@route.BookingCount vé</span></td>
                                    <td style="text-align:right"><strong>@Money(route.TotalRevenue)</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <!-- Lối tắt Quản trị Nhanh -->
        <section class="adm-card" style="margin-bottom:0">
            <div class="adm-toolbar">
                <h2>Lối tắt Thao tác Nhanh</h2>
                <span class="adm-kpi-tag">Truy cập nhanh</span>
            </div>
            <p class="adm-hint" style="margin-top:0">Các hành động thường dùng dành cho quản trị viên và điều hành hệ thống.</p>

            <div class="adm-quick-grid">
                <a href="/admin/trips" class="adm-quick-card">
                    <i class="bi bi-calendar2-plus text-primary"></i>
                    <span>Tạo chuyến xe</span>
                </a>
                <a href="/admin/routes" class="adm-quick-card">
                    <i class="bi bi-signpost-split text-success"></i>
                    <span>Thêm tuyến đường</span>
                </a>
                <a href="/admin/fleet" class="adm-quick-card">
                    <i class="bi bi-truck text-purple"></i>
                    <span>Đăng ký xe mới</span>
                </a>
                <a href="/admin/operators" class="adm-quick-card">
                    <i class="bi bi-building-add text-warning"></i>
                    <span>Thêm nhà xe</span>
                </a>
                <a href="/staff/verify-ticket" class="adm-quick-card">
                    <i class="bi bi-qr-code-scan text-danger"></i>
                    <span>Soát vé QR</span>
                </a>
                <a href="/admin/monitoring" class="adm-quick-card">
                    <i class="bi bi-envelope-paper text-info"></i>
                    <span>Hàng đợi Email</span>
                </a>
            </div>
        </section>
    </div>

    <!-- RECENT BOOKINGS PREVIEW -->
    <section class="adm-card" style="margin-top: 20px;">
        <div class="adm-toolbar">
            <h2>Đơn đặt chỗ mới nhất</h2>
            <a href="/admin/bookings" class="adm-btn small primary">Quản lý toàn bộ @data.TotalBookings đơn đặt chỗ</a>
        </div>
        @if (data.RecentBookings == null || data.RecentBookings.Count == 0)
        {
            <div class="adm-empty">Chưa có đơn đặt chỗ nào được tạo.</div>
        }
        else
        {
            <div class="adm-table-wrap">
                <table class="adm-table">
                    <thead>
                        <tr>
                            <th>Mã đơn</th>
                            <th>Tuyến đường / Khởi hành</th>
                            <th>Hành khách</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái đơn</th>
                            <th>Thanh toán</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in data.RecentBookings)
                        {
                            <tr>
                                <td><strong>@row.BookingCode</strong><small>@Vn(row.CreatedAt)</small></td>
                                <td>@row.RouteName<small>@Vn(row.DepartureTime)</small></td>
                                <td>@row.MaskedPassengerName<small>@row.MaskedPhone</small></td>
                                <td>@Money(row.TotalAmount)@if (row.IsSandbox) { <small>Sandbox</small> }</td>
                                <td><span class="adm-pill @BookingPill(row.Status)">@BookingLabel(row.Status)</span></td>
                                <td><span class="adm-pill @PaymentPill(row.PaymentStatus)">@PaymentLabel(row.PaymentStatus)</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@code {
    private AdminDashboardDto? data;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private Task ReloadAsync() => LoadAsync(async () => data = await Admin.GetDashboardAsync());

    private static double GetPercentage(int part, int total)
    {
        if (total <= 0) return 0;
        return Math.Round((double)part * 100 / total, 1);
    }

    private static string BookingLabel(string status) => status switch
    {
        "PendingPayment" => "Chờ thanh toán",
        "Confirmed" => "Đã xác nhận",
        "Cancelled" => "Đã hủy",
        "Completed" => "Hoàn tất",
        "Expired" => "Hết hạn",
        _ => status
    };

    private static string PaymentLabel(string status) => status switch
    {
        "Unpaid" => "Chưa thanh toán",
        "Pending" => "Đang xử lý",
        "Paid" => "Đã thanh toán",
        "Refunded" => "Đã hoàn tiền",
        "Failed" => "Thất bại",
        _ => status
    };

    private static string BookingPill(string status) => status switch
    {
        "Confirmed" or "Completed" => "good",
        "PendingPayment" => "warn",
        "Cancelled" => "bad",
        _ => "muted"
    };

    private static string PaymentPill(string status) => status switch
    {
        "Paid" => "good",
        "Failed" => "bad",
        "Pending" => "warn",
        _ => "muted"
    };
}
