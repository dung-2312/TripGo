@page "/account/profile"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = Tripgo.Web.Services.AccountPolicy.Name)]
@using System.Security.Claims
@using Tripgo.Application.DTOs
@using Tripgo.Application.Interfaces
@inject IAuthService AuthService
@inject IBookingService BookingService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Hồ sơ cá nhân | TripGo</PageTitle>

<div class="py-4 py-md-5" style="background-color: var(--tg-bg); min-height: calc(100vh - 160px);">
    <div class="container">
        <!-- Breadcrumb & Top Bar -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1">
                        <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Trang chủ</a></li>
                        <li class="breadcrumb-item active text-primary fw-semibold" aria-current="page">Hồ sơ cá nhân</li>
                    </ol>
                </nav>
                <h2 class="fw-bold text-dark mb-0" style="font-size: 1.75rem;">Quản lý tài khoản</h2>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a href="/my-tickets" class="btn btn-warning rounded-pill px-3 py-2 fw-bold text-dark shadow-sm">
                    <i class="bi bi-ticket-detailed-fill me-1"></i> Vé của tôi
                </a>
                <a href="/auth/logout" class="btn btn-outline-danger rounded-pill px-3 py-2 fw-bold">
                    <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
                </a>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="card p-5 text-center rounded-4 border-0 shadow-sm" style="background: var(--tg-surface);">
                <div class="spinner-border text-primary mx-auto mb-3" role="status"></div>
                <div class="text-muted">Đang tải thông tin tài khoản...</div>
            </div>
        }
        else if (profile == null)
        {
            <div class="alert alert-warning rounded-4 shadow-sm p-4 text-center border-0">
                <i class="bi bi-exclamation-circle-fill text-warning fs-1 d-block mb-2"></i>
                <h5 class="fw-bold text-dark">Không tìm thấy thông tin tài khoản</h5>
                <p class="text-muted small mb-3">Phiên đăng nhập của bạn có thể đã hết hạn hoặc cần đăng nhập lại.</p>
                <a href="/login" class="tg-auth-btn-primary d-inline-block text-decoration-none px-4 py-2">Đăng nhập lại</a>
            </div>
        }
        else
        {
            <div class="row g-4">
                <!-- Left Sidebar: Profile Summary Card -->
                <div class="col-lg-4">
                    <div class="card shadow-sm rounded-4 border-0 p-4 text-center mb-4" style="background: var(--tg-surface); border: 1px solid var(--tg-border) !important;">
                        <div class="tg-profile-avatar-circle mx-auto mb-3">
                            @(string.IsNullOrWhiteSpace(profile.FullName) ? "U" : profile.FullName.Substring(0, 1).ToUpper())
                        </div>
                        <h4 class="fw-bold text-dark mb-1">@profile.FullName</h4>
                        <div class="text-muted small mb-2">@profile.Email</div>
                        <div>
                            @if (profile.Role == "Admin")
                            {
                                <span class="badge bg-danger rounded-pill px-3 py-1">Quản trị viên</span>
                            }
                            else
                            {
                                <span class="badge bg-primary rounded-pill px-3 py-1">Khách hàng thành viên</span>
                            }
                        </div>

                        <hr class="my-4" style="border-color: var(--tg-border);" />

                        <div class="d-flex flex-column gap-3 text-start">
                            <div class="d-flex justify-content-between align-items-center small">
                                <span class="text-secondary"><i class="bi bi-telephone-fill me-2 text-primary"></i>Điện thoại:</span>
                                <span class="fw-bold text-dark">@profile.PhoneNumber</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center small">
                                <span class="text-secondary"><i class="bi bi-calendar-check-fill me-2 text-success"></i>Ngày tham gia:</span>
                                <span class="fw-semibold text-dark">@profile.CreatedAt.ToVietnam().ToString("dd/MM/yyyy")</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center small">
                                <span class="text-secondary"><i class="bi bi-ticket-perforated-fill me-2 text-warning"></i>Vé đã đặt:</span>
                                <span class="badge bg-light text-primary border fw-bold px-2 py-1">@totalBookingsCount vé</span>
                            </div>
                        </div>

                        <div class="mt-4 pt-2">
                            <a href="/my-tickets" class="btn btn-primary w-100 fw-bold rounded-pill shadow-sm py-2">
                                <i class="bi bi-ticket-detailed me-1"></i> Xem lịch sử đặt vé
                            </a>
                        </div>
                    </div>

                    <!-- Trust / Security Card -->
                    <div class="card shadow-sm rounded-4 border-0 p-3" style="background: var(--tg-surface); border: 1px solid var(--tg-border) !important;">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle p-2 bg-success bg-opacity-10 text-success fs-4">
                                <i class="bi bi-shield-check"></i>
                            </div>
                            <div>
                                <div class="fw-bold small text-dark">Tài khoản được bảo vệ</div>
                                <div class="text-muted" style="font-size: 0.78rem;">Phiên làm việc được mã hóa an toàn qua Cookie HTTP-Only</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Tabs: Update Information & Change Password -->
                <div class="col-lg-8">
                    <div class="card shadow-sm rounded-4 border-0 overflow-hidden" style="background: var(--tg-surface); border: 1px solid var(--tg-border) !important;">
                        <div class="card-header bg-white border-bottom p-0">
                            <ul class="nav nav-tabs tg-profile-nav border-0 px-4 pt-2" role="tablist">
                                <li class="nav-item" role="presentation">
                                    <button id="tab-info" class="nav-link @(activeTab == "info" ? "active" : "")"
                                            role="tab"
                                            aria-selected="@(activeTab == "info" ? "true" : "false")"
                                            aria-controls="tabpanel-info"
                                            @onclick='() => activeTab = "info"'>
                                        <i class="bi bi-person-lines-fill me-2"></i> Thông tin cá nhân
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button id="tab-password" class="nav-link @(activeTab == "password" ? "active" : "")"
                                            role="tab"
                                            aria-selected="@(activeTab == "password" ? "true" : "false")"
                                            aria-controls="tabpanel-password"
                                            @onclick='() => activeTab = "password"'>
                                        <i class="bi bi-shield-lock-fill me-2"></i> Đổi mật khẩu
                                    </button>
                                </li>
                            </ul>
                        </div>

                        <div class="card-body p-4 p-md-5">
                            @if (!string.IsNullOrWhiteSpace(successMessage))
                            {
                                <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4 border-0 shadow-sm" role="status" aria-live="polite">
                                    <i class="bi bi-check-circle-fill me-2"></i>@successMessage
                                    <button type="button" class="btn-close" @onclick="() => successMessage = null" aria-label="Đóng thông báo"></button>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(errorMessage))
                            {
                                <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4 border-0 shadow-sm" role="alert" aria-live="assertive">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
                                    <button type="button" class="btn-close" @onclick="() => errorMessage = null" aria-label="Đóng thông báo lỗi"></button>
                                </div>
                            }

                            <!-- Tab 1: Personal Info -->
                            @if (activeTab == "info")
                            {
                                <div id="tabpanel-info" role="tabpanel" aria-labelledby="tab-info">
                                    <EditForm Model="@updateProfileModel" OnValidSubmit="HandleUpdateProfileAsync">
                                        <DataAnnotationsValidator />

                                        <div class="mb-3">
                                            <label class="form-label fw-bold small text-dark mb-1" for="profEmail">Địa chỉ Email (Định danh tài khoản)</label>
                                            <div class="tg-auth-input-group bg-light">
                                                <span class="tg-auth-input-icon text-muted">
                                                    <i class="bi bi-envelope"></i>
                                                </span>
                                                <input id="profEmail" type="text" class="tg-auth-input text-muted" value="@profile.Email" disabled readonly />
                                                <span class="tg-auth-input-icon text-muted" title="Email không thể thay đổi">
                                                    <i class="bi bi-lock-fill"></i>
                                                </span>
                                            </div>
                                            <small class="text-muted"><i class="bi bi-info-circle me-1"></i>Email đăng ký được dùng làm định danh đăng nhập và không thể sửa đổi</small>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label fw-bold small text-dark mb-1" for="profFullName">Họ và tên</label>
                                            <div class="tg-auth-input-group">
                                                <span class="tg-auth-input-icon">
                                                    <i class="bi bi-person"></i>
                                                </span>
                                                <InputText id="profFullName" class="tg-auth-input"
                                                           autocomplete="name"
                                                           @bind-Value="updateProfileModel.FullName" disabled="@isSaving" />
                                            </div>
                                            <ValidationMessage For="@(() => updateProfileModel.FullName)" class="text-danger small mt-1" />
                                        </div>

                                        <div class="mb-4">
                                            <label class="form-label fw-bold small text-dark mb-1" for="profPhone">Số điện thoại</label>
                                            <div class="tg-auth-input-group">
                                                <span class="tg-auth-input-icon">
                                                    <i class="bi bi-telephone"></i>
                                                </span>
                                                <InputText id="profPhone" class="tg-auth-input"
                                                           autocomplete="tel"
                                                           @bind-Value="updateProfileModel.PhoneNumber" disabled="@isSaving" />
                                            </div>
                                            <ValidationMessage For="@(() => updateProfileModel.PhoneNumber)" class="text-danger small mt-1" />
                                        </div>

                                        <button type="submit" class="tg-auth-btn-primary d-inline-flex align-items-center gap-2"
                                                disabled="@isSaving">
                                            @if (isSaving)
                                            {
                                                <span class="spinner-border spinner-border-sm" role="status"></span>
                                                <span>Đang lưu thay đổi...</span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-check2-circle"></i>
                                                <span>Lưu thay đổi</span>
                                            }
                                        </button>
                                    </EditForm>
                                </div>
                            }

                            <!-- Tab 2: Change Password -->
                            @if (activeTab == "password")
                            {
                                <div id="tabpanel-password" role="tabpanel" aria-labelledby="tab-password">
                                    <EditForm Model="@changePasswordModel" OnValidSubmit="HandleChangePasswordAsync">
                                        <DataAnnotationsValidator />

                                        <div class="mb-3">
                                            <label class="form-label fw-bold small text-dark mb-1" for="currPass">Mật khẩu hiện tại</label>
                                            <div class="tg-auth-input-group">
                                                <span class="tg-auth-input-icon">
                                                    <i class="bi bi-shield-lock"></i>
                                                </span>
                                                <input id="currPass" type="@(showCurrentPassword ? "text" : "password")"
                                                       class="tg-auth-input"
                                                       placeholder="Nhập mật khẩu hiện tại..."
                                                       autocomplete="current-password"
                                                       @bind="changePasswordModel.CurrentPassword"
                                                       disabled="@isSaving" />
                                                <button type="button" class="tg-auth-toggle-pwd"
                                                        @onclick="() => showCurrentPassword = !showCurrentPassword"
                                                        aria-label="@(showCurrentPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")"
                                                        title="@(showCurrentPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")">
                                                    <i class="bi @(showCurrentPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                                </button>
                                            </div>
                                            <ValidationMessage For="@(() => changePasswordModel.CurrentPassword)" class="text-danger small mt-1" />
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label fw-bold small text-dark mb-1" for="newPass">Mật khẩu mới</label>
                                            <div class="tg-auth-input-group">
                                                <span class="tg-auth-input-icon">
                                                    <i class="bi bi-key"></i>
                                                </span>
                                                <input id="newPass" type="@(showNewPassword ? "text" : "password")"
                                                       class="tg-auth-input"
                                                       placeholder="Tối thiểu 6 ký tự..."
                                                       autocomplete="new-password"
                                                       @bind="changePasswordModel.NewPassword"
                                                       disabled="@isSaving" />
                                                <button type="button" class="tg-auth-toggle-pwd"
                                                        @onclick="() => showNewPassword = !showNewPassword"
                                                        aria-label="@(showNewPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")"
                                                        title="@(showNewPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")">
                                                    <i class="bi @(showNewPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                                </button>
                                            </div>
                                            <ValidationMessage For="@(() => changePasswordModel.NewPassword)" class="text-danger small mt-1" />
                                        </div>

                                        <div class="mb-4">
                                            <label class="form-label fw-bold small text-dark mb-1" for="confirmPass">Xác nhận mật khẩu mới</label>
                                            <div class="tg-auth-input-group">
                                                <span class="tg-auth-input-icon">
                                                    <i class="bi bi-key-fill"></i>
                                                </span>
                                                <input id="confirmPass" type="@(showConfirmPassword ? "text" : "password")"
                                                       class="tg-auth-input"
                                                       placeholder="Nhập lại mật khẩu mới..."
                                                       autocomplete="new-password"
                                                       @bind="changePasswordModel.ConfirmNewPassword"
                                                       disabled="@isSaving" />
                                                <button type="button" class="tg-auth-toggle-pwd"
                                                        @onclick="() => showConfirmPassword = !showConfirmPassword"
                                                        aria-label="@(showConfirmPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")"
                                                        title="@(showConfirmPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")">
                                                    <i class="bi @(showConfirmPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                                </button>
                                            </div>
                                            <ValidationMessage For="@(() => changePasswordModel.ConfirmNewPassword)" class="text-danger small mt-1" />
                                        </div>

                                        <button type="submit" class="tg-auth-btn-primary d-inline-flex align-items-center gap-2"
                                                disabled="@isSaving">
                                            @if (isSaving)
                                            {
                                                <span class="spinner-border spinner-border-sm" role="status"></span>
                                                <span>Đang cập nhật mật khẩu...</span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-shield-check"></i>
                                                <span>Đổi mật khẩu</span>
                                            }
                                        </button>
                                    </EditForm>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private bool isLoading = true;
    private bool isSaving = false;
    private string activeTab = "info";
    private UserProfileDto? profile;
    private long currentUserId;
    private int totalBookingsCount = 0;

    private UpdateProfileRequestDto updateProfileModel = new();
    private ChangePasswordRequestDto changePasswordModel = new();

    private bool showCurrentPassword = false;
    private bool showNewPassword = false;
    private bool showConfirmPassword = false;

    private string? successMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userIdVal = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

            if (long.TryParse(userIdVal, out currentUserId) && currentUserId > 0)
            {
                profile = await AuthService.GetUserProfileAsync(currentUserId);
                if (profile != null)
                {
                    updateProfileModel.FullName = profile.FullName;
                    updateProfileModel.PhoneNumber = profile.PhoneNumber;

                    var tickets = await BookingService.GetBookingsForCurrentUserAsync();
                    totalBookingsCount = tickets.Count;
                }
            }
        }
        catch (Exception)
        {
            errorMessage = "Không thể tải thông tin hồ sơ lúc này.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleUpdateProfileAsync()
    {
        successMessage = null;
        errorMessage = null;
        isSaving = true;

        try
        {
            var result = await AuthService.UpdateProfileAsync(currentUserId, updateProfileModel);
            if (result.Success)
            {
                successMessage = "Cập nhật thông tin cá nhân thành công!";
                if (profile != null)
                {
                    profile.FullName = updateProfileModel.FullName;
                    profile.PhoneNumber = updateProfileModel.PhoneNumber;
                }
            }
            else
            {
                errorMessage = result.Message;
            }
        }
        catch
        {
            errorMessage = "Đã xảy ra lỗi khi cập nhật thông tin.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task HandleChangePasswordAsync()
    {
        successMessage = null;
        errorMessage = null;
        isSaving = true;

        try
        {
            var result = await AuthService.ChangePasswordAsync(currentUserId, changePasswordModel);
            if (result.Success)
            {
                successMessage = "Đổi mật khẩu thành công!";
                changePasswordModel = new ChangePasswordRequestDto();
            }
            else
            {
                errorMessage = result.Message;
            }
        }
        catch
        {
            errorMessage = "Đã xảy ra lỗi khi đổi mật khẩu.";
        }
        finally
        {
            isSaving = false;
        }
    }
}
