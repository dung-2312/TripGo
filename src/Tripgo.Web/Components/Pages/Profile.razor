@page "/account/profile"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Security.Claims
@using Tripgo.Application.DTOs
@using Tripgo.Application.Interfaces
@inject IAuthService AuthService
@inject IBookingService BookingService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Tài khoản của tôi | TripGo</PageTitle>

<div class="tg-profile-page py-4 py-md-5">
    <div class="container">
        <!-- Breadcrumb & Header -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1">
                        <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Trang chủ</a></li>
                        <li class="breadcrumb-item active text-primary fw-semibold" aria-current="page">Tài khoản cá nhân</li>
                    </ol>
                </nav>
                <h2 class="fw-bold text-dark mb-0">Hồ sơ khách hàng</h2>
            </div>
            <a href="/auth/logout" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1 fw-bold">
                <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
            </a>
        </div>

        @if (isLoading)
        {
            <div class="card p-5 text-center shadow-sm rounded-4 border-0">
                <div class="spinner-border text-primary mx-auto mb-3" role="status"></div>
                <div class="text-muted">Đang tải thông tin tài khoản...</div>
            </div>
        }
        else if (profile == null)
        {
            <div class="alert alert-warning rounded-4 shadow-sm p-4 text-center">
                <i class="bi bi-exclamation-circle-fill text-warning fs-3 d-block mb-2"></i>
                <h5 class="fw-bold">Không tìm thấy thông tin tài khoản</h5>
                <p class="text-muted small mb-3">Phiên đăng nhập của bạn có thể đã hết hạn.</p>
                <a href="/login" class="btn btn-primary btn-sm rounded-pill px-4">Đăng nhập lại</a>
            </div>
        }
        else
        {
            <div class="row g-4">
                <!-- Left Sidebar: Profile Summary Card -->
                <div class="col-lg-4">
                    <div class="card shadow-sm rounded-4 border-0 p-4 text-center mb-4 bg-white">
                        <div class="tg-avatar-lg mx-auto mb-3 text-white fw-bold">
                            @(string.IsNullOrWhiteSpace(profile.FullName) ? "U" : profile.FullName.Substring(0, 1).ToUpper())
                        </div>
                        <h5 class="fw-bold text-dark mb-1">@profile.FullName</h5>
                        <div class="text-muted small mb-2">@profile.Email</div>
                        <div>
                            @if (profile.Role == "Admin")
                            {
                                <span class="badge bg-danger rounded-pill px-3 py-1">Quản trị viên</span>
                            }
                            else
                            {
                                <span class="badge bg-primary rounded-pill px-3 py-1">Khách hàng thành viên</span>
                            }
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-between align-items-center small text-secondary mb-2">
                            <span><i class="bi bi-telephone-fill me-2 text-primary"></i>Điện thoại:</span>
                            <span class="fw-bold text-dark">@profile.PhoneNumber</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center small text-secondary mb-2">
                            <span><i class="bi bi-calendar-check-fill me-2 text-success"></i>Ngày tham gia:</span>
                            <span class="fw-semibold text-dark">@profile.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center small text-secondary">
                            <span><i class="bi bi-ticket-perforated-fill me-2 text-warning"></i>Vé đã đặt:</span>
                            <span class="badge bg-light text-dark border fw-bold">@totalBookingsCount vé</span>
                        </div>

                        <div class="mt-4 pt-2">
                            <a href="/my-tickets" class="btn btn-warning w-100 fw-bold rounded-pill text-dark shadow-sm">
                                <i class="bi bi-ticket-detailed-fill me-1"></i> Xem danh sách vé của tôi
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Right Tabs: Update Information & Change Password -->
                <div class="col-lg-8">
                    <div class="card shadow-sm rounded-4 border-0 overflow-hidden bg-white">
                        <div class="card-header bg-white border-bottom p-0">
                            <ul class="nav nav-tabs tg-profile-tabs border-0 px-4 pt-3" role="tablist">
                                <li class="nav-item">
                                    <button class="nav-link @(activeTab == "info" ? "active" : "") fw-bold border-0 pb-3"
                                            @onclick='() => activeTab = "info"'>
                                        <i class="bi bi-person-lines-fill me-1"></i> Thông tin cá nhân
                                    </button>
                                </li>
                                <li class="nav-item">
                                    <button class="nav-link @(activeTab == "password" ? "active" : "") fw-bold border-0 pb-3"
                                            @onclick='() => activeTab = "password"'>
                                        <i class="bi bi-shield-lock-fill me-1"></i> Đổi mật khẩu
                                    </button>
                                </li>
                            </ul>
                        </div>

                        <div class="card-body p-4 p-md-5">
                            @if (!string.IsNullOrWhiteSpace(successMessage))
                            {
                                <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
                                    <i class="bi bi-check-circle-fill me-2"></i>@successMessage
                                    <button type="button" class="btn-close" @onclick="() => successMessage = null" aria-label="Close"></button>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(errorMessage))
                            {
                                <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
                                    <button type="button" class="btn-close" @onclick="() => errorMessage = null" aria-label="Close"></button>
                                </div>
                            }

                            <!-- Tab 1: Personal Info -->
                            @if (activeTab == "info")
                            {
                                <EditForm Model="@updateProfileModel" OnValidSubmit="HandleUpdateProfileAsync">
                                    <DataAnnotationsValidator />

                                    <div class="mb-3">
                                        <label class="form-label fw-semibold small text-dark">Địa chỉ Email (Định danh tài khoản)</label>
                                        <input type="text" class="form-control bg-light text-muted" value="@profile.Email" disabled readonly />
                                        <small class="text-muted"><i class="bi bi-lock-fill me-1"></i>Email không thể thay đổi sau khi đăng ký</small>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-semibold small text-dark" for="profFullName">Họ và tên</label>
                                        <InputText id="profFullName" class="form-control" @bind-Value="updateProfileModel.FullName" disabled="@isSaving" />
                                        <ValidationMessage For="@(() => updateProfileModel.FullName)" class="text-danger small mt-1" />
                                    </div>

                                    <div class="mb-4">
                                        <label class="form-label fw-semibold small text-dark" for="profPhone">Số điện thoại</label>
                                        <InputText id="profPhone" class="form-control" @bind-Value="updateProfileModel.PhoneNumber" disabled="@isSaving" />
                                        <ValidationMessage For="@(() => updateProfileModel.PhoneNumber)" class="text-danger small mt-1" />
                                    </div>

                                    <button type="submit" class="btn btn-primary px-4 py-2 fw-bold rounded-pill shadow-sm d-inline-flex align-items-center gap-2"
                                            disabled="@isSaving">
                                        @if (isSaving)
                                        {
                                            <span class="spinner-border spinner-border-sm" role="status"></span>
                                            <span>Đang lưu thông tin...</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-save2-fill"></i>
                                            <span>Cập nhật thông tin</span>
                                        }
                                    </button>
                                </EditForm>
                            }

                            <!-- Tab 2: Change Password -->
                            @if (activeTab == "password")
                            {
                                <EditForm Model="@changePasswordModel" OnValidSubmit="HandleChangePasswordAsync">
                                    <DataAnnotationsValidator />

                                    <div class="mb-3">
                                        <label class="form-label fw-semibold small text-dark" for="currPass">Mật khẩu hiện tại</label>
                                        <div class="input-group">
                                            <input id="currPass" type="@(showCurrentPassword ? "text" : "password")"
                                                   class="form-control"
                                                   @bind="changePasswordModel.CurrentPassword"
                                                   disabled="@isSaving" />
                                            <button type="button" class="btn btn-outline-secondary"
                                                    @onclick="() => showCurrentPassword = !showCurrentPassword">
                                                <i class="bi @(showCurrentPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                            </button>
                                        </div>
                                        <ValidationMessage For="@(() => changePasswordModel.CurrentPassword)" class="text-danger small mt-1" />
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-semibold small text-dark" for="newPass">Mật khẩu mới</label>
                                        <div class="input-group">
                                            <input id="newPass" type="@(showNewPassword ? "text" : "password")"
                                                   class="form-control"
                                                   @bind="changePasswordModel.NewPassword"
                                                   disabled="@isSaving" />
                                            <button type="button" class="btn btn-outline-secondary"
                                                    @onclick="() => showNewPassword = !showNewPassword">
                                                <i class="bi @(showNewPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                            </button>
                                        </div>
                                        <ValidationMessage For="@(() => changePasswordModel.NewPassword)" class="text-danger small mt-1" />
                                    </div>

                                    <div class="mb-4">
                                        <label class="form-label fw-semibold small text-dark" for="confirmPass">Xác nhận mật khẩu mới</label>
                                        <div class="input-group">
                                            <input id="confirmPass" type="@(showConfirmPassword ? "text" : "password")"
                                                   class="form-control"
                                                   @bind="changePasswordModel.ConfirmNewPassword"
                                                   disabled="@isSaving" />
                                            <button type="button" class="btn btn-outline-secondary"
                                                    @onclick="() => showConfirmPassword = !showConfirmPassword">
                                                <i class="bi @(showConfirmPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                            </button>
                                        </div>
                                        <ValidationMessage For="@(() => changePasswordModel.ConfirmNewPassword)" class="text-danger small mt-1" />
                                    </div>

                                    <button type="submit" class="btn btn-primary px-4 py-2 fw-bold rounded-pill shadow-sm d-inline-flex align-items-center gap-2"
                                            disabled="@isSaving">
                                        @if (isSaving)
                                        {
                                            <span class="spinner-border spinner-border-sm" role="status"></span>
                                            <span>Đang đổi mật khẩu...</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-key-fill"></i>
                                            <span>Đổi mật khẩu</span>
                                        }
                                    </button>
                                </EditForm>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .tg-profile-page {
        min-height: calc(100vh - 160px);
        background: #f8fafc;
    }

    .tg-avatar-lg {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #0d5cb6, #083e7d);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.2rem;
        box-shadow: 0 4px 12px rgba(13, 92, 182, 0.25);
    }

    .tg-profile-tabs .nav-link {
        color: #64748b;
        background: transparent;
        position: relative;
    }

    .tg-profile-tabs .nav-link.active {
        color: #0d5cb6 !important;
        background: transparent;
        border-bottom: 3px solid #0d5cb6 !important;
    }
</style>

@code {
    private bool isLoading = true;
    private bool isSaving = false;
    private string activeTab = "info";
    private UserProfileDto? profile;
    private long currentUserId;
    private int totalBookingsCount = 0;

    private UpdateProfileRequestDto updateProfileModel = new();
    private ChangePasswordRequestDto changePasswordModel = new();

    private bool showCurrentPassword = false;
    private bool showNewPassword = false;
    private bool showConfirmPassword = false;

    private string? successMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userIdVal = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

            if (long.TryParse(userIdVal, out currentUserId) && currentUserId > 0)
            {
                profile = await AuthService.GetUserProfileAsync(currentUserId);
                if (profile != null)
                {
                    updateProfileModel.FullName = profile.FullName;
                    updateProfileModel.PhoneNumber = profile.PhoneNumber;

                    var tickets = await BookingService.GetBookingsForCurrentUserAsync();
                    totalBookingsCount = tickets.Count;
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Không thể tải thông tin hồ sơ lúc này.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleUpdateProfileAsync()
    {
        successMessage = null;
        errorMessage = null;
        isSaving = true;

        try
        {
            var result = await AuthService.UpdateProfileAsync(currentUserId, updateProfileModel);
            if (result.Success)
            {
                successMessage = "Cập nhật thông tin cá nhân thành công!";
                if (profile != null)
                {
                    profile.FullName = updateProfileModel.FullName;
                    profile.PhoneNumber = updateProfileModel.PhoneNumber;
                }
            }
            else
            {
                errorMessage = result.Message;
            }
        }
        catch
        {
            errorMessage = "Đã xảy ra lỗi khi cập nhật thông tin.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task HandleChangePasswordAsync()
    {
        successMessage = null;
        errorMessage = null;
        isSaving = true;

        try
        {
            var result = await AuthService.ChangePasswordAsync(currentUserId, changePasswordModel);
            if (result.Success)
            {
                successMessage = "Đổi mật khẩu thành công!";
                changePasswordModel = new ChangePasswordRequestDto();
            }
            else
            {
                errorMessage = result.Message;
            }
        }
        catch
        {
            errorMessage = "Đã xảy ra lỗi khi đổi mật khẩu.";
        }
        finally
        {
            isSaving = false;
        }
    }
}
