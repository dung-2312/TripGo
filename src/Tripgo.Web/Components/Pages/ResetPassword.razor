@page "/reset-password"
@using Tripgo.Application.DTOs
@using Tripgo.Application.Interfaces
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Đặt lại mật khẩu | TripGo</PageTitle>

<div class="tg-auth-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6 col-xl-5">
                <div class="tg-auth-card p-4 p-md-5">
                    <h3 class="fw-bold text-dark mb-3">Đặt lại mật khẩu</h3>
                    @if (completed)
                    {
                        <div class="alert alert-success" role="status">@statusMessage</div>
                        <a href="/login" class="tg-auth-btn-primary text-center text-decoration-none">Đăng nhập</a>
                    }
                    else
                    {
                        @if (!string.IsNullOrWhiteSpace(statusMessage))
                        {
                            <div class="alert alert-danger" role="alert">@statusMessage</div>
                        }

                        <EditForm Model="form" OnValidSubmit="ResetAsync">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="text-danger mb-3" />
                            <div class="mb-3">
                                <label class="form-label fw-bold" for="newPassword">Mật khẩu mới</label>
                                <InputText id="newPassword" type="password" class="tg-auth-input"
                                           @bind-Value="form.NewPassword" autocomplete="new-password" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold" for="confirmPassword">Xác nhận mật khẩu</label>
                                <InputText id="confirmPassword" type="password" class="tg-auth-input"
                                           @bind-Value="form.ConfirmNewPassword" autocomplete="new-password" />
                            </div>
                            <button type="submit" class="tg-auth-btn-primary w-100" disabled="@isSubmitting">
                                @(isSubmitting ? "Đang cập nhật..." : "Cập nhật mật khẩu")
                            </button>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private readonly ResetPasswordRequestDto form = new();
    private bool isSubmitting;
    private bool completed;
    private string? statusMessage;

    private async Task ResetAsync()
    {
        isSubmitting = true;
        statusMessage = null;
        try
        {
            var result = await AuthService.ResetPasswordAsync(new ResetPasswordRequestDto
            {
                Token = Token ?? string.Empty,
                NewPassword = form.NewPassword,
                ConfirmNewPassword = form.ConfirmNewPassword
            });
            completed = result.Success;
            statusMessage = result.Success
                ? "Mật khẩu đã được cập nhật."
                : result.ErrorMessage;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
