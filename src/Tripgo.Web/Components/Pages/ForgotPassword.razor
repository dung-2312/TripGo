@page "/forgot-password"
@using Tripgo.Application.DTOs
@using Tripgo.Application.Interfaces
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Đặt lại mật khẩu | TripGo</PageTitle>

<div class="tg-auth-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6 col-xl-5">
                <div class="tg-auth-card p-4 p-md-5">
                    <div class="text-center mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
                             style="width: 64px; height: 64px; background: var(--tg-primary-subtle); color: var(--tg-primary); font-size: 1.75rem; box-shadow: 0 4px 14px rgba(18, 100, 232, 0.15);">
                            <i class="bi bi-shield-lock-fill"></i>
                        </div>
                        <h3 class="fw-bold text-dark mb-1">Khôi phục mật khẩu</h3>
                        <p class="text-muted small mb-0">
                            Nhập địa chỉ email tài khoản TripGo của bạn. Chúng tôi sẽ xử lý yêu cầu đặt lại mật khẩu an toàn.
                        </p>
                    </div>

                    @if (isSubmitted)
                    {
                        <div class="alert alert-success rounded-4 p-3 mb-4 border-0 shadow-sm" role="status" aria-live="polite">
                            <div class="d-flex align-items-center gap-2 fw-bold text-success mb-2">
                                <i class="bi bi-check-circle-fill fs-5"></i> Yêu cầu đã được tiếp nhận
                            </div>
                            <div class="small text-secondary mb-3">
                                Nếu email khớp với tài khoản và dịch vụ email đã được cấu hình, liên kết đặt lại sẽ được gửi. Nếu không nhận được, hãy liên hệ quản trị viên qua kênh hỗ trợ đã xác thực.
                            </div>
                            <div class="p-3 bg-light rounded-3 small text-muted border border-secondary border-opacity-10">
                                <div class="fw-bold text-dark mb-1">
                                    <i class="bi bi-info-circle-fill text-primary me-1"></i> Bảo mật tài khoản
                                </div>
                                <div>
                                    Vì lý do bảo mật, thông báo này không cho biết địa chỉ email có thuộc tài khoản TripGo hay không.
                                </div>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <a href="/login" class="tg-auth-btn-primary text-center text-decoration-none">
                                <i class="bi bi-arrow-left me-1"></i> Quay lại trang Đăng nhập
                            </a>
                        </div>
                    }
                    else
                    {
                        @if (!string.IsNullOrWhiteSpace(errorMessage))
                        {
                            <div class="alert alert-danger alert-dismissible fade show mb-4 rounded-3 border-0 shadow-sm" role="alert" aria-live="assertive">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
                                <button type="button" class="btn-close" @onclick="() => errorMessage = null" aria-label="Đóng thông báo lỗi"></button>
                            </div>
                        }

                        <form @onsubmit="HandleForgotPasswordAsync">
                            <div class="mb-4">
                                <label class="form-label fw-bold small text-dark mb-1" for="resetEmail">Email đăng ký tài khoản</label>
                                <div class="tg-auth-input-group">
                                    <span class="tg-auth-input-icon">
                                        <i class="bi bi-envelope"></i>
                                    </span>
                                    <input id="resetEmail" type="email" class="tg-auth-input"
                                           placeholder="Nhập email của bạn..."
                                           autocomplete="email"
                                           @bind="email" required disabled="@isSubmitting" />
                                </div>
                            </div>

                            <button type="submit" class="tg-auth-btn-primary w-100 d-flex align-items-center justify-content-center gap-2 mb-3"
                                    disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status"></span>
                                    <span>Đang gửi yêu cầu...</span>
                                }
                                else
                                {
                                    <i class="bi bi-send-fill"></i>
                                    <span>Gửi yêu cầu đặt lại mật khẩu</span>
                                }
                            </button>

                            <div class="text-center pt-2">
                                <a href="/login" class="text-muted small text-decoration-none fw-semibold">
                                    <i class="bi bi-arrow-left me-1"></i> Quay lại trang Đăng nhập
                                </a>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string email = string.Empty;
    private bool isSubmitting = false;
    private bool isSubmitted = false;
    private string? errorMessage;

    private async Task HandleForgotPasswordAsync()
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            errorMessage = "Vui lòng nhập địa chỉ email.";
            return;
        }

        errorMessage = null;
        isSubmitting = true;

        try
        {
            await AuthService.RequestPasswordResetAsync(email.Trim());
            isSubmitted = true;
        }
        catch (Exception)
        {
            errorMessage = "Đã xảy ra lỗi khi gửi yêu cầu. Vui lòng thử lại sau.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
