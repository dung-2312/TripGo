@page "/forgot-password"
@using Tripgo.Application.DTOs
@using Tripgo.Application.Interfaces
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Quên mật khẩu | TripGo</PageTitle>

<div class="tg-auth-container py-4 py-md-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6 col-xl-5">
                <div class="card shadow-lg rounded-4 border-0 p-4 p-md-5 bg-white">
                    <div class="text-center mb-4">
                        <div class="tg-reset-icon-circle mx-auto mb-3">
                            <i class="bi bi-shield-lock text-primary fs-2"></i>
                        </div>
                        <h3 class="fw-bold text-dark">Đặt lại mật khẩu</h3>
                        <p class="text-muted small">
                            Nhập địa chỉ email đã đăng ký tài khoản TripGo. Hệ thống sẽ tạo liên kết và mã xác thực đặt lại mật khẩu an toàn.
                        </p>
                    </div>

                    @if (isSubmitted)
                    {
                        <div class="alert alert-success rounded-3 p-3 mb-4" role="alert">
                            <div class="d-flex align-items-center gap-2 fw-bold text-success mb-1">
                                <i class="bi bi-check-circle-fill"></i> Yêu cầu đã được ghi nhận
                            </div>
                            <div class="small text-secondary">
                                Nếu địa chỉ email <strong>@email</strong> tồn tại trên hệ thống, hướng dẫn đặt lại mật khẩu đã được gửi đến hộp thư của bạn.
                            </div>
                            <div class="mt-3 p-2 bg-light border rounded small text-muted">
                                <i class="bi bi-info-circle me-1 text-primary"></i>
                                <em>Lưu ý môi trường thử nghiệm:</em> Hệ thống email SMTP hiện đang ở chế độ giả lập. Vui lòng liên hệ quản trị viên hoặc sử dụng đường dây nóng hỗ trợ <strong>1900 6868</strong> để được cấp lại mật khẩu ngay lập tức.
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <a href="/login" class="btn btn-outline-primary py-2 fw-bold rounded-3">
                                <i class="bi bi-arrow-left me-1"></i> Trở về trang đăng nhập
                            </a>
                        </div>
                    }
                    else
                    {
                        @if (!string.IsNullOrWhiteSpace(errorMessage))
                        {
                            <div class="alert alert-danger alert-dismissible fade show mb-4 rounded-3" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
                                <button type="button" class="btn-close" @onclick="() => errorMessage = null" aria-label="Close"></button>
                            </div>
                        }

                        <form @onsubmit="HandleForgotPasswordAsync">
                            <div class="mb-4">
                                <label class="form-label fw-semibold small text-dark" for="resetEmail">Email đăng ký tài khoản</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted">
                                        <i class="bi bi-envelope"></i>
                                    </span>
                                    <input id="resetEmail" type="email" class="form-control border-start-0 ps-0"
                                           placeholder="Nhập email của bạn..."
                                           @bind="email" required disabled="@isSubmitting" />
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 py-2 fw-bold rounded-3 shadow-sm d-flex align-items-center justify-content-center gap-2 mb-3"
                                    disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status"></span>
                                    <span>Đang xử lý...</span>
                                }
                                else
                                {
                                    <i class="bi bi-send-fill"></i>
                                    <span>Gửi yêu cầu đặt lại mật khẩu</span>
                                }
                            </button>

                            <div class="text-center">
                                <a href="/login" class="text-secondary small text-decoration-none hover-primary">
                                    <i class="bi bi-arrow-left me-1"></i> Quay lại Đăng nhập
                                </a>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .tg-auth-container {
        min-height: calc(100vh - 160px);
        background: #f1f5f9;
        display: flex;
        align-items: center;
    }

    .tg-reset-icon-circle {
        width: 64px;
        height: 64px;
        background: rgba(13, 92, 182, 0.1);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>

@code {
    private string email = string.Empty;
    private bool isSubmitting = false;
    private bool isSubmitted = false;
    private string? errorMessage;

    private async Task HandleForgotPasswordAsync()
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            errorMessage = "Vui lòng nhập địa chỉ email.";
            return;
        }

        errorMessage = null;
        isSubmitting = true;

        try
        {
            await AuthService.RequestPasswordResetAsync(email.Trim());
            // Always show submitted view to prevent user enumeration
            isSubmitted = true;
        }
        catch
        {
            errorMessage = "Đã xảy ra lỗi khi gửi yêu cầu. Vui lòng thử lại sau.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
