@page "/"
@layout Tripgo.Web.Components.Layout.CustomerLayout
@inject NavigationManager Nav
@inject ICustomerBookingService BookingService

<PageTitle>TripGo - Đặt Vé Xe Khách Trực Tuyến Hàng Đầu Việt Nam</PageTitle>

<!-- Hero Section with Search Form -->
<section class="hero-section py-5 text-white position-relative">
    <div class="container py-lg-4 position-relative" style="z-index: 2;">
        <div class="row justify-content-center text-center mb-4">
            <div class="col-lg-9">
                <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-3 shadow-sm">
                    <i class="bi bi-stars me-1"></i> Nền tảng đặt vé xe khách thông minh
                </span>
                <h1 class="display-4 fw-black text-white mb-3">
                    Hành Trình Vạn Dặm, Vẹn Tròn Niềm Vui
                </h1>
                <p class="lead text-light opacity-90 mx-auto" style="max-width: 650px;">
                    Kết nối hơn 500+ nhà xe uy tín trên toàn quốc. Đặt vé nhanh chóng, chọn đúng chỗ ngồi, thanh toán bảo mật 100%.
                </p>
            </div>
        </div>

        <!-- Quick Search Box -->
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white text-dark">
                    <div class="row g-3 align-items-center">
                        <!-- Điểm đi -->
                        <div class="col-md-3 col-sm-6">
                            <label class="form-label fw-bold small text-secondary text-uppercase mb-1">
                                <i class="bi bi-geo-alt-fill text-danger me-1"></i> Điểm xuất phát
                            </label>
                            <select class="form-select form-select-lg rounded-3 fw-semibold border-secondary-subtle" @bind="originCity">
                                <option value="">-- Chọn điểm đi --</option>
                                @foreach (var c in popularOrigins)
                                {
                                    <option value="@c">@c</option>
                                }
                            </select>
                        </div>

                        <!-- Nút Hoán đổi -->
                        <div class="col-auto d-none d-md-flex align-items-end justify-content-center pt-3">
                            <button type="button" class="btn btn-light rounded-circle border shadow-sm p-2" title="Đổi chiều" @onclick="SwapLocations">
                                <i class="bi bi-arrow-left-right text-primary"></i>
                            </button>
                        </div>

                        <!-- Điểm đến -->
                        <div class="col-md-3 col-sm-6">
                            <label class="form-label fw-bold small text-secondary text-uppercase mb-1">
                                <i class="bi bi-geo-alt-fill text-success me-1"></i> Điểm đến
                            </label>
                            <select class="form-select form-select-lg rounded-3 fw-semibold border-secondary-subtle" @bind="destinationCity">
                                <option value="">-- Chọn điểm đến --</option>
                                @foreach (var c in popularDestinations)
                                {
                                    <option value="@c">@c</option>
                                }
                            </select>
                        </div>

                        <!-- Ngày đi -->
                        <div class="col-md-3 col-sm-6">
                            <label class="form-label fw-bold small text-secondary text-uppercase mb-1">
                                <i class="bi bi-calendar-event-fill text-primary me-1"></i> Ngày khởi hành
                            </label>
                            <input type="date" class="form-control form-control-lg rounded-3 fw-semibold border-secondary-subtle" 
                                   @bind="departureDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>

                        <!-- Nút Tìm kiếm -->
                        <div class="col-md-2 col-sm-6 d-flex align-items-end">
                            <button type="button" class="btn btn-warning btn-lg w-100 py-3 fw-bold text-dark rounded-3 shadow-sm btn-search-hero" @onclick="HandleSearch">
                                <i class="bi bi-search me-1"></i> TÌM VÉ
                            </button>
                        </div>
                    </div>

                    <!-- Gợi ý nhanh các chặng hot -->
                    <div class="d-flex flex-wrap align-items-center gap-2 mt-3 pt-3 border-top small text-muted">
                        <span class="fw-semibold text-secondary"><i class="bi bi-fire text-danger"></i> Gợi ý nhanh:</span>
                        <button class="btn btn-sm btn-light border rounded-pill px-3 py-1" @onclick='() => SelectQuickRoute("TP. Hồ Chí Minh", "Đà Lạt")'>Sài Gòn ➔ Đà Lạt</button>
                        <button class="btn btn-sm btn-light border rounded-pill px-3 py-1" @onclick='() => SelectQuickRoute("Hà Nội", "Sapa")'>Hà Nội ➔ Sapa</button>
                        <button class="btn btn-sm btn-light border rounded-pill px-3 py-1" @onclick='() => SelectQuickRoute("TP. Hồ Chí Minh", "Nha Trang")'>Sài Gòn ➔ Nha Trang</button>
                        <button class="btn btn-sm btn-light border rounded-pill px-3 py-1" @onclick='() => SelectQuickRoute("Đà Nẵng", "Huế")'>Đà Nẵng ➔ Huế</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Tuyến Đường Phổ Biến -->
<section class="py-5 bg-white">
    <div class="container py-3">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <h3 class="fw-bold mb-1 text-dark">Tuyến Đường Phổ Biến</h3>
                <p class="text-secondary mb-0">Các tuyến xe được đặt nhiều nhất với mức giá ưu đãi</p>
            </div>
            <a href="/tim-chuyen" class="btn btn-outline-primary rounded-pill px-3 fw-semibold">
                Xem tất cả chuyến <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="row g-4">
            <!-- Chặng 1 -->
            <div class="col-lg-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden route-card" @onclick='() => SelectQuickRoute("TP. Hồ Chí Minh", "Đà Lạt")' style="cursor: pointer;">
                    <div class="bg-primary text-white p-4 text-center route-header" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
                        <i class="bi bi-tree-fill display-5 mb-2 text-warning"></i>
                        <h5 class="fw-bold mb-0">Sài Gòn ➔ Đà Lạt</h5>
                        <small class="opacity-75">305 km • Khoảng 6 - 8 giờ</small>
                    </div>
                    <div class="card-body p-3 d-flex justify-content-between align-items-center bg-white">
                        <div>
                            <small class="text-muted d-block">Giá vé chỉ từ</small>
                            <span class="fs-5 fw-bold text-danger">280.000 đ</span>
                        </div>
                        <span class="btn btn-sm btn-warning text-dark fw-bold rounded-pill px-3">Đặt vé</span>
                    </div>
                </div>
            </div>

            <!-- Chặng 2 -->
            <div class="col-lg-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden route-card" @onclick='() => SelectQuickRoute("Hà Nội", "Sapa")' style="cursor: pointer;">
                    <div class="bg-primary text-white p-4 text-center route-header" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);">
                        <i class="bi bi-cloud-snow-fill display-5 mb-2 text-white"></i>
                        <h5 class="fw-bold mb-0">Hà Nội ➔ Sapa</h5>
                        <small class="opacity-75">315 km • Khoảng 5 - 6 giờ</small>
                    </div>
                    <div class="card-body p-3 d-flex justify-content-between align-items-center bg-white">
                        <div>
                            <small class="text-muted d-block">Giá vé chỉ từ</small>
                            <span class="fs-5 fw-bold text-danger">290.000 đ</span>
                        </div>
                        <span class="btn btn-sm btn-warning text-dark fw-bold rounded-pill px-3">Đặt vé</span>
                    </div>
                </div>
            </div>

            <!-- Chặng 3 -->
            <div class="col-lg-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden route-card" @onclick='() => SelectQuickRoute("TP. Hồ Chí Minh", "Nha Trang")' style="cursor: pointer;">
                    <div class="bg-primary text-white p-4 text-center route-header" style="background: linear-gradient(135deg, #00c6ff 0%, #0072ff 100%);">
                        <i class="bi bi-water display-5 mb-2 text-warning"></i>
                        <h5 class="fw-bold mb-0">Sài Gòn ➔ Nha Trang</h5>
                        <small class="opacity-75">435 km • Khoảng 8 - 9 giờ</small>
                    </div>
                    <div class="card-body p-3 d-flex justify-content-between align-items-center bg-white">
                        <div>
                            <small class="text-muted d-block">Giá vé chỉ từ</small>
                            <span class="fs-5 fw-bold text-danger">450.000 đ</span>
                        </div>
                        <span class="btn btn-sm btn-warning text-dark fw-bold rounded-pill px-3">Đặt vé</span>
                    </div>
                </div>
            </div>

            <!-- Chặng 4 -->
            <div class="col-lg-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden route-card" @onclick='() => SelectQuickRoute("Đà Nẵng", "Huế")' style="cursor: pointer;">
                    <div class="bg-primary text-white p-4 text-center route-header" style="background: linear-gradient(135deg, #f857a6 0%, #ff5858 100%);">
                        <i class="bi bi-buildings-fill display-5 mb-2 text-white"></i>
                        <h5 class="fw-bold mb-0">Đà Nẵng ➔ Huế</h5>
                        <small class="opacity-75">100 km • Khoảng 2 giờ</small>
                    </div>
                    <div class="card-body p-3 d-flex justify-content-between align-items-center bg-white">
                        <div>
                            <small class="text-muted d-block">Giá vé chỉ từ</small>
                            <span class="fs-5 fw-bold text-danger">160.000 đ</span>
                        </div>
                        <span class="btn btn-sm btn-warning text-dark fw-bold rounded-pill px-3">Đặt vé</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Lý Do Chọn TripGo -->
<section class="py-5 bg-light">
    <div class="container py-3 text-center">
        <h3 class="fw-bold mb-1 text-dark">Tại Sao Nên Đặt Vé Tại TripGo?</h3>
        <p class="text-secondary mb-5">Mang đến trải nghiệm đặt vé văn minh, minh bạch và an tâm tuyệt đối</p>

        <div class="row g-4">
            <div class="col-md-3">
                <div class="p-4 bg-white rounded-4 shadow-sm h-100">
                    <div class="bg-primary-subtle text-primary p-3 rounded-circle d-inline-flex mb-3">
                        <i class="bi bi-shield-check display-6"></i>
                    </div>
                    <h5 class="fw-bold">Chắc Chắn Có Chỗ</h5>
                    <p class="text-secondary small mb-0">Hoàn tiền 100% và hỗ trợ xe khác ngay lập tức nếu nhà xe không giữ chỗ đúng cam kết.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-4 bg-white rounded-4 shadow-sm h-100">
                    <div class="bg-success-subtle text-success p-3 rounded-circle d-inline-flex mb-3">
                        <i class="bi bi-ticket-perforated display-6"></i>
                    </div>
                    <h5 class="fw-bold">Chọn Chỗ Trực Quan</h5>
                    <p class="text-secondary small mb-0">Sơ đồ 2 tầng chân thực, giúp bạn chọn đúng giường nằm tầng trên/dưới hoặc ghế ngồi ưa thích.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-4 bg-white rounded-4 shadow-sm h-100">
                    <div class="bg-warning-subtle text-warning p-3 rounded-circle d-inline-flex mb-3">
                        <i class="bi bi-tag-fill display-6"></i>
                    </div>
                    <h5 class="fw-bold">Giá Vé Minh Bạch</h5>
                    <p class="text-secondary small mb-0">Cam kết giá gốc chính thức từ nhà xe, không phụ phí ẩn, tích hợp nhiều mã khuyến mãi hấp dẫn.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-4 bg-white rounded-4 shadow-sm h-100">
                    <div class="bg-info-subtle text-info p-3 rounded-circle d-inline-flex mb-3">
                        <i class="bi bi-headset display-6"></i>
                    </div>
                    <h5 class="fw-bold">Hỗ Trợ 24/7</h5>
                    <p class="text-secondary small mb-0">Đội ngũ CSKH chuyên nghiệp luôn sẵn sàng đồng hành cùng bạn trên mọi nẻo đường qua hotline 1900 6868.</p>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private string originCity = "TP. Hồ Chí Minh";
    private string destinationCity = "Đà Lạt";
    private DateTime departureDate = DateTime.Today;

    private List<string> popularOrigins = new();
    private List<string> popularDestinations = new();

    protected override async Task OnInitializedAsync()
    {
        popularOrigins = await BookingService.GetPopularOriginsAsync();
        popularDestinations = await BookingService.GetPopularDestinationsAsync();
    }

    private void SwapLocations()
    {
        var temp = originCity;
        originCity = destinationCity;
        destinationCity = temp;
    }

    private void SelectQuickRoute(string from, string to)
    {
        originCity = from;
        destinationCity = to;
        HandleSearch();
    }

    private void HandleSearch()
    {
        var dateStr = departureDate.ToString("yyyy-MM-dd");
        Nav.NavigateTo($"/tim-chuyen?origin={Uri.EscapeDataString(originCity)}&dest={Uri.EscapeDataString(destinationCity)}&date={dateStr}");
    }
}

<style>
    .hero-section {
        background: linear-gradient(135deg, #0d6efd 0%, #003b95 100%);
        padding-top: 60px;
        padding-bottom: 70px;
    }
    .btn-search-hero {
        background-color: #ffc107;
        transition: all 0.2s;
    }
    .btn-search-hero:hover {
        background-color: #ffb300;
        transform: translateY(-2px);
    }
    .route-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .route-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 25px rgba(0, 0, 0, 0.15) !important;
    }
</style>
