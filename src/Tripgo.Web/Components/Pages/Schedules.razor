@page "/schedules"
@using Tripgo.Application.Interfaces
@inject ITripService TripService
@rendermode InteractiveServer

<PageTitle>Lịch trình tham khảo | TripGo</PageTitle>

<section class="schedule-page">
    <div class="schedule-wrap">
        <div class="mb-3">
            <BackButton Label="Quay lại trang chủ" FallbackUrl="/" />
        </div>
        <header class="schedule-heading">
            <div>
                <span class="eyebrow">LỊCH TRÌNH THAM KHẢO · SANDBOX</span>
                <h1>Lịch trình chuyến xe</h1>
                <p>Dữ liệu lịch trình và giá trong môi trường thử nghiệm chưa được xác nhận bởi nhà xe, không phải dịch vụ đặt vé thương mại.</p>
            </div>
            <label class="schedule-date">
                <span>Chọn ngày khởi hành</span>
                <InputDate @bind-Value="selectedDate" class="form-control rounded-3" />
            </label>
        </header>

        <div class="schedule-toolbar">
            <span>
                <i class="bi bi-calendar3 text-primary"></i>
                @selectedDate.ToDateTime(TimeOnly.MinValue).ToString("dddd, dd/MM/yyyy", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))
            </span>
            <div class="tg-auth-input-group" style="width: min(380px, 100%);">
                <span class="tg-auth-input-icon"><i class="bi bi-search"></i></span>
                <input class="tg-auth-input py-2" placeholder="Lọc tuyến, nhà xe, loại xe..." @bind="filterText" @bind:event="oninput" />
            </div>
        </div>

        @if (isLoading)
        {
            <div class="schedule-empty">
                <span class="spinner-border text-primary"></span>
                <span>Đang tải danh sách lịch chạy...</span>
            </div>
        }
        else if (!VisibleTrips.Any())
        {
            <div class="schedule-empty">
                <i class="bi bi-calendar-x text-muted fs-1 mb-2"></i>
                <strong class="fs-5 text-dark">Chưa có chuyến xe phù hợp ngày này</strong>
                <span class="text-muted small">Hãy chọn một ngày khởi hành khác hoặc điều chỉnh từ khóa tìm kiếm.</span>
            </div>
        }
        else
        {
            <div class="table-responsive schedule-table-wrap">
                <table class="schedule-table">
                    <thead>
                        <tr>
                            <th>Mã chuyến</th>
                            <th>Tuyến xe</th>
                            <th>Nhà xe</th>
                            <th>Giờ xuất bến</th>
                            <th>Thời gian chạy</th>
                            <th>Loại xe</th>
                            <th>Giá tham khảo</th>
                            <th>Chỗ trống</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var trip in VisibleTrips)
                        {
                            <tr>
                                <td><span class="badge bg-light text-primary border font-monospace px-2 py-1">@trip.TripCode</span></td>
                                <td><strong class="text-dark">@trip.RouteName</strong></td>
                                <td>
                                    <div class="fw-bold text-dark">@trip.OperatorName</div>
                                    <span class="operator-vehicle font-monospace">@trip.BusLicensePlate</span>
                                </td>
                                <td>
                                    <strong class="fs-6 text-primary">@trip.DepartureTime.ToLocalTime().ToString("HH:mm")</strong>
                                    <span class="operator-vehicle">@trip.DepartureTime.ToLocalTime().ToString("dd/MM/yyyy")</span>
                                </td>
                                <td><span class="badge bg-light text-secondary border">@DurationLabel(trip)</span></td>
                                <td><span class="small text-dark">@trip.BusTypeName</span></td>
                                <td><strong class="schedule-price">@trip.BasePrice.ToString("N0") đ</strong></td>
                                <td>
                                    <span class="badge bg-success bg-opacity-10 text-success fw-bold px-2 py-1">
                                        @trip.AvailableSeats / @trip.TotalSeats chỗ
                                    </span>
                                </td>
                                <td>
                                    <a class="tg-auth-btn-accent text-decoration-none py-1 px-3 d-inline-block small" href="@GetSearchUrl(trip)">
                                        Đặt vé
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

<style>
    .schedule-page { min-height: 100vh; padding: 42px 20px 70px; background: var(--tg-bg); color: var(--tg-text); }
    .schedule-wrap { max-width: 1260px; margin: auto; }
    .schedule-heading { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; margin-bottom: 24px; }
    .eyebrow { color: var(--tg-primary); font-size: 11px; font-weight: 800; letter-spacing: .08em; }
    .schedule-heading h1 { margin: 8px 0 5px; font-size: 30px; font-weight: 800; color: var(--tg-text); }
    .schedule-heading p { margin: 0; color: var(--tg-text-muted); font-size: 14.5px; }
    .schedule-date { display: grid; gap: 5px; color: var(--tg-text-secondary); font-size: 12px; font-weight: 700; }
    .schedule-toolbar { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 14px 20px; border: 1px solid var(--tg-border); border-bottom: 0; border-radius: var(--tg-radius-lg) var(--tg-radius-lg) 0 0; background: var(--tg-surface); color: var(--tg-text); font-size: 13.5px; }
    .schedule-toolbar > span { display: flex; gap: 8px; align-items: center; font-weight: 700; }
    .schedule-table-wrap { border: 1px solid var(--tg-border); border-radius: 0 0 var(--tg-radius-lg) var(--tg-radius-lg); background: var(--tg-surface); box-shadow: var(--tg-shadow-sm); }
    .schedule-table { width: 100%; border-collapse: collapse; min-width: 1050px; }
    .schedule-table th { padding: 14px 16px; background: #f8fafc; color: var(--tg-text-secondary); text-align: left; font-size: 11px; letter-spacing: .04em; font-weight: 700; white-space: nowrap; border-bottom: 1px solid var(--tg-border); }
    .schedule-table td { padding: 15px 16px; border-top: 1px solid var(--tg-border-light); vertical-align: middle; font-size: 13px; }
    .schedule-table tbody tr:hover { background: #f8fafc; }
    .operator-vehicle { display: block; margin-top: 3px; color: var(--tg-text-muted); font-size: 11.5px; }
    .schedule-price { color: var(--tg-danger); font-size: 15px; font-weight: 800; white-space: nowrap; }
    .schedule-empty { display: grid; justify-items: center; gap: 10px; padding: 60px 20px; border: 1px solid var(--tg-border); border-radius: var(--tg-radius-lg); background: var(--tg-surface); box-shadow: var(--tg-shadow-sm); }
    @@media (max-width: 768px) { .schedule-page { padding: 28px 14px; } .schedule-heading { align-items: flex-start; flex-direction: column; } .schedule-heading h1 { font-size: 25px; } .schedule-toolbar { align-items: stretch; flex-direction: column; } }
</style>

@code {
    private List<TripSearchResultDto> allTrips = new();
    private DateOnly selectedDate = DateOnly.FromDateTime(DateTime.Today);
    private string filterText = string.Empty;
    private bool isLoading;

    private IEnumerable<TripSearchResultDto> VisibleTrips
    {
        get
        {
            var trips = allTrips.Where(trip => trip.Status == "Scheduled" && trip.DepartureTime >= DateTimeOffset.Now && trip.DepartureTime.ToLocalTime().Date == selectedDate.ToDateTime(TimeOnly.MinValue).Date);
            if (!string.IsNullOrWhiteSpace(filterText))
            {
                var filter = filterText.Trim();
                trips = trips.Where(trip => trip.RouteName.Contains(filter, StringComparison.OrdinalIgnoreCase) ||
                    trip.OperatorName.Contains(filter, StringComparison.OrdinalIgnoreCase) ||
                    trip.BusTypeName.Contains(filter, StringComparison.OrdinalIgnoreCase));
            }
            return trips.OrderBy(trip => trip.DepartureTime);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try { allTrips = await TripService.GetAllTripsAdminAsync(); }
        finally { isLoading = false; }
    }

    private static string DurationLabel(TripSearchResultDto trip)
    {
        var duration = trip.ArrivalTime - trip.DepartureTime;
        return $"{(int)duration.TotalHours}h {duration.Minutes:D2}m";
    }

    private static string GetSearchUrl(TripSearchResultDto trip)
    {
        var parts = trip.RouteName.Split(new[] { '-', '→', '–' }, StringSplitOptions.TrimEntries);
        if (parts.Length >= 2)
        {
            var origin = Uri.EscapeDataString(parts[0]);
            var dest = Uri.EscapeDataString(parts[1]);
            var date = trip.DepartureTime.ToLocalTime().ToString("yyyy-MM-dd");
            return $"/search-trips?origin={origin}&dest={dest}&date={date}";
        }
        return "/search-trips";
    }
}
