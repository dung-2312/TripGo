@page "/login"
@using Tripgo.Application.DTOs
@using Tripgo.Application.Interfaces
@using Tripgo.Web.Services
@using System.Security.Claims
@inject IAuthService AuthService
@inject ISignInExchangeStore SignInExchangeStore
@inject IBookingSessionContext BookingSessionContext
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>Đăng nhập | TripGo</PageTitle>

<div class="tg-auth-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-xl-10">
                <div class="tg-auth-card">
                    <div class="row g-0">
                        <!-- Left Hero / Brand Visual -->
                        <div class="col-lg-5 tg-auth-hero d-none d-lg-flex flex-column justify-content-between p-5 text-white">
                            <div>
                                <div class="mb-4">
                                    <a href="/" class="d-inline-flex align-items-center gap-2 text-decoration-none text-white">
                                        <div class="tg-hero-logo-box">
                                            <svg viewBox="0 0 36 36" fill="none" style="width: 28px; height: 28px;" xmlns="http://www.w3.org/2000/svg">
                                                <rect width="36" height="36" rx="9" fill="#FFCA28" />
                                                <path d="M9 11C9 8.79086 10.7909 7 13 7H23C25.2091 7 27 8.79086 27 11V22C27 24.2091 25.2091 26 23 26H13C10.7909 26 9 24.2091 9 22V11Z" fill="#071F49" />
                                                <rect x="11" y="9.5" width="14" height="6.5" rx="2" fill="white" />
                                                <circle cx="13.5" cy="21.5" r="2" fill="#FFCA28" />
                                                <circle cx="22.5" cy="21.5" r="2" fill="#FFCA28" />
                                            </svg>
                                        </div>
                                        <span class="fs-4 fw-bold tracking-tight">Trip<span class="text-warning">Go</span></span>
                                    </a>
                                </div>

                                <div class="mb-3">
                                    <span class="d-inline-flex align-items-center gap-1 rounded-pill px-3 py-1 small fw-semibold" style="background: rgba(255, 255, 255, 0.12); color: #ffffff; border: 1px solid rgba(255, 255, 255, 0.2);">
                                        <i class="bi bi-shield-check me-1 text-warning"></i> Cổng đăng nhập an toàn
                                    </span>
                                </div>

                                <h2 class="fw-bold mb-3" style="font-size: 1.85rem; line-height: 1.3;">Chào mừng bạn trở lại!</h2>
                                <p class="text-white-50 mb-4 small" style="line-height: 1.6;">
                                    Đăng nhập để xem và quản lý các đơn đặt chỗ được gắn với tài khoản của bạn.
                                </p>

                                <div class="d-flex flex-column gap-3 mt-4">
                                    <div class="tg-auth-feature-pill">
                                        <div class="tg-auth-feature-icon">
                                            <i class="bi bi-ticket-perforated-fill"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold small text-white">Quản lý đơn đặt chỗ</div>
                                            <div class="text-white-50" style="font-size: 0.78rem;">Xem thông tin đặt chỗ gắn với tài khoản</div>
                                        </div>
                                    </div>

                                    <div class="tg-auth-feature-pill">
                                        <div class="tg-auth-feature-icon">
                                            <i class="bi bi-lightning-charge-fill"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold small text-white">Giữ chỗ trong môi trường thử nghiệm</div>
                                            <div class="text-white-50" style="font-size: 0.78rem;">Thời hạn giữ chỗ được hiển thị trong quy trình đặt chỗ</div>
                                        </div>
                                    </div>

                                    <div class="tg-auth-feature-pill">
                                        <div class="tg-auth-feature-icon">
                                            <i class="bi bi-shield-lock-fill"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold small text-white">Bảo vệ tài khoản</div>
                                            <div class="text-white-50" style="font-size: 0.78rem;">Không chia sẻ mật khẩu hoặc mã xác thực của bạn</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="pt-4 border-top border-white border-opacity-10 small text-white-50">
                                Các giao dịch đặt chỗ và thanh toán hiện là mô phỏng sandbox.
                            </div>
                        </div>

                        <!-- Right Form Panel -->
                        <div class="col-lg-7 p-4 p-md-5 d-flex flex-column justify-content-center">
                            <div class="mb-4">
                                <div class="d-lg-none d-flex align-items-center gap-2 mb-3">
                                    <a href="/" class="d-inline-flex align-items-center gap-2 text-decoration-none">
                                        <div class="tg-hero-logo-box bg-primary bg-opacity-10">
                                            <svg viewBox="0 0 36 36" fill="none" style="width: 28px; height: 28px;" xmlns="http://www.w3.org/2000/svg">
                                                <rect width="36" height="36" rx="9" fill="#FFCA28" />
                                                <path d="M9 11C9 8.79086 10.7909 7 13 7H23C25.2091 7 27 8.79086 27 11V22C27 24.2091 25.2091 26 23 26H13C10.7909 26 9 24.2091 9 22V11Z" fill="#071F49" />
                                                <rect x="11" y="9.5" width="14" height="6.5" rx="2" fill="white" />
                                                <circle cx="13.5" cy="21.5" r="2" fill="#FFCA28" />
                                                <circle cx="22.5" cy="21.5" r="2" fill="#FFCA28" />
                                            </svg>
                                        </div>
                                        <span class="fs-4 fw-bold text-dark">Trip<span class="text-warning">Go</span></span>
                                    </a>
                                </div>
                                <h3 class="fw-bold text-dark mb-1">Đăng nhập tài khoản</h3>
                                <p class="text-muted small">Nhập Email hoặc Số điện thoại để truy cập hành trình của bạn</p>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(notificationMessage))
                            {
                                <div class="alert @notificationAlertClass alert-dismissible fade show mb-4 rounded-3 border-0 shadow-sm" role="status" aria-live="polite">
                                    <i class="bi @notificationIcon me-2"></i>@notificationMessage
                                    <button type="button" class="btn-close" @onclick="() => notificationMessage = null" aria-label="Đóng thông báo"></button>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(errorMessage))
                            {
                                <div class="alert alert-danger alert-dismissible fade show mb-4 rounded-3 border-0 shadow-sm" role="alert" aria-live="assertive">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
                                    <button type="button" class="btn-close" @onclick="() => errorMessage = null" aria-label="Đóng thông báo lỗi"></button>
                                </div>
                            }

                            <EditForm Model="@model" OnValidSubmit="HandleLoginAsync">
                                <DataAnnotationsValidator />

                                <!-- Email or Phone -->
                                <div class="mb-3">
                                    <label class="form-label fw-bold small text-dark mb-1" for="loginIdentifier">Email hoặc Số điện thoại</label>
                                    <div class="tg-auth-input-group">
                                        <span class="tg-auth-input-icon">
                                            <i class="bi bi-person"></i>
                                        </span>
                                        <InputText id="loginIdentifier" class="tg-auth-input"
                                                   placeholder="Nhập email hoặc số điện thoại..."
                                                   autocomplete="username"
                                                   @bind-Value="model.AccountIdentifier" disabled="@isSubmitting" />
                                    </div>
                                    <ValidationMessage For="@(() => model.AccountIdentifier)" class="text-danger small mt-1" />
                                </div>

                                <!-- Password -->
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <label class="form-label fw-bold small text-dark mb-0" for="loginPassword">Mật khẩu</label>
                                        <a href="/forgot-password" class="text-decoration-none small text-primary fw-bold">Quên mật khẩu?</a>
                                    </div>
                                    <div class="tg-auth-input-group">
                                        <span class="tg-auth-input-icon">
                                            <i class="bi bi-shield-lock"></i>
                                        </span>
                                        <input id="loginPassword" type="@(showPassword ? "text" : "password")"
                                               class="tg-auth-input"
                                               placeholder="Nhập mật khẩu..."
                                               autocomplete="current-password"
                                               @bind="model.Password"
                                               disabled="@isSubmitting" />
                                        <button type="button" class="tg-auth-toggle-pwd"
                                                @onclick="() => showPassword = !showPassword"
                                                aria-label="@(showPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")"
                                                title="@(showPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")">
                                            <i class="bi @(showPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                        </button>
                                    </div>
                                    <ValidationMessage For="@(() => model.Password)" class="text-danger small mt-1" />
                                </div>

                                <!-- Remember Me -->
                                <div class="mb-4 form-check">
                                    <InputCheckbox id="rememberMe" class="form-check-input" @bind-Value="model.RememberMe" disabled="@isSubmitting" />
                                    <label class="form-check-label small text-secondary" for="rememberMe">
                                        Ghi nhớ đăng nhập trên thiết bị này
                                    </label>
                                </div>

                                <!-- Submit Button -->
                                <button type="submit" class="tg-auth-btn-primary w-100 d-flex align-items-center justify-content-center gap-2"
                                        disabled="@isSubmitting">
                                    @if (isSubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                        <span>Đang xác thực thông tin...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-box-arrow-in-right"></i>
                                        <span>Đăng nhập</span>
                                    }
                                </button>
                            </EditForm>

                            <!-- Register CTA -->
                            <div class="text-center mt-4 pt-3 border-top">
                                <span class="text-muted small">Chưa có tài khoản TripGo?</span>
                                <a href="@RegisterUrl" class="text-primary fw-bold text-decoration-none ms-1 small">
                                    Đăng ký thành viên ngay <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    public string? error { get; set; }

    [SupplyParameterFromQuery]
    public string? loggedOut { get; set; }

    [SupplyParameterFromQuery]
    public string? registered { get; set; }

    private LoginViewModel model = new();
    private bool isSubmitting = false;
    private bool showPassword = false;
    private string? errorMessage;
    private string? notificationMessage;
    private string notificationAlertClass = "alert-info";
    private string notificationIcon = "bi-info-circle-fill";

    private string RegisterUrl => string.IsNullOrWhiteSpace(ReturnUrl) ? "/register" : $"/register?ReturnUrl={Uri.EscapeDataString(ReturnUrl)}";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true &&
            authState.User.FindFirst(ClaimTypes.NameIdentifier) != null)
        {
            var target = IsSafeLocalReturnUrl(ReturnUrl) ? ReturnUrl! : "/";
            NavigationManager.NavigateTo(target);
            return;
        }

        if (loggedOut == "1")
        {
            notificationMessage = "Bạn đã đăng xuất thành công khỏi hệ thống TripGo.";
            notificationAlertClass = "alert-success";
            notificationIcon = "bi-check-circle-fill";
        }
        else if (registered == "1")
        {
            notificationMessage = "Đăng ký tài khoản thành công! Vui lòng đăng nhập để tiếp tục.";
            notificationAlertClass = "alert-success";
            notificationIcon = "bi-check-circle-fill";
        }
        else if (error == "invalid_token")
        {
            errorMessage = "Phiên xác thực đã hết hạn hoặc không hợp lệ. Vui lòng đăng nhập lại.";
        }
    }

    private static bool IsSafeLocalReturnUrl(string? returnUrl) =>
        !string.IsNullOrWhiteSpace(returnUrl) &&
        returnUrl.StartsWith("/", StringComparison.Ordinal) &&
        !returnUrl.StartsWith("//", StringComparison.Ordinal) &&
        !returnUrl.StartsWith("/\\", StringComparison.Ordinal);

    private async Task HandleLoginAsync()
    {
        errorMessage = null;
        notificationMessage = null;
        isSubmitting = true;

        try
        {
            model.ReturnUrl = ReturnUrl;
            var result = await AuthService.AuthenticateAsync(model);

            if (!result.Success || !result.UserId.HasValue)
            {
                errorMessage = result.Message;
                return;
            }

            var guestOwner = await BookingSessionContext.GetOwnerIdentifierAsync();

            var token = SignInExchangeStore.Store(new SignInExchangeModel
            {
                UserId = result.UserId.Value,
                FullName = result.FullName ?? "Khách hàng",
                Email = result.Email ?? string.Empty,
                PhoneNumber = result.PhoneNumber ?? string.Empty,
                Role = result.Role ?? "Customer",
                RememberMe = model.RememberMe,
                ReturnUrl = ReturnUrl,
                GuestOwnerIdentifier = guestOwner
            });

            // Force browser full page load to exchange token and issue secure HTTP cookie
            NavigationManager.NavigateTo($"/auth/exchange?token={token}", forceLoad: true);
        }
        catch (Exception)
        {
            errorMessage = "Đã xảy ra lỗi hệ thống trong quá trình đăng nhập. Vui lòng thử lại sau.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
