@page "/thanh-toan/{TripId:long}"
@layout Tripgo.Web.Components.Layout.CustomerLayout
@inject ICustomerBookingService BookingService
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Xác Nhận & Thanh Toán Vé - TripGo</PageTitle>

@if (trip == null)
{
    <div class="container py-5 text-center">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-muted">Đang tải thông tin đặt vé...</p>
    </div>
}
else
{
    <!-- Booking Stepper -->
    <div class="bg-white border-bottom py-3">
        <div class="container">
            <div class="d-flex justify-content-center align-items-center gap-2 gap-md-4 small fw-semibold text-secondary">
                <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i> 1. Chọn chuyến</span>
                <i class="bi bi-chevron-right text-muted"></i>
                <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i> 2. Chọn chỗ ngồi</span>
                <i class="bi bi-chevron-right text-muted"></i>
                <span class="text-primary fw-bold"><i class="bi bi-3-circle-fill me-1"></i> 3. Thanh toán & Xác nhận</span>
                <i class="bi bi-chevron-right text-muted"></i>
                <span class="text-muted"><i class="bi bi-4-circle me-1"></i> 4. Hoàn tất</span>
            </div>
        </div>
    </div>

    <!-- Countdown Timer Bar -->
    <div class="bg-warning-subtle border-bottom border-warning py-2 text-center small text-dark fw-semibold">
        <i class="bi bi-hourglass-split text-danger me-1"></i> 
        Thời gian giữ chỗ còn lại: 
        <strong class="text-danger fs-6">@countdownMinutes.ToString("D2"):@countdownSeconds.ToString("D2")</strong>. Vui lòng hoàn tất thanh toán trước khi hết hạn!
    </div>

    <div class="container py-4">
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
                <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
            </div>
        }

        <div class="row g-4">
            <!-- Cột trái: Form Thông Tin Khách Hàng & Thanh Toán -->
            <div class="col-lg-8">
                <EditForm Model="bookingRequest" OnValidSubmit="HandleBookingSubmit">
                    <DataAnnotationsValidator />

                    <!-- Card 1: Thông tin người liên hệ / hành khách -->
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                        <h5 class="fw-bold text-dark border-bottom pb-3 mb-3">
                            <i class="bi bi-person-lines-fill text-primary me-2"></i>THÔNG TIN HÀNH KHÁCH
                        </h5>
                        <p class="text-muted small mb-3">
                            Mã vé và thông tin chuyến xe sẽ được gửi qua SMS và Email này. Vui lòng kiểm tra kỹ!
                        </p>

                        <div class="row g-3">
                            <div class="col-md-12">
                                <label class="form-label fw-bold small text-secondary">
                                    Họ và tên hành khách <span class="text-danger">*</span>
                                </label>
                                <InputText class="form-control form-control-lg rounded-3" 
                                           placeholder="Ví dụ: Nguyễn Văn An" 
                                           @bind-Value="bookingRequest.FullName" />
                                <ValidationMessage For="() => bookingRequest.FullName" class="text-danger small mt-1" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-secondary">
                                    Số điện thoại nhận vé <span class="text-danger">*</span>
                                </label>
                                <InputText class="form-control form-control-lg rounded-3" 
                                           placeholder="Ví dụ: 0987654321" 
                                           @bind-Value="bookingRequest.PhoneNumber" />
                                <ValidationMessage For="() => bookingRequest.PhoneNumber" class="text-danger small mt-1" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-secondary">
                                    Email nhận vé điện tử <span class="text-danger">*</span>
                                </label>
                                <InputText class="form-control form-control-lg rounded-3" 
                                           placeholder="Ví dụ: hotro@gmail.com" 
                                           @bind-Value="bookingRequest.Email" />
                                <ValidationMessage For="() => bookingRequest.Email" class="text-danger small mt-1" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-secondary">
                                    Điểm đón khách <span class="text-danger">*</span>
                                </label>
                                <InputSelect class="form-select form-select-lg rounded-3" @bind-Value="bookingRequest.PickupPoint">
                                    <option value="">-- Chọn điểm đón --</option>
                                    <option value="@trip.PickupPoint">@trip.PickupPoint (Điểm chính)</option>
                                    <option value="Trạm trung chuyển bến xe">Trạm trung chuyển bến xe</option>
                                    <option value="Đón dọc đường thuận tuyến">Đón dọc đường thuận tuyến (Nhà xe liên hệ)</option>
                                </InputSelect>
                                <ValidationMessage For="() => bookingRequest.PickupPoint" class="text-danger small mt-1" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-secondary">
                                    Điểm trả khách <span class="text-danger">*</span>
                                </label>
                                <InputSelect class="form-select form-select-lg rounded-3" @bind-Value="bookingRequest.DropoffPoint">
                                    <option value="">-- Chọn điểm trả --</option>
                                    <option value="@trip.DropoffPoint">@trip.DropoffPoint (Điểm chính)</option>
                                    <option value="Bến xe trung tâm thành phố">Bến xe trung tâm thành phố</option>
                                    <option value="Trung chuyển về tận khách sạn/nội thành">Trung chuyển về tận nơi (Nếu có)</option>
                                </InputSelect>
                                <ValidationMessage For="() => bookingRequest.DropoffPoint" class="text-danger small mt-1" />
                            </div>

                            <div class="col-md-12">
                                <label class="form-label fw-bold small text-secondary">Ghi chú cho nhà xe (Tùy chọn)</label>
                                <InputTextArea class="form-control rounded-3" rows="2" 
                                               placeholder="Ví dụ: Có người lớn tuổi, hỗ trợ ghế dưới..." 
                                               @bind-Value="bookingRequest.Note" />
                            </div>
                        </div>
                    </div>

                    <!-- Card 2: Phương thức thanh toán -->
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                        <h5 class="fw-bold text-dark border-bottom pb-3 mb-3">
                            <i class="bi bi-wallet2 text-primary me-2"></i>PHƯƠNG THỨC THANH TOÁN
                        </h5>

                        <div class="d-flex flex-column gap-3">
                            <label class="payment-option border rounded-4 p-3 d-flex align-items-center justify-content-between cursor-pointer @(bookingRequest.PaymentMethod == "VNPayQR" ? "border-primary bg-primary-subtle" : "")">
                                <div class="d-flex align-items-center gap-3">
                                    <input type="radio" name="paymentMethod" value="VNPayQR" 
                                           checked="@(bookingRequest.PaymentMethod == "VNPayQR")"
                                           @onchange='() => bookingRequest.PaymentMethod = "VNPayQR"' />
                                    <div>
                                        <div class="fw-bold text-dark">Quét mã VNPAY-QR / Ứng dụng ngân hàng</div>
                                        <small class="text-muted">Hỗ trợ hơn 40+ ứng dụng ngân hàng và ví điện tử</small>
                                    </div>
                                </div>
                                <span class="badge bg-danger p-2">Khuyên dùng</span>
                            </label>

                            <label class="payment-option border rounded-4 p-3 d-flex align-items-center justify-content-between cursor-pointer @(bookingRequest.PaymentMethod == "MoMo" ? "border-primary bg-primary-subtle" : "")">
                                <div class="d-flex align-items-center gap-3">
                                    <input type="radio" name="paymentMethod" value="MoMo" 
                                           checked="@(bookingRequest.PaymentMethod == "MoMo")"
                                           @onchange='() => bookingRequest.PaymentMethod = "MoMo"' />
                                    <div>
                                        <div class="fw-bold text-dark">Ví Điện Tử MoMo</div>
                                        <small class="text-muted">Thanh toán tức thì qua ứng dụng MoMo</small>
                                    </div>
                                </div>
                                <i class="bi bi-phone text-primary fs-4"></i>
                            </label>

                            <label class="payment-option border rounded-4 p-3 d-flex align-items-center justify-content-between cursor-pointer @(bookingRequest.PaymentMethod == "VietQR" ? "border-primary bg-primary-subtle" : "")">
                                <div class="d-flex align-items-center gap-3">
                                    <input type="radio" name="paymentMethod" value="VietQR" 
                                           checked="@(bookingRequest.PaymentMethod == "VietQR")"
                                           @onchange='() => bookingRequest.PaymentMethod = "VietQR"' />
                                    <div>
                                        <div class="fw-bold text-dark">Chuyển khoản nhanh VietQR 24/7</div>
                                        <small class="text-muted">Chuyển tiền tự động nhận diện giao dịch tức thì</small>
                                    </div>
                                </div>
                                <i class="bi bi-qr-code-scan text-success fs-4"></i>
                            </label>
                        </div>
                    </div>

                    <!-- Nút Xác nhận gửi form -->
                    <button type="submit" class="btn btn-warning w-100 py-3 fw-bold fs-5 text-dark rounded-pill shadow-sm mb-3" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>ĐANG XỬ LÝ ĐẶT VÉ...</span>
                        }
                        else
                        {
                            <span><i class="bi bi-shield-lock-fill me-1"></i> XÁC NHẬN & THANH TOÁN NGAY</span>
                        }
                    </button>
                </EditForm>
            </div>

            <!-- Cột phải: Tóm tắt vé & Tiền -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white sticky-top" style="top: 85px;">
                    <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                        <i class="bi bi-receipt text-primary me-2"></i>TÓM TẮT ĐƠN VÉ
                    </h5>

                    <!-- Tuyến -->
                    <div class="mb-3">
                        <span class="badge bg-primary-subtle text-primary mb-1">Chuyến xe</span>
                        <div class="fw-bold fs-5 text-dark">@trip.OriginCity ➔ @trip.DestinationCity</div>
                        <div class="small text-muted">@trip.OperatorName • @trip.BusTypeName</div>
                    </div>

                    <!-- Thời gian -->
                    <div class="border-top pt-2 mb-3">
                        <div class="d-flex justify-content-between small text-secondary mb-1">
                            <span>Khởi hành:</span>
                            <strong class="text-dark">@trip.DepartureTime.ToString("HH:mm - dd/MM/yyyy")</strong>
                        </div>
                        <div class="d-flex justify-content-between small text-secondary">
                            <span>Dự kiến đến:</span>
                            <strong class="text-dark">@trip.ExpectedArrivalTime.ToString("HH:mm - dd/MM/yyyy")</strong>
                        </div>
                    </div>

                    <!-- Ghế đã chọn -->
                    <div class="border-top pt-2 mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small text-secondary">Ghế ngồi (@seatsList.Count vé):</span>
                            <div class="d-flex gap-1 flex-wrap">
                                @foreach (var s in seatsList)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success">@s</span>
                                }
                            </div>
                        </div>
                        <div class="d-flex justify-content-between small text-secondary">
                            <span>Đơn giá mỗi ghế:</span>
                            <span>@trip.BasePrice.ToString("N0") đ</span>
                        </div>
                    </div>

                    <!-- Tổng thanh toán -->
                    <div class="border-top border-bottom py-3 my-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-dark">TỔNG THANH TOÁN:</span>
                            <span class="fs-3 fw-bold text-danger">@totalAmount.ToString("N0") <span class="fs-6">đ</span></span>
                        </div>
                        <div class="small text-muted mt-1 text-end">(Đã bao gồm VAT và bảo hiểm hành khách)</div>
                    </div>

                    <!-- Cam kết -->
                    <div class="bg-light p-3 rounded-3 small text-secondary">
                        <div class="mb-1"><i class="bi bi-shield-check text-success me-1"></i> Bảo hiểm hành khách đầy đủ</div>
                        <div class="mb-1"><i class="bi bi-arrow-repeat text-primary me-1"></i> Chính sách hỗ trợ đổi vé linh hoạt</div>
                        <div><i class="bi bi-check-circle-fill text-success me-1"></i> Đảm bảo giữ đúng 100% chỗ đã chọn</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public long TripId { get; set; }

    [SupplyParameterFromQuery(Name = "seats")]
    public string? QuerySeats { get; set; }

    private CustomerTripDto? trip;
    private List<string> seatsList = new();
    private decimal totalAmount = 0;
    private CustomerBookingRequest bookingRequest = new();
    private string? errorMessage;
    private bool isSubmitting = false;

    // Countdown timer (10 phút)
    private int countdownMinutes = 10;
    private int countdownSeconds = 0;
    private System.Threading.Timer? timer;

    protected override async Task OnParametersSetAsync()
    {
        trip = await BookingService.GetTripDetailsAsync(TripId);
        if (trip != null)
        {
            if (!string.IsNullOrEmpty(QuerySeats))
            {
                seatsList = QuerySeats.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
            }

            if (!seatsList.Any())
            {
                Nav.NavigateTo($"/chon-ghe/{TripId}");
                return;
            }

            totalAmount = trip.BasePrice * seatsList.Count;

            bookingRequest.TripId = TripId;
            bookingRequest.SelectedSeats = seatsList;
            bookingRequest.PickupPoint = trip.PickupPoint;
            bookingRequest.DropoffPoint = trip.DropoffPoint;

            // Khởi tạo timer đếm ngược 10 phút
            timer = new System.Threading.Timer(OnTimerElapsed, null, 1000, 1000);
        }
    }

    private void OnTimerElapsed(object? state)
    {
        if (countdownSeconds == 0)
        {
            if (countdownMinutes == 0)
            {
                timer?.Dispose();
                errorMessage = "Thời gian giữ chỗ đã hết hạn. Vui lòng chọn lại ghế!";
                InvokeAsync(StateHasChanged);
                return;
            }
            countdownMinutes--;
            countdownSeconds = 59;
        }
        else
        {
            countdownSeconds--;
        }
        InvokeAsync(StateHasChanged);
    }

    private async Task HandleBookingSubmit()
    {
        isSubmitting = true;
        errorMessage = null;

        var result = await BookingService.CreateBookingAsync(bookingRequest);
        isSubmitting = false;

        if (result.Success && result.Result != null)
        {
            Nav.NavigateTo($"/ket-qua-dat-ve/{result.Result.BookingCode}");
        }
        else
        {
            errorMessage = result.Message;
        }
    }

    public void Dispose()
    {
        timer?.Dispose();
    }
}

<style>
    .payment-option {
        transition: all 0.2s ease-in-out;
    }
    .payment-option:hover {
        border-color: #0d6efd !important;
        background-color: #f8fafc;
    }
    .cursor-pointer {
        cursor: pointer;
    }
</style>
