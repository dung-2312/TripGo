@page "/ket-qua-dat-ve/{BookingCode}"
@layout Tripgo.Web.Components.Layout.CustomerLayout
@inject ICustomerBookingService BookingService
@inject NavigationManager Nav

<PageTitle>Chi Tiết Vé Xe - TripGo</PageTitle>

<div class="container py-5">
    @if (booking == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Đang tải thông tin vé...</p>
        </div>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <!-- Header trạng thái đặt vé thành công -->
                <div class="text-center mb-4">
                    <div class="bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center p-3 mb-3 shadow">
                        <i class="bi bi-check-lg display-4"></i>
                    </div>
                    <h2 class="fw-bold text-success">ĐẶT VÉ XE THÀNH CÔNG!</h2>
                    <p class="text-secondary lead">
                        Cảm ơn bạn đã lựa chọn TripGo. Thông tin vé điện tử đã được ghi nhận trong hệ thống.
                    </p>
                </div>

                <!-- Thẻ Vé Điện Tử (E-Ticket) -->
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white mb-4 ticket-card">
                    <!-- Ticket Header -->
                    <div class="bg-primary text-white p-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center">
                        <div class="d-flex align-items-center gap-3">
                            <span class="badge bg-white text-primary p-2 rounded-circle fs-5">
                                <i class="bi bi-bus-front-fill"></i>
                            </span>
                            <div>
                                <h5 class="fw-bold mb-0">VÉ XE KHÁCH ĐIỆN TỬ</h5>
                                <small class="opacity-75">TripGo E-Ticket • www.tripgo.vn</small>
                            </div>
                        </div>
                        <div class="mt-3 mt-md-0 text-md-end">
                            <div class="small opacity-75">Mã đặt chỗ:</div>
                            <div class="fs-4 fw-black text-warning">@booking.BookingCode</div>
                        </div>
                    </div>

                    <!-- Ticket Body -->
                    <div class="card-body p-4 p-md-5">
                        <div class="row g-4 align-items-center">
                            <!-- Tuyến xe & Lộ trình -->
                            <div class="col-md-8 border-end-md">
                                <div class="badge bg-primary-subtle text-primary mb-2">Chuyến xe của bạn</div>
                                <h4 class="fw-bold text-dark mb-1">
                                    @booking.Trip.OriginCity <i class="bi bi-arrow-right text-muted mx-2"></i> @booking.Trip.DestinationCity
                                </h4>
                                <div class="text-secondary fw-semibold mb-3">
                                    @booking.Trip.OperatorName • Xe @booking.Trip.BusTypeName (Biển số: @booking.Trip.LicensePlate)
                                </div>

                                <div class="row g-3 bg-light rounded-3 p-3 mb-3">
                                    <div class="col-sm-6">
                                        <div class="small text-muted mb-1"><i class="bi bi-clock-fill text-primary me-1"></i> Khởi hành:</div>
                                        <div class="fw-bold text-dark">@booking.Trip.DepartureTime.ToString("HH:mm - dd/MM/yyyy")</div>
                                        <div class="small text-secondary mt-1">Đón: <strong>@booking.PickupPoint</strong></div>
                                    </div>
                                    <div class="col-sm-6">
                                        <div class="small text-muted mb-1"><i class="bi bi-clock-history text-success me-1"></i> Dự kiến đến:</div>
                                        <div class="fw-bold text-dark">@booking.Trip.ExpectedArrivalTime.ToString("HH:mm - dd/MM/yyyy")</div>
                                        <div class="small text-secondary mt-1">Trả: <strong>@booking.DropoffPoint</strong></div>
                                    </div>
                                </div>

                                <div class="row g-2">
                                    <div class="col-sm-6">
                                        <div class="small text-muted">Hành khách:</div>
                                        <div class="fw-bold text-dark">@booking.PassengerName</div>
                                    </div>
                                    <div class="col-sm-6">
                                        <div class="small text-muted">Số điện thoại:</div>
                                        <div class="fw-bold text-dark">@booking.PassengerPhone</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Ghế ngồi & Mã QR vé -->
                            <div class="col-md-4 text-center">
                                <div class="p-3 border rounded-3 bg-light d-inline-block mb-3">
                                    <!-- QR Code giả lập hiển thị mã vé -->
                                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=130x130&data=@booking.BookingCode" 
                                         alt="QR Code Vé" class="img-fluid rounded" style="width: 130px; height: 130px;" />
                                </div>
                                <div class="small text-muted mb-1">Quét mã khi lên xe</div>
                                
                                <div class="mb-2">
                                    <span class="small text-secondary d-block">Vị trí ghế:</span>
                                    <div class="d-flex justify-content-center gap-1 flex-wrap mt-1">
                                        @foreach (var s in booking.Seats)
                                        {
                                            <span class="badge bg-success fs-6 px-3 py-2 rounded-pill">@s</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <!-- Thanh toán & Trạng thái -->
                        <div class="row align-items-center g-3">
                            <div class="col-sm-6">
                                <div class="small text-muted">Phương thức & Trạng thái:</div>
                                <div class="fw-semibold text-dark">
                                    @booking.PaymentMethod • 
                                    <span class="badge @(booking.PaymentStatus == "Đã thanh toán" ? "bg-success" : "bg-warning text-dark")">
                                        @booking.PaymentStatus
                                    </span>
                                </div>
                            </div>
                            <div class="col-sm-6 text-sm-end">
                                <div class="small text-muted">Tổng tiền vé:</div>
                                <div class="fs-3 fw-bold text-danger">@booking.TotalAmount.ToString("N0") <span class="fs-6">đ</span></div>
                            </div>
                        </div>
                    </div>

                    <!-- Ticket Footer Notice -->
                    <div class="card-footer bg-light p-3 small text-muted text-center border-top">
                        <i class="bi bi-info-circle-fill text-primary me-1"></i>
                        Vui lòng có mặt tại điểm đón trước giờ khởi hành ít nhất <strong>30 phút</strong> để làm thủ tục lên xe.
                    </div>
                </div>

                <!-- Các nút hành động -->
                <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">
                    <button class="btn btn-outline-primary px-4 py-2 rounded-pill fw-semibold" onclick="window.print()">
                        <i class="bi bi-printer me-1"></i> In vé điện tử
                    </button>
                    <a href="/tra-cuu" class="btn btn-outline-secondary px-4 py-2 rounded-pill fw-semibold">
                        <i class="bi bi-search me-1"></i> Tra cứu đơn vé
                    </a>
                    <a href="/" class="btn btn-primary px-4 py-2 rounded-pill fw-bold">
                        <i class="bi bi-house-door me-1"></i> Về trang chủ
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string BookingCode { get; set; } = string.Empty;

    private CustomerBookingResultDto? booking;

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(BookingCode))
        {
            booking = await BookingService.GetBookingResultAsync(BookingCode);
        }
    }
}

<style>
    .ticket-card {
        border: 1px solid #e2e8f0;
    }
    @@media (min-width: 768px) {
        .border-end-md {
            border-right: 1px dashed #cbd5e1;
        }
    }
    @@media print {
        header, footer, .btn, .top-utility-bar {
            display: none !important;
        }
        .ticket-card {
            border: none !important;
            box-shadow: none !important;
        }
    }
</style>
