@page "/chon-ghe"
@page "/chon-ghe/{TripId:long}"
@inject NavigationManager NavigationManager

@code {
    [Parameter]
    public long TripId { get; set; }

    protected override void OnInitialized()
    {
        if (TripId > 0)
        {
            NavigationManager.NavigateTo($"/search-trips?tripId={TripId}", replace: true);
        }
        else
        {
            NavigationManager.NavigateTo("/search-trips", replace: true);
        }
    }
}
