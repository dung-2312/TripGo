@page "/chon-ghe/{TripId:long}"
@layout Tripgo.Web.Components.Layout.CustomerLayout
@inject ICustomerBookingService BookingService
@inject NavigationManager Nav

<PageTitle>Chọn Chỗ Ngồi - TripGo</PageTitle>

@if (trip == null)
{
    <div class="container py-5 text-center">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-muted">Đang tải thông tin chuyến và sơ đồ ghế...</p>
    </div>
}
else
{
    <!-- Breadcrumb & Trip Summary -->
    <div class="bg-primary text-white py-3 shadow-sm">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-md-center">
            <div>
                <a href="/tim-chuyen" class="text-white text-decoration-none small opacity-75">
                    <i class="bi bi-chevron-left"></i> Quay lại tìm chuyến
                </a>
                <h4 class="fw-bold mb-0 mt-1">
                    @trip.OriginCity ➔ @trip.DestinationCity
                </h4>
                <div class="small opacity-90 mt-1">
                    <span class="me-3"><i class="bi bi-bus-front me-1"></i> @trip.OperatorName (@trip.BusTypeName)</span>
                    <span><i class="bi bi-clock me-1"></i> Khởi hành: <strong>@trip.DepartureTime.ToString("HH:mm - dd/MM/yyyy")</strong></span>
                </div>
            </div>
            <div class="text-md-end mt-2 mt-md-0">
                <span class="small opacity-75 d-block">Giá vé gốc:</span>
                <span class="fs-4 fw-bold text-warning">@trip.BasePrice.ToString("N0") đ</span>
            </div>
        </div>
    </div>

    <!-- Main Seat Map & Selection -->
    <div class="container py-4">
        <!-- Chú thích trạng thái ghế (Legend) -->
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-4">
            <div class="d-flex flex-wrap justify-content-center align-items-center gap-4 small fw-semibold">
                <div class="d-flex align-items-center gap-2">
                    <span class="seat-sample seat-available border"></span>
                    <span>Ghế trống (có thể chọn)</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="seat-sample seat-selected"></span>
                    <span class="text-success fw-bold">Ghế đang chọn</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="seat-sample seat-unavailable"></span>
                    <span class="text-muted">Ghế đã bán (không khả dụng)</span>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- Sơ đồ ghế 2 tầng -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <h5 class="fw-bold text-center text-dark mb-4">
                        <i class="bi bi-layout-text-window-reverse text-primary me-2"></i>SƠ ĐỒ CHỌN GIƯỜNG / GHẾ NGỒI
                    </h5>

                    <div class="row g-4 justify-content-center">
                        <!-- Tầng Dưới (Floor 1 - Dãy A) -->
                        <div class="col-md-6">
                            <div class="bus-floor-card border rounded-4 p-3 bg-light">
                                <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom">
                                    <h6 class="fw-bold text-primary mb-0">
                                        <i class="bi bi-arrow-down-circle-fill me-1"></i> TẦNG DƯỚI (DÃY A)
                                    </h6>
                                    <span class="badge bg-primary-subtle text-primary">Tầng 1</span>
                                </div>

                                <!-- Mô phỏng khoang lái đầu xe -->
                                <div class="d-flex justify-content-between align-items-center bg-white border rounded-3 p-2 mb-3 small text-muted">
                                    <span><i class="bi bi-person-badge text-primary"></i> Vị trí tài xế</span>
                                    <span><i class="bi bi-door-open-fill text-success"></i> Cửa lên xuống</span>
                                </div>

                                <!-- Lưới ghế tầng 1 -->
                                <div class="row g-2">
                                    @foreach (var seat in floor1Seats)
                                    {
                                        bool isSelected = selectedSeatCodes.Contains(seat.SeatCode);
                                        bool isBooked = seat.Status == SeatStatus.Unavailable;

                                        <div class="col-4">
                                            <button type="button" 
                                                    class="btn w-100 py-3 seat-btn @(isBooked ? "seat-btn-booked" : isSelected ? "seat-btn-selected" : "seat-btn-available")"
                                                    disabled="@isBooked"
                                                    @onclick="() => ToggleSeat(seat)">
                                                <div class="fw-bold fs-6">@seat.SeatCode</div>
                                                <div class="seat-type-tag">@seat.Price.ToString("N0")đ</div>
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Tầng Trên (Floor 2 - Dãy B) -->
                        <div class="col-md-6">
                            <div class="bus-floor-card border rounded-4 p-3 bg-light">
                                <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom">
                                    <h6 class="fw-bold text-success mb-0">
                                        <i class="bi bi-arrow-up-circle-fill me-1"></i> TẦNG TRÊN (DÃY B)
                                    </h6>
                                    <span class="badge bg-success-subtle text-success">Tầng 2</span>
                                </div>

                                <!-- Mô phỏng khoảng trống đầu tầng 2 -->
                                <div class="text-center bg-white border rounded-3 p-2 mb-3 small text-muted">
                                    <i class="bi bi-stars text-warning"></i> Giường nằm thoáng mát, tầm nhìn cao
                                </div>

                                <!-- Lưới ghế tầng 2 -->
                                <div class="row g-2">
                                    @foreach (var seat in floor2Seats)
                                    {
                                        bool isSelected = selectedSeatCodes.Contains(seat.SeatCode);
                                        bool isBooked = seat.Status == SeatStatus.Unavailable;

                                        <div class="col-4">
                                            <button type="button" 
                                                    class="btn w-100 py-3 seat-btn @(isBooked ? "seat-btn-booked" : isSelected ? "seat-btn-selected" : "seat-btn-available")"
                                                    disabled="@isBooked"
                                                    @onclick="() => ToggleSeat(seat)">
                                                <div class="fw-bold fs-6">@seat.SeatCode</div>
                                                <div class="seat-type-tag">@seat.Price.ToString("N0")đ</div>
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Khung Tóm Tắt & Tiếp tục bên phải -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white sticky-top" style="top: 85px;">
                    <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                        <i class="bi bi-cart-check text-primary me-2"></i>THÔNG TIN ĐẶT CHỖ
                    </h5>

                    <div class="mb-3">
                        <div class="text-secondary small">Tuyến đường:</div>
                        <div class="fw-bold fs-6 text-dark">@trip.OriginCity ➔ @trip.DestinationCity</div>
                    </div>

                    <div class="mb-3">
                        <div class="text-secondary small">Thời gian khởi hành:</div>
                        <div class="fw-bold text-dark">@trip.DepartureTime.ToString("HH:mm - dd/MM/yyyy")</div>
                    </div>

                    <div class="mb-3">
                        <div class="text-secondary small">Nhà xe & Xe:</div>
                        <div class="fw-semibold text-dark">@trip.OperatorName - @trip.BusTypeName</div>
                    </div>

                    <hr />

                    <!-- Danh sách ghế đã chọn -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-secondary small">Vị trí ghế đã chọn:</span>
                            <span class="badge bg-primary rounded-pill">@selectedSeatCodes.Count ghế</span>
                        </div>
                        @if (!selectedSeatCodes.Any())
                        {
                            <div class="alert alert-light border small text-muted text-center py-2 mb-0">
                                Chưa có ghế nào được chọn. Nhấp vào sơ đồ bên trái để chọn!
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var seatCode in selectedSeatCodes)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success px-3 py-2 fs-6 rounded-pill">
                                        @seatCode <i class="bi bi-x-circle ms-1 cursor-pointer" @onclick="() => RemoveSeat(seatCode)"></i>
                                    </span>
                                }
                            </div>
                        }
                    </div>

                    <!-- Tạm tính tổng tiền -->
                    <div class="d-flex justify-content-between align-items-center py-3 border-top border-bottom mb-4">
                        <span class="fw-bold text-dark">Tổng tiền tạm tính:</span>
                        <span class="fs-3 fw-bold text-danger">@totalAmount.ToString("N0") <span class="fs-6">đ</span></span>
                    </div>

                    <!-- Nút thao tác -->
                    <button class="btn btn-warning w-100 py-3 fw-bold fs-5 text-dark rounded-pill shadow-sm mb-2" 
                            disabled="@(!selectedSeatCodes.Any())"
                            @onclick="ProceedToCheckout">
                        TIẾP TỤC ĐẶT VÉ <i class="bi bi-arrow-right ms-1"></i>
                    </button>

                    <a href="/tim-chuyen" class="btn btn-outline-secondary w-100 py-2 rounded-pill small">
                        Hủy & Chọn chuyến khác
                    </a>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public long TripId { get; set; }

    private CustomerTripDto? trip;
    private List<CustomerSeatDto> seats = new();
    private List<CustomerSeatDto> floor1Seats = new();
    private List<CustomerSeatDto> floor2Seats = new();

    private List<string> selectedSeatCodes = new();
    private decimal totalAmount = 0;

    protected override async Task OnParametersSetAsync()
    {
        trip = await BookingService.GetTripDetailsAsync(TripId);
        if (trip != null)
        {
            seats = await BookingService.GetSeatsForTripAsync(TripId);
            floor1Seats = seats.Where(s => s.Floor == 1).OrderBy(s => s.SeatCode).ToList();
            floor2Seats = seats.Where(s => s.Floor == 2).OrderBy(s => s.SeatCode).ToList();
        }
    }

    private void ToggleSeat(CustomerSeatDto seat)
    {
        if (seat.Status == SeatStatus.Unavailable) return;

        if (selectedSeatCodes.Contains(seat.SeatCode))
        {
            selectedSeatCodes.Remove(seat.SeatCode);
            totalAmount -= seat.Price;
        }
        else
        {
            // Giới hạn chọn tối đa 6 vé 1 lần
            if (selectedSeatCodes.Count >= 6)
            {
                return;
            }
            selectedSeatCodes.Add(seat.SeatCode);
            totalAmount += seat.Price;
        }
    }

    private void RemoveSeat(string code)
    {
        var seat = seats.FirstOrDefault(s => s.SeatCode == code);
        if (seat != null && selectedSeatCodes.Contains(code))
        {
            selectedSeatCodes.Remove(code);
            totalAmount -= seat.Price;
        }
    }

    private void ProceedToCheckout()
    {
        if (!selectedSeatCodes.Any()) return;
        var seatsQuery = string.Join(",", selectedSeatCodes);
        Nav.NavigateTo($"/thanh-toan/{TripId}?seats={Uri.EscapeDataString(seatsQuery)}");
    }
}

<style>
    .seat-sample {
        width: 22px;
        height: 22px;
        border-radius: 4px;
        display: inline-block;
    }
    .seat-available {
        background-color: #ffffff;
        border: 2px solid #0d6efd !important;
    }
    .seat-selected {
        background-color: #198754;
    }
    .seat-unavailable {
        background-color: #adb5bd;
    }

    .seat-btn {
        border-radius: 8px;
        transition: all 0.15s ease-in-out;
        position: relative;
    }
    .seat-btn-available {
        background-color: #ffffff;
        border: 2px solid #0d6efd;
        color: #0d6efd;
    }
    .seat-btn-available:hover {
        background-color: #e7f1ff;
        transform: scale(1.04);
    }
    .seat-btn-selected {
        background-color: #198754 !important;
        border: 2px solid #146c43 !important;
        color: #ffffff !important;
        transform: scale(1.04);
        box-shadow: 0 4px 10px rgba(25, 135, 84, 0.4);
    }
    .seat-btn-booked {
        background-color: #e9ecef !important;
        border: 2px solid #ced4da !important;
        color: #6c757d !important;
        text-decoration: line-through;
        cursor: not-allowed;
        opacity: 0.7;
    }
    .seat-type-tag {
        font-size: 11px;
        opacity: 0.85;
    }
    .cursor-pointer {
        cursor: pointer;
    }
</style>
