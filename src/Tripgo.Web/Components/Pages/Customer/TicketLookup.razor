@page "/tra-cuu"
@layout Tripgo.Web.Components.Layout.CustomerLayout
@inject ICustomerBookingService BookingService

<PageTitle>Tra Cứu Vé Xe - TripGo</PageTitle>

<div class="bg-primary text-white py-5 shadow-sm">
    <div class="container text-center">
        <h2 class="fw-bold mb-2"><i class="bi bi-search me-2"></i> TRA CỨU THÔNG TIN VÉ XE</h2>
        <p class="lead opacity-90 mx-auto" style="max-width: 600px;">
            Nhập Mã đặt vé (VD: TG...) hoặc Số điện thoại đã dùng để đặt vé để kiểm tra thông tin hành trình.
        </p>

        <!-- Search Form -->
        <div class="row justify-content-center mt-4">
            <div class="col-lg-6 col-md-8">
                <form class="d-flex gap-2 bg-white p-2 rounded-pill shadow-lg" @onsubmit="HandleLookup">
                    <input type="text" class="form-control form-control-lg border-0 rounded-pill px-4 fw-bold" 
                           placeholder="Nhập mã vé hoặc số điện thoại..." 
                           @bind="keyword" />
                    <button type="submit" class="btn btn-warning px-4 py-2 rounded-pill fw-bold text-dark text-nowrap">
                        <i class="bi bi-search"></i> Tra cứu
                    </button>
                </form>
                <div class="small text-light opacity-75 mt-2">
                    Gợi ý thử: Mã <code>TG20260928001</code> hoặc SĐT <code>0987654321</code>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container py-5">
    @if (hasSearched)
    {
        @if (!results.Any())
        {
            <div class="card border-0 shadow-sm rounded-4 text-center p-5 bg-white mx-auto col-lg-8">
                <i class="bi bi-ticket-detailed text-muted display-4 mb-3"></i>
                <h5 class="fw-bold text-dark">Không tìm thấy vé nào phù hợp!</h5>
                <p class="text-secondary small mb-0">
                    Vui lòng kiểm tra lại tính chính xác của Mã vé hoặc Số điện thoại. Nếu cần hỗ trợ khẩn cấp, vui lòng gọi tổng đài <strong>1900 6868</strong>.
                </p>
            </div>
        }
        else
        {
            <div class="col-lg-10 mx-auto">
                <h5 class="fw-bold text-dark mb-3">
                    Kết quả tra cứu (@results.Count vé tìm thấy):
                </h5>

                <div class="d-flex flex-column gap-3">
                    @foreach (var item in results)
                    {
                        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                            <div class="row align-items-center g-3">
                                <div class="col-md-3 border-end">
                                    <span class="small text-muted d-block">Mã đặt vé:</span>
                                    <strong class="fs-5 text-primary">@item.BookingCode</strong>
                                    <div class="small text-muted mt-1">@item.BookingTime.ToString("dd/MM/yyyy HH:mm")</div>
                                </div>
                                <div class="col-md-4">
                                    <div class="fw-bold fs-6 text-dark">
                                        @item.Trip.OriginCity ➔ @item.Trip.DestinationCity
                                    </div>
                                    <div class="small text-secondary">
                                        Khởi hành: <strong>@item.Trip.DepartureTime.ToString("HH:mm - dd/MM/yyyy")</strong>
                                    </div>
                                    <div class="small text-muted">
                                        Hành khách: @item.PassengerName (@item.PassengerPhone)
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="small text-muted">Ghế đã đặt:</div>
                                    <div class="d-flex gap-1 flex-wrap mb-1">
                                        @foreach (var s in item.Seats)
                                        {
                                            <span class="badge bg-success">@s</span>
                                        }
                                    </div>
                                    <div class="fs-5 fw-bold text-danger">@item.TotalAmount.ToString("N0") đ</div>
                                </div>
                                <div class="col-md-2 text-md-end">
                                    <a href="/ket-qua-dat-ve/@item.BookingCode" class="btn btn-outline-primary rounded-pill btn-sm px-3 fw-bold">
                                        Xem vé <i class="bi bi-arrow-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private string keyword = "";
    private List<CustomerBookingResultDto> results = new();
    private bool hasSearched = false;

    private async Task HandleLookup()
    {
        if (string.IsNullOrWhiteSpace(keyword)) return;
        results = await BookingService.SearchBookingsAsync(keyword);
        hasSearched = true;
    }
}
