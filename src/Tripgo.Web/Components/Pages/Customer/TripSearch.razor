@page "/tim-chuyen"
@layout Tripgo.Web.Components.Layout.CustomerLayout
@inject ICustomerBookingService BookingService
@inject NavigationManager Nav
@using Microsoft.AspNetCore.WebUtilities

<PageTitle>Tìm Kiếm Chuyến Xe - TripGo</PageTitle>

<!-- Top Quick Filter/Search Bar -->
<div class="bg-primary text-white py-4 shadow-sm">
    <div class="container">
        <div class="row g-2 align-items-center bg-white text-dark p-3 rounded-4 shadow-sm">
            <div class="col-md-3 col-sm-6">
                <label class="small text-muted fw-bold mb-1"><i class="bi bi-geo-alt-fill text-danger"></i> Điểm đi</label>
                <input type="text" class="form-control fw-bold" @bind="searchFilter.Origin" placeholder="Ví dụ: TP. Hồ Chí Minh" />
            </div>
            <div class="col-md-3 col-sm-6">
                <label class="small text-muted fw-bold mb-1"><i class="bi bi-geo-alt-fill text-success"></i> Điểm đến</label>
                <input type="text" class="form-control fw-bold" @bind="searchFilter.Destination" placeholder="Ví dụ: Đà Lạt" />
            </div>
            <div class="col-md-3 col-sm-6">
                <label class="small text-muted fw-bold mb-1"><i class="bi bi-calendar-event text-primary"></i> Ngày khởi hành</label>
                <input type="date" class="form-control fw-bold" @bind="searchFilter.DepartureDate" />
            </div>
            <div class="col-md-3 col-sm-6 d-flex align-items-end">
                <button class="btn btn-warning w-100 py-2 fw-bold text-dark rounded-3" @onclick="ExecuteSearch">
                    <i class="bi bi-search me-1"></i> TÌM LẠI
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Main Search Results & Filter -->
<div class="container py-4">
    <div class="row g-4">
        <!-- Sidebar Bộ lọc bên trái -->
        <div class="col-lg-3 col-md-4">
            <Tripgo.Web.Components.Customer.TripFilter Filter="searchFilter" OnFilterChanged="ExecuteSearch" />
        </div>

        <!-- Danh sách chuyến xe bên phải -->
        <div class="col-lg-9 col-md-8">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center bg-white p-3 rounded-4 shadow-sm mb-3">
                <div>
                    <h5 class="fw-bold mb-1 text-primary">
                        @(string.IsNullOrEmpty(searchFilter.Origin) ? "Tất cả điểm đi" : searchFilter.Origin) 
                        <i class="bi bi-arrow-right text-muted mx-1"></i> 
                        @(string.IsNullOrEmpty(searchFilter.Destination) ? "Tất cả điểm đến" : searchFilter.Destination)
                    </h5>
                    <small class="text-secondary">
                        <i class="bi bi-calendar3 me-1"></i> Khởi hành: <strong>@(searchFilter.DepartureDate?.ToString("dd/MM/yyyy") ?? "Hôm nay")</strong> • Tìm thấy <strong>@trips.Count</strong> chuyến phù hợp
                    </small>
                </div>

                <div class="d-flex align-items-center gap-2 mt-3 mt-md-0">
                    <span class="small text-secondary text-nowrap">Sắp xếp:</span>
                    <select class="form-select form-select-sm fw-semibold" style="width: 180px;" @bind="searchFilter.SortBy" @bind:after="ExecuteSearch">
                        <option value="TimeAsc">Giờ chạy sớm nhất</option>
                        <option value="PriceAsc">Giá vé thấp đến cao</option>
                        <option value="PriceDesc">Giá vé cao đến thấp</option>
                        <option value="RatingDesc">Đánh giá cao nhất</option>
                    </select>
                </div>
            </div>

            <!-- Trạng thái tải / Kết quả -->
            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Đang tải...</span>
                    </div>
                    <p class="mt-2 text-muted fw-semibold">Đang tìm kiếm chuyến xe tốt nhất cho bạn...</p>
                </div>
            }
            else if (!trips.Any())
            {
                <div class="card border-0 shadow-sm rounded-4 text-center p-5 bg-white">
                    <div class="mb-3">
                        <i class="bi bi-search text-muted display-3"></i>
                    </div>
                    <h4 class="fw-bold text-dark">Rất tiếc, không tìm thấy chuyến xe nào phù hợp!</h4>
                    <p class="text-secondary mx-auto" style="max-width: 500px;">
                        Bạn có thể thử tìm kiếm ngày khác, hoặc xóa bớt các tiêu chí lọc (nhà xe, khung giờ, khoảng giá) để xem thêm kết quả khả dụng.
                    </p>
                    <div class="mt-2">
                        <button class="btn btn-primary px-4 py-2 rounded-pill fw-bold" @onclick="ResetAndSearchAll">
                            Xem tất cả các chuyến hiện có
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var trip in trips)
                    {
                        <Tripgo.Web.Components.Customer.TripCard Trip="trip" />
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "origin")]
    public string? QueryOrigin { get; set; }

    [SupplyParameterFromQuery(Name = "dest")]
    public string? QueryDest { get; set; }

    [SupplyParameterFromQuery(Name = "date")]
    public string? QueryDate { get; set; }

    private TripSearchFilter searchFilter = new();
    private List<CustomerTripDto> trips = new();
    private bool isLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        searchFilter.Origin = QueryOrigin;
        searchFilter.Destination = QueryDest;

        if (DateTime.TryParse(QueryDate, out var d))
        {
            searchFilter.DepartureDate = d;
        }
        else
        {
            searchFilter.DepartureDate = DateTime.Today;
        }

        await ExecuteSearch();
    }

    private async Task ExecuteSearch()
    {
        isLoading = true;
        trips = await BookingService.SearchTripsAsync(searchFilter);
        isLoading = false;
    }

    private async Task ResetAndSearchAll()
    {
        searchFilter = new TripSearchFilter
        {
            DepartureDate = DateTime.Today
        };
        await ExecuteSearch();
    }
}
