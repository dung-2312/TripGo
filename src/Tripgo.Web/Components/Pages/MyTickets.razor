@page "/my-tickets"
@using Tripgo.Application.DTOs
@using Tripgo.Application.Interfaces
@using System.Security.Claims
@inject ITripService TripService
@inject IBookingService BookingService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Vé của tôi | TripGo</PageTitle>

<section class="tg-tickets-page py-4 py-md-5">
    <div class="container">
        <!-- Top Navigation / Breadcrumb -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1">
                        <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Trang chủ</a></li>
                        <li class="breadcrumb-item active text-primary fw-semibold" aria-current="page">Vé của tôi</li>
                    </ol>
                </nav>
                <h2 class="fw-bold text-dark mb-0">Quản lý vé & Hành trình</h2>
            </div>

            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3"
                        @onclick="() => showLookupBox = !showLookupBox">
                    <i class="bi @(showLookupBox ? "bi-chevron-up" : "bi-search") me-1"></i>
                    <span>@(showLookupBox ? "Ẩn công cụ tra cứu" : "Tra cứu theo mã / SĐT")</span>
                </button>
                <a href="/search-trips" class="btn btn-warning btn-sm rounded-pill px-3 fw-bold text-dark shadow-sm">
                    <i class="bi bi-plus-circle-fill me-1"></i> Đặt vé mới
                </a>
            </div>
        </div>

        <!-- Optional Direct Lookup Tool (Collapsible) -->
        @if (showLookupBox)
        {
            <div class="card shadow-sm rounded-4 border-0 p-4 mb-4 bg-white tg-lookup-card">
                <div class="row align-items-center g-3">
                    <div class="col-lg-8">
                        <label class="form-label fw-bold text-dark small mb-1" for="manualLookupInput">
                            Tra cứu nhanh bằng Mã đặt chỗ hoặc Số điện thoại
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-search"></i>
                            </span>
                            <input id="manualLookupInput" type="text" class="form-control border-start-0 ps-0"
                                   placeholder="Nhập mã TRIPGO-XXXX hoặc số điện thoại..."
                                   @bind="manualLookupQuery" @bind:event="oninput" @onkeydown="HandleLookupKeyDown" />
                            <button type="button" class="btn btn-primary px-4 fw-bold" disabled="@isSearchingManual" @onclick="ExecuteManualLookup">
                                @if (isSearchingManual)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                    <span>Đang tìm...</span>
                                }
                                else
                                {
                                    <span>Tra cứu</span>
                                }
                            </button>
                        </div>
                    </div>
                    <div class="col-lg-4 text-muted small border-start-lg ps-lg-4">
                        <i class="bi bi-shield-check text-success me-1"></i> Chỉ các vé thuộc quyền sở hữu của tài khoản hoặc phiên trình duyệt hiện tại mới được hiển thị nhằm bảo vệ an toàn thông tin cá nhân.
                    </div>
                </div>
            </div>
        }

        <!-- Status & Feedback Alerts -->
        @if (!string.IsNullOrWhiteSpace(actionAlertMessage))
        {
            <div class="alert @(actionAlertIsError ? "alert-danger" : "alert-success") alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
                <i class="bi @(actionAlertIsError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-2 fs-5"></i>
                <span>@actionAlertMessage</span>
                <button type="button" class="btn-close" @onclick="() => actionAlertMessage = null" aria-label="Close"></button>
            </div>
        }

        <!-- Account Context Header -->
        <AuthorizeView>
            <Authorized>
                <div class="card shadow-sm border-0 rounded-4 p-3 px-md-4 mb-4 bg-white d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="tg-user-avatar text-white fw-bold">
                            @(string.IsNullOrWhiteSpace(context.User.Identity?.Name) ? "U" : context.User.Identity.Name.Substring(0, 1).ToUpper())
                        </div>
                        <div>
                            <div class="fw-bold text-dark">Xin chào, @context.User.Identity?.Name!</div>
                            <small class="text-muted">
                                <i class="bi bi-check-circle-fill text-success me-1"></i>
                                Các đơn đặt chỗ của bạn được tự động đồng bộ hóa trên mọi thiết bị.
                            </small>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="/account/profile" class="btn btn-light btn-sm rounded-pill border px-3">
                            <i class="bi bi-person-gear me-1"></i> Hồ sơ
                        </a>
                    </div>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="alert alert-info rounded-4 border-0 shadow-sm p-3 px-md-4 mb-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                    <div>
                        <div class="fw-bold text-primary mb-1">
                            <i class="bi bi-info-circle-fill me-1"></i> Bạn đang xem vé ở chế độ Khách (Phiên hiện tại)
                        </div>
                        <div class="small text-secondary">
                            Đăng nhập hoặc đăng ký tài khoản TripGo để tự động lưu trữ và quản lý vé vĩnh viễn trên mọi thiết bị.
                        </div>
                    </div>
                    <div class="d-flex gap-2 flex-shrink-0">
                        <a href="/login?ReturnUrl=/my-tickets" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold">
                            Đăng nhập
                        </a>
                        <a href="/register?ReturnUrl=/my-tickets" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-bold">
                            Đăng ký
                        </a>
                    </div>
                </div>
            </NotAuthorized>
        </AuthorizeView>

        <!-- Filter Tabs -->
        <div class="card shadow-sm rounded-4 border-0 mb-4 bg-white overflow-hidden">
            <div class="p-2 p-md-3 border-bottom">
                <ul class="nav nav-pills tg-ticket-tabs gap-2" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link @(activeFilter == "all" ? "active" : "") rounded-pill px-3 py-2 fw-semibold"
                                @onclick='() => SetFilter("all")'>
                            Tất cả vé
                            <span class="badge ms-1 @(activeFilter == "all" ? "bg-white text-primary" : "bg-light text-dark")">@allTickets.Count</span>
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link @(activeFilter == "upcoming" ? "active" : "") rounded-pill px-3 py-2 fw-semibold"
                                @onclick='() => SetFilter("upcoming")'>
                            Sắp khởi hành
                            <span class="badge ms-1 @(activeFilter == "upcoming" ? "bg-white text-primary" : "bg-light text-dark")">@upcomingCount</span>
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link @(activeFilter == "completed" ? "active" : "") rounded-pill px-3 py-2 fw-semibold"
                                @onclick='() => SetFilter("completed")'>
                            Đã hoàn thành
                            <span class="badge ms-1 @(activeFilter == "completed" ? "bg-white text-primary" : "bg-light text-dark")">@completedCount</span>
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link @(activeFilter == "cancelled" ? "active" : "") rounded-pill px-3 py-2 fw-semibold"
                                @onclick='() => SetFilter("cancelled")'>
                            Đã hủy / Hết hạn
                            <span class="badge ms-1 @(activeFilter == "cancelled" ? "bg-white text-primary" : "bg-light text-dark")">@cancelledCount</span>
                        </button>
                    </li>
                </ul>
            </div>

            <!-- Content Area: List of Ticket Cards -->
            <div class="p-3 p-md-4">
                @if (isLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary mb-3" role="status"></div>
                        <div class="text-muted">Đang tải danh sách vé của bạn...</div>
                    </div>
                }
                else if (filteredTickets.Count == 0)
                {
                    <!-- Empty State -->
                    <div class="text-center py-5">
                        <div class="tg-empty-icon-circle mx-auto mb-3">
                            <i class="bi bi-ticket-perforated text-muted fs-1"></i>
                        </div>
                        <h5 class="fw-bold text-dark">Chưa có vé nào trong mục này</h5>
                        <p class="text-muted small mb-4" style="max-width: 450px; margin: 0 auto;">
                            @if (activeFilter == "all")
                            {
                                <span>Bạn chưa có đơn đặt vé nào được lưu trong tài khoản hoặc phiên trình duyệt này. Hãy khám phá các hành trình chất lượng cao trên TripGo ngay!</span>
                            }
                            else
                            {
                                <span>Không có chuyến xe nào phù hợp với bộ lọc hiện tại.</span>
                            }
                        </p>
                        <a href="/search-trips" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm">
                            <i class="bi bi-bus-front me-2"></i>Tìm & Đặt vé xe ngay
                        </a>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-4">
                        @foreach (var ticket in filteredTickets)
                        {
                            <div class="card shadow-sm rounded-4 border-0 overflow-hidden tg-ticket-card">
                                <!-- Card Header -->
                                <div class="p-3 px-md-4 bg-light border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-primary px-3 py-2 rounded-pill font-monospace fs-6">
                                            @ticket.BookingCode
                                        </span>
                                        <span class="badge @GetStatusBadgeClass(ticket) rounded-pill px-3 py-2">
                                            @GetStatusLabel(ticket)
                                        </span>
                                        <span class="badge bg-warning text-dark rounded-pill px-2 py-1 small">
                                            SANDBOX
                                        </span>
                                    </div>
                                    <div class="text-muted small">
                                        <i class="bi bi-clock me-1"></i>Đặt lúc: @ticket.BookedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                </div>

                                <!-- Card Body -->
                                <div class="p-3 p-md-4">
                                    <div class="row g-4 align-items-center">
                                        <!-- Trip Main Info -->
                                        <div class="col-lg-8">
                                            <div class="d-flex align-items-center gap-2 mb-2">
                                                <i class="bi bi-bus-front-fill text-primary fs-5"></i>
                                                <h5 class="fw-bold text-dark mb-0">@ticket.RouteName</h5>
                                                <span class="badge bg-light text-dark border">@ticket.OperatorName</span>
                                                <span class="badge bg-light text-secondary border">@ticket.BusTypeName</span>
                                            </div>

                                            <!-- Departure Schedule -->
                                            <div class="d-flex flex-wrap align-items-center gap-3 my-3 p-3 bg-light rounded-3">
                                                <div>
                                                    <small class="text-muted d-block text-uppercase fw-semibold" style="font-size: 0.75rem;">Giờ khởi hành</small>
                                                    <span class="fs-4 fw-bold text-primary">@ticket.DepartureTime.ToLocalTime().ToString("HH:mm")</span>
                                                    <span class="text-dark fw-semibold ms-1">@ticket.DepartureTime.ToLocalTime().ToString("ddd, dd/MM/yyyy")</span>
                                                </div>
                                                <div class="vr d-none d-sm-block"></div>
                                                <div>
                                                    <small class="text-muted d-block text-uppercase fw-semibold" style="font-size: 0.75rem;">Biển số xe</small>
                                                    <span class="fw-bold text-dark">@(string.IsNullOrWhiteSpace(ticket.BusLicensePlate) ? "Đang điều phối" : ticket.BusLicensePlate)</span>
                                                </div>
                                                <div class="vr d-none d-sm-block"></div>
                                                <div>
                                                    <small class="text-muted d-block text-uppercase fw-semibold" style="font-size: 0.75rem;">Số lượng ghế</small>
                                                    <span class="fw-bold text-dark">@ticket.SeatCodes.Count chỗ (@string.Join(", ", ticket.SeatCodes))</span>
                                                </div>
                                            </div>

                                            <!-- Pickup & Dropoff Points (Authoritative Unicode) -->
                                            <div class="row g-2 small text-secondary">
                                                <div class="col-md-6">
                                                    <div class="d-flex align-items-start gap-2">
                                                        <i class="bi bi-geo-alt-fill text-primary mt-1"></i>
                                                        <div>
                                                            <strong class="text-dark d-block">Điểm đón:</strong>
                                                            <span>@ticket.SelectedPickupPoint</span>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="d-flex align-items-start gap-2">
                                                        <i class="bi bi-geo-alt-fill text-danger mt-1"></i>
                                                        <div>
                                                            <strong class="text-dark d-block">Điểm trả:</strong>
                                                            <span>@ticket.SelectedDropoffPoint</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Passenger Info -->
                                            <div class="mt-3 pt-3 border-top small d-flex flex-wrap gap-4 text-muted">
                                                <div><strong>Hành khách đại diện:</strong> @ticket.Name</div>
                                                <div><strong>Số điện thoại:</strong> @ticket.Phone</div>
                                                @if (!string.IsNullOrWhiteSpace(ticket.Email))
                                                {
                                                    <div><strong>Email:</strong> @ticket.Email</div>
                                                }
                                            </div>

                                            @if (ticket.Passengers != null && ticket.Passengers.Count > 1)
                                            {
                                                <div class="mt-2 p-2 bg-light rounded small">
                                                    <span class="text-secondary fw-semibold">Danh sách hành khách: </span>
                                                    @string.Join(" | ", ticket.Passengers.Select(p => $"{p.FullName} ({p.PhoneNumber})"))
                                                </div>
                                            }
                                        </div>

                                        <!-- Pricing & Actions Column -->
                                        <div class="col-lg-4 text-lg-end border-start-lg ps-lg-4">
                                            <small class="text-muted text-uppercase fw-semibold d-block">Tổng tiền thanh toán</small>
                                            <div class="fs-3 fw-bold text-danger mb-2">
                                                @ticket.TotalAmount.ToString("N0") đ
                                            </div>

                                            <div class="small text-muted mb-3">
                                                @if (!string.IsNullOrWhiteSpace(ticket.PaymentMethod))
                                                {
                                                    <div>Phương thức: <strong>@ticket.PaymentMethod</strong></div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(ticket.TransactionCode))
                                                {
                                                    <div class="text-truncate" title="@ticket.TransactionCode">Mã GD: @ticket.TransactionCode</div>
                                                }
                                            </div>

                                            <!-- Action Buttons -->
                                            <div class="d-flex flex-column gap-2 justify-content-lg-end">
                                                @if (CanCancel(ticket))
                                                {
                                                    @if (confirmingCancelId == ticket.BookingId)
                                                    {
                                                        <div class="p-2 border border-danger rounded-3 bg-danger-subtle text-center">
                                                            <div class="small fw-bold text-danger mb-2">Bạn có chắc chắn muốn hủy đặt chỗ này?</div>
                                                            <div class="d-flex gap-2 justify-content-center">
                                                                <button class="btn btn-danger btn-sm fw-bold px-3"
                                                                        disabled="@isCancelling"
                                                                        @onclick="() => ExecuteCancelAsync(ticket)">
                                                                    @if (isCancelling)
                                                                    {
                                                                        <span class="spinner-border spinner-border-sm"></span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span>Xác nhận hủy</span>
                                                                    }
                                                                </button>
                                                                <button class="btn btn-secondary btn-sm"
                                                                        disabled="@isCancelling"
                                                                        @onclick="() => confirmingCancelId = null">
                                                                    Đóng
                                                                </button>
                                                            </div>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3"
                                                                @onclick="() => confirmingCancelId = ticket.BookingId">
                                                            <i class="bi bi-x-circle me-1"></i> Hủy đặt chỗ
                                                        </button>
                                                    }
                                                }
                                                else if (ticket.BookingStatus == "PendingPayment")
                                                {
                                                    <a href="/search-trips" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold">
                                                        <i class="bi bi-credit-card me-1"></i> Thanh toán ngay
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<style>
    .tg-tickets-page {
        background-color: #f8fafc;
        min-height: calc(100vh - 160px);
    }

    .tg-user-avatar {
        width: 44px;
        height: 44px;
        background: linear-gradient(135deg, #0d5cb6, #083e7d);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    .tg-ticket-tabs .nav-link {
        color: #475569;
        background: #f1f5f9;
        transition: all 0.2s;
    }

    .tg-ticket-tabs .nav-link.active {
        background: #0d5cb6 !important;
        color: #ffffff !important;
    }

    .tg-ticket-card {
        transition: transform 0.15s, box-shadow 0.15s;
    }

    .tg-ticket-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08) !important;
    }

    .tg-empty-icon-circle {
        width: 72px;
        height: 72px;
        background: #f1f5f9;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    @@media (min-width: 992px) {
        .border-start-lg {
            border-left: 1px solid #e2e8f0;
        }
    }
</style>

@code {
    [SupplyParameterFromQuery(Name = "code")]
    public string? QueryCode { get; set; }

    [SupplyParameterFromQuery(Name = "phone")]
    public string? QueryPhone { get; set; }

    private bool isLoading = true;
    private bool isSearchingManual = false;
    private bool isCancelling = false;
    private bool showLookupBox = false;

    private string activeFilter = "all";
    private string manualLookupQuery = string.Empty;
    private long? confirmingCancelId;

    private string? actionAlertMessage;
    private bool actionAlertIsError = false;

    private List<CustomerBookingInfoDto> allTickets = new();
    private List<CustomerBookingInfoDto> filteredTickets = new();

    private int upcomingCount = 0;
    private int completedCount = 0;
    private int cancelledCount = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadTicketsAsync();

        if (!string.IsNullOrWhiteSpace(QueryCode) || !string.IsNullOrWhiteSpace(QueryPhone))
        {
            showLookupBox = true;
            manualLookupQuery = QueryCode ?? QueryPhone ?? string.Empty;
            await ExecuteManualLookup();
        }
    }

    private async Task LoadTicketsAsync()
    {
        isLoading = true;
        try
        {
            allTickets = await TripService.GetBookingsForCurrentUserAsync();
            ApplyFilter();
        }
        catch (Exception ex)
        {
            actionAlertMessage = "Không thể tải danh sách vé lúc này. Vui lòng thử lại sau.";
            actionAlertIsError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SetFilter(string filter)
    {
        activeFilter = filter;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var now = DateTimeOffset.UtcNow;

        upcomingCount = allTickets.Count(t =>
            t.DepartureTime > now &&
            t.BookingStatus != "Cancelled" &&
            t.BookingStatus != "Expired");

        completedCount = allTickets.Count(t =>
            t.DepartureTime <= now &&
            t.BookingStatus != "Cancelled" &&
            t.BookingStatus != "Expired");

        cancelledCount = allTickets.Count(t =>
            t.BookingStatus == "Cancelled" ||
            t.BookingStatus == "Expired");

        filteredTickets = activeFilter switch
        {
            "upcoming" => allTickets.Where(t => t.DepartureTime > now && t.BookingStatus != "Cancelled" && t.BookingStatus != "Expired").ToList(),
            "completed" => allTickets.Where(t => t.DepartureTime <= now && t.BookingStatus != "Cancelled" && t.BookingStatus != "Expired").ToList(),
            "cancelled" => allTickets.Where(t => t.BookingStatus == "Cancelled" || t.BookingStatus == "Expired").ToList(),
            _ => allTickets.ToList()
        };
    }

    private async Task HandleLookupKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await ExecuteManualLookup();
        }
    }

    private async Task ExecuteManualLookup()
    {
        if (string.IsNullOrWhiteSpace(manualLookupQuery))
        {
            actionAlertMessage = "Vui lòng nhập mã đặt chỗ hoặc số điện thoại để tra cứu.";
            actionAlertIsError = true;
            return;
        }

        isSearchingManual = true;
        actionAlertMessage = null;

        try
        {
            var query = manualLookupQuery.Trim();
            if (query.StartsWith("TRIPGO-", StringComparison.OrdinalIgnoreCase))
            {
                var found = await TripService.GetBookingByCodeAsync(query);
                if (found != null)
                {
                    if (!allTickets.Any(t => t.BookingId == found.BookingId))
                    {
                        allTickets.Insert(0, found);
                    }
                    actionAlertMessage = $"Đã tìm thấy thông tin đơn đặt chỗ {found.BookingCode}.";
                    actionAlertIsError = false;
                }
                else
                {
                    actionAlertMessage = "Không tìm thấy vé phù hợp hoặc bạn không có quyền xem vé này.";
                    actionAlertIsError = true;
                }
            }
            else
            {
                var list = await TripService.GetBookingsByPhoneAsync(query);
                if (list.Count > 0)
                {
                    foreach (var item in list)
                    {
                        if (!allTickets.Any(t => t.BookingId == item.BookingId))
                        {
                            allTickets.Add(item);
                        }
                    }
                    actionAlertMessage = $"Đã tìm thấy {list.Count} vé phù hợp.";
                    actionAlertIsError = false;
                }
                else
                {
                    actionAlertMessage = "Không tìm thấy vé phù hợp với số điện thoại trong phiên hiện tại.";
                    actionAlertIsError = true;
                }
            }

            ApplyFilter();
        }
        catch (Exception ex)
        {
            actionAlertMessage = "Lỗi tra cứu: " + ex.Message;
            actionAlertIsError = true;
        }
        finally
        {
            isSearchingManual = false;
        }
    }

    private static bool CanCancel(CustomerBookingInfoDto ticket)
    {
        // Cancel permitted if pending payment or confirmed before departure
        return ticket.BookingStatus == "PendingPayment";
    }

    private static string GetStatusBadgeClass(CustomerBookingInfoDto ticket)
    {
        if (ticket.BookingStatus == "PendingPayment") return "bg-warning text-dark";
        if (ticket.BookingStatus == "Confirmed" && ticket.PaymentStatus == "Paid") return "bg-success text-white";
        if (ticket.BookingStatus == "Cancelled") return "bg-danger text-white";
        if (ticket.BookingStatus == "Expired") return "bg-secondary text-white";
        return "bg-secondary text-white";
    }

    private static string GetStatusLabel(CustomerBookingInfoDto ticket)
    {
        if (ticket.BookingStatus == "PendingPayment" && ticket.PaymentStatus == "Unpaid")
            return "CHỜ THANH TOÁN";
        return ticket.BookingStatus switch
        {
            "Confirmed" when ticket.PaymentStatus == "Paid" => "ĐÃ XÁC NHẬN (ĐÃ THANH TOÁN)",
            "Cancelled" => "ĐÃ HỦY",
            "Expired" => "HẾT HẠN",
            "Completed" => "ĐÃ HOÀN TẤT",
            _ => ticket.BookingStatus
        };
    }

    private async Task ExecuteCancelAsync(CustomerBookingInfoDto ticket)
    {
        isCancelling = true;
        actionAlertMessage = null;

        try
        {
            var success = await BookingService.CancelBookingAsync(ticket.BookingId, "Khách hàng tự hủy trên trang Vé của tôi");
            if (success)
            {
                actionAlertIsError = false;
                actionAlertMessage = $"Đã hủy đặt chỗ {ticket.BookingCode} thành công. Ghế đã được hoàn trả lại hệ thống.";
                confirmingCancelId = null;
                await LoadTicketsAsync();
            }
            else
            {
                actionAlertIsError = true;
                actionAlertMessage = "Không thể hủy đặt chỗ (chỉ có thể hủy đơn đặt chỗ đang chờ thanh toán thuộc quyền sở hữu của bạn).";
            }
        }
        catch (Exception ex)
        {
            actionAlertIsError = true;
            actionAlertMessage = $"Đã xảy ra lỗi khi hủy đặt chỗ: {ex.Message}";
        }
        finally
        {
            isCancelling = false;
        }
    }
}
