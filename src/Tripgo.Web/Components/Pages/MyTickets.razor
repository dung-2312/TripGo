@page "/my-tickets"
@using Tripgo.Application.DTOs
@using Tripgo.Application.Interfaces
@using System.Security.Claims
@inject ITripService TripService
@inject IBookingService BookingService
@inject IPaymentGatewayService PaymentGatewayService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ILogger<MyTickets> Logger
@rendermode InteractiveServer

<PageTitle>Đơn đặt chỗ của tôi | TripGo</PageTitle>

<section class="py-4 py-md-5" style="background-color: var(--tg-bg); min-height: calc(100vh - 160px);">
    <div class="container">
        <!-- Top Navigation / Breadcrumb -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1">
                        <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Trang chủ</a></li>
                        <li class="breadcrumb-item active text-primary fw-semibold" aria-current="page">Vé của tôi</li>
                    </ol>
                </nav>
                <h2 class="fw-bold text-dark mb-0" style="font-size: 1.75rem;">Đơn đặt chỗ của tôi</h2>
            </div>

            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3 py-2 fw-semibold"
                        @onclick="() => showLookupBox = !showLookupBox">
                    <i class="bi @(showLookupBox ? "bi-chevron-up" : "bi-search") me-1"></i>
                    <span>@(showLookupBox ? "Ẩn tìm kiếm" : "Tra cứu theo mã / SĐT")</span>
                </button>
                <a href="/search-trips" class="btn btn-warning btn-sm rounded-pill px-3 py-2 fw-bold text-dark shadow-sm">
                    <i class="bi bi-plus-circle-fill me-1"></i> Đặt vé mới
                </a>
            </div>
        </div>

        <!-- Optional Direct Lookup Tool (Collapsible) -->
        @if (showLookupBox)
        {
            <div class="card shadow-sm rounded-4 border-0 p-4 mb-4" style="background: var(--tg-surface); border: 1px solid var(--tg-border) !important;">
                <div class="row align-items-center g-3">
                    <div class="col-lg-8">
                        <label class="form-label fw-bold text-dark small mb-1" for="manualLookupInput">
                            Tra cứu nhanh bằng Mã đặt chỗ hoặc Số điện thoại
                        </label>
                        <div class="tg-auth-input-group">
                            <span class="tg-auth-input-icon">
                                <i class="bi bi-search"></i>
                            </span>
                            <input id="manualLookupInput" type="text" class="tg-auth-input"
                                   placeholder="Nhập mã TRIPGO-XXXX hoặc số điện thoại..."
                                   @bind="manualLookupQuery" @bind:event="oninput" @onkeydown="HandleLookupKeyDown" />
                            <button type="button" class="tg-auth-btn-primary py-2 px-4 m-1" disabled="@isSearchingManual" @onclick="ExecuteManualLookup">
                                @if (isSearchingManual)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                    <span>Đang tìm...</span>
                                }
                                else
                                {
                                    <span>Tra cứu</span>
                                }
                            </button>
                        </div>
                    </div>
                    <div class="col-lg-4 text-muted small border-start-lg ps-lg-4">
                        <div class="d-flex align-items-start gap-2">
                            <i class="bi bi-shield-check text-success fs-5"></i>
                            <span>Chỉ các vé thuộc quyền sở hữu của tài khoản hoặc phiên trình duyệt hiện tại mới được hiển thị nhằm bảo mật thông tin hành khách.</span>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Status & Feedback Alerts -->
        @if (!string.IsNullOrWhiteSpace(actionAlertMessage))
        {
            <div class="alert @(actionAlertIsError ? "alert-danger" : "alert-success") alert-dismissible fade show rounded-4 shadow-sm mb-4 border-0 d-flex flex-wrap align-items-center justify-content-between gap-2" role="alert">
                <div class="d-flex align-items-center gap-2">
                <i class="bi @(actionAlertIsError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-2 fs-5"></i>
                <span>@actionAlertMessage</span>
                </div>
                @if (actionAlertIsError && !string.IsNullOrWhiteSpace(QueryCode))
                {
                    <AuthorizeView Policy="@Tripgo.Web.Services.AccountPolicy.Name">
                        <NotAuthorized>
                            <a href="@GetLoginUrl()" class="btn btn-danger btn-sm rounded-pill px-3 fw-bold text-white shadow-sm">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập ngay
                            </a>
                        </NotAuthorized>
                        <Authorized>
                            <a href="/auth/logout" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold shadow-sm">
                                <i class="bi bi-box-arrow-right me-1"></i> Đổi tài khoản khác
                            </a>
                        </Authorized>
                    </AuthorizeView>
                }
                <button type="button" class="btn-close" @onclick="() => actionAlertMessage = null" aria-label="Close"></button>
            </div>
        }

        <!-- Account Context Header -->
        <AuthorizeView Policy="@Tripgo.Web.Services.AccountPolicy.Name">
            <Authorized>
                <div class="card shadow-sm border-0 rounded-4 p-3 px-md-4 mb-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3"
                     style="background: var(--tg-surface); border: 1px solid var(--tg-border) !important;">
                    <div class="d-flex align-items-center gap-3">
                        <div class="tg-user-avatar-circle text-white fw-bold"
                             style="width: 46px; height: 46px; border-radius: 50%; background: linear-gradient(135deg, var(--tg-primary), #072f7a); display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
                            @(string.IsNullOrWhiteSpace(context.User.Identity?.Name) ? "U" : context.User.Identity.Name.Substring(0, 1).ToUpper())
                        </div>
                        <div>
                            <div class="fw-bold text-dark">Xin chào, @(string.IsNullOrWhiteSpace(context.User.Identity?.Name) ? "Quý khách" : context.User.Identity.Name)!</div>
                            <small class="text-muted">
                                <i class="bi bi-check-circle-fill text-success me-1"></i>
                                Các đơn đặt chỗ của bạn được tự động đồng bộ hóa trên mọi thiết bị.
                            </small>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="/account/profile" class="btn btn-light btn-sm rounded-pill border px-3 py-1 fw-semibold">
                            <i class="bi bi-person-gear me-1"></i> Hồ sơ của tôi
                        </a>
                    </div>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="alert alert-info rounded-4 border-0 shadow-sm p-3 px-md-4 mb-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3"
                     style="background: var(--tg-primary-subtle); border-left: 4px solid var(--tg-primary) !important;">
                    <div>
                        <div class="fw-bold text-primary mb-1">
                            <i class="bi bi-info-circle-fill me-1"></i> Bạn đang xem vé ở chế độ Khách (Phiên hiện tại)
                        </div>
                        <div class="small text-secondary">
                            Đăng nhập để xem các đơn đặt chỗ sandbox được lưu cho tài khoản này. Thời gian lưu phụ thuộc vào môi trường thử nghiệm.
                        </div>
                    </div>
                    <div class="d-flex gap-2 flex-shrink-0">
                        <a href="@GetLoginUrl()" class="tg-auth-btn-primary btn-sm text-decoration-none px-3 py-1">
                            Đăng nhập
                        </a>
                        <a href="/register?ReturnUrl=/my-tickets" class="btn btn-outline-primary btn-sm rounded-pill px-3 py-1 fw-bold">
                            Đăng ký
                        </a>
                    </div>
                </div>
            </NotAuthorized>
        </AuthorizeView>

        <!-- Filter Tabs -->
        <div class="mb-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="tg-ticket-tabs">
                <button class="tg-ticket-tab-item @(activeFilter == "all" ? "active" : "")"
                        @onclick='() => SetFilter("all")'>
                    <span>Tất cả vé</span>
                    <span class="tg-ticket-tab-badge">@allTickets.Count</span>
                </button>
                <button class="tg-ticket-tab-item @(activeFilter == "upcoming" ? "active" : "")"
                        @onclick='() => SetFilter("upcoming")'>
                    <span>Sắp khởi hành</span>
                    <span class="tg-ticket-tab-badge">@upcomingCount</span>
                </button>
                <button class="tg-ticket-tab-item @(activeFilter == "completed" ? "active" : "")"
                        @onclick='() => SetFilter("completed")'>
                    <span>Đã hoàn thành</span>
                    <span class="tg-ticket-tab-badge">@completedCount</span>
                </button>
                <button class="tg-ticket-tab-item @(activeFilter == "cancelled" ? "active" : "")"
                        @onclick='() => SetFilter("cancelled")'>
                    <span>Đã hủy / Hết hạn</span>
                    <span class="tg-ticket-tab-badge">@cancelledCount</span>
                </button>
            </div>

            <div class="text-muted small">
                Hiển thị <strong>@filteredTickets.Count</strong> đơn đặt chỗ
            </div>
        </div>

        <!-- Content Area: List of Boarding Pass Ticket Cards -->
        @if (isLoading)
        {
            <div class="text-center py-5 card rounded-4 border-0 shadow-sm" style="background: var(--tg-surface);">
                <div class="spinner-border text-primary mb-3" role="status"></div>
                <div class="text-muted">Đang tải danh sách đơn đặt chỗ...</div>
            </div>
        }
        else if (filteredTickets.Count == 0)
        {
            <!-- Empty State -->
            <div class="text-center py-5 card rounded-4 border-0 shadow-sm p-4 p-md-5" style="background: var(--tg-surface);">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mx-auto mb-3"
                     style="width: 80px; height: 80px; background: var(--tg-primary-subtle); color: var(--tg-primary); font-size: 2.25rem;">
                    <i class="bi bi-ticket-perforated"></i>
                </div>
                <h4 class="fw-bold text-dark mb-2">Chưa có vé nào trong mục này</h4>
                <p class="text-muted small mb-4" style="max-width: 480px; margin: 0 auto; line-height: 1.6;">
                    @if (activeFilter == "all")
                    {
                        <span>Bạn chưa có đơn đặt chỗ nào trong tài khoản hoặc phiên trình duyệt này.</span>
                    }
                    else
                    {
                        <span>Không có chuyến xe nào phù hợp với bộ lọc "@(activeFilter switch { "upcoming" => "Sắp khởi hành", "completed" => "Đã hoàn thành", _ => "Đã hủy" })".</span>
                    }
                </p>
                <div>
                    <a href="/search-trips" class="tg-auth-btn-primary d-inline-flex align-items-center gap-2 text-decoration-none px-4 py-2">
                        <i class="bi bi-bus-front"></i>
                        <span>Tìm & Đặt vé xe khách</span>
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-4">
                @foreach (var ticket in filteredTickets)
                {
                    <div class="tg-ticket-boarding-pass">
                        <!-- Top Header -->
                        <div class="tg-ticket-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <span class="badge bg-dark text-white px-3 py-2 rounded-pill font-monospace" style="letter-spacing: 0.05em; font-size: 0.85rem;">
                                    <i class="bi bi-upc-scan me-1 text-warning"></i> @ticket.BookingCode
                                </span>
                                <span class="badge @GetStatusBadgeClass(ticket) rounded-pill px-3 py-2 fw-bold">
                                    @GetStatusLabel(ticket)
                                </span>
                                <span class="badge bg-warning bg-opacity-25 text-dark border border-warning rounded-pill px-2 py-1 small fw-bold">
                                    SANDBOX
                                </span>
                            </div>
                            <div class="text-muted small">
                                <i class="bi bi-clock-history me-1"></i>Đặt lúc: @ticket.BookedAt.ToVietnam().ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>

                        <!-- Sandbox booking summary -->
                        <div class="row g-0">
                            <!-- Main Pass Body (Left 70-75%) -->
                            <div class="col-lg-8 p-3 p-md-4">
                                <!-- Reference route and vehicle data -->
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                                    <span class="badge bg-primary rounded-pill px-3 py-1 fw-bold">
                                        <i class="bi bi-building me-1"></i> @ticket.OperatorName
                                    </span>
                                    <span class="badge bg-light text-dark border rounded-pill px-3 py-1">
                                        <i class="bi bi-bus-front me-1"></i> @ticket.BusTypeName
                                    </span>
                                    <span class="badge bg-light text-secondary border rounded-pill px-2 py-1 font-monospace">
                                        BS: @(string.IsNullOrWhiteSpace(ticket.BusLicensePlate) ? "Chưa có dữ liệu xe" : ticket.BusLicensePlate)
                                    </span>
                                </div>

                                <!-- Route Timeline Visual -->
                                <div class="bg-light p-3 rounded-4 mb-3">
                                    <div class="row align-items-center text-center text-md-start g-2">
                                        <div class="col-md-4">
                                            <div class="text-muted text-uppercase fw-bold" style="font-size: 0.72rem; letter-spacing: 0.05em;">Khởi hành</div>
                                            <div class="fs-3 fw-bold text-primary">@ticket.DepartureTime.ToVietnam().ToString("HH:mm")</div>
                                            <div class="fw-semibold text-dark small">@ticket.DepartureTime.ToVietnam().ToString("ddd, dd/MM/yyyy")</div>
                                            <div class="text-truncate text-secondary small fw-bold mt-1">@GetOriginFromRoute(ticket.RouteName)</div>
                                        </div>

                                        <div class="col-md-4 py-2 py-md-0">
                                            <div class="tg-ticket-timeline">
                                                <div class="tg-ticket-station-dot" title="Điểm xuất phát"></div>
                                                <div class="tg-ticket-route-line">
                                                    <span class="tg-ticket-route-badge">
                                                        <i class="bi bi-bus-front text-primary"></i>
                                                        <span>Lộ trình tham khảo</span>
                                                    </span>
                                                </div>
                                                <div class="tg-ticket-station-dot destination" title="Điểm đến"></div>
                                            </div>
                                            <div class="text-center text-muted small mt-1" style="font-size: 0.75rem;">
                                                <span class="text-muted">Thông tin chuyến thử nghiệm</span>
                                            </div>
                                        </div>

                                        <div class="col-md-4 text-md-end">
                                            <div class="text-muted text-uppercase fw-bold" style="font-size: 0.72rem; letter-spacing: 0.05em;">Điểm đến</div>
                                            <div class="fw-semibold text-dark small">Thời gian đến chưa có dữ liệu</div>
                                            <div class="text-truncate text-secondary small fw-bold mt-1">@GetDestFromRoute(ticket.RouteName)</div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Stops Details -->
                                <div class="row g-3 small mb-3">
                                    <div class="col-md-6">
                                        <div class="p-2 px-3 rounded-3 border bg-white h-100">
                                            <div class="d-flex align-items-start gap-2">
                                                <i class="bi bi-geo-alt-fill text-primary mt-1"></i>
                                                <div>
                                                    <strong class="text-dark d-block">Điểm đón khách:</strong>
                                                    <span class="text-secondary">@ticket.SelectedPickupPoint</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="p-2 px-3 rounded-3 border bg-white h-100">
                                            <div class="d-flex align-items-start gap-2">
                                                <i class="bi bi-geo-alt-fill text-danger mt-1"></i>
                                                <div>
                                                    <strong class="text-dark d-block">Điểm trả khách:</strong>
                                                    <span class="text-secondary">@ticket.SelectedDropoffPoint</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Passenger & Seats -->
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 pt-2 border-top">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="text-muted small">Ghế / Giường:</span>
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var sc in ticket.SeatCodes)
                                            {
                                                <span class="tg-seat-pill-luxury">
                                                    <i class="bi bi-bookmark-check-fill text-primary"></i> @sc
                                                </span>
                                            }
                                        </div>
                                    </div>

                                    <div class="small text-muted">
                                        <span>Khách đặt: <strong>@ticket.Name</strong> (@ticket.Phone)</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Perforated Tear-off Stub (Right 25-30%) -->
                            <div class="col-lg-4 p-3 p-md-4 tg-ticket-perforated bg-light d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <span class="text-muted text-uppercase fw-bold" style="font-size: 0.72rem; letter-spacing: 0.05em;">Thanh toán</span>
                                        <span class="badge @(ticket.PaymentStatus == "Paid" ? "bg-success" : "bg-warning text-dark") rounded-pill px-2 py-1 small">
                                            @(ticket.PaymentStatus == "Paid" ? "Đã thanh toán" : "Chưa thanh toán")
                                        </span>
                                    </div>

                                    <div class="fs-2 fw-bold text-danger mb-1">
                                        @ticket.TotalAmount.ToString("N0") <span class="fs-6 text-muted">đ</span>
                                    </div>

                                    <div class="small text-muted mb-3" style="font-size: 0.8rem;">
                                        @if (!string.IsNullOrWhiteSpace(ticket.PaymentMethod))
                                        {
                                            <div>Phương thức: <strong>@ticket.PaymentMethod</strong></div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(ticket.TransactionCode))
                                        {
                                            <div class="text-truncate" title="@ticket.TransactionCode">Mã GD: <span class="font-monospace">@ticket.TransactionCode</span></div>
                                        }
                                    </div>

                                    <div class="mb-3 d-none d-sm-block">
                                        <div class="text-center font-monospace text-muted" style="font-size: 0.68rem; letter-spacing: 0.1em;">
                                            @ticket.BookingCode
                                        </div>
                                    </div>
                                </div>

                                <!-- Action Buttons -->
                                <div class="d-flex flex-column gap-2 mt-2">
                                    <button type="button" class="btn btn-primary fw-bold rounded-pill shadow-sm py-2 d-flex align-items-center justify-content-center gap-2"
                                            @onclick="() => OpenTicketModal(ticket)">
                                        <i class="bi bi-ticket-perforated"></i>
                                        <span>Xem thông tin đặt chỗ</span>
                                    </button>

                                    <!-- REALTIME MAP BUTTON -->
                                    <button type="button" class="btn btn-outline-primary fw-bold rounded-pill shadow-sm py-2 d-flex align-items-center justify-content-center gap-2"
                                            @onclick="() => OpenRouteMapModal(ticket)">
                                        <i class="bi bi-geo-alt-fill text-danger"></i>
                                        <span>Xem lộ trình & Trạm dừng chân</span>
                                    </button>

                                    @if (CanCancel(ticket))
                                    {
                                        <button type="button" class="btn btn-outline-danger btn-sm rounded-pill py-2 fw-bold d-flex align-items-center justify-content-center gap-1"
                                                @onclick="() => OpenCancelModal(ticket)">
                                            <i class="bi bi-x-circle me-1"></i>
                                            <span>@(ticket.BookingStatus == "Confirmed" ? "Hủy vé (Hoàn 50% tiền)" : "Hủy đặt chỗ")</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

<!-- TASK 6: TICKET DETAILS & DIGITAL BOARDING PASS MODAL -->
@if (selectedDetailTicket != null)
{
    <div class="tg-modal-backdrop" @onclick="CloseTicketModal">
        <div class="tg-modal-dialog tg-printable-ticket" role="dialog" aria-modal="true" aria-label="Chi tiết đơn @selectedDetailTicket.BookingCode" @onclick:stopPropagation="true">
            <!-- Modal Header / Airline & Bus Boarding Pass Top -->
            <div class="tg-boarding-pass-head d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="d-flex align-items-center gap-2">
                    <div class="tg-hero-logo-box" style="width: 36px; height: 36px;">
                        <svg viewBox="0 0 36 36" fill="none" style="width: 24px; height: 24px;" xmlns="http://www.w3.org/2000/svg">
                            <rect width="36" height="36" rx="9" fill="#FFCA28" />
                            <path d="M9 11C9 8.79086 10.7909 7 13 7H23C25.2091 7 27 8.79086 27 11V22C27 24.2091 25.2091 26 23 26H13C10.7909 26 9 24.2091 9 22V11Z" fill="#071F49" />
                            <rect x="11" y="9.5" width="14" height="6.5" rx="2" fill="white" />
                            <circle cx="13.5" cy="21.5" r="2" fill="#FFCA28" />
                            <circle cx="22.5" cy="21.5" r="2" fill="#FFCA28" />
                        </svg>
                    </div>
                    <div>
                        <div class="fw-bold fs-5 text-white">THÔNG TIN ĐẶT CHỖ</div>
                        <div class="text-white-50" style="font-size: 0.72rem; letter-spacing: 0.08em;">SANDBOX BOOKING DETAILS — TRIPGO</div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge @GetStatusBadgeClass(selectedDetailTicket) px-3 py-2 rounded-pill fw-bold">
                        @GetStatusLabel(selectedDetailTicket)
                    </span>
                    <button type="button" class="btn-close btn-close-white ms-2" @onclick="CloseTicketModal" aria-label="Đóng cửa sổ chi tiết vé"></button>
                </div>
            </div>

            <!-- Modal Content -->
            <div class="p-4">
                <!-- Sandbox booking reference -->
                <div class="text-center p-4 bg-light rounded-4 mb-4 border">
                    <div class="tg-ticket-reference-icon mb-3" aria-hidden="true">
                        <i class="bi bi-ticket-perforated-fill"></i>
                    </div>

                    <div class="text-muted small fw-semibold text-uppercase mb-1">Mã đặt chỗ sandbox</div>
                    <div class="fs-4 fw-bold font-monospace text-dark mb-1">
                        @selectedDetailTicket.BookingCode
                    </div>
                    <div class="p-2 px-3 bg-white rounded-3 border small text-muted mb-3 mx-auto" style="max-width: 540px;">
                        <i class="bi bi-shield-exclamation text-warning me-1"></i>
                        <span>Đây là mã đặt chỗ của môi trường thử nghiệm, không phải mã QR lên xe hoặc vé xe khách thương mại.</span>
                    </div>
                    <div class="d-flex justify-content-center gap-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3"
                                aria-label="Sao chép mã đặt chỗ"
                                @onclick="() => CopyBookingCode(selectedDetailTicket.BookingCode)">
                            <i class="bi @(isCopied ? "bi-check2 text-success" : "bi-clipboard") me-1"></i>
                            <span>@(isCopied ? "Đã sao chép!" : "Sao chép mã vé")</span>
                        </button>
                    </div>
                </div>

                <div class="alert alert-warning py-2 px-3 small rounded-3 mb-4 d-flex align-items-center gap-2">
                    <i class="bi bi-cpu text-dark fs-5 flex-shrink-0"></i>
                    <div>
                        <strong>CHUYẾN XE MÔ PHỎNG — SANDBOX:</strong> Thẻ lên xe điện tử và thanh toán mô phỏng phục vụ kiểm thử kỹ thuật, không phát sinh giao dịch tiền tệ thực tế.
                    </div>
                </div>

                <!-- Route & Timing Summary -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="p-3 rounded-3 bg-light border">
                            <div class="text-muted small fw-bold text-uppercase">Tuyến đường & Nhà xe</div>
                            <div class="fw-bold text-dark fs-6 mt-1">@selectedDetailTicket.RouteName</div>
                            <div class="text-primary small fw-semibold">@selectedDetailTicket.OperatorName · @selectedDetailTicket.BusTypeName</div>
                            <div class="small text-secondary font-monospace mt-1">Biển số: @(string.IsNullOrWhiteSpace(selectedDetailTicket.BusLicensePlate) ? "Đang điều phối" : selectedDetailTicket.BusLicensePlate)</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 rounded-3 bg-light border">
                            <div class="text-muted small fw-bold text-uppercase">Thời gian khởi hành</div>
                            <div class="fw-bold text-primary fs-5 mt-1">@selectedDetailTicket.DepartureTime.ToVietnam().ToString("HH:mm - dddd, dd/MM/yyyy")</div>
                            <div class="small text-muted mt-1">
                                <i class="bi bi-exclamation-circle text-warning me-1"></i>
                                Quý khách vui lòng có mặt tại điểm đón trước <strong>30 phút</strong>.
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Pickup & Dropoff -->
                <div class="card p-3 rounded-3 border mb-4">
                    <div class="d-flex flex-column gap-3">
                        <div class="d-flex align-items-start gap-2">
                            <i class="bi bi-geo-alt-fill text-primary mt-1"></i>
                            <div>
                                <strong class="text-dark d-block">Điểm đón khách:</strong>
                                <span class="text-secondary small">@selectedDetailTicket.SelectedPickupPoint</span>
                            </div>
                        </div>
                        <div class="d-flex align-items-start gap-2">
                            <i class="bi bi-geo-alt-fill text-danger mt-1"></i>
                            <div>
                                <strong class="text-dark d-block">Điểm trả khách:</strong>
                                <span class="text-secondary small">@selectedDetailTicket.SelectedDropoffPoint</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Passenger Manifest -->
                <div class="mb-4">
                    <h6 class="fw-bold text-dark mb-2">Danh sách hành khách & Chỗ ngồi</h6>
                    <div class="table-responsive border rounded-3 overflow-hidden">
                        <table class="table table-sm table-striped mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th>Số ghế</th>
                                    <th>Họ và tên</th>
                                    <th>Số điện thoại</th>
                                    <th>Vai trò</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (selectedDetailTicket.Passengers != null && selectedDetailTicket.Passengers.Count > 0)
                                {
                                    @foreach (var p in selectedDetailTicket.Passengers)
                                    {
                                        <tr>
                                            <td><span class="badge bg-primary font-monospace">@(p.SeatCode ?? "Ghế đặt")</span></td>
                                            <td class="fw-bold text-dark">@p.FullName</td>
                                            <td>@p.PhoneNumber</td>
                                            <td>@(p.IsPrimaryContact ? "Người liên hệ chính" : "Hành khách đi cùng")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td>
                                            @foreach (var sc in selectedDetailTicket.SeatCodes)
                                            {
                                                <span class="badge bg-primary font-monospace me-1">@sc</span>
                                            }
                                        </td>
                                        <td class="fw-bold text-dark">@selectedDetailTicket.Name</td>
                                        <td>@selectedDetailTicket.Phone</td>
                                        <td>Người đặt vé</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Financial Breakdown -->
                <div class="p-3 bg-light rounded-3 border mb-4">
                    <h6 class="fw-bold text-dark mb-3">Chi tiết thanh toán</h6>
                    <div class="d-flex flex-column gap-2 small">
                        <div class="d-flex justify-content-between">
                            <span class="text-secondary">Giá vé gốc (@selectedDetailTicket.SeatCodes.Count chỗ):</span>
                            <span class="fw-semibold">@selectedDetailTicket.BasePrice.ToString("N0") đ</span>
                        </div>
                        @if (selectedDetailTicket.SurchargeAmount > 0)
                        {
                            <div class="d-flex justify-content-between">
                                <span class="text-secondary">Phụ phí / Giường VIP:</span>
                                <span class="fw-semibold">+@selectedDetailTicket.SurchargeAmount.ToString("N0") đ</span>
                            </div>
                        }
                        @if (selectedDetailTicket.InsuranceAmount > 0)
                        {
                            <div class="d-flex justify-content-between">
                                <span class="text-secondary">Bảo hiểm hành khách:</span>
                                <span class="fw-semibold">+@selectedDetailTicket.InsuranceAmount.ToString("N0") đ</span>
                            </div>
                        }
                        <hr class="my-1" />
                        <div class="d-flex justify-content-between align-items-center">
                            <strong class="text-dark fs-6">Tổng tiền thanh toán:</strong>
                            <strong class="text-danger fs-5">@selectedDetailTicket.TotalAmount.ToString("N0") đ</strong>
                        </div>
                    </div>

                    <div class="mt-3 pt-2 border-top small text-muted">
                        <div>Phương thức thanh toán: <strong>@(selectedDetailTicket.PaymentMethod ?? "Sandbox Test Payment")</strong></div>
                        @if (!string.IsNullOrWhiteSpace(selectedDetailTicket.TransactionCode))
                        {
                            <div>Mã giao dịch xác nhận: <strong class="font-monospace">@selectedDetailTicket.TransactionCode</strong></div>
                        }
                    </div>
                </div>

                @if (CanPay(selectedDetailTicket))
                {
                    <div class="p-3 border rounded-3 bg-light mb-3 d-print-none">
                        <div class="fw-bold text-dark mb-1"><i class="bi bi-wallet2 text-primary me-1" aria-hidden="true"></i> Tiếp tục thanh toán (mô phỏng Sandbox)</div>
                        <p class="small text-muted mb-2">Đơn được giữ đến @selectedDetailTicket.ExpiresAt.ToVietnam().ToString("HH:mm dd/MM/yyyy"). Không phát sinh giao dịch tiền thật.</p>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-success btn-sm fw-bold" disabled="@(isPaying || !sandboxPaymentAvailable)" @onclick="() => PayAsync(selectedDetailTicket, true)">
                                @(isPaying ? "Đang xử lý..." : $"Thanh toán mô phỏng {selectedDetailTicket.TotalAmount:N0} đ")
                            </button>
                            <button type="button" class="btn btn-outline-danger btn-sm" disabled="@(isPaying || !sandboxPaymentAvailable)" @onclick="() => PayAsync(selectedDetailTicket, false)">
                                Mô phỏng thanh toán thất bại
                            </button>
                        </div>
                    </div>
                }
                else if (HasPendingPayment(selectedDetailTicket) && !selectedDetailTicket.IsDemoBooking)
                {
                    <div class="alert alert-warning small mb-3">
                        Chưa có cổng thanh toán thương mại được cấu hình cho đơn này. Không thể xác nhận thanh toán thực tế từ giao diện sandbox.
                    </div>
                }
                else if (HasPendingPayment(selectedDetailTicket) && !sandboxPaymentAvailable)
                {
                    <div class="alert alert-warning small mb-3">
                        Cổng thanh toán sandbox chưa được bật trong môi trường này; đơn vẫn chưa được thanh toán.
                    </div>
                }

                @if (selectedDetailTicket.BookingStatus is "Confirmed" && selectedDetailTicket.PaymentStatus == "Paid")
                {
                    <TicketQr BookingCode="@selectedDetailTicket.BookingCode" />
                }

                <!-- Modal Actions -->
                <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center d-print-none">
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-outline-primary rounded-pill px-3 fw-bold" @onclick="PrintBoardingPass">
                            <i class="bi bi-printer me-1"></i> In vé / Lưu PDF
                        </button>
                        <a href="@GetReturnTripUrl(selectedDetailTicket)" class="btn btn-warning rounded-pill px-3 fw-bold text-dark shadow-sm">
                            <i class="bi bi-arrow-left-right me-1"></i> Đặt chiều về
                        </a>
                        <button type="button" class="btn btn-outline-primary rounded-pill px-3 fw-bold" @onclick="() => OpenRouteMapModal(selectedDetailTicket)">
                            <i class="bi bi-map-fill me-1 text-danger"></i> Xem bản đồ lộ trình (Realtime)
                        </button>
                    </div>
                    <div class="d-flex gap-2">
                        @if (CanCancel(selectedDetailTicket))
                        {
                            <button type="button" class="btn btn-outline-danger rounded-pill px-3 fw-bold" @onclick="() => OpenCancelModal(selectedDetailTicket)">
                                <i class="bi bi-x-circle me-1"></i> @(selectedDetailTicket.BookingStatus == "Confirmed" ? "Hủy vé (Hoàn 50%)" : "Hủy đặt chỗ")
                            </button>
                        }
                        <button type="button" class="btn btn-secondary rounded-pill px-4 fw-bold" @onclick="CloseTicketModal">
                            Đóng
                        </button>
                    </div>
                </div>
                <div style="display: none;">
                    <button type="button" class="btn btn-outline-primary rounded-pill px-4 fw-bold" @onclick="PrintBoardingPass">
                        <i class="bi bi-printer me-1"></i> In vé / Lưu PDF
                    </button>
                    <button type="button" class="btn btn-secondary rounded-pill px-4" @onclick="CloseTicketModal">
                        Đóng
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- CANCELLATION CONFIRMATION MODAL WITH 50% REFUND BREAKDOWN -->
@if (showCancelModal && ticketToCancel != null)
{
    <div class="tg-modal-backdrop" @onclick="CloseCancelModal">
        <div class="tg-modal-dialog" style="max-width: 580px;" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden bg-white">
                <div class="modal-header bg-danger text-white py-3 px-4 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-octagon-fill fs-4"></i>
                        <h5 class="modal-title fw-bold mb-0">Xác nhận hủy đơn đặt vé</h5>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseCancelModal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <!-- Ticket Info Card -->
                    <div class="bg-light p-3 rounded-3 mb-3 border">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small">Mã đơn đặt chỗ:</span>
                            <span class="fw-bold font-monospace text-primary">@ticketToCancel.BookingCode</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small">Chuyến xe:</span>
                            <span class="fw-bold text-dark">@ticketToCancel.RouteName</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small">Nhà xe & Vị trí:</span>
                            <span><strong>@ticketToCancel.OperatorName</strong> (Ghế: @string.Join(", ", ticketToCancel.SeatCodes))</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted small">Giờ khởi hành:</span>
                            <span class="text-danger fw-bold">@ticketToCancel.DepartureTime.ToVietnam().ToString("HH:mm - dd/MM/yyyy")</span>
                        </div>
                    </div>

                    @if (ticketToCancel.BookingStatus == "Confirmed" && ticketToCancel.PaymentStatus == "Paid")
                    {
                        <!-- Paid Booking: 50% Refund Policy Breakdown -->
                        <div class="card border-warning bg-warning-subtle rounded-3 p-3 mb-3">
                            <div class="d-flex align-items-center gap-2 text-warning-emphasis fw-bold mb-2">
                                <i class="bi bi-shield-exclamation fs-5"></i>
                                <span>Chính sách hủy vé & hoàn 50% tiền</span>
                            </div>
                            <div class="small text-muted mb-3">
                                Theo chính sách của nhà xe và quy chế TripGo, vé hủy trước giờ xuất bến sẽ được hoàn trả <strong>50% giá trị đã thanh toán</strong>, 50% còn lại là phí giữ chỗ và hủy vé.
                            </div>
                            <div class="bg-white p-3 rounded-3 border">
                                <div class="d-flex justify-content-between py-1 border-bottom">
                                    <span class="text-muted">Tổng tiền đã thanh toán:</span>
                                    <span class="fw-bold">@ticketToCancel.TotalAmount.ToString("N0") đ</span>
                                </div>
                                <div class="d-flex justify-content-between py-1 border-bottom text-danger">
                                    <span>Phí hủy vé theo quy chế (50%):</span>
                                    <span class="fw-bold">-@GetCancellationFee(ticketToCancel).ToString("N0") đ</span>
                                </div>
                                <div class="d-flex justify-content-between pt-2 fs-5">
                                    <span class="fw-bold text-success">Số tiền thực tế hoàn lại (50%):</span>
                                    <span class="fw-bolder text-success">@GetRefundAmount(ticketToCancel).ToString("N0") đ</span>
                                </div>
                            </div>
                            <div class="small text-muted mt-2">
                                <i class="bi bi-info-circle me-1"></i> Số tiền hoàn sẽ được chuyển về tài khoản thanh toán ban đầu của quý khách trong vòng 24 - 48 giờ làm việc.
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Unpaid Pending Booking -->
                        <div class="card border-info bg-info-subtle rounded-3 p-3 mb-3">
                            <div class="d-flex align-items-center gap-2 text-info-emphasis fw-bold mb-1">
                                <i class="bi bi-info-circle fs-5"></i>
                                <span>Hủy đơn chưa thanh toán</span>
                            </div>
                            <div class="small text-muted">
                                Đơn này chưa thanh toán nên sẽ được hủy miễn phí hoàn toàn. Ghế giữ chỗ sẽ được giải phóng ngay lập tức để người khác có thể đặt.
                            </div>
                        </div>
                    }

                    <div class="alert alert-secondary small rounded-3 mb-0">
                        <i class="bi bi-exclamation-triangle me-1"></i> Sau khi xác nhận hủy, vé của bạn sẽ không còn giá trị để lên xe. Thao tác này không thể hoàn tác.
                    </div>
                </div>
                <div class="modal-footer bg-light px-4 py-3 d-flex justify-content-between">
                    <button type="button" class="btn btn-secondary rounded-pill px-4 fw-bold" @onclick="CloseCancelModal" disabled="@isCancelling">
                        Giữ lại đơn đặt vé
                    </button>
                    <button type="button" class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm d-flex align-items-center gap-2"
                            @onclick="() => ExecuteCancelConfirmedAsync(ticketToCancel)" disabled="@isCancelling">
                        @if (isCancelling)
                        {
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                            <span>Đang xử lý hủy...</span>
                        }
                        else
                        {
                            <i class="bi bi-check-circle-fill"></i>
                            <span>@(ticketToCancel.BookingStatus == "Confirmed" ? "Xác nhận hủy đơn (Hoàn 50%)" : "Xác nhận hủy đơn")</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ROAD ROUTE MAP MODAL (OPENSTREETMAP + REAL ROAD ROUTING) -->
@if (showMapModal && currentRouteMap != null)
{
    <div class="tg-modal-backdrop" @onclick="CloseMapModal">
        <div class="tg-modal-dialog modal-xl" style="max-width: 1100px; width: 95%;" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <div class="modal-content border-0 rounded-4 shadow-2xl overflow-hidden bg-white">
                <!-- Modal Header -->
                <div class="modal-header bg-dark text-white py-3 px-4 d-flex justify-content-between align-items-center border-bottom border-secondary">
                    <div class="d-flex align-items-center gap-3">
                        <div style="background:#2563eb;color:white;width:40px;height:40px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:20px;box-shadow:0 0 12px rgba(37,99,235,0.6);">
                            <i class="bi bi-map-fill"></i>
                        </div>
                        <div>
                            <div class="fw-bold fs-5 text-white d-flex align-items-center gap-2">
                                <span>Lộ trình đường bộ: @currentRouteMap.RouteName</span>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 rounded-pill" style="font-size: 0.75rem;">
                                    BẢN ĐỒ ĐƯỜNG BỘ
                                </span>
                            </div>
                            <div class="text-white-50 small">
                                Nhà xe: <strong class="text-white">@currentRouteMap.OperatorName</strong> &bull; Biển số: <span class="badge bg-warning text-dark font-monospace fw-bold">@currentRouteMap.BusLicensePlate</span> &bull; Cự ly: @currentRouteMap.DistanceKm km
                            </div>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseMapModal" aria-label="Đóng cửa sổ bản đồ"></button>
                </div>

                <!-- Journey Duration & Endpoints Breakdown -->
                <div class="bg-light px-4 py-3 border-bottom">
                    <div class="row g-2 align-items-center">
                        <div class="col-md-4">
                            <div class="p-2 px-3 bg-white rounded-3 border">
                                <small class="text-success fw-bold d-block"><i class="bi bi-box-arrow-in-right me-1"></i>ĐIỂM ĐÓN ĐÃ CHỌN</small>
                                <strong class="text-dark d-block text-truncate" title="@currentRouteMap.SelectedPickupPoint.Name">@currentRouteMap.SelectedPickupPoint.Name</strong>
                                <span class="text-muted small">@currentRouteMap.SelectedPickupPoint.ScheduledTime</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-2 px-3 bg-white rounded-3 border">
                                <small class="text-danger fw-bold d-block"><i class="bi bi-flag-fill me-1"></i>ĐIỂM TRẢ ĐÃ CHỌN</small>
                                <strong class="text-dark d-block text-truncate" title="@currentRouteMap.SelectedDropoffPoint.Name">@currentRouteMap.SelectedDropoffPoint.Name</strong>
                                <span class="text-muted small">@currentRouteMap.SelectedDropoffPoint.ScheduledTime</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-2 px-3 bg-white rounded-3 border">
                                <small class="text-primary fw-bold d-block"><i class="bi bi-clock-history me-1"></i>THỜI GIAN HÀNH TRÌNH DỰ KIẾN</small>
                                <strong class="text-dark d-block">@currentRouteMap.DurationSummary</strong>
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    @if (!string.IsNullOrWhiteSpace(currentRouteMap.RoadEstimatedDurationText))
                                    {
                                        <span class="badge bg-light text-secondary border" style="font-size:0.7rem;">@currentRouteMap.RoadEstimatedDurationText</span>
                                    }
                                    @if (currentRouteMap.RestStopDurationMinutes > 0)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border" style="font-size:0.7rem;">@currentRouteMap.RestStopDurationMinutes phút nghỉ</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="small text-muted mt-2">
                        <i class="bi bi-info-circle me-1"></i>@currentRouteMap.DurationNotice
                    </div>
                </div>

                <!-- Modal Body: Map + Stops List Grid -->
                <div class="p-0">
                    <div class="row g-0">
                        <!-- Main Map Canvas -->
                        <div class="col-lg-8 border-end position-relative" style="min-height: 520px;">
                            <div id="tripgo-route-map-container" style="height: 520px; width: 100%;"></div>

                            @if (!currentRouteMap.IsRouteFound)
                            {
                                <div class="position-absolute top-50 start-50 translate-middle w-75 p-3 bg-white border border-warning rounded-3 shadow text-center" style="z-index: 550;">
                                    <i class="bi bi-exclamation-triangle-fill text-warning fs-3 d-block mb-2"></i>
                                    <h6 class="fw-bold text-dark">Chưa thể tải dữ liệu lộ trình đường bộ chi tiết</h6>
                                    <p class="small text-muted mb-0">@(currentRouteMap.ErrorMessage ?? "Không thể kết nối đến máy chủ định tuyến đường bộ OSRM.")</p>
                                </div>
                            }

                            <!-- Map Overlay Controls & Legend -->
                            <div class="position-absolute bottom-0 start-0 m-3 bg-white p-2 px-3 rounded-4 shadow-sm border small d-flex flex-wrap align-items-center gap-3" style="z-index: 500;">
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill py-1 px-2 fw-semibold" onclick="tripgoMap.fitRoute()">
                                    <i class="bi bi-arrows-fullscreen me-1"></i> Toàn tuyến
                                </button>
                                <div class="d-flex align-items-center gap-1">
                                    <span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:#16a34a;"></span>
                                    <span>Điểm đón</span>
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    <span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:#f59e0b;"></span>
                                    <span>Trạm dừng nghỉ</span>
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    <span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:#dc2626;"></span>
                                    <span>Điểm trả</span>
                                </div>
                            </div>
                        </div>

                        <!-- Right Panel: Stop Details & Amenities -->
                        <div class="col-lg-4 p-3 bg-light overflow-y-auto" style="max-height: 520px;">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                                    <i class="bi bi-cup-hot-fill text-warning"></i>
                                    <span>Trạm dừng nghỉ chân (@currentRouteMap.RestStops.Count)</span>
                                </h6>
                            </div>

                            @if (currentRouteMap.HasVerifiedRestStops)
                            {
                                <div class="d-flex flex-column gap-3">
                                    @foreach (var pt in currentRouteMap.RestStops)
                                    {
                                        <div class="card border rounded-3 p-3 shadow-sm bg-white position-relative">
                                            <div class="d-flex justify-content-between align-items-start mb-1">
                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill">
                                                    <i class="bi bi-cup-hot-fill me-1"></i> Dừng nghỉ @(pt.StayMinutes ?? 20) phút
                                                </span>
                                                <span class="font-monospace fw-bold text-dark small">@pt.ScheduledTime</span>
                                            </div>

                                            <div class="fw-bold text-dark fs-6 mt-1 mb-1">@pt.Name</div>
                                            <div class="small text-muted mb-2"><i class="bi bi-geo-alt me-1"></i>@pt.Address</div>

                                            <div class="small text-success bg-success-subtle p-1 px-2 rounded-2 mb-2 border border-success-subtle d-inline-block">
                                                <i class="bi bi-shield-check me-1"></i>@pt.VerificationStatus
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(pt.Services))
                                            {
                                                <div class="small bg-light p-2 rounded-2 text-secondary mb-2 border">
                                                    <strong>Tiện ích:</strong> @pt.Services
                                                </div>
                                            }

                                            <button type="button" class="btn btn-outline-primary btn-sm rounded-pill py-1 mt-1"
                                                    onclick="tripgoMap.focusPoint(@pt.Latitude, @pt.Longitude, '@pt.Name', 'stop_@pt.Id')">
                                                <i class="bi bi-crosshair me-1"></i> Xem vị trí này trên bản đồ
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="p-4 text-center bg-white rounded-3 border text-muted small">
                                    <i class="bi bi-signpost-split fs-2 text-secondary d-block mb-2"></i>
                                    <strong>Chưa có dữ liệu trạm dừng nghỉ xác thực</strong>
                                    <p class="text-muted mt-1 mb-0">Trên chặng đường này chưa ghi nhận trạm dừng chân đối tác chính thức. Nhà xe sẽ bố trí điểm dừng nghỉ theo quy trình vận hành thực tế.</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="modal-footer bg-light px-4 py-3 d-flex justify-content-between align-items-center">
                    <div class="text-muted small">
                        <i class="bi bi-info-circle me-1 text-primary"></i> Lộ trình thực tế được mô phỏng theo dữ liệu đường bộ OpenStreetMap &amp; OSRM.
                    </div>
                    <button type="button" class="btn btn-secondary rounded-pill px-4 fw-bold" @onclick="CloseMapModal">
                        Đóng bản đồ
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    @@media (min-width: 992px) {
        .border-start-lg {
            border-left: 1px solid var(--tg-border);
        }
    }
</style>

@code {
    [SupplyParameterFromQuery(Name = "code")]
    public string? QueryCode { get; set; }

    [SupplyParameterFromQuery(Name = "phone")]
    public string? QueryPhone { get; set; }
    [SupplyParameterFromQuery(Name = "action")]
    public string? QueryAction { get; set; }

    private bool isLoading = true;
    private bool isSearchingManual = false;
    private bool isCancelling = false;
    private bool showLookupBox = false;
    private bool isCopied = false;

    private string activeFilter = "all";
    private string manualLookupQuery = string.Empty;
    private long? confirmingCancelId;

    private string? actionAlertMessage;
    private bool actionAlertIsError = false;

    private List<CustomerBookingInfoDto> allTickets = new();
    private List<CustomerBookingInfoDto> filteredTickets = new();
    private CustomerBookingInfoDto? selectedDetailTicket;

    private int upcomingCount = 0;
    private int completedCount = 0;
    private int cancelledCount = 0;
    private bool sandboxPaymentAvailable;

    private string GetLoginUrl()
    {
        var relativeUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        return string.IsNullOrWhiteSpace(relativeUrl) ? "/login" : $"/login?ReturnUrl=/{relativeUrl}";
    }

    protected override async Task OnInitializedAsync()
    {
        sandboxPaymentAvailable = PaymentGatewayService.GetProviders().Any(provider => provider.IsSandbox);
        await LoadTicketsAsync();

        if (!string.IsNullOrWhiteSpace(QueryCode) || !string.IsNullOrWhiteSpace(QueryPhone))
        {
            showLookupBox = true;
            manualLookupQuery = QueryCode ?? QueryPhone ?? string.Empty;
            await ExecuteManualLookup();
        }
    }

    private async Task LoadTicketsAsync()
    {
        isLoading = true;
        try
        {
            allTickets = await TripService.GetBookingsForCurrentUserAsync();
            ApplyFilter();

            if (!string.IsNullOrWhiteSpace(QueryCode))
            {
                var match = allTickets.FirstOrDefault(t => string.Equals(t.BookingCode, QueryCode.Trim(), StringComparison.OrdinalIgnoreCase));
                if (match != null)
                {
                    selectedDetailTicket = match;
                }
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not load booking summaries for the current session.");
            actionAlertMessage = "Không thể tải danh sách vé lúc này. Vui lòng thử lại sau.";
            actionAlertIsError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SetFilter(string filter)
    {
        activeFilter = filter;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var now = DateTimeOffset.UtcNow;

        upcomingCount = allTickets.Count(t =>
            t.DepartureTime > now &&
            t.BookingStatus != "Cancelled" &&
            t.BookingStatus != "Expired");

        completedCount = allTickets.Count(t =>
            t.DepartureTime <= now &&
            t.BookingStatus != "Cancelled" &&
            t.BookingStatus != "Expired");

        cancelledCount = allTickets.Count(t =>
            t.BookingStatus == "Cancelled" ||
            t.BookingStatus == "Expired");

        filteredTickets = activeFilter switch
        {
            "upcoming" => allTickets.Where(t => t.DepartureTime > now && t.BookingStatus != "Cancelled" && t.BookingStatus != "Expired").ToList(),
            "completed" => allTickets.Where(t => t.DepartureTime <= now && t.BookingStatus != "Cancelled" && t.BookingStatus != "Expired").ToList(),
            "cancelled" => allTickets.Where(t => t.BookingStatus == "Cancelled" || t.BookingStatus == "Expired").ToList(),
            _ => allTickets.ToList()
        };
    }

    private async Task HandleLookupKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await ExecuteManualLookup();
        }
    }

    private async Task ExecuteManualLookup()
    {
        if (string.IsNullOrWhiteSpace(manualLookupQuery))
        {
            actionAlertMessage = "Vui lòng nhập mã đặt chỗ hoặc số điện thoại để tra cứu.";
            actionAlertIsError = true;
            return;
        }

        isSearchingManual = true;
        actionAlertMessage = null;

        try
        {
            var query = manualLookupQuery.Trim();
            if (query.StartsWith("TRIPGO-", StringComparison.OrdinalIgnoreCase))
            {
                var found = await TripService.GetBookingByCodeAsync(query);
                if (found != null)
                {
                    if (!allTickets.Any(t => t.BookingId == found.BookingId))
                    {
                        allTickets.Insert(0, found);
                    }
                    selectedDetailTicket = found;
                    if (string.Equals(QueryAction, "cancel", StringComparison.OrdinalIgnoreCase))
                    {
                        if (CanCancel(found))
                        {
                            OpenCancelModal(found);
                        }
                        else
                        {
                            actionAlertMessage = $"Đơn đặt chỗ {found.BookingCode} không đủ điều kiện hủy trực tuyến lúc này (chuyến xe đã hoàn tất hoặc đã hủy trước đó). Vui lòng liên hệ tổng đài 1900 888684.";
                            actionAlertIsError = true;
                        }
                    }
                    else
                    {
                        selectedDetailTicket = found;
                        actionAlertMessage = $"Đã tìm thấy thông tin đơn đặt chỗ {found.BookingCode}.";
                        actionAlertIsError = false;
                    }
                }
                else
                {
                    var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                    var isAuthenticated = authState.User?.Identity?.IsAuthenticated == true &&
                                         authState.User.HasClaim(c => c.Type == ClaimTypes.NameIdentifier);
                    var isAdmin = authState.User?.IsInRole("Admin") == true;
                    if (isAdmin)
                    {
                        actionAlertMessage = "Tài khoản Quản trị viên hiện tại không thể xem vé ở chế độ Khách hàng. Vui lòng bấm 'Đổi tài khoản khác' bên trên.";
                    }
                    else if (!isAuthenticated)
                    {
                        actionAlertMessage = $"Đơn đặt chỗ {query} được liên kết với tài khoản thành viên. Quý khách vui lòng đăng nhập bằng tài khoản đã đặt vé để xem và quản lý đơn đặt chỗ này.";
                    }
                    else
                    {
                        actionAlertMessage = "Không tìm thấy vé phù hợp hoặc bạn không có quyền xem vé này.";
                    }
                    actionAlertIsError = true;
                }
            }
            else
            {
                var list = await TripService.GetBookingsByPhoneAsync(query);
                if (list.Count > 0)
                {
                    foreach (var item in list)
                    {
                        if (!allTickets.Any(t => t.BookingId == item.BookingId))
                        {
                            allTickets.Add(item);
                        }
                    }
                    actionAlertMessage = $"Đã tìm thấy {list.Count} vé phù hợp.";
                    actionAlertIsError = false;
                }
                else
                {
                    actionAlertMessage = "Không tìm thấy vé phù hợp với số điện thoại trong phiên hiện tại.";
                    actionAlertIsError = true;
                }
            }

            ApplyFilter();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Booking lookup failed for the current session.");
            actionAlertMessage = "Không thể tra cứu đơn đặt chỗ lúc này. Vui lòng thử lại sau.";
            actionAlertIsError = true;
        }
        finally
        {
            isSearchingManual = false;
        }
    }

    private void OpenTicketModal(CustomerBookingInfoDto ticket)
    {
        selectedDetailTicket = ticket;
        isCopied = false;
    }

    private void CloseTicketModal()
    {
        selectedDetailTicket = null;
        isCopied = false;
    }

    private async Task CopyBookingCode(string code)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", code);
            isCopied = true;
        }
        catch
        {
            isCopied = false;
        }
    }

    private async Task PrintBoardingPass()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("window.print");
        }
        catch { }
    }

    private static string GetOriginFromRoute(string routeName)
    {
        var parts = routeName.Split(new[] { '-', '→', '–' }, StringSplitOptions.TrimEntries);
        return parts.Length > 0 ? parts[0] : routeName;
    }

    private static string GetDestFromRoute(string routeName)
    {
        var parts = routeName.Split(new[] { '-', '→', '–' }, StringSplitOptions.TrimEntries);
        return parts.Length > 1 ? parts[1] : routeName;
    }

    private static string GetReturnTripUrl(CustomerBookingInfoDto ticket)
    {
        var origin = GetOriginFromRoute(ticket.RouteName);
        var dest = GetDestFromRoute(ticket.RouteName);
        return $"/search-trips?origin={Uri.EscapeDataString(dest)}&dest={Uri.EscapeDataString(origin)}";
    }

    private static bool CanCancel(CustomerBookingInfoDto ticket)
    {
        if (ticket.BookingStatus == "PendingPayment" && ticket.PaymentStatus is "Unpaid" or "Failed")
            return true;

        if (ticket.BookingStatus == "Confirmed" && ticket.PaymentStatus == "Paid")
            return ticket.DepartureTime > DateTimeOffset.UtcNow;

        return false;
    }

    private static decimal GetRefundAmount(CustomerBookingInfoDto ticket) =>
        (ticket.BookingStatus == "Confirmed" && ticket.PaymentStatus == "Paid")
            ? Math.Round(ticket.TotalAmount * 0.5m, 0)
            : 0m;

    private static decimal GetCancellationFee(CustomerBookingInfoDto ticket) =>
        (ticket.BookingStatus == "Confirmed" && ticket.PaymentStatus == "Paid")
            ? ticket.TotalAmount - GetRefundAmount(ticket)
            : 0m;

    private CustomerBookingInfoDto? ticketToCancel;
    private bool showCancelModal = false;

    private void OpenCancelModal(CustomerBookingInfoDto ticket)
    {
        ticketToCancel = ticket;
        showCancelModal = true;
    }

    private void CloseCancelModal()
    {
        ticketToCancel = null;
        showCancelModal = false;
    }

    private async Task ExecuteCancelConfirmedAsync(CustomerBookingInfoDto ticket)
    {
        if (isCancelling) return;
        isCancelling = true;
        actionAlertMessage = null;

        try
        {
            var wasPaid = ticket.BookingStatus == "Confirmed" && ticket.PaymentStatus == "Paid";
            var refundAmount = wasPaid ? GetRefundAmount(ticket) : 0m;
            var feeAmount = wasPaid ? GetCancellationFee(ticket) : 0m;
            var reason = wasPaid
                ? $"Khách hàng tự hủy trên web. Hoàn 50% ({refundAmount:N0} đ), phí hủy 50% ({feeAmount:N0} đ)."
                : "Khách hàng tự hủy trên trang Vé của tôi";

            var success = await BookingService.CancelBookingAsync(ticket.BookingId, reason);
            if (success)
            {
                actionAlertIsError = false;
                actionAlertMessage = wasPaid
                    ? $"Đã hủy vé {ticket.BookingCode} thành công. Hệ thống đã xác nhận hoàn 50% số tiền ({refundAmount:N0} đ) cho quý khách trong vòng 24 - 48 giờ làm việc. Ghế đã được hoàn trả lại hệ thống."
                    : $"Đã hủy đặt chỗ {ticket.BookingCode} thành công. Ghế đã được hoàn trả lại hệ thống.";

                showCancelModal = false;
                ticketToCancel = null;
                selectedDetailTicket = null;
                confirmingCancelId = null;
                await LoadTicketsAsync();
            }
            else
            {
                actionAlertIsError = true;
                actionAlertMessage = "Không thể hủy đơn đặt chỗ này (chuyến xe có thể đã hoàn tất hoặc bạn không có quyền thao tác).";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Booking cancellation failed for booking {BookingId}.", ticket.BookingId);
            actionAlertIsError = true;
            actionAlertMessage = "Không thể hủy đơn đặt chỗ lúc này. Vui lòng thử lại sau.";
        }
        finally
        {
            isCancelling = false;
        }
    }

    // REALTIME ROUTE MAP MODAL HANDLERS
    private TripRouteMapDto? currentRouteMap;
    private bool showMapModal = false;
    private bool isLoadingMap = false;

    private async Task OpenRouteMapModal(CustomerBookingInfoDto ticket)
    {
        isLoadingMap = true;
        showMapModal = true;
        currentRouteMap = await TripService.GetTripRouteMapAsync(ticket.TripId, ticket.PickupPointId, ticket.DropoffPointId);
        isLoadingMap = false;
        StateHasChanged();

        if (currentRouteMap != null)
        {
            await Task.Delay(250);
            await JSRuntime.InvokeVoidAsync("tripgoMap.initMap", "tripgo-route-map-container", currentRouteMap);
        }
    }

    private async Task CloseMapModal()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("tripgoMap.destroy");
        }
        catch { }
        showMapModal = false;
        currentRouteMap = null;
    }

    private static bool HasPendingPayment(CustomerBookingInfoDto ticket) =>
        ticket.BookingStatus == "PendingPayment" &&
        ticket.PaymentStatus is "Unpaid" or "Failed" &&
        ticket.ExpiresAt > DateTimeOffset.UtcNow;

    private bool CanPay(CustomerBookingInfoDto ticket) =>
        sandboxPaymentAvailable && ticket.IsDemoBooking && HasPendingPayment(ticket);

    private bool isPaying;

    private async Task PayAsync(CustomerBookingInfoDto ticket, bool simulateSuccess)
    {
        if (isPaying)
        {
            return;
        }

        isPaying = true;
        actionAlertMessage = null;
        try
        {
            var result = await PaymentGatewayService.SimulateSandboxPaymentAsync(ticket.BookingCode, simulateSuccess);
            await LoadTicketsAsync();
            selectedDetailTicket = allTickets.FirstOrDefault(t => t.BookingId == ticket.BookingId)
                ?? await TripService.GetBookingByCodeAsync(ticket.BookingCode);
            var paid = selectedDetailTicket?.BookingStatus == "Confirmed" && selectedDetailTicket.PaymentStatus == "Paid";
            actionAlertIsError = !paid;
            actionAlertMessage = paid
                ? $"Đã thanh toán sandbox đơn {ticket.BookingCode}."
                : $"Thanh toán sandbox chưa được xác nhận: {result.Message}";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Resuming payment failed for booking {BookingId}.", ticket.BookingId);
            actionAlertIsError = true;
            actionAlertMessage = "Không thể xử lý thanh toán lúc này. Vui lòng thử lại.";
        }
        finally
        {
            isPaying = false;
        }
    }

    private static string GetStatusBadgeClass(CustomerBookingInfoDto ticket)
    {
        if (ticket.BookingStatus == "PendingPayment") return "bg-warning text-dark";
        if (ticket.BookingStatus == "Confirmed" && ticket.PaymentStatus == "Paid") return "bg-success text-white";
        if (ticket.BookingStatus == "Cancelled") return "bg-danger text-white";
        if (ticket.BookingStatus == "Expired") return "bg-secondary text-white";
        return "bg-secondary text-white";
    }

    private static string GetStatusLabel(CustomerBookingInfoDto ticket)
    {
        if (ticket.BookingStatus == "PendingPayment")
        {
            return ticket.PaymentStatus == "Failed" ? "THANH TOÁN THẤT BẠI - CÓ THỂ THỬ LẠI" : "CHỜ THANH TOÁN";
        }

        return ticket.BookingStatus switch
        {
            "Cancelled" when ticket.PaymentStatus == "Refunded" => "ĐÃ HỦY - ĐÃ HOÀN TIỀN",
            "Confirmed" when ticket.PaymentStatus == "Paid" => "ĐÃ XÁC NHẬN (ĐÃ THANH TOÁN)",
            "Cancelled" => "ĐÃ HỦY",
            "Expired" => "HẾT HẠN",
            "Completed" => "ĐÃ HOÀN TẤT",
            _ => ticket.BookingStatus
        };
    }

    private async Task ExecuteCancelAsync(CustomerBookingInfoDto ticket)
    {
        isCancelling = true;
        actionAlertMessage = null;

        try
        {
            var success = await BookingService.CancelBookingAsync(ticket.BookingId, "Khách hàng tự hủy trên trang Vé của tôi");
            if (success)
            {
                actionAlertIsError = false;
                actionAlertMessage = $"Đã hủy đặt chỗ {ticket.BookingCode} thành công. Ghế đã được hoàn trả lại hệ thống.";
                confirmingCancelId = null;
                await LoadTicketsAsync();
            }
            else
            {
                actionAlertIsError = true;
                actionAlertMessage = "Không thể hủy đặt chỗ (chỉ có thể hủy đơn đặt chỗ đang chờ thanh toán thuộc quyền sở hữu của bạn).";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Booking cancellation failed for booking {BookingId}.", ticket.BookingId);
            actionAlertIsError = true;
            actionAlertMessage = "Không thể hủy đơn đặt chỗ lúc này. Vui lòng thử lại sau.";
        }
        finally
        {
            isCancelling = false;
        }
    }
}
