</style>

@code {
    private List<LocationDto> locations = new();
    private List<BusTypeDto> busTypes = new();
    private List<RouteDto> routes = new();
    private List<OperatorDto> operators = new();
    private List<BusSelectDto> buses = new();
    private List<TripSearchResultDto> allTrips = new();

    private string activeTab = "operators";
    private long selectedTripOperatorId;
    private CreateOperatorDto newOperator = new();
    private CreateBusDto newBus = new();
    private CreateRouteDto newRoute = new();
    private CreateTripDto newTrip = new() { BasePrice = 500000 };
    private DateTime departureInput = DateTime.Today.AddHours(8);
    private DateTime arrivalInput = DateTime.Today.AddDays(1).AddHours(14);
    private string? statusMsg;
    private bool isSubmitting;
    private bool isSuccess;
    private bool isLoadingTrips;
    private string searchText = "";
    private string tripFilter = "all";
    private IEnumerable<BusSelectDto> TripBuses => buses.Where(bus => bus.OperatorId == selectedTripOperatorId);

    private IEnumerable<TripSearchResultDto> FilteredTrips
    {
        get
        {
            IEnumerable<TripSearchResultDto> query = allTrips;
            if (!string.IsNullOrWhiteSpace(searchText))
            {
                var keyword = searchText.Trim();
                query = query.Where(t =>
                    (t.TripCode?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (t.RouteName?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (t.OperatorName?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (t.BusTypeName?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (t.BusLicensePlate?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false));
            }
            var today = DateTime.Today;
            query = tripFilter switch
            {
                "future" => query.Where(t => t.Status != "Cancelled" && t.DepartureTime.ToLocalTime().DateTime >= DateTime.Now),
                "today" => query.Where(t => t.DepartureTime.ToLocalTime().Date == today),
                _ => query
            };
            return query.OrderByDescending(t => t.DepartureTime);
        }
    }

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        operators = await TripService.GetOperatorsAsync();
        busTypes = await TripService.GetBusTypesAsync();
        locations = await TripService.GetLocationsAsync();
        routes = await TripService.GetRoutesAsync();
        allTrips = await TripService.GetAllTripsAdminAsync();
        await RefreshBuses();
    }

    private void SetActiveTab(string tab) => activeTab = tab;

    private string GetOperatorName(long operatorId) => operators.FirstOrDefault(op => op.Id == operatorId)?.Name ?? "-";

    private async Task RefreshBuses()
    {
        var fleet = new List<BusSelectDto>();
        foreach (var op in operators)
            fleet.AddRange(await TripService.GetBusesByOperatorAsync(op.Id));
        buses = fleet;
    }

    private async Task RefreshTrips()
    {
        isLoadingTrips = true;
        try { await LoadData(); }
        finally { isLoadingTrips = false; }
    }

    private Task OnTripRouteChanged()
    {
        selectedTripOperatorId = routes.FirstOrDefault(route => route.Id == newTrip.RouteId)?.OperatorId ?? 0;
        if (!TripBuses.Any(bus => bus.Id == newTrip.BusId))
            newTrip.BusId = 0;
        return Task.CompletedTask;
    }

    private async Task CreateOperator()
    {
        if (string.IsNullOrWhiteSpace(newOperator.Name) || string.IsNullOrWhiteSpace(newOperator.Code))
        {
            SetStatus("Vui lòng nhập tên và mã nhà xe.", false);
            return;
        }
        isSubmitting = true;
        try
        {
            await TripService.CreateOperatorAsync(newOperator);
            newOperator = new CreateOperatorDto();
            await LoadData();
            SetStatus("Đã thêm nhà xe.", true);
        }
        catch (Exception exception)
        {
            SetStatus($"Không thể thêm nhà xe: {exception.Message}", false);
        }
        finally { isSubmitting = false; }
    }

    private async Task CreateBus()
    {
        if (newBus.OperatorId <= 0 || newBus.BusTypeId <= 0 || string.IsNullOrWhiteSpace(newBus.LicensePlate))
        {
            SetStatus("Vui lòng chọn nhà xe, loại xe và nhập biển số.", false);
            return;
        }
        isSubmitting = true;
        try
        {
            await TripService.CreateBusWithLayoutAsync(newBus);
            newBus = new CreateBusDto();
            await LoadData();
            SetStatus("Đã đăng ký xe và tạo sơ đồ 24 giường.", true);
        }
        catch (Exception exception)
        {
            SetStatus($"Không thể đăng ký xe: {exception.Message}", false);
        }
        finally { isSubmitting = false; }
    }

    private async Task CreateRoute()
    {
        var origin = locations.FirstOrDefault(location => location.Id == newRoute.OriginLocationId);
        var destination = locations.FirstOrDefault(location => location.Id == newRoute.DestinationLocationId);
        if (newRoute.OperatorId <= 0 || origin == null || destination == null || origin.Id == destination.Id || newRoute.DistanceKm <= 0 || newRoute.EstimatedDurationMinutes <= 0)
        {
            SetStatus("Vui lòng chọn nhà xe, hai điểm khác nhau, cự ly và thời lượng hợp lệ.", false);
            return;
        }
        newRoute.Name = $"{origin.Name} - {destination.Name}";
        newRoute.Code = $"{origin.Code}-{destination.Code}-{DateTime.UtcNow.Ticks % 100000}";
        isSubmitting = true;
        try
        {
            await TripService.CreateRouteAsync(newRoute);
            newRoute = new CreateRouteDto();
            await LoadData();
            SetStatus("Đã tạo tuyến đường.", true);
        }
        catch (Exception exception)
        {
            SetStatus($"Không thể tạo tuyến: {exception.Message}", false);
        }
        finally { isSubmitting = false; }
    }

    private async Task CreateTrip()
    {
        if (newTrip.RouteId <= 0 || newTrip.BusId <= 0 || selectedTripOperatorId <= 0)
        {
            SetStatus("Vui lòng chọn tuyến và xe thuộc nhà xe khai thác tuyến đó.", false);
            return;
        }
        if (departureInput < DateTime.Now || arrivalInput <= departureInput || newTrip.BasePrice <= 0)
        {
            SetStatus("Thời gian và giá vé chuyến xe chưa hợp lệ.", false);
            return;
        }
        isSubmitting = true;
        try
        {
            newTrip.DepartureTime = new DateTimeOffset(departureInput);
            newTrip.ExpectedArrivalTime = new DateTimeOffset(arrivalInput);
            await TripService.CreateTripAsync(newTrip);
            newTrip = new CreateTripDto { BasePrice = 500000 };
            selectedTripOperatorId = 0;
            await LoadData();
            SetStatus("Đã mở bán chuyến xe.", true);
        }
        catch (Exception exception)
        {
            SetStatus($"Không thể mở bán chuyến: {exception.Message}", false);
        }
        finally { isSubmitting = false; }
    }

    private async Task CancelTrip(long tripId)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Hủy chuyến xe này? Chuyến đã hủy không còn xuất hiện trong kết quả tìm kiếm."))
            return;
        try
        {
            var cancelled = await TripService.DeleteTripAsync(tripId);
            await LoadData();
            SetStatus(cancelled ? "Đã hủy chuyến xe." : "Không tìm thấy chuyến xe.", cancelled);
        }
        catch (Exception exception)
        {
            SetStatus($"Không thể hủy chuyến: {exception.Message}", false);
        }
    }

    private void SetStatus(string message, bool success)
    {
        statusMsg = message;
        isSuccess = success;
    }
}
