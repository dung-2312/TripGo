                </div>

                @if (popularRoutes.Any())
                {
                    <div class="row g-3">
                        @foreach (var route in popularRoutes.Take(4))
                        {
                            <div class="col-md-3 col-sm-6">
                                <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100 tg-route-card cursor-pointer"
                                     role="button" tabindex="0" @onclick="() => QuickSearchRoute(route)">
                                    <div class="tg-route-photo position-relative" style="height: 140px; background: #e2e8f0;">
                                        <img src="@GetRouteImage(route)" alt="@route.Name" class="w-100 h-100 object-fit-cover" />
                                        <span class="badge bg-primary position-absolute top-0 start-0 m-2">Tuyến trọng điểm</span>
                                    </div>
                                    <div class="card-body p-3">
                                        <h6 class="fw-bold text-dark mb-1">@route.Name</h6>
                                        <div class="text-muted small mb-2">
                                            <i class="bi bi-signpost-2 me-1"></i> @(route.DistanceKm.HasValue ? $"{route.DistanceKm.Value:N0} km" : "Liên tỉnh")
                                            @(route.EstimatedDurationMinutes.HasValue ? $" • ~{route.EstimatedDurationMinutes.Value / 60}h" : "")
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="text-danger fw-bold fs-6">Từ 280.000 đ</span>
                                            <span class="btn btn-sm btn-outline-primary py-0 px-2 rounded-pill small">Tìm vé</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-muted small">Đang nạp dữ liệu tuyến đường từ hệ thống...</div>
                }
            </section>

            <!-- PLATFORM FEATURES & VALUE (Authentic presentation) -->
            <section class="my-5">
                <h4 class="fw-bold text-dark mb-4 text-center">Tại sao nên chọn TripGo?</h4>
                <div class="row g-4">
                    <div class="col-md-3 col-sm-6">
                        <div class="card border-0 shadow-sm rounded-4 p-4 text-center h-100 bg-white">
                            <div class="badge bg-primary-subtle text-primary p-3 rounded-circle mx-auto mb-3" style="width: 60px; height: 60px; display: grid; place-items: center;">
                                <i class="bi bi-bus-front-fill fs-3"></i>
                            </div>
                            <h6 class="fw-bold text-dark">Hàng ngàn chuyến xe</h6>
                            <p class="text-muted small mb-0">Mạng lưới tuyến đường rộng khắp kết nối các tỉnh thành lớn trên toàn quốc.</p>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <div class="card border-0 shadow-sm rounded-4 p-4 text-center h-100 bg-white">
                            <div class="badge bg-success-subtle text-success p-3 rounded-circle mx-auto mb-3" style="width: 60px; height: 60px; display: grid; place-items: center;">
                                <i class="bi bi-check2-circle fs-3"></i>
                            </div>
                            <h6 class="fw-bold text-dark">Giữ chỗ tức thì</h6>
