@page "/search-trips"
@page "/search"
@page "/tim-chuyen-xe"
@page "/"
@layout Tripgo.Web.Components.Layout.CustomerLayout
@using Tripgo.Application.DTOs
@using Tripgo.Application.Interfaces
@inject ITripService TripService
@inject IBookingService BookingService
@inject IPaymentService PaymentService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ILogger<SearchTrips> Logger
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>TripGo - Tra cứu lịch trình tham khảo</PageTitle>

<div class="tg-portal">
    <!-- ========================================================
         HERO & SEARCH HUB
         ======================================================== -->
    <!-- ========================================================
         HERO & SEARCH HUB
         ======================================================== -->
    <section class="tg-hero">
        <div class="container position-relative z-2">
            <div class="text-center mb-4 text-white">
                <span class="tg-hero-badge mb-3">
                    <i class="bi bi-shield-check text-warning"></i> Tra cứu lịch trình xe khách liên tỉnh
                </span>
                <h1 class="tg-hero-title mb-3">HÀNH TRÌNH VẠN DẶM — KHỞI ĐẦU DỄ DÀNG</h1>
                <p class="tg-hero-subtitle">
                    Tra cứu tuyến đường, lịch trình và giá tham khảo; vui lòng xác nhận trực tiếp với nhà xe trước khi khởi hành.
                </p>
            </div>

            <!-- Floating Search Card -->
            <div class="tg-search-box p-3 p-md-4 mx-auto">
                <!-- Search Inputs Grid -->
                <div class="row g-2 align-items-center">
                    <!-- Nơi xuất phát -->
                    <div class="col-lg-3 col-md-6 position-relative">
                        <div class="tg-input-wrapper" @onclick="() => ToggleDropdown(true)">
                            <label class="tg-label small text-muted d-block fw-semibold mb-1">
                                <i class="bi bi-geo-alt-fill text-primary me-1"></i> Nơi xuất phát
                            </label>
                            <div class="tg-val fw-bold text-dark text-truncate fs-6">
                                @(originLocation != null ? $"{originLocation.Name} ({originLocation.Province})" : "Chọn điểm đi")
                            </div>
                        </div>

                        @if (showOriginDropdown)
                        {
                            <div class="tg-dropdown position-absolute start-0 end-0 z-3 p-2 mt-1 bg-white" @onclick:stopPropagation="true">
                                <div class="input-group input-group-sm mb-2">
                                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                                    <input type="text" class="form-control border-start-0 ps-0" placeholder="Tìm tỉnh/thành..." @bind="originSearchText" @bind:event="oninput" autofocus />
                                </div>
                                <div class="tg-dropdown-items" style="max-height: 220px; overflow-y: auto;">
                                    @foreach (var loc in FilteredOriginLocations)
                                    {
                                        <div class="p-2 rounded cursor-pointer tg-drop-item @(searchModel.OriginLocationId == loc.Id ? "bg-primary-subtle text-primary fw-bold" : "")"
                                             @onclick="() => SelectOrigin(loc)">
                                            <i class="bi bi-geo-alt me-1 text-primary"></i> @loc.Name <span class="text-muted small">(@loc.Province)</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Nút Swap Đảo chiều -->
                    <div class="col-auto d-none d-lg-flex justify-content-center px-0">
                        <button type="button" class="tg-swap-btn" @onclick="SwapLocations" title="Đổi nơi đi và nơi đến">
                            <i class="bi bi-arrow-left-right fs-6"></i>
                        </button>
                    </div>

                    <!-- Nơi đến -->
                    <div class="col-lg-3 col-md-6 position-relative">
                        <div class="tg-input-wrapper" @onclick="() => ToggleDropdown(false)">
                            <label class="tg-label small text-muted d-block fw-semibold mb-1">
                                <i class="bi bi-geo-alt-fill text-danger me-1"></i> Nơi đến
                            </label>
                            <div class="tg-val fw-bold text-dark text-truncate fs-6">
                                @(destLocation != null ? $"{destLocation.Name} ({destLocation.Province})" : "Chọn điểm đến")
                            </div>
                        </div>

                        @if (showDestDropdown)
                        {
                            <div class="tg-dropdown position-absolute start-0 end-0 z-3 p-2 mt-1 bg-white" @onclick:stopPropagation="true">
                                <div class="input-group input-group-sm mb-2">
                                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                                    <input type="text" class="form-control border-start-0 ps-0" placeholder="Tìm tỉnh/thành..." @bind="destSearchText" @bind:event="oninput" autofocus />
                                </div>
                                <div class="tg-dropdown-items" style="max-height: 220px; overflow-y: auto;">
                                    @foreach (var loc in FilteredDestLocations)
                                    {
                                        <div class="p-2 rounded cursor-pointer tg-drop-item @(searchModel.DestinationLocationId == loc.Id ? "bg-primary-subtle text-danger fw-bold" : "")"
                                             @onclick="() => SelectDestination(loc)">
                                            <i class="bi bi-geo-alt me-1 text-danger"></i> @loc.Name <span class="text-muted small">(@loc.Province)</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Ngày đi -->
                    <div class="col-lg-3 col-md-6">
                        <div class="tg-input-wrapper bg-white">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="small text-muted fw-semibold mb-0">
                                    <i class="bi bi-calendar3 text-primary me-1"></i> Ngày đi
                                </label>
                                <div class="d-flex gap-1">
                                    <button type="button" class="btn btn-link p-0 text-decoration-none tg-date-chip @(searchModel.DepartureDate == DateOnly.FromDateTime(DateTime.Today) ? "active" : "")" @onclick="() => SelectQuickDate(0)">Hôm nay</button>
                                    <button type="button" class="btn btn-link p-0 text-decoration-none tg-date-chip @(searchModel.DepartureDate == DateOnly.FromDateTime(DateTime.Today.AddDays(1)) ? "active" : "")" @onclick="() => SelectQuickDate(1)">Ngày mai</button>
                                    <button type="button" class="btn btn-link p-0 text-decoration-none tg-date-chip d-none d-xl-inline @(searchModel.DepartureDate == DateOnly.FromDateTime(DateTime.Today.AddDays(2)) ? "active" : "")" @onclick="() => SelectQuickDate(2)">+2 ngày</button>
                                </div>
                            </div>
                            <InputDate @bind-Value="searchModel.DepartureDate" class="form-control form-control-sm border-0 p-0 fw-bold fs-6 text-dark" />
                        </div>
                    </div>

                    <!-- Nút Tìm kiếm -->
                    <div class="col-lg col-md-6">
                        <button type="button" class="btn btn-warning w-100 py-3 fw-bold rounded-3 fs-5 shadow-sm" @onclick="HandleSearch" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Đang tìm...</span>
                            }
                            else
                            {
                                <i class="bi bi-search me-2"></i>
                                <span>Tìm vé</span>
                            }
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-warning py-2 mt-3 mb-0 small rounded-3 d-flex align-items-center border-0 shadow-xs">
                        <i class="bi bi-exclamation-triangle-fill text-warning fs-5 me-2"></i>
                        <span>@errorMessage</span>
                    </div>
                }
            </div>

            <!-- Data limitations -->
            <div class="tg-trust-strip mt-4">
                <div class="tg-trust-item"><i class="bi bi-calendar-check text-warning"></i> Lịch trình mang tính tham khảo</div>
                <div class="tg-trust-item"><i class="bi bi-tag-fill text-warning"></i> Giá vé cần xác nhận với nhà xe</div>
                <div class="tg-trust-item"><i class="bi bi-info-circle text-warning"></i> Chưa đồng bộ tồn chỗ trực tiếp</div>
                <div class="tg-trust-item"><i class="bi bi-shield-lock text-warning"></i> Không phát hành vé thật</div>
            </div>
        </div>
    </section>

    <!-- ========================================================
         MAIN CONTENT: Search Results OR Landing Content
         ======================================================== -->
    <main class="container my-4" id="trip-results">
        @if (hasSearched)
        {
            <!-- TOP SEARCH SUMMARY BAR -->
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-4">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 small fw-bold">KẾT QUẢ TÌM KIẾM</span>
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 small fw-bold">
                                <i class="bi bi-check2-circle me-1"></i>Tìm thấy @VisibleSearchResults.Count() chuyến
                            </span>
                        </div>
                        <h4 class="fw-bold mb-1 text-navy">
                            @(originLocation?.Name ?? "Điểm đi") <i class="bi bi-arrow-right text-primary mx-1"></i> @(destLocation?.Name ?? "Điểm đến")
                        </h4>
                        <div class="small text-secondary">
                            <i class="bi bi-calendar3 text-primary me-1"></i> Ngày đi: <strong class="text-dark">@DepartureDateLabel</strong>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <div class="btn-group btn-group-sm" role="group" aria-label="Đổi ngày">
                            <button type="button" class="btn btn-outline-primary px-3 py-2 fw-semibold" @onclick="TryPreviousDay" disabled="@(searchModel.DepartureDate <= DateOnly.FromDateTime(DateTime.Today))" title="Ngày trước">
                                <i class="bi bi-chevron-left me-1"></i> Ngày trước
                            </button>
                            <button type="button" class="btn btn-outline-primary px-3 py-2 fw-semibold" @onclick="TryNextDay" title="Ngày sau">
                                Ngày sau <i class="bi bi-chevron-right ms-1"></i>
                            </button>
                        </div>
                        <BackButton Label="Đổi tuyến" FallbackUrl="/" OnClick="ResetToHome" />
                    </div>
                </div>
            </div>

            <div class="row g-4">
                <!-- CỘT LỌC BÊN TRÁI -->
                <aside class="col-lg-3 mb-4">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white sticky-top" style="top: 80px;">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="fw-bold fs-6"><i class="bi bi-funnel-fill text-primary me-1"></i> Bộ lọc chuyến xe</span>
                            <button type="button" class="btn btn-sm btn-link text-decoration-none p-0 text-muted" @onclick="ResetFilters">
                                Đặt lại
                            </button>
                        </div>

                        <!-- Sắp xếp theo -->
                        <div class="mb-3">
                            <label class="fw-bold small text-secondary text-uppercase mb-2 d-block">Sắp xếp theo</label>
                            <div class="d-flex flex-column gap-2 small">
                                <label class="cursor-pointer"><input type="radio" name="sort" value="departure_asc" checked='@(sortOrder == "departure_asc")' @onchange="HandleSortChange" class="me-2" /> Giờ đi sớm nhất</label>
                                <label class="cursor-pointer"><input type="radio" name="sort" value="departure_desc" checked='@(sortOrder == "departure_desc")' @onchange="HandleSortChange" class="me-2" /> Giờ đi muộn nhất</label>
                                <label class="cursor-pointer"><input type="radio" name="sort" value="price_asc" checked='@(sortOrder == "price_asc")' @onchange="HandleSortChange" class="me-2" /> Giá vé tăng dần</label>
                                <label class="cursor-pointer"><input type="radio" name="sort" value="price_desc" checked='@(sortOrder == "price_desc")' @onchange="HandleSortChange" class="me-2" /> Giá vé giảm dần</label>
                            </div>
                        </div>

                        <hr />

                        <!-- Khung giờ khởi hành -->
                        <div class="mb-3">
                            <label class="fw-bold small text-secondary text-uppercase mb-2 d-block">Giờ khởi hành</label>
                            <div class="d-flex flex-column gap-2 small">
                                <label class="cursor-pointer"><input type="checkbox" @bind="filterMorning" class="me-2" /> Buổi sáng (00:00 – 11:59)</label>
                                <label class="cursor-pointer"><input type="checkbox" @bind="filterAfternoon" class="me-2" /> Buổi chiều (12:00 – 17:59)</label>
                                <label class="cursor-pointer"><input type="checkbox" @bind="filterEvening" class="me-2" /> Buổi tối (18:00 – 23:59)</label>
                            </div>
                        </div>

                        <hr />

                        <!-- Nhà xe vận hành (Lấy từ kết quả DB thực tế) -->
                        @if (AvailableOperators.Any())
                        {
                            <div class="mb-3">
                                <label class="fw-bold small text-secondary text-uppercase mb-2 d-block">Nhà xe</label>
                                <div class="d-flex flex-column gap-2 small" style="max-height: 160px; overflow-y: auto;">
                                    @foreach (var op in AvailableOperators)
                                    {
                                        <label class="cursor-pointer">
                                            <input type="checkbox" checked="@selectedOperators.Contains(op)" @onchange="args => ToggleOperatorFilter(op, args)" class="me-2" />
                                            @op
                                        </label>
                                    }
                                </div>
                            </div>
                            <hr />
                        }

                        <!-- Loại xe (Lấy từ kết quả DB thực tế) -->
                        @if (AvailableBusTypes.Any())
                        {
                            <div class="mb-3">
                                <label class="fw-bold small text-secondary text-uppercase mb-2 d-block">Loại xe</label>
                                <div class="d-flex flex-column gap-2 small" style="max-height: 160px; overflow-y: auto;">
                                    @foreach (var bt in AvailableBusTypes)
                                    {
                                        <label class="cursor-pointer">
                                            <input type="checkbox" checked="@selectedBusTypes.Contains(bt)" @onchange="args => ToggleBusTypeFilter(bt, args)" class="me-2" />
                                            @bt
                                        </label>
                                    }
                                </div>
                            </div>
                            <hr />
                        }

                        <!-- Lọc theo giá vé -->
                        <div class="mb-2">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="fw-bold small text-secondary text-uppercase mb-0">Giá tối đa</label>
                                <span class="fw-bold text-primary small">@maximumPrice.ToString("N0") đ</span>
                            </div>
                            <input class="form-range" type="range" min="100000" max="2000000" step="20000" @bind="maximumPrice" @bind:event="oninput" />
                        </div>
                    </div>
                </aside>

                <!-- CỘT DANH SÁCH CHUYẾN XE BÊN PHẢI -->
                <section class="col-lg-9">
                    @if (isLoading)
                    {
                        <!-- SKELETON LOADING STATE -->
                        <div class="d-flex flex-column gap-3">
                            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white tg-skeleton" style="height: 160px;"></div>
                            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white tg-skeleton" style="height: 160px;"></div>
                            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white tg-skeleton" style="height: 160px;"></div>
                        </div>
                    }
                    else if (!VisibleSearchResults.Any())
                    {
                        <!-- EMPTY STATE -->
                        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
                            <div class="mb-3">
                                <i class="bi bi-calendar-x display-3 text-secondary"></i>
                            </div>
                            <h5 class="fw-bold text-dark">Không tìm thấy chuyến xe nào phù hợp</h5>
                            <p class="text-muted small mb-4">
                                Hiện chưa có chuyến khởi hành đúng ngày <strong>@DepartureDateLabel</strong> cho tuyến <strong>@(originLocation?.Name) ➔ @(destLocation?.Name)</strong>.
                            </p>
                            <div>
                                <button type="button" class="btn btn-primary px-4 fw-bold rounded-pill me-2" @onclick="TryNextDay">
                                    <i class="bi bi-arrow-right-circle me-1"></i> Tìm ngày hôm sau
                                </button>
                                <button type="button" class="btn btn-outline-secondary px-3 rounded-pill" @onclick="() => hasSearched = false">
                                    Đổi tuyến đường
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        @foreach (var trip in VisibleSearchResults)
                        {
                            <div class="card border-0 shadow-sm rounded-4 mb-3 trip-card bg-white p-3 @(selectedTripId == trip.Id ? "border border-2 border-primary" : "")">
                                <div class="row align-items-center g-3">
                                    <!-- Thông tin chuyến & Nhà xe -->
                                    <div class="col-md-8">
                                        <div class="d-flex align-items-center gap-3 mb-2">
                                            <div class="rounded-3 bg-primary text-white d-flex align-items-center justify-content-center fw-bold shadow-xs" style="width: 44px; height: 44px; font-size: 1.15rem; flex-shrink: 0;">
                                                @(string.IsNullOrWhiteSpace(trip.OperatorName) ? "T" : trip.OperatorName.Substring(0, 1))
                                            </div>
                                            <div>
                                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                                    <h5 class="fw-bold mb-0 text-navy">@trip.OperatorName</h5>
                                                    @if (trip.IsBookable)
                                                    {
                                                        <span class="badge bg-warning text-dark border border-warning-subtle fw-bold" style="font-size: 0.72rem;">
                                                            <i class="bi bi-cpu me-1"></i>CHUYẾN MÔ PHỎNG — SANDBOX
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary-subtle text-secondary border fw-semibold" style="font-size: 0.72rem;">
                                                            <i class="bi bi-info-circle me-1"></i>LỊCH TRÌNH THAM KHẢO
                                                        </span>
                                                    }
                                                </div>
                                                <div class="small text-muted mt-1">
                                                    <i class="bi bi-truck-front me-1"></i>@trip.BusTypeName · Mã chuyến: <strong class="text-dark">@trip.TripCode</strong>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="d-flex align-items-center gap-3 my-3">
                                            <div>
                                                <span class="fs-4 fw-bold text-primary">@trip.DepartureTime.ToLocalTime().ToString("HH:mm")</span>
                                                <div class="small text-dark fw-semibold">@(originLocation?.Name ?? "Điểm đi")</div>
                                            </div>
                                            <div class="text-center px-2 flex-grow-1">
                                                <small class="badge bg-light text-secondary border px-2 py-1 mb-1">
                                                    <i class="bi bi-clock me-1"></i>@GetDurationText(trip.DepartureTime, trip.ArrivalTime)
                                                </small>
                                                <div class="position-relative d-flex align-items-center justify-content-center my-1">
                                                    <hr class="w-100 my-0 border-primary opacity-50" />
                                                    <i class="bi bi-arrow-right text-primary position-absolute bg-white px-1"></i>
                                                </div>
                                                <small class="text-muted fw-bold"><i class="bi bi-info-circle me-1"></i>Thời gian tham khảo</small>
                                            </div>
                                            <div>
                                                <span class="fs-4 fw-bold text-navy">@trip.ArrivalTime.ToLocalTime().ToString("HH:mm")</span>
                                                <div class="small text-dark fw-semibold">@(destLocation?.Name ?? "Điểm đến")</div>
                                            </div>
                                        </div>

                                        <div class="d-flex align-items-center gap-3 mt-2 flex-wrap">
                                            <div class="small text-muted">
                                                <i class="bi bi-card-text me-1"></i> Biển số xe: <strong>@trip.BusLicensePlate</strong>
                                            </div>
                                            <button type="button" class="btn btn-sm btn-link text-decoration-none p-0 text-primary fw-semibold" @onclick="() => ToggleStopsPreview(trip.Id)">
                                                <i class="bi bi-geo-alt-fill me-1"></i> Điểm đón/trả & Chi tiết lộ trình
                                                <i class="bi @(previewStopsTripId == trip.Id ? "bi-chevron-up" : "bi-chevron-down") ms-1 small"></i>
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Giá vé & Nút chọn chuyến -->
                                    <div class="col-md-4 text-md-end border-start-md ps-md-4">
                                        <div class="text-danger fs-3 fw-bold mb-1">
                                            @trip.BasePrice.ToString("N0") <span class="fs-6 fw-normal text-muted">đ / vé</span>
                                        </div>
                                        @if (trip.IsBookable)
                                        {
                                            <div class="small text-muted mb-3">
                                                Còn <strong class="text-success fw-bold fs-6">@trip.AvailableSeats</strong> / @trip.TotalSeats chỗ trống
                                            </div>
                                            <button class="btn btn-warning fw-bold px-4 py-2 w-100 rounded-3 text-dark shadow-sm" @onclick="() => ToggleSelectTrip(trip.Id)">
                                                @(selectedTripId == trip.Id ? "Đóng chọn ghế" : "Chọn chuyến này")
                                            </button>
                                        }
                                        else
                                        {
                                            <div class="small text-muted mb-3">
                                                <span class="badge bg-secondary-subtle text-secondary border">
                                                    <i class="bi bi-clock-history me-1"></i> @trip.OperationalTierLabel
                                                </span>
                                            </div>
                                            <button class="btn btn-outline-primary fw-bold px-4 py-2 w-100 rounded-3" @onclick="() => ToggleSelectTrip(trip.Id)">
                                                @(selectedTripId == trip.Id ? "Đóng chi tiết" : "Xem lộ trình & Điểm đón")
                                            </button>
                                        }
                                    </div>
                                </div>

                                <!-- EXPANDABLE STOPS PREVIEW SECTION -->
                                @if (previewStopsTripId == trip.Id)
                                {
                                    <div class="p-3 bg-light rounded-3 mt-3 border">
                                        <div class="row g-3">
                                            <div class="col-md-6 border-end-md">
                                                <div class="d-flex align-items-center gap-2 mb-2">
                                                    <span class="badge bg-primary text-white"><i class="bi bi-circle-fill me-1"></i> ĐIỂM ĐÓN DỰ KIẾN</span>
                                                    <small class="text-muted">(@(originLocation?.Name))</small>
                                                </div>
                                                @if (trip.PickupPoints.Any())
                                                {
                                                    <div class="d-flex flex-column gap-2">
                                                        @foreach (var pt in trip.PickupPoints)
                                                        {
                                                            <div class="d-flex align-items-start gap-2 small">
                                                                @if (pt.HasFixedTime)
                                                                {
                                                                    <span class="badge bg-primary-subtle text-primary fw-bold mt-1">@pt.Time</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-secondary-subtle text-secondary fw-semibold mt-1">
                                                                        <i class="bi bi-clock me-1"></i>@pt.Time
                                                                    </span>
                                                                }
                                                                <div>
                                                                    <strong class="text-dark d-block">@pt.Name</strong>
                                                                    <span class="text-muted" style="font-size: 0.8rem;">@pt.Address</span>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="alert alert-warning py-2 px-3 small mb-0 rounded-3">
                                                        <i class="bi bi-exclamation-circle-fill me-1"></i> Chưa có dữ liệu điểm đón xác thực từ nhà xe.
                                                    </div>
                                                }
                                            </div>
                                            <div class="col-md-6 ps-md-3">
                                                <div class="d-flex align-items-center gap-2 mb-2">
                                                    <span class="badge bg-danger text-white"><i class="bi bi-geo-alt-fill me-1"></i> ĐIỂM TRẢ DỰ KIẾN</span>
                                                    <small class="text-muted">(@(destLocation?.Name))</small>
                                                </div>
                                                @if (trip.DropoffPoints.Any())
                                                {
                                                    <div class="d-flex flex-column gap-2 small">
                                                        @foreach (var pt in trip.DropoffPoints)
                                                        {
                                                            <div class="d-flex align-items-start gap-2 small">
                                                                @if (pt.HasFixedTime)
                                                                {
                                                                    <span class="badge bg-danger-subtle text-danger fw-bold mt-1">@pt.Time</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-secondary-subtle text-secondary fw-semibold mt-1">
                                                                        <i class="bi bi-clock me-1"></i>@pt.Time
                                                                    </span>
                                                                }
                                                                <div>
                                                                    <strong class="text-dark d-block">@pt.Name</strong>
                                                                    <span class="text-muted" style="font-size: 0.8rem;">@pt.Address</span>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="alert alert-warning py-2 px-3 small mb-0 rounded-3">
                                                        <i class="bi bi-exclamation-circle-fill me-1"></i> Chưa có dữ liệu điểm trả xác thực từ nhà xe.
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }

                                <!-- EXPANDABLE SEAT SELECTION & BOOKING DRAWER / REFERENCE SCHEDULE DRAWER -->
                                @if (selectedTripId == trip.Id && selectedTripDetail != null)
                                {
                                    @if (!selectedTripDetail.IsBookable)
                                    {
                                        <div class="p-4 bg-light rounded-4 mt-3 border">
                                            <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="badge bg-secondary text-white px-2 py-1"><i class="bi bi-clock-history me-1"></i> LỊCH TRÌNH THAM KHẢO</span>
                                                    <span class="small text-muted">Mã chuyến: <strong>@selectedTripDetail.TripCode</strong></span>
                                                </div>
                                                <button type="button" class="btn btn-sm btn-link text-decoration-none text-muted p-0" @onclick="CloseTripDetail">
                                                    <i class="bi bi-x-lg me-1"></i> Đóng
                                                </button>
                                            </div>

                                            <div class="alert alert-info py-3 px-3 rounded-3 small mb-3 border-info-subtle">
                                                <h6 class="fw-bold mb-1 text-primary"><i class="bi bi-info-circle-fill me-1"></i> Dữ liệu thử nghiệm</h6>
                                                <p class="mb-2">
                                                    Tuyến, nhà xe, thời gian và giá dưới đây chỉ là dữ liệu tham khảo trong môi trường sandbox, chưa được xác nhận bởi nhà xe và không phải dịch vụ vận tải mở bán thực tế.
                                                </p>
                                                <div class="d-flex flex-wrap gap-3 align-items-center pt-2 border-top border-info-subtle">
                                                    <div><i class="bi bi-tag-fill text-danger me-1"></i> Giá vé tham khảo: <strong class="fs-6 text-danger">@selectedTripDetail.BasePrice.ToString("N0") đ</strong></div>
                                                </div>
                                            </div>

                                            <h6 class="fw-bold small text-dark mb-2"><i class="bi bi-geo-alt-fill text-primary me-1"></i> Điểm đón và trả hiển thị cho tuyến</h6>
                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <div class="p-3 bg-white rounded-3 border h-100">
                                                        <div class="fw-bold small text-primary mb-2"><i class="bi bi-circle-fill me-1"></i> Điểm đón tại @(originLocation?.Name)</div>
                                                        @if (selectedTripDetail.PickupPoints.Any())
                                                        {
                                                            <div class="d-flex flex-column gap-2 small">
                                                                @foreach (var pt in selectedTripDetail.PickupPoints)
                                                                {
                                                                    <div class="d-flex align-items-start gap-2">
                                                                        @if (pt.HasFixedTime)
                                                                        {
                                                                            <span class="badge bg-primary-subtle text-primary fw-bold mt-1">@pt.Time</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="badge bg-secondary-subtle text-secondary fw-semibold mt-1">
                                                                                <i class="bi bi-clock me-1"></i>@pt.Time
                                                                            </span>
                                                                        }
                                                                        <div>
                                                                            <strong class="text-dark d-block">@pt.Name</strong>
                                                                            <span class="text-muted" style="font-size: 0.8rem;">@pt.Address</span>
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="small text-muted">Chưa có dữ liệu trạm đón xác thực.</div>
                                                        }
                                                    </div>
                                                </div>

                                                <div class="col-md-6">
                                                    <div class="p-3 bg-white rounded-3 border h-100">
                                                        <div class="fw-bold small text-danger mb-2"><i class="bi bi-geo-alt-fill me-1"></i> Điểm trả tại @(destLocation?.Name)</div>
                                                        @if (selectedTripDetail.DropoffPoints.Any())
                                                        {
                                                            <div class="d-flex flex-column gap-2 small">
                                                                @foreach (var pt in selectedTripDetail.DropoffPoints)
                                                                {
                                                                    <div class="d-flex align-items-start gap-2">
                                                                        @if (pt.HasFixedTime)
                                                                        {
                                                                            <span class="badge bg-danger-subtle text-danger fw-bold mt-1">@pt.Time</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="badge bg-secondary-subtle text-secondary fw-semibold mt-1">
                                                                                <i class="bi bi-clock me-1"></i>@pt.Time
                                                                            </span>
                                                                        }
                                                                        <div>
                                                                            <strong class="text-dark d-block">@pt.Name</strong>
                                                                            <span class="text-muted" style="font-size: 0.8rem;">@pt.Address</span>
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="small text-muted">Chưa có dữ liệu trạm trả xác thực.</div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top flex-wrap gap-2">
                                                <BackButton Label="Quay lại danh sách chuyến" OnClick="CloseTripDetail" />
                                                <span class="small text-muted">Chưa có thông tin liên hệ nhà xe được xác minh.</span>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="booking-drawer mt-3 pt-3 border-top tg-fade-up">
                                            <!-- Modern Horizontal Stepper (Task 3) -->
                                            <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom flex-wrap gap-2">
                                                <div class="tg-progress-stepper flex-grow-1 mb-0 py-0">
                                                    <div class="tg-progress-step @(bookingStep == 0 ? "active" : (bookingStep > 0 ? "completed" : ""))">
                                                        <div class="tg-step-circle">@(bookingStep > 0 ? "✓" : "1")</div>
                                                        <div class="tg-step-label">1. Chọn chỗ</div>
                                                    </div>
                                                    <div class="tg-step-connector @(bookingStep > 0 ? "completed" : "")"></div>
                                                    <div class="tg-progress-step @(bookingStep == 1 ? "active" : (bookingStep > 1 ? "completed" : ""))">
                                                        <div class="tg-step-circle">@(bookingStep > 1 ? "✓" : "2")</div>
                                                        <div class="tg-step-label">2. Điểm đón / trả</div>
                                                    </div>
                                                    <div class="tg-step-connector @(bookingStep > 1 ? "completed" : "")"></div>
                                                    <div class="tg-progress-step @(bookingStep == 2 ? "active" : (bookingStep > 2 ? "completed" : ""))">
                                                        <div class="tg-step-circle">@(bookingStep > 2 ? "✓" : "3")</div>
                                                        <div class="tg-step-label">3. Thông tin hành khách</div>
                                                    </div>
                                                    <div class="tg-step-connector @(bookingStep > 2 ? "completed" : "")"></div>
                                                    <div class="tg-progress-step @(bookingStep == 3 ? "active" : (bookingStep > 3 ? "completed" : ""))">
                                                        <div class="tg-step-circle">@(bookingStep > 3 ? "✓" : "4")</div>
                                                        <div class="tg-step-label">4. Thanh toán</div>
                                                    </div>
                                                </div>
                                                @if (bookingStep < 4)
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" @onclick="CloseTripDetail">
                                                        <i class="bi bi-x-lg me-1"></i> Đóng
                                                    </button>
                                                }
                                            </div>

                                        <!-- SEAT-HOLD COUNTDOWN BANNER (Task 5) -->
                                        @if (bookingStep >= 1 && bookingStep <= 3 && !string.IsNullOrEmpty(countdownText))
                                        {
                                            var isUrgent = holdExpiresAt != null && (holdExpiresAt.Value - DateTimeOffset.UtcNow).TotalSeconds < 120;
                                            <div class="tg-hold-banner @(isUrgent ? "tg-hold-urgent" : "") mb-3">
                                                <div class="d-flex align-items-center gap-3">
                                                    <div class="tg-hold-time-badge @(isUrgent ? "tg-pulse-timer" : "")">
                                                        <i class="bi bi-clock-history me-1"></i> @countdownText
                                                    </div>
                                                    <div>
                                                        <strong class="text-dark small d-block">
                                                            @(isUrgent ? "⚠️ Sắp hết hạn giữ chỗ! Vui lòng hoàn tất trong thời gian trên." : "Thời gian giữ chỗ còn lại trên máy chủ:")
                                                        </strong>
                                                        <span class="text-muted" style="font-size: 0.8rem;">
                                                            Ghế của bạn được bảo lưu 10 phút. Hệ thống máy chủ tự động giải phóng ghế nếu quá hạn.
                                                        </span>
                                                    </div>
                                                </div>
                                                <span class="badge bg-white text-primary border shadow-xs d-none d-md-inline-flex align-items-center gap-1 px-3 py-2">
                                                    <i class="bi bi-shield-lock-fill text-success"></i> Khóa máy chủ 10 phút
                                                </span>
                                            </div>
                                        }

                                        <!-- STEP 0: SƠ ĐỒ CHỌN GIƯỜNG NẰM 2 TẦNG (Task 4) -->
                                        @if (bookingStep == 0)
                                        {
                                            @if (!string.IsNullOrWhiteSpace(bookingError))
                                            {
                                                <div class="alert alert-warning py-2 small mb-3 rounded-3 d-flex align-items-center">
                                                    <i class="bi bi-exclamation-triangle-fill me-2 fs-6"></i>
                                                    <span>@bookingError</span>
                                                </div>
                                            }

                                            <!-- Chú thích ghế (Legend) -->
                                            <div class="d-flex flex-wrap align-items-center gap-3 p-2 px-3 bg-light rounded-3 mb-3 small">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="tg-seat-berth" style="width: 28px; height: 32px; padding: 2px; cursor: default; box-shadow: none;">
                                                        <div class="tg-berth-pillow" style="width: 14px; height: 4px;"></div>
                                                    </div>
                                                    <span class="text-secondary fw-semibold">Ghế trống</span>
                                                </div>
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="tg-seat-berth seat-selected" style="width: 28px; height: 32px; padding: 2px; cursor: default;">
                                                        <div class="tg-berth-pillow" style="width: 14px; height: 4px;"></div>
                                                    </div>
                                                    <span class="text-secondary fw-semibold">Đang chọn</span>
                                                </div>
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="tg-seat-berth seat-booked" style="width: 28px; height: 32px; padding: 2px; cursor: default;">
                                                        <div class="tg-berth-pillow" style="width: 14px; height: 4px;"></div>
                                                    </div>
                                                    <span class="text-secondary fw-semibold">Đã bán / Đang giữ</span>
                                                </div>
                                            </div>

                                            <div class="row g-3">
                                                @foreach (var floor in selectedTripDetail.Seats.GroupBy(s => s.Floor).OrderBy(g => g.Key))
                                                {
                                                    <div class="col-md-6">
                                                        <div class="tg-bus-cabin p-3 mb-2 h-100 rounded-4">
                                                            <div class="tg-cabin-cockpit rounded-3 mb-3">
                                                                <div class="tg-cockpit-steering">
                                                                    <i class="bi bi-steering-wheel"></i>
                                                                    <span>BÁC TÀI / ĐẦU XE</span>
                                                                </div>
                                                                <div class="tg-cockpit-door">
                                                                    <i class="bi bi-door-open-fill me-1"></i> CỬA LÊN XUỐNG
                                                                </div>
                                                            </div>

                                                            <div class="fw-bold text-primary mb-3 text-center small text-uppercase" style="letter-spacing: 0.5px;">
                                                                <i class="bi bi-layers-fill me-1"></i> TẦNG @floor.Key (@(floor.Key == 1 ? "Tầng dưới" : "Tầng trên"))
                                                            </div>

                                                            <div class="d-flex flex-column gap-2">
                                                                @foreach (var rowGroup in floor.GroupBy(s => s.Row).OrderBy(g => g.Key))
                                                                {
                                                                    <div class="d-flex justify-content-between align-items-center gap-2">
                                                                        <!-- Dãy bên trái (Column 1) -->
                                                                        <div class="d-flex gap-2">
                                                                            @foreach (var seat in rowGroup.Where(s => s.Column == 1))
                                                                            {
                                                                                <button type="button" class="tg-seat-berth @(GetSeatClass(seat))"
                                                                                        disabled="@(!seat.IsAvailable)"
                                                                                        @onclick="() => ToggleSeat(seat.SeatCode)"
                                                                                        title="Ghế @seat.SeatCode - @(seat.IsAvailable ? "Còn trống" : "Đã bán")">
                                                                                    <div class="tg-berth-pillow"></div>
                                                                                    <span class="tg-berth-code">@seat.SeatCode</span>
                                                                                    <span class="tg-berth-price">@((seat.Price > 0 ? seat.Price : selectedTripDetail.BasePrice).ToString("N0"))đ</span>
                                                                                </button>
                                                                            }
                                                                        </div>

                                                                        <!-- Lối đi giữa xe -->
                                                                        <div class="tg-cabin-aisle">
                                                                            <span class="tg-cabin-aisle-pill">Lối đi</span>
                                                                        </div>

                                                                        <!-- Dãy bên phải (Column 2) -->
                                                                        <div class="d-flex gap-2">
                                                                            @foreach (var seat in rowGroup.Where(s => s.Column == 2))
                                                                            {
                                                                                <button type="button" class="tg-seat-berth @(GetSeatClass(seat))"
                                                                                        disabled="@(!seat.IsAvailable)"
                                                                                        @onclick="() => ToggleSeat(seat.SeatCode)"
                                                                                        title="Ghế @seat.SeatCode - @(seat.IsAvailable ? "Còn trống" : "Đã bán")">
                                                                                    <div class="tg-berth-pillow"></div>
                                                                                    <span class="tg-berth-code">@seat.SeatCode</span>
                                                                                    <span class="tg-berth-price">@((seat.Price > 0 ? seat.Price : selectedTripDetail.BasePrice).ToString("N0"))đ</span>
                                                                                </button>
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>

                                            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top flex-wrap gap-2">
                                                <div class="d-flex align-items-center gap-3">
                                                    <BackButton Label="Quay lại danh sách chuyến" OnClick="CloseTripDetail" />
                                                    <div>
                                                        <span class="small text-muted d-block">Ghế đã chọn (@selectedSeats.Count):</span>
                                                        @if (selectedSeats.Count == 0)
                                                        {
                                                            <span class="text-secondary small fst-italic">Vui lòng chọn ghế trên sơ đồ</span>
                                                        }
                                                        else
                                                        {
                                                            <div class="d-flex flex-wrap gap-1">
                                                                @foreach (var sc in selectedSeats.OrderBy(s => s))
                                                                {
                                                                    <span class="badge bg-success font-monospace px-2 py-1">@sc</span>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="d-flex align-items-center gap-3">
                                                    <div class="text-end">
                                                        <span class="small text-muted d-block">Tổng tiền vé:</span>
                                                        <strong class="fs-4 text-danger fw-bold">@SeatTotal.ToString("N0") <span class="fs-6">đ</span></strong>
                                                    </div>
                                                    <button type="button" class="btn btn-primary fw-bold px-4 py-2" disabled="@(selectedSeats.Count == 0 || isHoldingSeats)" @onclick="ProceedToPickupDropoff">
                                                        @if (isHoldingSeats)
                                                        {
                                                            <span class="spinner-border spinner-border-sm me-1"></span>
                                                            <span>Đang giữ chỗ 10 phút...</span>
                                                        }
                                                        else
                                                        {
                                                            <span>Tiếp tục: Điểm đón/trả</span> <i class="bi bi-arrow-right ms-1"></i>
                                                        }
                                                    </button>
                                                </div>
                                            </div>
                                        }

                                        <!-- STEP 1: CHỌN ĐIỂM ĐÓN / TRẢ (Task 6) -->
                                        @if (bookingStep == 1)
                                        {
                                            @if (!selectedTripDetail.PickupPoints.Any() || !selectedTripDetail.DropoffPoints.Any())
                                            {
                                                <div class="alert alert-warning py-3 rounded-3 d-flex align-items-start gap-3 mb-3">
                                                    <i class="bi bi-exclamation-triangle-fill fs-4 text-warning flex-shrink-0"></i>
                                                    <div>
                                                        <h6 class="fw-bold mb-1">Chưa có thông tin điểm đón/trả xác thực</h6>
                                                        <p class="small mb-1">
                                                            Chuyến xe này hiện chưa có danh sách điểm đón/trả được xác nhận từ nhà xe <strong>@selectedTripDetail.OperatorName</strong>.
                                                            Tripgo không cung cấp điểm đón/trả giả định và không thể tiếp tục đặt vé trực tuyến cho chuyến xe chưa có điểm dừng xác thực.
                                                        </p>
                                                        <small class="text-secondary">
                                                            Vui lòng quay lại chọn một chuyến có dữ liệu điểm dừng trong môi trường thử nghiệm. Không có thông tin liên hệ nhà xe được xác minh.
                                                        </small>
                                                    </div>
                                                </div>
                                            }

                                            <div class="row g-3">
                                                <!-- Điểm đón -->
                                                <div class="col-md-6">
                                                    <h6 class="fw-bold small text-primary mb-2 d-flex align-items-center gap-2">
                                                        <i class="bi bi-geo-alt-fill"></i> 1. Chọn điểm đón khách (@(originLocation?.Name))
                                                    </h6>
                                                    <div class="d-flex flex-column gap-2">
                                                        @if (selectedTripDetail.PickupPoints.Any())
                                                        {
                                                            @foreach (var pt in selectedTripDetail.PickupPoints)
                                                            {
                                                                <label class="tg-point-card @(selectedPickupPoint?.Id == pt.Id ? "selected-pickup" : "")">
                                                                    <input type="radio" name="pickup" class="form-check-input mt-1" checked="@(selectedPickupPoint?.Id == pt.Id)" @onchange="() => selectedPickupPoint = pt" />
                                                                    <div class="flex-grow-1">
                                                                        <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                                                            <span class="tg-point-time @(pt.HasFixedTime ? "bg-primary text-white" : "bg-secondary text-white")">
                                                                                <i class="bi bi-clock me-1"></i>@pt.Time
                                                                            </span>
                                                                            @if (pt.Name.Contains("[SANDBOX]"))
                                                                            {
                                                                                <span class="badge bg-warning text-dark" style="font-size: 0.68rem;"><i class="bi bi-cpu me-1"></i>SANDBOX</span>
                                                                                <strong class="text-dark">@pt.Name.Replace("[SANDBOX]", "").Trim()</strong>
                                                                            }
                                                                            else
                                                                            {
                                                                                <strong class="text-dark">@pt.Name</strong>
                                                                            }
                                                                        </div>
                                                                        <small class="text-muted d-block" style="font-size: 0.8rem;"><i class="bi bi-signpost me-1"></i>@pt.Address</small>
                                                                    </div>
                                                                </label>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <div class="p-3 border rounded-3 bg-light text-center small text-muted">
                                                                <i class="bi bi-geo-alt-slash text-secondary d-block fs-5 mb-1"></i>
                                                                Chưa có dữ liệu điểm đón xác thực cho chuyến xe này.
                                                            </div>
                                                        }
                                                    </div>
                                                </div>

                                                <!-- Điểm trả -->
                                                <div class="col-md-6">
                                                    <h6 class="fw-bold small text-danger mb-2 d-flex align-items-center gap-2">
                                                        <i class="bi bi-geo-alt-fill"></i> 2. Chọn điểm trả khách (@(destLocation?.Name))
                                                    </h6>
                                                    <div class="d-flex flex-column gap-2">
                                                        @if (selectedTripDetail.DropoffPoints.Any())
                                                        {
                                                            @foreach (var pt in selectedTripDetail.DropoffPoints)
                                                            {
                                                                <label class="tg-point-card @(selectedDropoffPoint?.Id == pt.Id ? "selected-dropoff" : "")">
                                                                    <input type="radio" name="dropoff" class="form-check-input mt-1" checked="@(selectedDropoffPoint?.Id == pt.Id)" @onchange="() => selectedDropoffPoint = pt" />
                                                                    <div class="flex-grow-1">
                                                                        <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                                                            <span class="tg-point-time @(pt.HasFixedTime ? "bg-danger text-white" : "bg-secondary text-white")">
                                                                                <i class="bi bi-clock me-1"></i>@pt.Time
                                                                            </span>
                                                                            @if (pt.Name.Contains("[SANDBOX]"))
                                                                            {
                                                                                <span class="badge bg-warning text-dark" style="font-size: 0.68rem;"><i class="bi bi-cpu me-1"></i>SANDBOX</span>
                                                                                <strong class="text-dark">@pt.Name.Replace("[SANDBOX]", "").Trim()</strong>
                                                                            }
                                                                            else
                                                                            {
                                                                                <strong class="text-dark">@pt.Name</strong>
                                                                            }
                                                                        </div>
                                                                        <small class="text-muted d-block" style="font-size: 0.8rem;"><i class="bi bi-signpost me-1"></i>@pt.Address</small>
                                                                    </div>
                                                                </label>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <div class="p-3 border rounded-3 bg-light text-center small text-muted">
                                                                <i class="bi bi-geo-alt-slash text-secondary d-block fs-5 mb-1"></i>
                                                                Chưa có dữ liệu điểm trả xác thực cho chuyến xe này.
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top flex-wrap gap-2">
                                                <BackButton Label="Quay lại chọn ghế" OnClick="() => bookingStep = 0" />
                                                <div class="d-flex align-items-center gap-2">
                                                    @if (selectedPickupPoint == null || selectedDropoffPoint == null)
                                                    {
                                                        <span class="small text-danger fw-semibold d-none d-md-inline">
                                                            <i class="bi bi-lock-fill me-1"></i> Vui lòng chọn điểm đón & trả để tiếp tục
                                                        </span>
                                                    }
                                                    <button type="button" class="btn btn-primary fw-bold px-4 py-2" disabled="@(selectedPickupPoint == null || selectedDropoffPoint == null)" @onclick="() => bookingStep = 2">
                                                        Tiếp tục: Thông tin khách <i class="bi bi-arrow-right ms-1"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        }

                                        <!-- STEP 2: THÔNG TIN HÀNH KHÁCH (Task 7) -->
                                        @if (bookingStep == 2)
                                        {
                                            <div class="row g-3">
                                                <div class="col-md-7">
                                                    <div class="p-3 bg-white rounded-3 border mb-3">
                                                        <h6 class="fw-bold text-navy mb-3 d-flex align-items-center gap-2">
                                                            <i class="bi bi-person-bounding-box text-primary"></i> Thông tin hành khách liên hệ chính
                                                        </h6>
                                                        <div class="mb-3">
                                                            <label class="form-label small fw-semibold">Họ và tên người liên hệ <span class="text-danger">*</span></label>
                                                            <input class="form-control" placeholder="Ví dụ: Nguyễn Văn A" @bind="booker.Name" />
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="form-label small fw-semibold">Số điện thoại liên hệ <span class="text-danger">*</span></label>
                                                            <input class="form-control" type="tel" placeholder="Ví dụ: 0912345678" @bind="booker.Phone" />
                                                        </div>
                                                        <div class="mb-2">
                                                            <label class="form-label small fw-semibold">Email liên hệ của người đặt <span class="text-danger">*</span></label>
                                                            <input class="form-control" type="email" placeholder="example@gmail.com"
                                                                   @bind="booker.Email" @bind:event="oninput" @bind:after="ResetContactEmailConfirmation" required maxlength="254" autocomplete="email" />
                                                            <div class="form-check mt-2">
                                                                <input id="contactEmailConfirmed" class="form-check-input" type="checkbox" @bind="contactEmailConfirmed" />
                                                                <label class="form-check-label small" for="contactEmailConfirmed">
                                                                    Tôi xác nhận email liên hệ trên là chính xác.
                                                                </label>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    @if (selectedSeats.Count > 1)
                                                    {
                                                        <div class="p-3 bg-light rounded-3 border mb-3">
                                                            <h6 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                                                                <i class="bi bi-people-fill text-primary"></i> Danh sách hành khách đi cùng
                                                            </h6>
                                                            <p class="small text-muted mb-3">
                                                                Ghế <strong>@selectedSeats.OrderBy(s => s).First()</strong> dành cho người liên hệ chính. Nhập thông tin hành khách cho các ghế còn lại:
                                                            </p>
                                                            @{
                                                                var sortedSeatList = selectedSeats.OrderBy(s => s).ToList();
                                                                for (int i = 1; i < sortedSeatList.Count; i++)
                                                                {
                                                                    var seatCode = sortedSeatList[i];
                                                                    var comp = GetCompanionPassenger(seatCode);
                                                                    <div class="p-3 mb-2 bg-white rounded-3 border">
                                                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                                                            <span class="badge bg-primary text-white px-2 py-1">Ghế @seatCode</span>
                                                                            <small class="text-muted fw-semibold">Hành khách @(i + 1)</small>
                                                                        </div>
                                                                        <div class="row g-2">
                                                                            <div class="col-sm-6">
                                                                                <label class="form-label small mb-1">Họ và tên</label>
                                                                                <input class="form-control form-control-sm" placeholder="Họ và tên hành khách" @bind="comp.FullName" />
                                                                            </div>
                                                                            <div class="col-sm-6">
                                                                                <label class="form-label small mb-1">Số điện thoại</label>
                                                                                <input class="form-control form-control-sm" type="tel" placeholder="09xxxxxxxx" @bind="comp.PhoneNumber" />
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                }
                                                            }
                                                        </div>
                                                    }

                                                    <div class="form-check p-2 bg-light rounded-3 my-2 border">
                                                        <input class="form-check-input ms-0 me-2" type="checkbox" id="ins" disabled checked="@false" />
                                                        <label class="form-check-label small text-muted fw-semibold" for="ins">
                                                            Bảo hiểm hành trình (Tạm ngưng thu phí trên môi trường thử nghiệm - 0 đ)
                                                        </label>
                                                    </div>

                                                    @if (!string.IsNullOrWhiteSpace(bookingError))
                                                    {
                                                        <div class="alert alert-warning py-2 small mb-0 rounded-3">
                                                            <i class="bi bi-exclamation-triangle-fill me-1"></i> @bookingError
                                                        </div>
                                                    }
                                                </div>

                                                <div class="col-md-5">
                                                    <div class="p-3 bg-light rounded-3 border sticky-top" style="top: 80px;">
                                                        <h6 class="fw-bold text-navy border-bottom pb-2 mb-3 d-flex align-items-center gap-2">
                                                            <i class="bi bi-receipt text-primary"></i> Tóm tắt chuyến đi
                                                        </h6>
                                                        <div class="small mb-2 d-flex justify-content-between">
                                                            <span class="text-muted">Nhà xe:</span> <strong class="text-dark">@selectedTripDetail.OperatorName</strong>
                                                        </div>
                                                        <div class="small mb-2 d-flex justify-content-between">
                                                            <span class="text-muted">Tuyến:</span> <strong class="text-dark">@selectedTripDetail.RouteName</strong>
                                                        </div>
                                                        <div class="small mb-2 d-flex justify-content-between">
                                                            <span class="text-muted">Điểm đón:</span> <strong class="text-primary text-end">@(selectedPickupPoint?.Name ?? originLocation?.Name)</strong>
                                                        </div>
                                                        <div class="small mb-2 d-flex justify-content-between">
                                                            <span class="text-muted">Điểm trả:</span> <strong class="text-danger text-end">@(selectedDropoffPoint?.Name ?? destLocation?.Name)</strong>
                                                        </div>
                                                        <div class="small mb-2 d-flex justify-content-between">
                                                            <span class="text-muted">Số ghế (@selectedSeats.Count):</span> <strong class="badge bg-primary text-white">@string.Join(", ", selectedSeats.OrderBy(s => s))</strong>
                                                        </div>
                                                        <hr class="my-2" />
                                                        <div class="d-flex justify-content-between fs-5 fw-bold text-danger mb-1">
                                                            <span>Tổng tạm tính:</span>
                                                            <span>@BookingTotal.ToString("N0") đ</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top flex-wrap gap-2">
                                                <BackButton Label="Quay lại điểm đón/trả" OnClick="() => bookingStep = 1" />
                                                <button type="button" class="btn btn-primary fw-bold px-4 py-2"
                                                        disabled="@(string.IsNullOrWhiteSpace(booker.Name) || string.IsNullOrWhiteSpace(booker.Phone))"
                                                        @onclick="PrepareStep3">
                                                    Tiếp tục: Thanh toán & Xác nhận <i class="bi bi-arrow-right ms-1"></i>
                                                </button>
                                            </div>
                                        }

                                        <!-- STEP 3: THANH TOÁN & XÁC NHẬN SANDBOX (Task 8) -->
                                        @if (bookingStep == 3)
                                        {
                                            <div class="row g-3">
                                                <div class="col-md-7">
                                                    <!-- Thông tin tóm tắt khách & chuyến -->
                                                    <div class="p-3 border rounded-3 bg-white mb-3">
                                                        <h6 class="fw-bold text-navy mb-2 d-flex align-items-center gap-2">
                                                            <i class="bi bi-shield-check text-success"></i> Xác nhận thông tin đặt chỗ
                                                        </h6>
                                                        <ul class="list-unstyled small mb-0 d-flex flex-column gap-1">
                                                            <li><span class="text-muted">Người liên hệ:</span> <strong class="text-dark">@booker.Name</strong> • SĐT: <strong class="text-dark">@booker.Phone</strong></li>
                                                            <li><span class="text-muted">Email:</span> <strong>@(string.IsNullOrWhiteSpace(booker.Email) ? "Không cung cấp" : booker.Email)</strong></li>
                                                            <li><span class="text-muted">Thời gian khởi hành:</span> <strong>@selectedTripDetail.DepartureTime.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong></li>
                                                            <li><span class="text-muted">Điểm đón:</span> <strong>@(selectedPickupPoint?.Time) - @(selectedPickupPoint?.Name)</strong> (@(selectedPickupPoint?.Address))</li>
                                                            <li><span class="text-muted">Điểm trả:</span> <strong>@(selectedDropoffPoint?.Time) - @(selectedDropoffPoint?.Name)</strong> (@(selectedDropoffPoint?.Address))</li>
                                                            <li><span class="text-muted">Ghế đã chọn:</span> <strong class="badge bg-primary text-white">@string.Join(", ", selectedSeats.OrderBy(s => s))</strong></li>
                                                            @if (booker.Passengers != null && booker.Passengers.Count > 1)
                                                            {
                                                                <li class="mt-2 pt-2 border-top">
                                                                    <span class="text-secondary fw-bold d-block mb-1">Danh sách hành khách theo từng ghế:</span>
                                                                    <div class="d-flex flex-column gap-1">
                                                                        @foreach (var p in booker.Passengers)
                                                                        {
                                                                            <div class="d-flex justify-content-between align-items-center bg-light px-2 py-1 rounded small">
                                                                                <span><strong class="text-primary me-1">[@p.SeatCode]</strong> @p.FullName @(p.IsPrimaryContact ? "(Đại diện)" : "")</span>
                                                                                <span class="text-muted">@p.PhoneNumber</span>
                                                                            </div>
                                                                        }
                                                                    </div>
                                                                </li>
                                                            }
                                                        </ul>
                                                    </div>

                                                    <!-- CỔNG THANH TOÁN MÔ PHỎNG (SANDBOX ENVIRONMENT) -->
                                                    <div class="p-3 border rounded-3 bg-light mb-3">
                                                        <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                                                            <div class="d-flex align-items-center gap-2">
                                                                <span class="badge bg-primary text-white"><i class="bi bi-wallet2 me-1"></i> Cổng Sandbox</span>
                                                                <strong class="small text-dark">Phương thức thanh toán thử nghiệm</strong>
                                                            </div>
                                                            <span class="badge bg-warning text-dark border border-warning-subtle fw-bold"><i class="bi bi-cpu me-1"></i> Môi trường Sandbox</span>
                                                        </div>
                                                        <p class="small text-muted mb-3">
                                                            Hệ thống đang hoạt động trong chế độ thử nghiệm (Sandbox). Bạn có thể lựa chọn phương thức thanh toán và kịch bản thử nghiệm bên dưới để kiểm tra toàn trình:
                                                        </p>

                                                        <!-- Chọn phương thức thanh toán -->
                                                        <div class="d-flex flex-column gap-2 mb-3">
                                                            <label class="tg-paymethod-card @(selectedPaymentMethod == "SANDBOX_ATM" ? "selected-payment" : "")">
                                                                <input type="radio" name="paymethod" class="form-check-input mt-0" checked="@(selectedPaymentMethod == "SANDBOX_ATM")" @onchange='() => selectedPaymentMethod = "SANDBOX_ATM"' />
                                                                <div class="tg-pay-icon bg-primary-subtle text-primary">
                                                                    <i class="bi bi-credit-card-2-front"></i>
                                                                </div>
                                                                <div class="flex-grow-1">
                                                                    <div class="fw-bold text-dark">Thẻ ATM / Chuyển khoản VietQR (Mô phỏng Sandbox)</div>
                                                                    <small class="text-muted d-block">Mô phỏng cổng thanh toán trực tuyến NAPAS / VNPAY / VietQR</small>
                                                                </div>
                                                            </label>
                                                            <label class="tg-paymethod-card @(selectedPaymentMethod == "SANDBOX_EWALLET" ? "selected-payment" : "")">
                                                                <input type="radio" name="paymethod" class="form-check-input mt-0" checked="@(selectedPaymentMethod == "SANDBOX_EWALLET")" @onchange='() => selectedPaymentMethod = "SANDBOX_EWALLET"' />
                                                                <div class="tg-pay-icon bg-success-subtle text-success">
                                                                    <i class="bi bi-phone"></i>
                                                                </div>
                                                                <div class="flex-grow-1">
                                                                    <div class="fw-bold text-dark">Ví điện tử MoMo / ZaloPay / PayOS (Mô phỏng Sandbox)</div>
                                                                    <small class="text-muted d-block">Mô phỏng quét mã QR thanh toán ví điện tử nhanh chóng</small>
                                                                </div>
                                                            </label>
                                                        </div>

                                                        <!-- Kịch bản thử nghiệm kết quả -->
                                                        <div class="p-3 rounded-3 border bg-white">
                                                            <span class="small fw-bold text-secondary d-block mb-2"><i class="bi bi-sliders me-1"></i> Kịch bản kiểm thử giao dịch:</span>
                                                            <div class="d-flex gap-3 flex-wrap">
                                                                <label class="cursor-pointer small d-flex align-items-center gap-2 text-success fw-bold">
                                                                    <input type="radio" name="paysim" class="form-check-input mt-0" checked="@(simulatePaymentSuccess)" @onchange="() => simulatePaymentSuccess = true" />
                                                                    <span>Thanh toán thành công (Mô phỏng)</span>
                                                                </label>
                                                                <label class="cursor-pointer small d-flex align-items-center gap-2 text-danger fw-bold">
                                                                    <input type="radio" name="paysim" class="form-check-input mt-0" checked="@(!simulatePaymentSuccess)" @onchange="() => simulatePaymentSuccess = false" />
                                                                    <span>Thanh toán thất bại (Mô phỏng từ chối thẻ)</span>
                                                                </label>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    @if (!string.IsNullOrWhiteSpace(bookingError))
                                                    {
                                                        <div class="alert alert-danger py-2 small mt-3 mb-0 rounded-3">
                                                            <i class="bi bi-exclamation-triangle-fill me-1"></i> @bookingError
                                                        </div>
                                                    }
                                                </div>

                                                <div class="col-md-5">
                                                    <div class="p-3 bg-light rounded-3 border sticky-top" style="top: 80px;">
                                                        <h6 class="fw-bold text-navy border-bottom pb-2 mb-3 d-flex align-items-center gap-2">
                                                            <i class="bi bi-wallet2 text-primary"></i> Chi tiết thanh toán
                                                        </h6>
                                                        @{
                                                            var basePricePerSeat = selectedTripDetail.BasePrice;
                                                            var totalBase = selectedSeats.Count * basePricePerSeat;
                                                            var totalSurcharge = Math.Max(0m, SeatTotal - totalBase);
                                                        }
                                                        <div class="d-flex justify-content-between small mb-2">
                                                            <span class="text-muted">Giá vé cơ sở (@selectedSeats.Count ghế):</span>
                                                            <strong class="text-dark">@totalBase.ToString("N0") đ</strong>
                                                        </div>
                                                        @if (totalSurcharge > 0)
                                                        {
                                                            <div class="d-flex justify-content-between small mb-2 text-primary">
                                                                <span>Phụ phí loại ghế:</span>
                                                                <strong>+@totalSurcharge.ToString("N0") đ</strong>
                                                            </div>
                                                        }
                                                        @if (booker.HasInsurance)
                                                        {
                                                            <div class="d-flex justify-content-between small mb-2">
                                                                <span>Bảo hiểm chuyến đi:</span>
                                                                <strong>@InsuranceTotal.ToString("N0") đ</strong>
                                                            </div>
                                                        }
                                                        <hr class="my-2" />
                                                        <div class="d-flex justify-content-between fs-4 fw-bold text-danger mb-3">
                                                            <span>Tổng thanh toán:</span>
                                                            <span>@BookingTotal.ToString("N0") đ</span>
                                                        </div>
                                                        <div class="p-2 bg-white rounded-3 border small text-muted">
                                                            <i class="bi bi-check2-circle text-success me-1"></i> Thanh toán mô phỏng an toàn, không phát sinh chi phí thực tế.
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top flex-wrap gap-2">
                                                <BackButton Label="Quay lại thông tin khách" OnClick="() => bookingStep = 2" />
                                                <button type="button" class="btn btn-success fw-bold px-4 py-2" disabled="@isBooking" @onclick="ExecutePaymentAndConfirm">
                                                    @if (isBooking)
                                                    {
                                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                                        <span>Đang xử lý thanh toán sandbox...</span>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-credit-card-fill me-1"></i>
                                                        <span>Thanh toán sandbox @BookingTotal.ToString("N0") đ & xác nhận đặt chỗ</span>
                                                    }
                                                </button>
                                            </div>
                                        }

                                        <!-- STEP 4: MÀN HÌNH XÁC NHẬN BOARDING PASS -->
                                        @if (bookingStep == 4)
                                        {
                                            <div class="p-4 p-md-5 bg-white border border-success-subtle rounded-4 text-center my-2 shadow-sm">
                                                <div class="tg-success-checkmark-circle mb-3">
                                                    <i class="bi bi-check-lg"></i>
                                                </div>
                                                <h3 class="fw-bold text-success mb-1">Đặt chỗ và thanh toán mô phỏng hoàn tất</h3>
                                                <p class="text-muted small mb-4">
                                                    Đơn đặt chỗ của bạn đã được thanh toán và xác nhận hoàn tất trong môi trường thử nghiệm (Sandbox).
                                                </p>

                                                <!-- Polished Boarding Pass Card with Strict Hierarchy -->
                                                <div class="tg-boarding-pass mb-4 text-start">
                                                    <!-- 1. Booking Reference & Status Header -->
                                                    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 pb-3 border-bottom gap-2">
                                                        <div>
                                                            <span class="text-muted small d-block">Mã đặt chỗ (Booking Code):</span>
                                                            <strong class="fs-4 text-primary font-monospace">@confirmedBookingCode</strong>
                                                        </div>
                                                        <div class="d-flex align-items-center gap-2">
                                                            <span class="badge bg-success px-3 py-2 rounded-pill fw-bold">
                                                                <i class="bi bi-check-circle-fill me-1"></i> Đã thanh toán
                                                            </span>
                                                            <span class="badge bg-warning bg-opacity-25 text-dark border border-warning rounded-pill px-2 py-1 small fw-bold">
                                                                SANDBOX
                                                            </span>
                                                        </div>
                                                    </div>

                                                    <!-- 2 & 3. Route, Date, Departure & Vehicle Info -->
                                                    <div class="bg-light p-3 rounded-3 mb-3 border">
                                                        <div class="row g-2 align-items-center">
                                                            <div class="col-md-7">
                                                                <div class="text-muted small fw-bold text-uppercase">Hành trình & Nhà xe</div>
                                                                <div class="fw-bold text-dark fs-5 mt-1">@confirmedTripName</div>
                                                                <div class="text-primary small fw-semibold">
                                                                    @(selectedTripDetail?.OperatorName ?? "Nhà xe đối tác") · @(selectedTripDetail?.BusTypeName ?? "Xe giường nằm")
                                                                </div>
                                                            </div>
                                                            <div class="col-md-5 text-md-end">
                                                                <div class="text-muted small fw-bold text-uppercase">Thời gian khởi hành</div>
                                                                <div class="fw-bold text-primary fs-5 mt-1">
                                                                    @(selectedTripDetail?.DepartureTime.ToLocalTime().ToString("HH:mm - dd/MM/yyyy") ?? DepartureDateLabel)
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <!-- 4. Passenger & Seat Information -->
                                                    <div class="mb-3">
                                                        <div class="text-muted small fw-bold text-uppercase mb-2">Thông tin hành khách & Chỗ ngồi</div>
                                                        <div class="p-3 bg-white rounded-3 border">
                                                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2 pb-2 border-bottom">
                                                                <div>
                                                                    <span class="text-muted small">Người đại diện đặt vé:</span>
                                                                    <strong class="text-dark ms-1">@booker.Name</strong>
                                                                    <span class="text-secondary small ms-2">(@booker.Phone)</span>
                                                                </div>
                                                                <div>
                                                                    <span class="text-muted small">Vị trí ghế:</span>
                                                                    <span class="badge bg-primary fs-6 font-monospace ms-1">@confirmedSeatList</span>
                                                                </div>
                                                            </div>
                                                            @if (booker.Passengers != null && booker.Passengers.Count > 1)
                                                            {
                                                                <div class="small text-muted">
                                                                    <span class="fw-semibold text-dark">Danh sách hành khách đi cùng:</span>
                                                                    <ul class="list-unstyled mb-0 mt-1 d-flex flex-column gap-1">
                                                                        @foreach (var p in booker.Passengers)
                                                                        {
                                                                            <li>
                                                                                <i class="bi bi-person-fill text-primary me-1"></i>
                                                                                <strong>[@p.SeatCode]</strong> @p.FullName - @p.PhoneNumber
                                                                            </li>
                                                                        }
                                                                    </ul>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>

                                                    <!-- 5. Itemized Price and Payment Status -->
                                                    <div class="mb-3">
                                                        <div class="text-muted small fw-bold text-uppercase mb-2">Chi tiết thanh toán & Giao dịch</div>
                                                        <div class="p-3 bg-light rounded-3 border">
                                                            <div class="d-flex justify-content-between small mb-1">
                                                                <span class="text-secondary">Phương thức thanh toán:</span>
                                                                <strong class="text-dark">@confirmedPaymentMethod</strong>
                                                            </div>
                                                            <div class="d-flex justify-content-between small mb-1">
                                                                <span class="text-secondary">Mã giao dịch xác thực:</span>
