        CloseTripDetail();
        NavigationManager.NavigateTo("/");
    }

    private Dictionary<string, BookingPassengerDto> companionMap = new(StringComparer.OrdinalIgnoreCase);

    private BookingPassengerDto GetCompanionPassenger(string seatCode)
    {
        if (!companionMap.TryGetValue(seatCode, out var p))
        {
            p = new BookingPassengerDto
            {
                SeatCode = seatCode,
                FullName = string.Empty,
                PhoneNumber = string.Empty,
                IsPrimaryContact = false
            };
            companionMap[seatCode] = p;
        }
        return p;
    }

    private async Task ProceedToPickupDropoff()
    {
        if (selectedTripDetail == null || !selectedTripDetail.IsBookable || selectedSeats.Count == 0 || isHoldingSeats) return;

        isHoldingSeats = true;
        bookingError = null;

        try
        {
            var holdResult = await BookingService.HoldSeatsAsync(new SeatHoldRequestDto
            {
                TripId = selectedTripDetail.Id,
                SeatCodes = selectedSeats.ToList(),
                ExistingHoldToken = activeHoldToken,
                HoldMinutes = 10
            });

            if (holdResult.Success && !string.IsNullOrEmpty(holdResult.HoldToken))
            {
                activeHoldToken = holdResult.HoldToken;
                holdExpiresAt = holdResult.ExpiresAt ?? DateTimeOffset.UtcNow.AddMinutes(10);
                StartHoldCountdown();
                if (selectedPickupPoint == null && selectedTripDetail.PickupPoints.Count == 1)
                {
                    selectedPickupPoint = selectedTripDetail.PickupPoints[0];
                }
                if (selectedDropoffPoint == null && selectedTripDetail.DropoffPoints.Count == 1)
                {
                    selectedDropoffPoint = selectedTripDetail.DropoffPoints[0];
                }
                bookingStep = 1;
            }
            else
            {
                bookingError = holdResult.Message ?? "Một số ghế vừa được giữ chỗ bởi hành khách khác. Vui lòng chọn lại.";
                selectedTripDetail = await TripService.GetTripDetailsAsync(selectedTripDetail.Id);
                selectedSeats.Clear();
                companionMap.Clear();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Seat hold failed for trip {TripId}.", selectedTripDetail?.Id);
            bookingError = "Không thể giữ chỗ lúc này. Vui lòng thử lại.";
        }
        finally
        {
            isHoldingSeats = false;
        }
    }

    private void StartHoldCountdown()
    {
        StopHoldCountdown();
        countdownCts = new CancellationTokenSource();
        var token = countdownCts.Token;

        _ = Task.Run(async () =>
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (!token.IsCancellationRequested && await timer.WaitForNextTickAsync(token))
            {
                if (holdExpiresAt == null) break;
                var remaining = holdExpiresAt.Value - DateTimeOffset.UtcNow;
                if (remaining <= TimeSpan.Zero)
                {
                    countdownText = "00:00";
                    await InvokeAsync(HandleHoldExpired);
                    break;
                }
                else
                {
                    countdownText = $"{remaining.Minutes:D2}:{remaining.Seconds:D2}";
                    await InvokeAsync(StateHasChanged);
                }
            }
        }, token);
    }

    private void StopHoldCountdown()
    {
        try
        {
            countdownCts?.Cancel();
            countdownCts?.Dispose();
        }
        catch { }
        finally
        {
            countdownCts = null;
        }
    }

    private async Task HandleHoldExpired()
    {
        StopHoldCountdown();
        activeHoldToken = null;
        holdExpiresAt = null;
        bookingStep = 0;
        bookingError = "Thời gian giữ chỗ 10 phút của bạn đã hết hạn. Hệ thống đã tự động giải phóng ghế, vui lòng chọn lại ghế.";
        if (selectedTripDetail != null)
        {
            selectedTripDetail = await TripService.GetTripDetailsAsync(selectedTripDetail.Id);
        }
        selectedSeats.Clear();
        companionMap.Clear();
        StateHasChanged();
    }

    private void PrepareStep3()
    {
        if (string.IsNullOrWhiteSpace(booker.Name) || string.IsNullOrWhiteSpace(booker.Phone))
        {
            bookingError = "Vui lòng nhập đầy đủ họ tên và số điện thoại liên hệ.";
            bookingStep = 2;
            return;
        }

        if (string.IsNullOrWhiteSpace(booker.Email) ||
            booker.Email.Length > 254 ||
            !new System.ComponentModel.DataAnnotations.EmailAddressAttribute()
                .IsValid(booker.Email.Trim()) ||
            !contactEmailConfirmed)
        {
            bookingError = "Vui lòng nhập email liên hệ hợp lệ và xác nhận địa chỉ này.";
            bookingStep = 2;
            return;
        }

        bookingError = null;
        var sortedSeats = selectedSeats.OrderBy(s => s).ToList();
        booker.Passengers.Clear();

        // 1st seat is primary contact
        booker.Passengers.Add(new BookingPassengerDto
        {
            FullName = booker.Name.Trim(),
            PhoneNumber = booker.Phone.Trim(),
            Email = booker.Email?.Trim(),
            SeatCode = sortedSeats[0],
            IsPrimaryContact = true
        });

        // Companion passengers for remaining seats
        for (int i = 1; i < sortedSeats.Count; i++)
        {
            var seatCode = sortedSeats[i];
            var comp = GetCompanionPassenger(seatCode);
            var name = !string.IsNullOrWhiteSpace(comp.FullName) ? comp.FullName.Trim() : $"{booker.Name.Trim()} (Khách {i + 1})";
            var phone = !string.IsNullOrWhiteSpace(comp.PhoneNumber) ? comp.PhoneNumber.Trim() : booker.Phone.Trim();

            booker.Passengers.Add(new BookingPassengerDto
            {
                FullName = name,
                PhoneNumber = phone,
                Email = booker.Email?.Trim(),
                SeatCode = seatCode,
                IsPrimaryContact = false
            });
        }

        bookingStep = 3;
    }

    private void ResetContactEmailConfirmation()
    {
        contactEmailConfirmed = false;
    }

    private async Task ExecutePaymentAndConfirm()
    {
        if (selectedTripDetail == null || !selectedTripDetail.IsBookable || selectedSeats.Count == 0 || isBooking) return;

        if (string.IsNullOrWhiteSpace(booker.Name) || string.IsNullOrWhiteSpace(booker.Phone))
        {
            bookingError = "Vui lòng nhập đầy đủ họ tên và số điện thoại liên hệ.";
            bookingStep = 2;
            return;
        }

        if (string.IsNullOrWhiteSpace(booker.Email) ||
            booker.Email.Length > 254 ||
            !new System.ComponentModel.DataAnnotations.EmailAddressAttribute()
                .IsValid(booker.Email.Trim()) ||
            !contactEmailConfirmed)
        {
            bookingError = "Vui lòng nhập email liên hệ hợp lệ và xác nhận địa chỉ này.";
            bookingStep = 2;
            return;
        }

        if (string.IsNullOrEmpty(activeHoldToken))
        {
            bookingError = "Phiên giữ chỗ của bạn đã hết hạn. Vui lòng chọn lại ghế.";
            bookingStep = 0;
            return;
        }

        if (booker.Passengers == null || booker.Passengers.Count != selectedSeats.Count)
        {
            PrepareStep3();
        }

        bookingError = null;
        isBooking = true;
        booker.SelectedPickupPoint = selectedPickupPoint?.Name ?? (originLocation?.Name ?? "Điểm đi");
        booker.SelectedDropoffPoint = selectedDropoffPoint?.Name ?? (destLocation?.Name ?? "Điểm đến");
        booker.PickupPoint = booker.SelectedPickupPoint;
        booker.PickupPointId = selectedPickupPoint?.Id;
        booker.DropoffPointId = selectedDropoffPoint?.Id;

        try
        {
            var tripId = selectedTripDetail.Id;
            var seatsToBook = selectedSeats.ToList();

            // 1. Ensure booking record exists in PendingPayment
            if (string.IsNullOrWhiteSpace(confirmedBookingCode))
            {
                var bookingReq = new CreateBookingRequestDto
                {
                    TripId = tripId,
                    HoldToken = activeHoldToken,
                    OwnerIdentifier = booker.OwnerIdentifier,
                    SeatCodes = seatsToBook,
                    PickupPointId = booker.PickupPointId,
                    DropoffPointId = booker.DropoffPointId,
                    PassengerName = booker.Name,
                    PassengerPhone = booker.Phone,
                    PassengerEmail = booker.Email,
                    ContactEmailConfirmed = contactEmailConfirmed,
                    HasInsurance = false,
                    Passengers = booker.Passengers ?? new()
                };

                var createResult = await BookingService.CreateBookingAsync(bookingReq);
                if (!createResult.Success || string.IsNullOrEmpty(createResult.BookingCode))
                {
                    bookingError = createResult.Message ?? "Không thể khởi tạo đơn đặt chỗ. Vui lòng thử lại.";
                    if (createResult.Message?.Contains("hết hạn", StringComparison.OrdinalIgnoreCase) == true)
                    {
                        await HandleHoldExpired();
                    }
                    return;
                }

                confirmedBookingCode = createResult.BookingCode;
                confirmedTotalAmount = createResult.TotalAmount;
            }

            // 2. Process Sandbox Payment
            var payReq = new ProcessPaymentRequestDto
            {
                BookingCode = confirmedBookingCode,
                PaymentMethod = selectedPaymentMethod,
                Amount = confirmedTotalAmount,
                SimulateSuccess = simulatePaymentSuccess,
                FailureReason = simulatePaymentSuccess ? null : "Giao dịch mô phỏng bị từ chối (Mã lỗi Sandbox E05: Số dư không đủ)."
            };

            var payResult = await PaymentService.ProcessPaymentAsync(payReq);
            if (payResult.Success)
            {
                StopHoldCountdown();
                confirmedTransactionCode = payResult.TransactionCode;
                confirmedPaymentMethod = selectedPaymentMethod switch
                {
                    "SANDBOX_ATM" => "Thẻ ATM nội địa (Sandbox)",
                    "SANDBOX_EWALLET" => "Ví điện tử MoMo/PayOS (Sandbox)",
                    _ => "Mô phỏng Sandbox"
                };
                confirmedSeatList = string.Join(", ", seatsToBook.OrderBy(s => s));
                confirmedTripName = selectedTripDetail.RouteName;
                bookingStep = 4; // Advance to confirmation card

                // Refresh search results
                try
                {
                    searchResults = await TripService.SearchTripsAsync(searchModel);
                    ApplySort();
                }
                catch { }
            }
            else
            {
                bookingError = "Thanh toán mô phỏng không thành công: " + payResult.Message +
                               $" (Đơn đặt chỗ {confirmedBookingCode} vẫn được giữ. Bạn có thể chọn lại kịch bản thành công và thử lại trước khi hết thời gian giữ chỗ).";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Sandbox booking payment processing failed.");
            bookingError = "Không thể xử lý thanh toán mô phỏng lúc này. Vui lòng thử lại.";
        }
        finally
        {
            isBooking = false;
        }
    }

    public void Dispose()
    {
        StopHoldCountdown();
    }

