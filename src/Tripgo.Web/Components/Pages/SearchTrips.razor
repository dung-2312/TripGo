</style>

@code {
    private List<LocationDto> locations = new();
    private List<TripSearchResultDto> searchResults = new();
    private TripSearchRequestDto searchModel = new()
    {
        DepartureDate = DateOnly.FromDateTime(DateTime.Today)
    };

    private LocationDto? originLocation;
    private LocationDto? destLocation;

    private bool showOriginDropdown = false;
    private bool showDestDropdown = false;
    private string originSearchText = "";
    private string destSearchText = "";

    private bool isLoading = false;
    private bool hasSearched = false;
    private bool showSupportDrawer;
    private string? errorMessage;

    private long? selectedTripId;
    private TripDetailDto? selectedTripDetail;
    private HashSet<string> selectedSeats = new();
    private int bookingStep;
    private PickupDropoffPointDto? selectedPickupPoint;
    private PickupDropoffPointDto? selectedDropoffPoint;
    private bool isBooking;
    private string? bookingError;

    private string sortOrder = "departure_asc";
    private CustomerBookingInfoDto booker = new();
    private bool filterMorning;
    private bool filterAfternoon;
    private bool filterEvening;
    private decimal maximumPrice = 5_000_000m;
    private HashSet<string> selectedOperators = new(StringComparer.OrdinalIgnoreCase);
    private decimal SeatTotal => selectedSeats.Count * (selectedTripDetail?.BasePrice ?? 0);
    private decimal InsuranceTotal => booker.HasInsurance ? selectedSeats.Count * 20_000m : 0;
    private decimal BookingTotal => SeatTotal + InsuranceTotal;
    private string DepartureDateLabel => searchModel.DepartureDate.ToDateTime(TimeOnly.MinValue)
        .ToString("dddd, dd/MM/yyyy", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"));

    private IEnumerable<TripSearchResultDto> VisibleSearchResults
    {
        get
        {
            var trips = searchResults.AsEnumerable();
            if (selectedOperators.Count > 0)
                trips = trips.Where(trip => selectedOperators.Contains(trip.OperatorName));

            if (filterMorning || filterAfternoon || filterEvening)
                trips = trips.Where(trip => IsWithinSelectedDeparturePeriod(trip.DepartureTime));

            return trips.Where(trip => trip.BasePrice <= maximumPrice);
        }
    }

    private bool HasNearbyDateSuggestions => searchResults.Any(trip =>
        trip.DepartureTime.ToLocalTime().Date != searchModel.DepartureDate.ToDateTime(TimeOnly.MinValue).Date);

    private IEnumerable<LocationDto> FilteredOriginLocations =>
        string.IsNullOrWhiteSpace(originSearchText)
            ? locations
            : locations.Where(l => l.Name.Contains(originSearchText, StringComparison.OrdinalIgnoreCase) ||
                                  (l.Province?.Contains(originSearchText, StringComparison.OrdinalIgnoreCase) ?? false));

    private IEnumerable<LocationDto> FilteredDestLocations =>
        string.IsNullOrWhiteSpace(destSearchText)
            ? locations
            : locations.Where(l => l.Name.Contains(destSearchText, StringComparison.OrdinalIgnoreCase) ||
                                  (l.Province?.Contains(destSearchText, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        locations = await TripService.GetLocationsAsync();
    }

    private Task CloseSupportDrawerAsync()
    {
        showSupportDrawer = false;
        return Task.CompletedTask;
    }

    private void ToggleDropdown(bool isOrigin)
    {
        if (isOrigin)
        {
            showOriginDropdown = !showOriginDropdown;
            showDestDropdown = false;
        }
        else
        {
            showDestDropdown = !showDestDropdown;
            showOriginDropdown = false;
        }
    }

    private void SelectOrigin(LocationDto loc)
    {
        originLocation = loc;
        searchModel.OriginLocationId = loc.Id;
        showOriginDropdown = false;
    }

    private void SelectDestination(LocationDto loc)
    {
        destLocation = loc;
        searchModel.DestinationLocationId = loc.Id;
        showDestDropdown = false;
    }

    private void SwapLocations()
    {
        (originLocation, destLocation) = (destLocation, originLocation);
        (searchModel.OriginLocationId, searchModel.DestinationLocationId) = (searchModel.DestinationLocationId, searchModel.OriginLocationId);
    }

    private async Task HandleSearch()
    {
        errorMessage = null;
        showOriginDropdown = false;
        showDestDropdown = false;

        if (searchModel.OriginLocationId == 0 || searchModel.DestinationLocationId == 0)
        {
            errorMessage = "Vui lòng chọn đầy đủ nơi xuất phát và nơi đến.";
            return;
        }

        if (searchModel.OriginLocationId == searchModel.DestinationLocationId)
        {
            errorMessage = "Nơi xuất phát và nơi đến không được trùng nhau.";
            return;
        }

        isLoading = true;
        selectedTripId = null;
        selectedSeats.Clear();

        try
        {
            searchResults = await TripService.SearchTripsAsync(searchModel);
            ApplySort();
            hasSearched = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplySort()
    {
        searchResults = sortOrder switch
        {
            "default" => searchResults.OrderBy(s => s.DepartureTime).ToList(),
            "departure_asc" => searchResults.OrderBy(s => s.DepartureTime).ToList(),
            "departure_desc" => searchResults.OrderByDescending(s => s.DepartureTime).ToList(),
            "price_asc" => searchResults.OrderBy(s => s.BasePrice).ToList(),
            "price_desc" => searchResults.OrderByDescending(s => s.BasePrice).ToList(),
            _ => searchResults
        };
    }

    private void SetSortOrder(string order)
    {
        sortOrder = order;
        ApplySort();
    }

    private void HandleSortChange(ChangeEventArgs args)
    {
        if (args.Value is string order)
            SetSortOrder(order);
    }

    private bool IsWithinSelectedDeparturePeriod(DateTimeOffset departureTime)
    {
        var hour = departureTime.ToLocalTime().Hour;
        return (filterMorning && hour < 12) ||
               (filterAfternoon && hour >= 12 && hour < 18) ||
               (filterEvening && hour >= 18);
    }

    private void ToggleOperatorFilter(string operatorName, ChangeEventArgs args)
    {
        if (args.Value is true)
            selectedOperators.Add(operatorName);
        else
            selectedOperators.Remove(operatorName);
    }

    private static string GetDurationText(DateTimeOffset departure, DateTimeOffset arrival)
    {
        var duration = arrival - departure;
        if (duration < TimeSpan.Zero)
            duration = duration.Add(TimeSpan.FromDays(1));

        return $"{(int)duration.TotalHours}h{duration.Minutes:00}m";
    }

    private string GetBerthClasses(SeatLayoutItemDto seat) =>
        $"{GetSeatClass(seat)} {(seat.SeatType == "DoubleBed" ? "double-berth" : string.Empty)}";

    private async Task QuickSearchAsync(string originCode, string destinationCode)
    {
        originLocation = locations.FirstOrDefault(location => location.Code == originCode);
        destLocation = locations.FirstOrDefault(location => location.Code == destinationCode);
        if (originLocation == null || destLocation == null)
        {
            errorMessage = "Tuyến đường hiện chưa có trong danh mục địa điểm.";
            return;
        }

        searchModel.OriginLocationId = originLocation.Id;
        searchModel.DestinationLocationId = destLocation.Id;
        searchModel.DepartureDate = DateOnly.FromDateTime(DateTime.Today);
        await HandleSearch();
        await JSRuntime.InvokeVoidAsync("tripgo.scrollToResults");
    }

    private async Task ToggleSelectTrip(long tripId)
    {
        if (selectedTripId == tripId)
        {
            selectedTripId = null;
            selectedTripDetail = null;
            selectedSeats.Clear();
            bookingStep = 0;
            return;
        }

        selectedTripId = tripId;
        selectedSeats.Clear();
        selectedPickupPoint = null;
        selectedDropoffPoint = null;
        bookingStep = 0;
        bookingError = null;
        booker = new CustomerBookingInfoDto();
        selectedTripDetail = await TripService.GetTripDetailsAsync(tripId);
    }

    private void ToggleSeat(string seatCode)
    {
        if (selectedSeats.Contains(seatCode))
            selectedSeats.Remove(seatCode);
        else
            selectedSeats.Add(seatCode);
    }

    private string GetSeatClass(SeatLayoutItemDto seat)
    {
        if (!seat.IsAvailable) return "";
        if (selectedSeats.Contains(seat.SeatCode)) return "seat-selected";
        return "";
    }

    private void ContinueToPoints()
    {
        if (selectedSeats.Count > 0)
            bookingStep = 1;
    }

    private void SelectPickup(PickupDropoffPointDto point) => selectedPickupPoint = point;

    private void SelectDropoff(PickupDropoffPointDto point) => selectedDropoffPoint = point;

    private async Task ConfirmBooking()
    {
        if (selectedTripDetail == null || selectedSeats.Count == 0 || isBooking) return;

        if (string.IsNullOrWhiteSpace(booker.Name) || string.IsNullOrWhiteSpace(booker.Phone))
        {
            bookingError = "Vui lòng nhập đầy đủ họ tên và số điện thoại.";
            return;
        }

        if (selectedPickupPoint == null || selectedDropoffPoint == null)
        {
            bookingError = "Vui lòng chọn điểm đón và điểm trả.";
            return;
        }

        bookingError = null;
        isBooking = true;
        booker.SelectedPickupPoint = selectedPickupPoint.Name;
        booker.SelectedDropoffPoint = selectedDropoffPoint.Name;
        booker.PickupPoint = selectedPickupPoint.Name;

        try
        {
            var tripId = selectedTripDetail.Id;
            var success = await TripService.BookSeatsAsync(tripId, selectedSeats.ToList(), booker);
            if (success)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Đặt vé thành công! Mã đặt chỗ: {booker.BookingCode}");
                searchResults = await TripService.SearchTripsAsync(searchModel);
                ApplySort();
                selectedSeats.Clear();
                selectedTripId = null;
                selectedTripDetail = null;
                selectedPickupPoint = null;
                selectedDropoffPoint = null;
                bookingStep = 0;
                booker = new CustomerBookingInfoDto();
            }
            else
            {
                bookingError = "Một số ghế vừa được đặt. Vui lòng chọn lại ghế còn trống.";
                selectedTripDetail = await TripService.GetTripDetailsAsync(tripId);
                selectedSeats.Clear();
                bookingStep = 0;
            }
        }
        finally
        {
            isBooking = false;
        }
    }
}
