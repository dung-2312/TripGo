@page "/search-trips"
@page "/search"
@page "/"
@layout Tripgo.Web.Components.Layout.CustomerLayout
@using Tripgo.Application.DTOs
@using Tripgo.Application.Interfaces
@inject ITripService TripService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>TripGo - Đặt vé xe khách trực tuyến toàn quốc</PageTitle>

<div class="tg-portal">
    <!-- ========================================================
         HERO & SEARCH HUB
         ======================================================== -->
    <section class="tg-hero py-4">
        <div class="container">
            <div class="text-center mb-4 text-white">
                <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-2">
                    <i class="bi bi-shield-check me-1"></i> Nền tảng đặt vé xe uy tín
                </span>
                <h1 class="fw-bold display-6 mb-2">HÀNH TRÌNH VẠN DẶM BẮT ĐẦU TẠI ĐÂY</h1>
                <p class="opacity-90 lead fs-6 mb-0">Tra cứu tuyến đường, so sánh giá vé và giữ chỗ trực tuyến dễ dàng</p>
            </div>

            <!-- Search Card -->
            <div class="tg-search-box shadow-lg bg-white rounded-4 p-3 p-md-4 mx-auto">
                <!-- Search Inputs Grid -->
                <div class="row g-2 align-items-center">
                    <!-- Nơi xuất phát -->
                    <div class="col-lg-3 col-md-6 position-relative">
                        <div class="tg-input-wrapper p-2 border rounded-3 cursor-pointer" @onclick="() => ToggleDropdown(true)">
                            <label class="tg-label small text-muted d-block fw-semibold">
                                <i class="bi bi-geo-alt-fill text-primary me-1"></i> Nơi xuất phát
                            </label>
                            <div class="tg-val fw-bold text-dark text-truncate">
                                @(originLocation != null ? $"{originLocation.Name} ({originLocation.Province})" : "Chọn điểm đi")
                            </div>
                        </div>

                        @if (showOriginDropdown)
                        {
                            <div class="tg-dropdown shadow rounded-3 border bg-white position-absolute start-0 end-0 z-3 p-2 mt-1" @onclick:stopPropagation="true">
                                <div class="input-group input-group-sm mb-2">
                                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                                    <input type="text" class="form-control" placeholder="Tìm tỉnh/thành..." @bind="originSearchText" @bind:event="oninput" autofocus />
                                </div>
                                <div class="tg-dropdown-items" style="max-height: 200px; overflow-y: auto;">
                                    @foreach (var loc in FilteredOriginLocations)
                                    {
                                        <div class="p-2 rounded cursor-pointer tg-drop-item @(searchModel.OriginLocationId == loc.Id ? "bg-primary-subtle text-primary fw-bold" : "")"
                                             @onclick="() => SelectOrigin(loc)">
                                            <i class="bi bi-geo-alt me-1 text-primary"></i> @loc.Name <span class="text-muted small">(@loc.Province)</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Nút Swap Đảo chiều -->
                    <div class="col-auto d-none d-lg-flex justify-content-center px-0">
                        <button type="button" class="btn btn-light border rounded-circle tg-swap-btn" @onclick="SwapLocations" title="Đổi nơi đi và nơi đến">
                            <i class="bi bi-arrow-left-right text-primary"></i>
                        </button>
                    </div>

                    <!-- Nơi đến -->
                    <div class="col-lg-3 col-md-6 position-relative">
                        <div class="tg-input-wrapper p-2 border rounded-3 cursor-pointer" @onclick="() => ToggleDropdown(false)">
                            <label class="tg-label small text-muted d-block fw-semibold">
                                <i class="bi bi-geo-alt-fill text-danger me-1"></i> Nơi đến
                            </label>
                            <div class="tg-val fw-bold text-dark text-truncate">
                                @(destLocation != null ? $"{destLocation.Name} ({destLocation.Province})" : "Chọn điểm đến")
                            </div>
                        </div>

                        @if (showDestDropdown)
                        {
                            <div class="tg-dropdown shadow rounded-3 border bg-white position-absolute start-0 end-0 z-3 p-2 mt-1" @onclick:stopPropagation="true">
                                <div class="input-group input-group-sm mb-2">
                                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                                    <input type="text" class="form-control" placeholder="Tìm tỉnh/thành..." @bind="destSearchText" @bind:event="oninput" autofocus />
                                </div>
                                <div class="tg-dropdown-items" style="max-height: 200px; overflow-y: auto;">
                                    @foreach (var loc in FilteredDestLocations)
                                    {
                                        <div class="p-2 rounded cursor-pointer tg-drop-item @(searchModel.DestinationLocationId == loc.Id ? "bg-primary-subtle text-danger fw-bold" : "")"
                                             @onclick="() => SelectDestination(loc)">
                                            <i class="bi bi-geo-alt me-1 text-danger"></i> @loc.Name <span class="text-muted small">(@loc.Province)</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Ngày đi -->
                    <div class="col-lg-3 col-md-6">
                        <div class="p-2 border rounded-3 bg-white">
                            <label class="small text-muted d-block fw-semibold mb-1">
                                <i class="bi bi-calendar3 text-primary me-1"></i> Ngày đi
                            </label>
                            <InputDate @bind-Value="searchModel.DepartureDate" class="form-control form-control-sm border-0 p-0 fw-bold fs-6" />
                        </div>
                    </div>

                    <!-- Nút Tìm kiếm -->
                    <div class="col-lg col-md-6">
                        <button type="button" class="btn btn-warning w-100 py-3 fw-bold text-dark rounded-3 fs-5" @onclick="HandleSearch" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <span>Đang tìm...</span>
                            }
                            else
                            {
                                <i class="bi bi-search me-1"></i>
                                <span>Tìm vé</span>
                            }
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-warning py-2 mt-3 mb-0 small rounded-3 d-flex align-items-center">
                        <i class="bi bi-exclamation-triangle-fill me-2 fs-6"></i>
                        <span>@errorMessage</span>
                    </div>
                }
            </div>

            <!-- Cam kết dịch vụ -->
            <div class="d-flex flex-wrap justify-content-center gap-4 mt-4 text-white small fw-semibold">
                <div><i class="bi bi-patch-check-fill text-warning me-1"></i> Xác nhận chỗ ngồi trực tuyến</div>
                <div><i class="bi bi-headset text-warning me-1"></i> Hỗ trợ hành khách 24/7</div>
                <div><i class="bi bi-tag-fill text-warning me-1"></i> Giá vé chính thức từ nhà xe</div>
                <div><i class="bi bi-credit-card-2-front-fill text-warning me-1"></i> Thanh toán an toàn tiện lợi</div>
            </div>
        </div>
    </section>

    <!-- ========================================================
         MAIN CONTENT: Search Results OR Landing Content
         ======================================================== -->
    <main class="container my-4" id="trip-results">
        @if (hasSearched)
        {
            <!-- TOP SEARCH SUMMARY BAR -->
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-4">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                    <div>
                        <div class="text-muted small fw-semibold">KẾT QUẢ TÌM KIẾM</div>
                        <h4 class="fw-bold mb-0 text-primary">
                            @(originLocation?.Name ?? "Điểm đi") <i class="bi bi-arrow-right text-muted mx-1"></i> @(destLocation?.Name ?? "Điểm đến")
                        </h4>
                        <div class="small text-secondary mt-1">
                            <i class="bi bi-calendar-event me-1"></i> Ngày đi: <strong>@DepartureDateLabel</strong> • Tìm thấy <strong>@VisibleSearchResults.Count()</strong> chuyến
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <BackButton Label="Quay lại trang chủ" FallbackUrl="/" OnClick="ResetToHome" />
                    </div>
                </div>
            </div>

            <div class="row g-4">
                <!-- CỘT LỌC BÊN TRÁI -->
                <aside class="col-lg-3 mb-4">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white sticky-top" style="top: 80px;">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="fw-bold fs-6"><i class="bi bi-funnel-fill text-primary me-1"></i> Bộ lọc chuyến xe</span>
                            <button type="button" class="btn btn-sm btn-link text-decoration-none p-0 text-muted" @onclick="ResetFilters">
                                Đặt lại
                            </button>
                        </div>

                        <!-- Sắp xếp theo -->
                        <div class="mb-3">
                            <label class="fw-bold small text-secondary text-uppercase mb-2 d-block">Sắp xếp theo</label>
                            <div class="d-flex flex-column gap-2 small">
                                <label class="cursor-pointer"><input type="radio" name="sort" value="departure_asc" checked='@(sortOrder == "departure_asc")' @onchange="HandleSortChange" class="me-2" /> Giờ đi sớm nhất</label>
                                <label class="cursor-pointer"><input type="radio" name="sort" value="departure_desc" checked='@(sortOrder == "departure_desc")' @onchange="HandleSortChange" class="me-2" /> Giờ đi muộn nhất</label>
                                <label class="cursor-pointer"><input type="radio" name="sort" value="price_asc" checked='@(sortOrder == "price_asc")' @onchange="HandleSortChange" class="me-2" /> Giá vé tăng dần</label>
                                <label class="cursor-pointer"><input type="radio" name="sort" value="price_desc" checked='@(sortOrder == "price_desc")' @onchange="HandleSortChange" class="me-2" /> Giá vé giảm dần</label>
                            </div>
                        </div>

                        <hr />

                        <!-- Khung giờ khởi hành -->
                        <div class="mb-3">
                            <label class="fw-bold small text-secondary text-uppercase mb-2 d-block">Giờ khởi hành</label>
                            <div class="d-flex flex-column gap-2 small">
                                <label class="cursor-pointer"><input type="checkbox" @bind="filterMorning" class="me-2" /> Buổi sáng (00:00 – 11:59)</label>
                                <label class="cursor-pointer"><input type="checkbox" @bind="filterAfternoon" class="me-2" /> Buổi chiều (12:00 – 17:59)</label>
                                <label class="cursor-pointer"><input type="checkbox" @bind="filterEvening" class="me-2" /> Buổi tối (18:00 – 23:59)</label>
                            </div>
                        </div>

                        <hr />

                        <!-- Nhà xe vận hành (Lấy từ kết quả DB thực tế) -->
                        @if (AvailableOperators.Any())
                        {
                            <div class="mb-3">
                                <label class="fw-bold small text-secondary text-uppercase mb-2 d-block">Nhà xe</label>
                                <div class="d-flex flex-column gap-2 small" style="max-height: 160px; overflow-y: auto;">
                                    @foreach (var op in AvailableOperators)
                                    {
                                        <label class="cursor-pointer">
                                            <input type="checkbox" checked="@selectedOperators.Contains(op)" @onchange="args => ToggleOperatorFilter(op, args)" class="me-2" />
                                            @op
                                        </label>
                                    }
                                </div>
                            </div>
                            <hr />
                        }

                        <!-- Loại xe (Lấy từ kết quả DB thực tế) -->
                        @if (AvailableBusTypes.Any())
                        {
                            <div class="mb-3">
                                <label class="fw-bold small text-secondary text-uppercase mb-2 d-block">Loại xe</label>
                                <div class="d-flex flex-column gap-2 small" style="max-height: 160px; overflow-y: auto;">
                                    @foreach (var bt in AvailableBusTypes)
                                    {
                                        <label class="cursor-pointer">
                                            <input type="checkbox" checked="@selectedBusTypes.Contains(bt)" @onchange="args => ToggleBusTypeFilter(bt, args)" class="me-2" />
                                            @bt
                                        </label>
                                    }
                                </div>
                            </div>
                            <hr />
                        }

                        <!-- Lọc theo giá vé -->
                        <div class="mb-2">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="fw-bold small text-secondary text-uppercase mb-0">Giá tối đa</label>
                                <span class="fw-bold text-primary small">@maximumPrice.ToString("N0") đ</span>
                            </div>
                            <input class="form-range" type="range" min="100000" max="2000000" step="20000" @bind="maximumPrice" @bind:event="oninput" />
                        </div>
                    </div>
                </aside>

                <!-- CỘT DANH SÁCH CHUYẾN XE BÊN PHẢI -->
                <section class="col-lg-9">
                    @if (isLoading)
                    {
                        <!-- SKELETON LOADING STATE -->
                        <div class="d-flex flex-column gap-3">
                            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white tg-skeleton" style="height: 160px;"></div>
                            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white tg-skeleton" style="height: 160px;"></div>
                            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white tg-skeleton" style="height: 160px;"></div>
                        </div>
                    }
                    else if (!VisibleSearchResults.Any())
                    {
                        <!-- EMPTY STATE -->
                        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
                            <div class="mb-3">
                                <i class="bi bi-calendar-x display-3 text-secondary"></i>
                            </div>
                            <h5 class="fw-bold text-dark">Không tìm thấy chuyến xe nào phù hợp</h5>
                            <p class="text-muted small mb-4">
                                Hiện chưa có chuyến khởi hành đúng ngày <strong>@DepartureDateLabel</strong> cho tuyến <strong>@(originLocation?.Name) ➔ @(destLocation?.Name)</strong>.
                            </p>
                            <div>
                                <button type="button" class="btn btn-primary px-4 fw-bold rounded-pill me-2" @onclick="TryNextDay">
                                    <i class="bi bi-arrow-right-circle me-1"></i> Tìm ngày hôm sau
                                </button>
                                <button type="button" class="btn btn-outline-secondary px-3 rounded-pill" @onclick="() => hasSearched = false">
                                    Đổi tuyến đường
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        @foreach (var trip in VisibleSearchResults)
                        {
                            <div class="card border-0 shadow-sm rounded-4 mb-3 trip-card bg-white p-3">
                                <div class="row align-items-center g-3">
                                    <!-- Thông tin chuyến & Nhà xe -->
                                    <div class="col-md-8">
                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            <span class="badge bg-primary text-white p-2 rounded-2">
                                                <i class="bi bi-bus-front fs-6"></i>
                                            </span>
                                            <div>
                                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                                    <h5 class="fw-bold mb-0 text-dark">@trip.OperatorName</h5>
                                                    @if (trip.IsBookable)
                                                    {
                                                        <span class="badge bg-warning text-dark border border-warning-subtle fw-bold" style="font-size: 0.72rem;">
                                                            <i class="bi bi-cpu me-1"></i>CHUYẾN XE MÔ PHỎNG — DEMO
                                                        </span>
                                                    }
                                                </div>
                                                <div class="small text-muted">@trip.BusTypeName · Mã chuyến: @trip.TripCode</div>
                                            </div>
                                        </div>

                                        <div class="d-flex align-items-center gap-3 my-3">
                                            <div>
                                                <span class="fs-4 fw-bold text-primary">@trip.DepartureTime.ToLocalTime().ToString("HH:mm")</span>
                                                <div class="small text-dark fw-semibold">@(originLocation?.Name ?? "Điểm đi")</div>
                                            </div>
                                            <div class="text-center px-2 flex-grow-1">
                                                <small class="text-muted d-block mb-1">@GetDurationText(trip.DepartureTime, trip.ArrivalTime)</small>
                                                <div class="position-relative d-flex align-items-center justify-content-center">
                                                    <hr class="w-100 my-0 border-primary opacity-50" />
                                                    <i class="bi bi-arrow-right text-primary position-absolute bg-white px-1"></i>
                                                </div>
                                                <small class="text-success fw-bold">Chạy thẳng</small>
                                            </div>
                                            <div>
                                                <span class="fs-4 fw-bold text-dark">@trip.ArrivalTime.ToLocalTime().ToString("HH:mm")</span>
                                                <div class="small text-dark fw-semibold">@(destLocation?.Name ?? "Điểm đến")</div>
                                            </div>
                                        </div>

                                        <div class="d-flex align-items-center gap-3 mt-2 flex-wrap">
                                            <div class="small text-muted">
                                                <i class="bi bi-info-circle me-1"></i> Biển số xe: <strong>@trip.BusLicensePlate</strong>
                                            </div>
                                            <button type="button" class="btn btn-sm btn-link text-decoration-none p-0 text-primary fw-semibold" @onclick="() => ToggleStopsPreview(trip.Id)">
                                                <i class="bi bi-geo-alt-fill me-1"></i> Điểm đón/trả & Chi tiết lộ trình
                                                <i class="bi @(previewStopsTripId == trip.Id ? "bi-chevron-up" : "bi-chevron-down") ms-1 small"></i>
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Giá vé & Nút chọn chuyến -->
                                    <div class="col-md-4 text-md-end border-start-md ps-md-4">
                                        <div class="text-danger fs-3 fw-bold mb-1">
                                            @trip.BasePrice.ToString("N0") <span class="fs-6">đ</span>
                                        </div>
                                        @if (trip.IsBookable)
                                        {
                                            <div class="small text-muted mb-3">
                                                Còn <strong class="text-success">@trip.AvailableSeats</strong> / @trip.TotalSeats chỗ trống
                                            </div>
                                            <button class="btn btn-warning fw-bold px-4 py-2 w-100 rounded-3 text-dark" @onclick="() => ToggleSelectTrip(trip.Id)">
                                                @(selectedTripId == trip.Id ? "Đóng chi tiết" : "Chọn chuyến")
                                            </button>
                                        }
                                        else
                                        {
                                            <div class="small text-muted mb-3">
                                                <span class="badge bg-secondary-subtle text-secondary border">
                                                    <i class="bi bi-clock-history me-1"></i> @trip.OperationalTierLabel
                                                </span>
                                            </div>
                                            <button class="btn btn-outline-primary fw-bold px-4 py-2 w-100 rounded-3" @onclick="() => ToggleSelectTrip(trip.Id)">
                                                @(selectedTripId == trip.Id ? "Đóng chi tiết" : "Xem lộ trình & Điểm đón")
                                            </button>
                                        }
                                    </div>
                                </div>

                                <!-- EXPANDABLE STOPS PREVIEW SECTION -->
                                @if (previewStopsTripId == trip.Id)
                                {
                                    <div class="p-3 bg-light rounded-3 mt-3 border">
                                        <div class="row g-3">
                                            <div class="col-md-6 border-end-md">
                                                <div class="d-flex align-items-center gap-2 mb-2">
                                                    <span class="badge bg-primary text-white"><i class="bi bi-circle-fill me-1"></i> ĐIỂM ĐÓN DỰ KIẾN</span>
                                                    <small class="text-muted">(@(originLocation?.Name))</small>
                                                </div>
                                                @if (trip.PickupPoints.Any())
                                                {
                                                    <div class="d-flex flex-column gap-2">
                                                        @foreach (var pt in trip.PickupPoints)
                                                        {
                                                            <div class="d-flex align-items-start gap-2 small">
                                                                @if (pt.HasFixedTime)
                                                                {
                                                                    <span class="badge bg-primary-subtle text-primary fw-bold mt-1">@pt.Time</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-secondary-subtle text-secondary fw-semibold mt-1">
                                                                        <i class="bi bi-clock me-1"></i>@pt.Time
                                                                    </span>
                                                                }
                                                                <div>
                                                                    <strong class="text-dark d-block">@pt.Name</strong>
                                                                    <span class="text-muted" style="font-size: 0.8rem;">@pt.Address</span>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="alert alert-warning py-2 px-3 small mb-0 rounded-3">
                                                        <i class="bi bi-exclamation-circle-fill me-1"></i> Chưa có dữ liệu điểm đón xác thực từ nhà xe.
                                                    </div>
                                                }
                                            </div>
                                            <div class="col-md-6 ps-md-3">
                                                <div class="d-flex align-items-center gap-2 mb-2">
                                                    <span class="badge bg-danger text-white"><i class="bi bi-geo-alt-fill me-1"></i> ĐIỂM TRẢ DỰ KIẾN</span>
                                                    <small class="text-muted">(@(destLocation?.Name))</small>
                                                </div>
                                                @if (trip.DropoffPoints.Any())
                                                {
                                                    <div class="d-flex flex-column gap-2 small">
                                                        @foreach (var pt in trip.DropoffPoints)
                                                        {
                                                            <div class="d-flex align-items-start gap-2 small">
                                                                @if (pt.HasFixedTime)
                                                                {
                                                                    <span class="badge bg-danger-subtle text-danger fw-bold mt-1">@pt.Time</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-secondary-subtle text-secondary fw-semibold mt-1">
                                                                        <i class="bi bi-clock me-1"></i>@pt.Time
                                                                    </span>
                                                                }
                                                                <div>
                                                                    <strong class="text-dark d-block">@pt.Name</strong>
                                                                    <span class="text-muted" style="font-size: 0.8rem;">@pt.Address</span>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="alert alert-warning py-2 px-3 small mb-0 rounded-3">
                                                        <i class="bi bi-exclamation-circle-fill me-1"></i> Chưa có dữ liệu điểm trả xác thực từ nhà xe.
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }

                                <!-- EXPANDABLE SEAT SELECTION & BOOKING DRAWER / REFERENCE SCHEDULE DRAWER -->
                                @if (selectedTripId == trip.Id && selectedTripDetail != null)
                                {
                                    @if (!selectedTripDetail.IsBookable)
                                    {
                                        <div class="p-4 bg-light rounded-4 mt-3 border">
                                            <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="badge bg-secondary text-white px-2 py-1"><i class="bi bi-clock-history me-1"></i> LỊCH TRÌNH THAM KHẢO</span>
                                                    <span class="small text-muted">Mã chuyến: <strong>@selectedTripDetail.TripCode</strong></span>
                                                </div>
                                                <button type="button" class="btn btn-sm btn-link text-decoration-none text-muted p-0" @onclick="CloseTripDetail">
                                                    <i class="bi bi-x-lg me-1"></i> Đóng
                                                </button>
                                            </div>

                                            <div class="alert alert-info py-3 px-3 rounded-3 small mb-3 border-info-subtle">
                                                <h6 class="fw-bold mb-1 text-primary"><i class="bi bi-info-circle-fill me-1"></i> Thông tin đối soát lịch trình vận tải</h6>
                                                <p class="mb-2">
                                                    Chuyến xe này hiển thị theo <strong>lịch trình công bố định kỳ</strong> của nhà xe <strong>@selectedTripDetail.OperatorName</strong>.
                                                    Do Tripgo hiện chưa kết nối hệ thống điều hành vé trực tiếp (Live GDS API) của nhà xe, hệ thống <strong>không mở bán vé trực tuyến hoặc phát hành vé điện tử</strong> nhằm bảo đảm quyền lợi chính xác tuyệt đối cho hành khách.
                                                </p>
                                                <div class="d-flex flex-wrap gap-3 align-items-center pt-2 border-top border-info-subtle">
                                                    <div><i class="bi bi-telephone-fill text-primary me-1"></i> Hotline nhà xe: <strong class="fs-6 text-primary">@selectedTripDetail.OperatorHotline</strong></div>
                                                    <div><i class="bi bi-tag-fill text-danger me-1"></i> Giá vé tham khảo: <strong class="fs-6 text-danger">@selectedTripDetail.BasePrice.ToString("N0") đ</strong></div>
                                                </div>
                                            </div>

                                            <h6 class="fw-bold small text-dark mb-2"><i class="bi bi-geo-alt-fill text-primary me-1"></i> Danh sách điểm đón và trả thực tế của nhà xe</h6>
                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <div class="p-3 bg-white rounded-3 border h-100">
                                                        <div class="fw-bold small text-primary mb-2"><i class="bi bi-circle-fill me-1"></i> Điểm đón tại @(originLocation?.Name)</div>
                                                        @if (selectedTripDetail.PickupPoints.Any())
                                                        {
                                                            <div class="d-flex flex-column gap-2 small">
                                                                @foreach (var pt in selectedTripDetail.PickupPoints)
                                                                {
                                                                    <div class="d-flex align-items-start gap-2">
                                                                        @if (pt.HasFixedTime)
                                                                        {
                                                                            <span class="badge bg-primary-subtle text-primary fw-bold mt-1">@pt.Time</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="badge bg-secondary-subtle text-secondary fw-semibold mt-1">
                                                                                <i class="bi bi-clock me-1"></i>@pt.Time
                                                                            </span>
                                                                        }
                                                                        <div>
                                                                            <strong class="text-dark d-block">@pt.Name</strong>
                                                                            <span class="text-muted" style="font-size: 0.8rem;">@pt.Address</span>
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="small text-muted">Chưa có dữ liệu trạm đón xác thực.</div>
                                                        }
                                                    </div>
                                                </div>

                                                <div class="col-md-6">
                                                    <div class="p-3 bg-white rounded-3 border h-100">
                                                        <div class="fw-bold small text-danger mb-2"><i class="bi bi-geo-alt-fill me-1"></i> Điểm trả tại @(destLocation?.Name)</div>
                                                        @if (selectedTripDetail.DropoffPoints.Any())
                                                        {
                                                            <div class="d-flex flex-column gap-2 small">
                                                                @foreach (var pt in selectedTripDetail.DropoffPoints)
                                                                {
                                                                    <div class="d-flex align-items-start gap-2">
                                                                        @if (pt.HasFixedTime)
                                                                        {
                                                                            <span class="badge bg-danger-subtle text-danger fw-bold mt-1">@pt.Time</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="badge bg-secondary-subtle text-secondary fw-semibold mt-1">
                                                                                <i class="bi bi-clock me-1"></i>@pt.Time
                                                                            </span>
                                                                        }
                                                                        <div>
                                                                            <strong class="text-dark d-block">@pt.Name</strong>
                                                                            <span class="text-muted" style="font-size: 0.8rem;">@pt.Address</span>
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="small text-muted">Chưa có dữ liệu trạm trả xác thực.</div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top flex-wrap gap-2">
                                                <BackButton Label="Quay lại danh sách chuyến" OnClick="CloseTripDetail" />
                                                <a href="tel:@(new string((selectedTripDetail.OperatorHotline ?? "").Where(char.IsDigit).ToArray()))" class="btn btn-outline-primary fw-bold px-4">
                                                    <i class="bi bi-telephone-fill me-1"></i> Gọi hotline nhà xe (@selectedTripDetail.OperatorHotline)
                                                </a>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="booking-drawer mt-3 pt-3 border-top">
                                            <!-- Stepper Navigation -->
                                            <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom small fw-bold flex-wrap gap-2">
                                                <div class="d-flex gap-3 flex-wrap">
                                                    <span class="@(bookingStep == 0 ? "text-primary border-bottom border-primary border-2 pb-1" : "text-muted")">
                                                        1. Chọn chỗ
                                                    </span>
                                                    <span class="@(bookingStep == 1 ? "text-primary border-bottom border-primary border-2 pb-1" : "text-muted")">
                                                        2. Điểm đón / trả
                                                    </span>
                                                    <span class="@(bookingStep == 2 ? "text-primary border-bottom border-primary border-2 pb-1" : "text-muted")">
                                                        3. Thông tin hành khách
                                                    </span>
                                                    <span class="@(bookingStep == 3 ? "text-primary border-bottom border-primary border-2 pb-1" : "text-muted")">
                                                        4. Thanh toán & Xác nhận
                                                    </span>
                                                </div>
                                                @if (bookingStep < 4)
                                                {
                                                    <button type="button" class="btn btn-sm btn-link text-decoration-none text-muted p-0" @onclick="CloseTripDetail">
                                                        <i class="bi bi-x-lg me-1"></i> Đóng
                                                    </button>
                                                }
                                            </div>

                                        <!-- STEP 0: SƠ ĐỒ CHỌN GHẾ 2 TẦNG THỰC TẾ -->
                                        @if (bookingStep == 0)
                                        {
                                            <!-- Chú thích ghế (Legend) -->
                                            <div class="d-flex flex-wrap gap-3 mb-3 small text-muted">
                                                <div class="d-flex align-items-center gap-1">
                                                    <span class="seat-legend-box border bg-white"></span> Ghế trống
                                                </div>
                                                <div class="d-flex align-items-center gap-1">
                                                    <span class="seat-legend-box bg-success text-white"></span> Đang chọn
                                                </div>
                                                <div class="d-flex align-items-center gap-1">
                                                    <span class="seat-legend-box bg-secondary-subtle"></span> Đã bán
                                                </div>
                                            </div>

                                            <div class="row g-3">
                                                @foreach (var floor in selectedTripDetail.Seats.GroupBy(s => s.Floor).OrderBy(g => g.Key))
                                                {
                                                    <div class="col-md-6">
                                                        <div class="p-3 border rounded-3 bg-light">
                                                            <div class="fw-bold small text-primary mb-2 text-center">
                                                                TẦNG @floor.Key
                                                            </div>
                                                            <div class="d-flex flex-column gap-2">
                                                                @foreach (var rowGroup in floor.GroupBy(s => s.Row).OrderBy(g => g.Key))
                                                                {
                                                                    <div class="d-flex justify-content-between align-items-center gap-2">
                                                                        <!-- Bên trái -->
                                                                        <div class="d-flex gap-1">
                                                                            @foreach (var seat in rowGroup.Where(s => s.Column == 1))
                                                                            {
                                                                                <button type="button" class="btn btn-sm tg-seat-btn @(GetSeatClass(seat))"
                                                                                        disabled="@(!seat.IsAvailable)"
                                                                                        @onclick="() => ToggleSeat(seat.SeatCode)">
                                                                                    @seat.SeatCode
                                                                                </button>
                                                                            }
                                                                        </div>
                                                                        <small class="text-muted" style="font-size: 0.65rem;">LỐI ĐI</small>
                                                                        <!-- Bên phải -->
                                                                        <div class="d-flex gap-1">
                                                                            @foreach (var seat in rowGroup.Where(s => s.Column == 2))
                                                                            {
                                                                                <button type="button" class="btn btn-sm tg-seat-btn @(GetSeatClass(seat))"
                                                                                        disabled="@(!seat.IsAvailable)"
                                                                                        @onclick="() => ToggleSeat(seat.SeatCode)">
                                                                                    @seat.SeatCode
                                                                                </button>
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>

                                            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top flex-wrap gap-2">
                                                <div class="d-flex align-items-center gap-3">
                                                    <BackButton Label="Quay lại danh sách chuyến" OnClick="CloseTripDetail" />
                                                    <div>
                                                        <span class="small text-muted d-block">Ghế đã chọn:</span>
                                                        <strong>@(selectedSeats.Count == 0 ? "Chưa chọn ghế" : string.Join(", ", selectedSeats.OrderBy(s => s)))</strong>
                                                    </div>
                                                </div>
                                                <div class="d-flex align-items-center gap-3">
                                                    <div class="text-end">
                                                        <span class="small text-muted d-block">Tổng tiền vé:</span>
                                                        <strong class="fs-5 text-danger">@SeatTotal.ToString("N0") đ</strong>
                                                    </div>
                                                    <button type="button" class="btn btn-primary fw-bold px-4" disabled="@(selectedSeats.Count == 0)" @onclick="() => bookingStep = 1">
                                                        Tiếp tục: Điểm đón/trả <i class="bi bi-arrow-right ms-1"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        }

                                        <!-- STEP 1: CHỌN ĐIỂM ĐÓN / TRẢ -->
                                        @if (bookingStep == 1)
                                        {
                                            @if (!selectedTripDetail.PickupPoints.Any() || !selectedTripDetail.DropoffPoints.Any())
                                            {
                                                <div class="alert alert-warning py-3 rounded-3 d-flex align-items-start gap-3 mb-3">
                                                    <i class="bi bi-exclamation-triangle-fill fs-4 text-warning flex-shrink-0"></i>
                                                    <div>
                                                        <h6 class="fw-bold mb-1">Chưa có thông tin điểm đón/trả xác thực</h6>
                                                        <p class="small mb-1">
                                                            Chuyến xe này hiện chưa có danh sách điểm đón/trả được xác nhận từ nhà xe <strong>@selectedTripDetail.OperatorName</strong>.
                                                            Tripgo không cung cấp điểm đón/trả giả định và không thể tiếp tục đặt vé trực tuyến cho chuyến xe chưa có điểm dừng xác thực.
                                                        </p>
                                                        <small class="text-secondary">
                                                            Vui lòng quay lại chọn chuyến xe đã có dữ liệu xác thực hoặc liên hệ hotline nhà xe.
                                                        </small>
                                                    </div>
                                                </div>
                                            }

                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <h6 class="fw-bold small text-primary"><i class="bi bi-circle-fill me-1"></i> Điểm đón khách</h6>
                                                    <div class="d-flex flex-column gap-2">
                                                        @if (selectedTripDetail.PickupPoints.Any())
                                                        {
                                                            @foreach (var pt in selectedTripDetail.PickupPoints)
                                                            {
                                                                <label class="p-2 border rounded-3 cursor-pointer bg-white d-flex align-items-center gap-2 @(selectedPickupPoint?.Id == pt.Id ? "border-primary bg-primary-subtle" : "")">
                                                                    <input type="radio" name="pickup" checked="@(selectedPickupPoint?.Id == pt.Id)" @onchange="() => selectedPickupPoint = pt" />
                                                                    <div>
                                                                        <div class="fw-bold small text-dark">
                                                                            @if (pt.HasFixedTime)
                                                                            {
                                                                                <span class="badge bg-primary text-white me-1">@pt.Time</span>
                                                                            }
                                                                            else
                                                                            {
                                                                                <span class="badge bg-secondary text-white me-1"><i class="bi bi-clock me-1"></i>@pt.Time</span>
                                                                            }
                                                                            @pt.Name
                                                                        </div>
                                                                        <small class="text-muted d-block">@pt.Address</small>
                                                                    </div>
                                                                </label>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <div class="p-3 border rounded-3 bg-light text-center small text-muted">
                                                                <i class="bi bi-geo-alt-slash text-secondary d-block fs-5 mb-1"></i>
                                                                Chưa có dữ liệu điểm đón xác thực cho chuyến xe này.
                                                            </div>
                                                        }
                                                    </div>
                                                </div>

                                                <div class="col-md-6">
                                                    <h6 class="fw-bold small text-danger"><i class="bi bi-geo-alt-fill me-1"></i> Điểm trả khách</h6>
                                                    <div class="d-flex flex-column gap-2">
                                                        @if (selectedTripDetail.DropoffPoints.Any())
                                                        {
                                                            @foreach (var pt in selectedTripDetail.DropoffPoints)
                                                            {
                                                                <label class="p-2 border rounded-3 cursor-pointer bg-white d-flex align-items-center gap-2 @(selectedDropoffPoint?.Id == pt.Id ? "border-danger bg-danger-subtle" : "")">
                                                                    <input type="radio" name="dropoff" checked="@(selectedDropoffPoint?.Id == pt.Id)" @onchange="() => selectedDropoffPoint = pt" />
                                                                    <div>
                                                                        <div class="fw-bold small text-dark">
                                                                            @if (pt.HasFixedTime)
                                                                            {
                                                                                <span class="badge bg-danger text-white me-1">@pt.Time</span>
                                                                            }
                                                                            else
                                                                            {
                                                                                <span class="badge bg-secondary text-white me-1"><i class="bi bi-clock me-1"></i>@pt.Time</span>
                                                                            }
                                                                            @pt.Name
                                                                        </div>
                                                                        <small class="text-muted d-block">@pt.Address</small>
                                                                    </div>
                                                                </label>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <div class="p-3 border rounded-3 bg-light text-center small text-muted">
                                                                <i class="bi bi-geo-alt-slash text-secondary d-block fs-5 mb-1"></i>
                                                                Chưa có dữ liệu điểm trả xác thực cho chuyến xe này.
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top flex-wrap gap-2">
                                                <BackButton Label="Quay lại chọn ghế" OnClick="() => bookingStep = 0" />
                                                <div class="d-flex align-items-center gap-2">
                                                    @if (selectedPickupPoint == null || selectedDropoffPoint == null)
                                                    {
                                                        <span class="small text-danger fw-semibold d-none d-md-inline">
                                                            <i class="bi bi-lock-fill me-1"></i> Vui lòng chọn điểm đón & trả để tiếp tục
                                                        </span>
                                                    }
                                                    <button type="button" class="btn btn-primary fw-bold px-4" disabled="@(selectedPickupPoint == null || selectedDropoffPoint == null)" @onclick="() => bookingStep = 2">
                                                        Tiếp tục: Thông tin khách <i class="bi bi-arrow-right ms-1"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        }

                                        <!-- STEP 2: THÔNG TIN HÀNH KHÁCH -->
                                        @if (bookingStep == 2)
                                        {
                                            <div class="row g-3">
                                                <div class="col-md-7">
                                                    <h6 class="fw-bold text-dark mb-3">Thông tin hành khách liên hệ</h6>
                                                    <div class="mb-2">
                                                        <label class="form-label small fw-semibold">Họ và tên hành khách <span class="text-danger">*</span></label>
                                                        <input class="form-control" placeholder="Nguyễn Văn A" @bind="booker.Name" />
                                                    </div>
                                                    <div class="mb-2">
                                                        <label class="form-label small fw-semibold">Số điện thoại liên hệ <span class="text-danger">*</span></label>
                                                        <input class="form-control" type="tel" placeholder="0912345678" @bind="booker.Phone" />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label small fw-semibold">Email nhận vé điện tử</label>
                                                        <input class="form-control" type="email" placeholder="example@gmail.com" @bind="booker.Email" />
                                                    </div>
                                                    <div class="form-check p-2 bg-light rounded-3 mb-2">
                                                        <input class="form-check-input ms-0 me-2" type="checkbox" id="ins" disabled checked="@false" />
                                                        <label class="form-check-label small text-muted fw-semibold" for="ins">
                                                            Bảo hiểm hành trình (Tạm ngưng thu phí trên môi trường thử nghiệm - 0 đ)
                                                        </label>
                                                    </div>

                                                    @if (!string.IsNullOrWhiteSpace(bookingError))
                                                    {
                                                        <div class="alert alert-warning py-2 small mb-0">
                                                            <i class="bi bi-exclamation-triangle-fill me-1"></i> @bookingError
                                                        </div>
                                                    }
                                                </div>

                                                <div class="col-md-5">
                                                    <div class="p-3 bg-light rounded-3 border">
                                                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-2">Tóm tắt chuyến đi</h6>
                                                        <div class="small mb-1">
                                                            <span class="text-muted">Nhà xe:</span> <strong>@selectedTripDetail.OperatorName</strong>
                                                        </div>
                                                        <div class="small mb-1">
                                                            <span class="text-muted">Tuyến:</span> <strong>@selectedTripDetail.RouteName</strong>
                                                        </div>
                                                        <div class="small mb-1">
                                                            <span class="text-muted">Điểm đón:</span> <strong>@(selectedPickupPoint?.Name ?? originLocation?.Name)</strong>
                                                        </div>
                                                        <div class="small mb-1">
                                                            <span class="text-muted">Điểm trả:</span> <strong>@(selectedDropoffPoint?.Name ?? destLocation?.Name)</strong>
                                                        </div>
                                                        <div class="small mb-1">
                                                            <span class="text-muted">Số ghế (@selectedSeats.Count):</span> <strong class="text-primary">@string.Join(", ", selectedSeats.OrderBy(s => s))</strong>
                                                        </div>
                                                        <hr class="my-2" />
                                                        <div class="d-flex justify-content-between fs-6 fw-bold text-danger mb-1">
                                                            <span>Tổng tạm tính:</span>
                                                            <span>@BookingTotal.ToString("N0") đ</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top flex-wrap gap-2">
                                                <BackButton Label="Quay lại điểm đón/trả" OnClick="() => bookingStep = 1" />
                                                <button type="button" class="btn btn-primary fw-bold px-4"
                                                        disabled="@(string.IsNullOrWhiteSpace(booker.Name) || string.IsNullOrWhiteSpace(booker.Phone))"
                                                        @onclick="() => bookingStep = 3">
                                                    Tiếp tục: Thanh toán & Xác nhận <i class="bi bi-arrow-right ms-1"></i>
                                                </button>
                                            </div>
                                        }

                                        <!-- STEP 3: THANH TOÁN & XÁC NHẬN (HONEST BLOCKED PAYMENT GATEWAY) -->
                                        @if (bookingStep == 3)
                                        {
                                            <div class="row g-3">
                                                <div class="col-md-7">
                                                    <div class="p-3 border rounded-3 bg-white mb-3">
                                                        <h6 class="fw-bold text-dark mb-2">
                                                            <i class="bi bi-shield-check text-success me-1"></i> Xác nhận thông tin đặt chỗ
                                                        </h6>
                                                        <ul class="list-unstyled small mb-0 d-flex flex-column gap-1">
                                                            <li><span class="text-muted">Hành khách:</span> <strong>@booker.Name</strong> • SĐT: <strong>@booker.Phone</strong></li>
                                                            <li><span class="text-muted">Email:</span> <strong>@(string.IsNullOrWhiteSpace(booker.Email) ? "Không cung cấp" : booker.Email)</strong></li>
                                                            <li><span class="text-muted">Thời gian khởi hành:</span> <strong>@selectedTripDetail.DepartureTime.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong></li>
                                                            <li><span class="text-muted">Điểm đón:</span> <strong>@(selectedPickupPoint?.Time) - @(selectedPickupPoint?.Name)</strong> (@(selectedPickupPoint?.Address))</li>
                                                            <li><span class="text-muted">Điểm trả:</span> <strong>@(selectedDropoffPoint?.Time) - @(selectedDropoffPoint?.Name)</strong> (@(selectedDropoffPoint?.Address))</li>
                                                            <li><span class="text-muted">Ghế:</span> <strong class="badge bg-primary text-white">@string.Join(", ", selectedSeats.OrderBy(s => s))</strong></li>
                                                        </ul>
                                                    </div>

                                                    <!-- Trạng thái cổng thanh toán thực tế (Honest development state) -->
                                                    <div class="p-3 border rounded-3 bg-light">
                                                        <div class="d-flex align-items-center gap-2 mb-2">
                                                            <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i> Đang tích hợp cổng</span>
                                                            <strong class="small text-secondary">Cổng thanh toán điện tử (VNPAY / MoMo / PayOS)</strong>
                                                        </div>
                                                        <p class="small text-muted mb-0">
                                                            Để đảm bảo an toàn giao dịch, phương thức hiện tại là <strong>Giữ chỗ trước - Thanh toán trực tiếp tại nhà xe hoặc qua hướng dẫn của nhân viên tổng đài</strong>. Quý khách bấm <em>Xác nhận đặt giữ chỗ</em> để lưu thông tin chuyến xe.
                                                        </p>
                                                    </div>

                                                    @if (!string.IsNullOrWhiteSpace(bookingError))
                                                    {
                                                        <div class="alert alert-danger py-2 small mt-3 mb-0">
                                                            <i class="bi bi-exclamation-triangle-fill me-1"></i> @bookingError
                                                        </div>
                                                    }
                                                </div>

                                                <div class="col-md-5">
                                                    <div class="p-3 bg-light rounded-3 border">
                                                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-2">Chi tiết thanh toán</h6>
                                                        <div class="d-flex justify-content-between small mb-1">
                                                            <span>Giá vé (@selectedSeats.Count ghế):</span>
                                                            <strong>@SeatTotal.ToString("N0") đ</strong>
                                                        </div>
                                                        @if (booker.HasInsurance)
                                                        {
                                                            <div class="d-flex justify-content-between small mb-1">
                                                                <span>Bảo hiểm chuyến đi:</span>
                                                                <strong>@InsuranceTotal.ToString("N0") đ</strong>
                                                            </div>
                                                        }
                                                        <hr class="my-2" />
                                                        <div class="d-flex justify-content-between fs-5 fw-bold text-danger mb-2">
                                                            <span>Tổng cần thanh toán:</span>
                                                            <span>@BookingTotal.ToString("N0") đ</span>
                                                        </div>
                                                        <div class="p-2 bg-white rounded border small text-muted">
                                                            <i class="bi bi-check2-circle text-success me-1"></i> Giữ chỗ trực tuyến miễn phí trong phiên làm việc.
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top flex-wrap gap-2">
                                                <BackButton Label="Quay lại thông tin khách" OnClick="() => bookingStep = 2" />
                                                <button type="button" class="btn btn-success fw-bold px-4" disabled="@isBooking" @onclick="ConfirmBooking">
                                                    @if (isBooking)
                                                    {
                                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                                        <span>Đang xử lý đặt chỗ...</span>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-check-circle-fill me-1"></i>
                                                        <span>Xác nhận đặt giữ chỗ</span>
                                                    }
                                                </button>
                                            </div>
                                        }

                                        <!-- STEP 4: MÀN HÌNH XÁC NHẬN ĐẶT VÉ THÀNH CÔNG (NO JAVASCRIPT ALERT) -->
                                        @if (bookingStep == 4)
                                        {
                                            <div class="p-4 bg-white border border-success-subtle rounded-3 text-center my-2">
                                                <div class="mb-3">
                                                    <i class="bi bi-check-circle-fill text-success" style="font-size: 3.5rem;"></i>
                                                </div>
                                                <h4 class="fw-bold text-success mb-1">Thông tin đặt chỗ đã được ghi nhận</h4>
                                                <p class="text-muted small mb-3">
                                                    Đây là đặt chỗ đang chờ thanh toán, chưa phải vé hợp lệ. TripGo chưa hỗ trợ thanh toán hoặc xác thực vé điện tử.
                                                </p>

                                                <div class="d-inline-block p-3 bg-light rounded-3 border mb-3 text-start" style="min-width: 320px; max-width: 500px;">
                                                    <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                                                        <span class="text-muted small">Mã đặt chỗ:</span>
                                                        <strong class="fs-5 text-primary">@confirmedBookingCode</strong>
                                                    </div>
                                                    <div class="small mb-1"><span class="text-muted">Hành khách:</span> <strong>@booker.Name</strong> (@booker.Phone)</div>
                                                    <div class="small mb-1"><span class="text-muted">Tuyến xe:</span> <strong>@confirmedTripName</strong></div>
                                                    <div class="small mb-1"><span class="text-muted">Ghế đã chọn:</span> <strong class="badge bg-primary text-white">@confirmedSeatList</strong></div>
                                                    <div class="small mb-2"><span class="text-muted">Tổng tiền:</span> <strong class="text-danger fw-bold">@confirmedTotalAmount.ToString("N0") đ</strong></div>
                                                    <div class="alert alert-warning py-2 px-3 small rounded-3 mb-0">
                                                        <i class="bi bi-cpu me-1"></i> <strong>CHUYẾN XE MÔ PHỎNG — DEMO:</strong> Phiếu đặt chỗ này được tạo cho mục đích thử nghiệm hệ thống, không có giá trị thanh toán thực tế và không thay thế vé đi xe thật.
                                                    </div>
                                                </div>

                                                <div class="d-flex justify-content-center gap-2 flex-wrap">
                                                    <a href="@($"/my-tickets?code={confirmedBookingCode}")" class="btn btn-primary fw-bold px-4">
                                                        <i class="bi bi-card-text me-1"></i> Xem thông tin đặt chỗ
                                                    </a>
                                                    <button type="button" class="btn btn-outline-secondary px-4" @onclick="CloseTripDetail">
                                                        <i class="bi bi-plus-circle me-1"></i> Đặt thêm chuyến khác
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                    }
                                }
                            </div>
                        }
                    }
                </section>
            </div>
        }
        else
        {
            <!-- ========================================================
                 LANDING VIEW: REAL POPULAR ROUTES (Populated from Real DB Routes)
                 ======================================================== -->
            <section class="my-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="fw-bold text-dark mb-0">Tuyến đường phổ biến</h4>
                    <a href="/schedules" class="text-primary text-decoration-none small fw-semibold">
                        Xem toàn bộ lịch trình <i class="bi bi-chevron-right"></i>
