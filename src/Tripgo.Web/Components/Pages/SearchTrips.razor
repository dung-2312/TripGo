        color: #212529;
    }

    .dot-icon {
        font-size: 1rem;
    }

    .date-clean {
        border: none;
        padding: 0;
        font-size: 0.95rem;
        background: transparent;
    }

        .date-clean:focus {
            box-shadow: none;
        }

    .btn-swap {
        border: 1px solid #dee2e6;
        border-radius: 50%;
        background-color: #fff;
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #0d5cb6;
        margin: 0 -8px;
        z-index: 2;
        transition: transform 0.2s;
    }

        .btn-swap:hover {
