            selectedTripId = null;
            selectedTripDetail = null;
            selectedSeats.Clear();
            bookingStep = 0;
            return;
        }

        selectedTripId = tripId;
        selectedSeats.Clear();
        selectedPickupPoint = null;
        selectedDropoffPoint = null;
        companionMap.Clear();
