    .btn-vexere-yellow {
        background-color: #ffd333;
        border: none;
        height: 60px;
        border-radius: 0 10px 10px 0;
        color: #000;
        transition: background-color 0.2s;
    }

        .btn-vexere-yellow:hover {
            background-color: #ffc700;
        }

    .custom-dropdown {
        position: absolute;
        top: 100%;
        left: 0;
        width: 320px;
        background: white;
        border-radius: 12px;
        z-index: 1050;
        max-height: 280px;
        overflow: hidden;
        border: 1px solid #e9ecef;
    }

    .dropdown-list {
        max-height: 220px;
        overflow-y: auto;
    }

    .dropdown-item-custom {
        padding: 10px 14px;
        cursor: pointer;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
    }

        .dropdown-item-custom:hover, .dropdown-item-custom.active {
            background-color: #e8f0fe;
            color: #0d5cb6;
        }

    .line-container {
        border-bottom: 2px dashed #ced4da;
        top: -6px;
    }

    .seat-btn {
        width: 48px;
        height: 56px;
        border-radius: 8px;
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border: 1px solid #ced4da;
        background-color: #fff;
        cursor: pointer;
    }

        .seat-btn.seat-selected {
            background-color: #ffd333;
            border-color: #e0a800;
            color: #000;
            font-weight: bold;
        }

        .seat-btn:disabled {
            background-color: #e9ecef;
            border-color: #dee2e6;
            color: #adb5bd;
            cursor: not-allowed;
        }

    .seat-sample {
        display: inline-block;
        width: 14px;
        height: 14px;
        border-radius: 3px;
        vertical-align: middle;
    }

    .seat-available {
        background-color: #fff;
        border: 1px solid #ced4da;
    }

    .seat-selected {
        background-color: #ffd333;
        border: 1px solid #e0a800;
    }

    .seat-disabled {
        background-color: #e9ecef;
        border: 1px solid #dee2e6;
    }

    .popular-card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .popular-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 16px rgba(0,0,0,0.1) !important;
        }
</style>


<style>
    /* ===== TripGo 2026 premium UI override ===== */
    :root {
        --tg-blue: #0d5cb6;
        --tg-blue-dark: #0d5cb6;
        --tg-navy: #071b3d;
        --tg-yellow: #ffd333;
        --tg-bg: #f4f7fb;
        --tg-text: #172033;
        --tg-muted: #667085;
        --tg-border: #e7ebf2;
    }

    .tripgo-page {
        min-height: 100vh;
        background: var(--tg-bg);
        color: var(--tg-text);
    }

        .tripgo-page .container {
            max-width: 1180px;
        }

    .vexere-header {
        position: sticky;
        top: 0;
        z-index: 1100;
        background: rgba(13, 92, 182, .96);
        backdrop-filter: blur(14px);
        box-shadow: 0 8px 30px rgba(8, 43, 95, .14);
    }

    .vexere-hero {
        background: radial-gradient(circle at 18% 15%, rgba(80, 169, 255, .35), transparent 30%), radial-gradient(circle at 85% 30%, rgba(29, 112, 230, .38), transparent 26%), linear-gradient(135deg, #0756b8 0%, #2474e5 55%, #0f64cb 100%);
        padding: 54px 0 72px;
        overflow: visible;
    }

    .hero-title {
        font-size: clamp(1.8rem, 3vw, 2.65rem);
        line-height: 1.15;
        text-shadow: 0 5px 24px rgba(0,0,0,.12);
    }

    .vexere-search-card {
        max-width: 1080px;
        border: 1px solid rgba(255,255,255,.6);
        box-shadow: 0 22px 55px rgba(0, 40, 100, .24) !important;
    }

    .search-inputs-grid {
        min-height: 72px;
        border-color: #dfe5ee;
        box-shadow: inset 0 0 0 1px rgba(36,116,229,.02);
    }

    .search-input-box {
        min-height: 70px;
        display: flex;
        align-items: center;
        transition: background .18s ease;
    }

        .search-input-box:hover {
            background: #f6f9ff;
        }

    .selected-text {
        max-width: 210px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .btn-swap {
        box-shadow: 0 5px 16px rgba(23,32,51,.12);
    }

    .btn-vexere-yellow {
        min-width: 145px;
        height: 70px;
        border-radius: 0 11px 11px 0;
        background: var(--tg-yellow);
    }

        .btn-vexere-yellow:hover {
            background: #ffbd00;
            transform: translateY(-1px);
        }

    main.container {
        margin-top: 32px !important;
    }

    .trip-card {
        border: 1px solid var(--tg-border) !important;
        box-shadow: 0 7px 24px rgba(16, 24, 40, .06) !important;
        transition: .22s ease;
    }

        .trip-card:hover {
            transform: translateY(-2px);
            border-color: #cbdcf7 !important;
            box-shadow: 0 15px 34px rgba(16,24,40,.10) !important;
        }

        .trip-card .btn-warning {
            background: var(--tg-yellow);
            border: none;
        }

    .custom-dropdown {
        border: 1px solid var(--tg-border);
        box-shadow: 0 18px 45px rgba(16,24,40,.16) !important;
    }

    .dropdown-item-custom {
        border-radius: 8px;
        margin: 3px 6px;
    }

    .seat-btn {
        width: 52px;
        height: 60px;
        border: 1px solid #b9d3f8;
        background: #f4f8ff;
        color: #2474e5;
        transition: .16s ease;
    }

        .seat-btn:not(:disabled):hover {
            transform: translateY(-2px);
            border-color: #2474e5;
        }

        .seat-btn.seat-selected {
            background: #dff2ff;
            border: 2px solid #2474e5;
            color: #0756b8;
        }

