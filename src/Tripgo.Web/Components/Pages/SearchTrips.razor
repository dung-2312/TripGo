            selectedSeats.Remove(seatCode);
        else
            selectedSeats.Add(seatCode);
    }

    private void CloseTripDetail()
    {
        if (!string.IsNullOrEmpty(activeHoldToken) && bookingStep < 4)
        {
            var tokenToRelease = activeHoldToken;
            _ = Task.Run(async () =>
            {
                try { await BookingService.ReleaseHoldAsync(tokenToRelease); } catch { }
            });
        }

        StopHoldCountdown();
        activeHoldToken = null;
        holdExpiresAt = null;
        selectedTripId = null;
        previewStopsTripId = null;
        selectedTripDetail = null;
        selectedSeats.Clear();
        companionMap.Clear();
        selectedPickupPoint = null;
        selectedDropoffPoint = null;
        bookingStep = 0;
        bookingError = null;
        confirmedBookingCode = null;
        confirmedTransactionCode = null;
        confirmedPaymentMethod = null;
    }

