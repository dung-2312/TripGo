@code {
    [SupplyParameterFromQuery(Name = "origin")]
    public string? QueryOrigin { get; set; }

    [SupplyParameterFromQuery(Name = "dest")]
    public string? QueryDest { get; set; }

    [SupplyParameterFromQuery(Name = "date")]
    public string? QueryDate { get; set; }

    [SupplyParameterFromQuery(Name = "tripId")]
    public long? QueryTripId { get; set; }

    private List<LocationDto> locations = new();
    private List<RouteDto> popularRoutes = new();
    private List<TripSearchResultDto> searchResults = new();
    private TripSearchRequestDto searchModel = new()
    {
        DepartureDate = DateOnly.FromDateTime(DateTime.Today)
    };

    private LocationDto? originLocation;
    private LocationDto? destLocation;

    private bool showOriginDropdown = false;
    private bool showDestDropdown = false;
    private string originSearchText = "";
    private string destSearchText = "";

    private bool isLoading = false;
    private bool hasSearched = false;
    private string? errorMessage;

    private long? selectedTripId;
    private long? previewStopsTripId;
    private TripDetailDto? selectedTripDetail;
    private HashSet<string> selectedSeats = new();
    private int bookingStep;
    private PickupDropoffPointDto? selectedPickupPoint;
    private PickupDropoffPointDto? selectedDropoffPoint;
    private bool isBooking;
    private bool contactEmailConfirmed;
    private string? bookingError;
    private string? confirmedBookingCode;
    private string? confirmedSeatList;
    private string? confirmedTripName;
    private decimal confirmedTotalAmount;
    private string? activeHoldToken;
    private DateTimeOffset? holdExpiresAt;
    private CancellationTokenSource? countdownCts;
    private string countdownText = "10:00";
    private bool isHoldingSeats;
    private string selectedPaymentMethod = "SANDBOX_ATM";
    private bool simulatePaymentSuccess = true;
    private string? confirmedTransactionCode;
    private string? confirmedPaymentMethod;

    private string sortOrder = "departure_asc";
    private CustomerBookingInfoDto booker = new();
    private bool filterMorning;
    private bool filterAfternoon;
    private bool filterEvening;
    private decimal maximumPrice = 2_000_000m;
    private HashSet<string> selectedOperators = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> selectedBusTypes = new(StringComparer.OrdinalIgnoreCase);

    private decimal SeatTotal => selectedTripDetail?.Seats
        .Where(seat => selectedSeats.Contains(seat.SeatCode))
        .Sum(seat => seat.Price) ?? 0m;
    private decimal InsuranceTotal => 0m;
    private decimal BookingTotal => SeatTotal;

    private string DepartureDateLabel => searchModel.DepartureDate.ToDateTime(TimeOnly.MinValue)
        .ToString("dddd, dd/MM/yyyy", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"));

    private IEnumerable<string> AvailableOperators => searchResults
        .Select(s => s.OperatorName)
        .Where(n => !string.IsNullOrWhiteSpace(n))
        .Distinct()
        .OrderBy(n => n);

    private IEnumerable<string> AvailableBusTypes => searchResults
        .Select(s => s.BusTypeName)
        .Where(n => !string.IsNullOrWhiteSpace(n))
        .Distinct()
        .OrderBy(n => n);

    private IEnumerable<TripSearchResultDto> VisibleSearchResults
    {
        get
        {
            var trips = searchResults.AsEnumerable();
            if (selectedOperators.Count > 0)
                trips = trips.Where(t => selectedOperators.Contains(t.OperatorName));

            if (selectedBusTypes.Count > 0)
                trips = trips.Where(t => selectedBusTypes.Contains(t.BusTypeName));

            if (filterMorning || filterAfternoon || filterEvening)
                trips = trips.Where(t => IsWithinSelectedDeparturePeriod(t.DepartureTime));

            return trips.Where(t => t.BasePrice <= maximumPrice);
        }
    }

    private IEnumerable<LocationDto> FilteredOriginLocations =>
        string.IsNullOrWhiteSpace(originSearchText)
            ? locations
            : locations.Where(l => l.Name.Contains(originSearchText, StringComparison.OrdinalIgnoreCase) ||
                                  (l.Province?.Contains(originSearchText, StringComparison.OrdinalIgnoreCase) ?? false));

    private IEnumerable<LocationDto> FilteredDestLocations =>
        string.IsNullOrWhiteSpace(destSearchText)
            ? locations
            : locations.Where(l => l.Name.Contains(destSearchText, StringComparison.OrdinalIgnoreCase) ||
                                  (l.Province?.Contains(destSearchText, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            locations = await TripService.GetLocationsAsync();
            var routes = await TripService.GetRoutesAsync();

            // Lấy danh sách tuyến đường phổ biến duy nhất từ database thực tế
            popularRoutes = routes
                .GroupBy(r => new { r.OriginLocationId, r.DestinationLocationId })
                .Select(g => g.First())
                .ToList();

            // Khởi tạo điểm đi/đến mặc định
            if (locations.Any())
            {
                originLocation = locations.FirstOrDefault(l => l.Code == "HAN" || l.Province?.Contains("Hà Nội") == true) ?? locations.First();
                destLocation = locations.FirstOrDefault(l => l.Code == "SAP" || l.Province?.Contains("Lào Cai") == true) ?? locations.Last();
                searchModel.OriginLocationId = originLocation.Id;
                searchModel.DestinationLocationId = destLocation.Id;
            }

            // Tự động tìm kiếm nếu có query params trên URL
            if (!string.IsNullOrEmpty(QueryOrigin) && !string.IsNullOrEmpty(QueryDest))
            {
                var qOrigin = locations.FirstOrDefault(l => l.Code.Equals(QueryOrigin, StringComparison.OrdinalIgnoreCase) || l.Name.Contains(QueryOrigin, StringComparison.OrdinalIgnoreCase));
                var qDest = locations.FirstOrDefault(l => l.Code.Equals(QueryDest, StringComparison.OrdinalIgnoreCase) || l.Name.Contains(QueryDest, StringComparison.OrdinalIgnoreCase));
                if (qOrigin != null && qDest != null)
                {
                    originLocation = qOrigin;
                    destLocation = qDest;
                    searchModel.OriginLocationId = qOrigin.Id;
                    searchModel.DestinationLocationId = qDest.Id;
                    if (!string.IsNullOrEmpty(QueryDate) && DateOnly.TryParse(QueryDate, out var parsedDate))
                    {
                        searchModel.DepartureDate = parsedDate;
                    }
                    await HandleSearch();
                }
            }

            if (QueryTripId.HasValue && QueryTripId.Value > 0)
            {
                if (!hasSearched)
                {
                    var tripDetails = await TripService.GetTripDetailsAsync(QueryTripId.Value);
                    if (tripDetails != null)
                    {
                        var matchedRoute = routes.FirstOrDefault(r => r.Name.Equals(tripDetails.RouteName, StringComparison.OrdinalIgnoreCase));
                        LocationDto? qOrigin = null;
                        LocationDto? qDest = null;
                        if (matchedRoute != null)
                        {
                            qOrigin = locations.FirstOrDefault(l => l.Id == matchedRoute.OriginLocationId);
                            qDest = locations.FirstOrDefault(l => l.Id == matchedRoute.DestinationLocationId);
                        }
                        else
                        {
                            var parts = tripDetails.RouteName.Split('-', StringSplitOptions.TrimEntries);
                            if (parts.Length >= 2)
                            {
                                qOrigin = locations.FirstOrDefault(l => l.Name.Contains(parts[0], StringComparison.OrdinalIgnoreCase));
                                qDest = locations.FirstOrDefault(l => l.Name.Contains(parts[1], StringComparison.OrdinalIgnoreCase));
                            }
                        }
                        if (qOrigin != null && qDest != null)
                        {
                            originLocation = qOrigin;
                            destLocation = qDest;
                            searchModel.OriginLocationId = qOrigin.Id;
                            searchModel.DestinationLocationId = qDest.Id;
                            searchModel.DepartureDate = DateOnly.FromDateTime(tripDetails.DepartureTime.ToLocalTime().Date);
                            await HandleSearch();
                        }
                    }
                }
                await ToggleSelectTrip(QueryTripId.Value);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Trip search page initialization failed.");
        }
    }

    private void ToggleDropdown(bool isOrigin)
    {
        if (isOrigin)
        {
            showOriginDropdown = !showOriginDropdown;
            showDestDropdown = false;
        }
        else
        {
            showDestDropdown = !showDestDropdown;
            showOriginDropdown = false;
        }
    }

    private void SelectOrigin(LocationDto loc)
    {
        originLocation = loc;
        searchModel.OriginLocationId = loc.Id;
        showOriginDropdown = false;
    }

    private void SelectDestination(LocationDto loc)
    {
        destLocation = loc;
        searchModel.DestinationLocationId = loc.Id;
        showDestDropdown = false;
    }

    private void SwapLocations()
    {
        (originLocation, destLocation) = (destLocation, originLocation);
        (searchModel.OriginLocationId, searchModel.DestinationLocationId) = (searchModel.DestinationLocationId, searchModel.OriginLocationId);
    }

    private async Task HandleSearch()
    {
        errorMessage = null;
        showOriginDropdown = false;
        showDestDropdown = false;

        if (searchModel.OriginLocationId == 0 || searchModel.DestinationLocationId == 0)
        {
            errorMessage = "Vui lòng chọn đầy đủ nơi xuất phát và nơi đến.";
            return;
        }

        if (searchModel.OriginLocationId == searchModel.DestinationLocationId)
        {
            errorMessage = "Nơi xuất phát và nơi đến không được trùng nhau.";
            return;
        }

        isLoading = true;
        selectedTripId = null;
        selectedSeats.Clear();

        try
        {
            searchResults = await TripService.SearchTripsAsync(searchModel);
            ApplySort();
            hasSearched = true;
            try
            {
                await JSRuntime.InvokeVoidAsync("tripgo.scrollToResults");
            }
            catch (InvalidOperationException)
            {
                // JSRuntime is not available during initial static prerendering
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task QuickSearchRoute(RouteDto route)
    {
        originLocation = locations.FirstOrDefault(l => l.Id == route.OriginLocationId);
        destLocation = locations.FirstOrDefault(l => l.Id == route.DestinationLocationId);
        if (originLocation != null && destLocation != null)
        {
            searchModel.OriginLocationId = originLocation.Id;
            searchModel.DestinationLocationId = destLocation.Id;
            searchModel.DepartureDate = DateOnly.FromDateTime(DateTime.Today);
            await HandleSearch();
        }
    }

    private async Task QuickSearchDestination(string destCode)
    {
        var targetDest = locations.FirstOrDefault(l => l.Code.Equals(destCode, StringComparison.OrdinalIgnoreCase) || 
                                                       l.Name.Contains(destCode, StringComparison.OrdinalIgnoreCase));
        if (targetDest != null)
        {
            destLocation = targetDest;
            searchModel.DestinationLocationId = targetDest.Id;
            if (originLocation == null || originLocation.Id == targetDest.Id)
            {
                originLocation = locations.FirstOrDefault(l => l.Id != targetDest.Id && (l.Code == "HAN" || l.Code == "SGN")) ?? locations.FirstOrDefault(l => l.Id != targetDest.Id);
                if (originLocation != null)
                {
                    searchModel.OriginLocationId = originLocation.Id;
                }
            }
            searchModel.DepartureDate = DateOnly.FromDateTime(DateTime.Today);
            await HandleSearch();
        }
    }

    private async Task TryNextDay()
    {
        searchModel.DepartureDate = searchModel.DepartureDate.AddDays(1);
        await HandleSearch();
    }

    private async Task TryPreviousDay()
    {
        if (searchModel.DepartureDate > DateOnly.FromDateTime(DateTime.Today))
        {
            searchModel.DepartureDate = searchModel.DepartureDate.AddDays(-1);
            await HandleSearch();
        }
    }

    private void ApplySort()
    {
        searchResults = sortOrder switch
        {
            "default" => searchResults.OrderBy(s => s.DepartureTime).ToList(),
            "departure_asc" => searchResults.OrderBy(s => s.DepartureTime).ToList(),
            "departure_desc" => searchResults.OrderByDescending(s => s.DepartureTime).ToList(),
            "price_asc" => searchResults.OrderBy(s => s.BasePrice).ToList(),
            "price_desc" => searchResults.OrderByDescending(s => s.BasePrice).ToList(),
            _ => searchResults
        };
    }

    private void HandleSortChange(ChangeEventArgs args)
    {
        if (args.Value is string order)
        {
            sortOrder = order;
            ApplySort();
        }
    }

    private void ResetFilters()
    {
        filterMorning = false;
        filterAfternoon = false;
        filterEvening = false;
        selectedOperators.Clear();
        selectedBusTypes.Clear();
        maximumPrice = 2_000_000m;
        sortOrder = "departure_asc";
        ApplySort();
    }

    private bool IsWithinSelectedDeparturePeriod(DateTimeOffset departureTime)
    {
        var hour = departureTime.ToLocalTime().Hour;
        return (filterMorning && hour < 12) ||
               (filterAfternoon && hour >= 12 && hour < 18) ||
               (filterEvening && hour >= 18);
    }

    private void ToggleOperatorFilter(string op, ChangeEventArgs args)
    {
        if (args.Value is true)
            selectedOperators.Add(op);
        else
            selectedOperators.Remove(op);
    }

    private void ToggleBusTypeFilter(string bt, ChangeEventArgs args)
    {
        if (args.Value is true)
            selectedBusTypes.Add(bt);
        else
            selectedBusTypes.Remove(bt);
    }

    private static string GetDurationText(DateTimeOffset departure, DateTimeOffset arrival)
    {
        var duration = arrival - departure;
        if (duration < TimeSpan.Zero)
            duration = duration.Add(TimeSpan.FromDays(1));

        return $"{(int)duration.TotalHours}h{duration.Minutes:00}m";
    }

    private void SelectQuickDate(int daysOffset)
    {
        searchModel.DepartureDate = DateOnly.FromDateTime(DateTime.Today.AddDays(daysOffset));
    }

    private string GetSeatClass(SeatLayoutItemDto seat)
    {
        if (!seat.IsAvailable) return "seat-booked";
        if (selectedSeats.Contains(seat.SeatCode)) return "seat-selected";
        return "seat-available";
    }

