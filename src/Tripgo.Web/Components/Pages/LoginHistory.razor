@page "/account/login-history"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = Tripgo.Web.Services.AccountPolicy.Name)]
@using System.Security.Claims
@using Tripgo.Application.DTOs
@using Tripgo.Application.Interfaces
@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>Lịch sử đăng nhập | TripGo</PageTitle>

<div class="py-4 py-md-5" style="background-color: var(--tg-bg); min-height: calc(100vh - 160px);">
    <div class="container">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1">
                        <li class="breadcrumb-item"><a href="/account/profile" class="text-decoration-none text-muted">Tài khoản</a></li>
                        <li class="breadcrumb-item active text-primary fw-semibold" aria-current="page">Lịch sử đăng nhập</li>
                    </ol>
                </nav>
                <h2 class="fw-bold text-dark mb-0">Lịch sử đăng nhập</h2>
                <p class="text-muted mb-0 mt-1">Theo dõi các lần truy cập gần đây vào tài khoản của bạn.</p>
            </div>
            <a href="/account/profile" class="btn btn-outline-primary rounded-pill px-3">
                <i class="bi bi-person me-1"></i> Hồ sơ cá nhân
            </a>
        </div>

        @if (isLoading)
        {
            <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
                <div class="spinner-border text-primary mx-auto mb-3" role="status"></div>
                <div class="text-muted">Đang tải lịch sử đăng nhập...</div>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-warning rounded-4 border-0 shadow-sm">@errorMessage</div>
        }
        else if (history.Count == 0)
        {
            <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
                <i class="bi bi-shield-check text-success fs-1 mb-3"></i>
                <h5 class="fw-bold">Chưa có lịch sử đăng nhập</h5>
                <p class="text-muted mb-0">Các lần đăng nhập tiếp theo sẽ được hiển thị tại đây.</p>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="px-4 py-3">Thời gian</th>
                                <th class="py-3">Trạng thái</th>
                                <th class="py-3">Địa chỉ IP</th>
                                <th class="py-3">Chi tiết</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in history)
                            {
                                <tr>
                                    <td class="px-4">@item.CreatedAt.ToVietnam().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @if (item.IsSuccessful)
                                        {
                                            <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2"><i class="bi bi-check-circle me-1"></i> Thành công</span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-danger-subtle text-danger px-3 py-2"><i class="bi bi-x-circle me-1"></i> Thất bại</span>
                                        }
                                    </td>
                                    <td class="text-muted">@(item.IpAddress ?? "Không xác định")</td>
                                    <td class="text-muted">@(item.IsSuccessful ? "Đăng nhập tài khoản" : GetFailureReason(item.FailureReason))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<LoginAuditLogDto> history = new();
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userIdValue = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
            if (!long.TryParse(userIdValue, out var userId))
            {
                errorMessage = "Không xác định được tài khoản hiện tại.";
                return;
            }

            history = (await AuthService.GetLoginHistoryAsync(userId)).ToList();
        }
        catch (Exception)
        {
            errorMessage = "Không thể tải lịch sử đăng nhập lúc này. Vui lòng thử lại sau.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string GetFailureReason(string? reason) => reason switch
    {
        "LockedOut" => "Tài khoản đang bị tạm khóa",
        "RateLimited" => "Vượt quá số lần yêu cầu",
        "UnknownAccount" => "Thông tin tài khoản không tồn tại",
        "InvalidCredentials" => "Thông tin đăng nhập không chính xác",
        _ => "Đăng nhập không thành công"
    };
}
