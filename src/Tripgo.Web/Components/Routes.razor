<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.CustomerLayout)">
            <NotAuthorized>
                <LayoutView Layout="typeof(Layout.CustomerLayout)">
                    <div class="container py-5" role="alert">
                        <h1>Không có quyền truy cập</h1>
                        <p>Tài khoản hiện tại không được phép mở trang này.</p>
                        <a class="btn btn-primary" href="/login">Đăng nhập bằng tài khoản khác</a>
                    </div>
                </LayoutView>
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
