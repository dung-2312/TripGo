<div class="top-row ps-3 navbar navbar-dark bg-primary">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold text-white d-flex align-items-center gap-2" href="">
            <i class="bi bi-bus-front-fill fs-5"></i>
            <span>TripGo</span>
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <!-- 1. Trang chủ / Tìm chuyến xe -->
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-search me-2" aria-hidden="true"></span> Tìm chuyến xe
            </NavLink>
        </div>

        <!-- 2. Quản lý vé của tôi -->
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="my-tickets">
                <span class="bi bi-ticket-perforated-fill me-2" aria-hidden="true"></span> Vé của tôi
            </NavLink>
        </div>

        <!-- 3. Quản lý chuyến xe (Dành cho Quản trị/Nhà xe) -->
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="schedules">
                <span class="bi bi-calendar3 me-2" aria-hidden="true"></span> Lịch trình chuyến
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="admin">
                <span class="bi bi-gear-wide-connected me-2" aria-hidden="true"></span> Quản trị chuyến xe
            </NavLink>
        </div>

        <hr class="text-white-50 mx-3 my-2" />

        <!-- 4. Hỗ trợ khách hàng -->
        <div class="nav-item px-3">
            <button type="button" class="nav-link w-100 text-start bg-transparent border-0" @onclick="() => showSupportDrawer = true">
                <span class="bi bi-info-circle me-2" aria-hidden="true"></span> Thông tin hỗ trợ
            </button>
        </div>
    </nav>
</div>

<SupportDrawer IsOpen="@showSupportDrawer" OnClose="CloseSupportDrawerAsync" />

@code {
    private bool showSupportDrawer;

    private Task CloseSupportDrawerAsync()
    {
        showSupportDrawer = false;
        return Task.CompletedTask;
    }
}