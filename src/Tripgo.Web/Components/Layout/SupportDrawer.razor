@if (IsOpen)
{
    <div class="support-drawer-scrim" @onclick="CloseAsync">
        <section class="support-drawer" role="dialog" aria-modal="true" aria-labelledby="support-drawer-title" @onclick:stopPropagation="true">
            <header class="drawer-header">
                <div><span>TRIPGO · SANDBOX</span><h2 id="support-drawer-title">Thông tin hỗ trợ</h2></div>
                <button type="button" class="drawer-close" aria-label="Đóng hỗ trợ" @onclick="CloseAsync"><i class="bi bi-x-lg"></i></button>
            </header>
            <div class="drawer-notice" role="status">
                Đặt chỗ và thanh toán trong ứng dụng chỉ là mô phỏng. Chưa có hotline hoặc dịch vụ gọi lại được xác minh; không dùng TripGo để điều phối chuyến đi thực tế hay xử lý tình huống khẩn cấp.
            </div>
            <div class="drawer-faq-title">Thông tin</div>
            <details class="drawer-faq"><summary>Mã đặt chỗ sandbox có phải vé lên xe?</summary><p>Không. TripGo chưa phát hành vé thương mại hoặc mã QR lên xe.</p></details>
            <details class="drawer-faq"><summary>Lịch trình, nhà xe và giá vé đã được xác nhận?</summary><p>Chưa. Thông tin hiển thị chỉ phục vụ thử nghiệm và cần xác minh độc lập trước khi sử dụng.</p></details>
            <details class="drawer-faq"><summary>Có thể đổi chuyến hoặc hoàn tiền thật?</summary><p>Không. Ứng dụng hiện chưa hỗ trợ đổi chuyến hoặc hoàn tiền thực tế.</p></details>
            <a class="drawer-action" href="/my-tickets">Mở đơn đặt chỗ sandbox</a>
            <a class="drawer-action secondary" href="/search-trips">Tìm kiếm thông tin tham khảo</a>
        </section>
    </div>
}

<style>
    .support-drawer-scrim { position: fixed; inset: 0; z-index: 2200; display: flex; justify-content: flex-end; background: rgba(13, 31, 44, .42); }
    .support-drawer { display: flex; flex-direction: column; width: min(430px, 100%); height: 100%; padding: 25px; overflow-y: auto; background: #f7fafb; color: #183042; box-shadow: -16px 0 45px rgba(13, 31, 44, .2); animation: drawer-in .2s ease-out; }
    .drawer-header { display: flex; justify-content: space-between; align-items: flex-start; padding-bottom: 19px; border-bottom: 1px solid #dce5e9; }
    .drawer-header span { color: #0d5cb6; font-size: 10px; font-weight: 850; letter-spacing: .08em; }
    .drawer-header h2 { margin: 6px 0 0; font-size: 22px; font-weight: 800; }
    .drawer-close { display: grid; place-items: center; width: 36px; height: 36px; border: 1px solid #dce5e9; border-radius: 5px; background: white; color: #536a78; }
    .drawer-notice { margin: 20px 0; padding: 14px; border: 1px solid #f0c36d; border-radius: 5px; background: #fff6df; color: #604816; font-size: 12px; line-height: 1.55; }
    .drawer-faq-title { margin-bottom: 8px; font-size: 13px; font-weight: 800; }
    .drawer-faq { margin-bottom: 7px; border: 1px solid #dce5e9; border-radius: 5px; background: white; }
    .drawer-faq summary { padding: 12px; cursor: pointer; font-size: 12px; font-weight: 750; }
    .drawer-faq p { margin: 0; padding: 0 12px 12px; color: #647784; font-size: 12px; line-height: 1.55; }
    .drawer-action { display: block; margin-top: 12px; padding: 11px 14px; border: 1px solid #0d5cb6; border-radius: 5px; background: #0d5cb6; color: white; text-align: center; text-decoration: none; font-size: 13px; font-weight: 750; }
    .drawer-action.secondary { background: white; color: #0d5cb6; }
    @@keyframes drawer-in { from { transform: translateX(18px); opacity: .7; } to { transform: translateX(0); opacity: 1; } }
</style>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private Task CloseAsync() => OnClose.InvokeAsync();
}
