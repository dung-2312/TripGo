@inherits LayoutComponentBase

<div class="customer-app d-flex flex-column min-vh-100">
    <!-- Top Utility Bar -->
    <div class="bg-dark text-white py-1 px-3 small border-bottom border-secondary">
        <div class="container d-flex justify-content-between align-items-center">
            <div>
                <span class="me-3"><i class="bi bi-telephone-fill text-warning me-1"></i> Tổng đài CSKH: <strong>1900 6868</strong> (24/7)</span>
                <span class="d-none d-md-inline text-secondary">|</span>
                <span class="d-none d-md-inline ms-3"><i class="bi bi-shield-check text-success me-1"></i> Cam kết 100% hoàn tiền nếu nhà xe không giữ chỗ</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                <a href="/tra-cuu" class="text-white text-decoration-none hover-link">
                    <i class="bi bi-ticket-perforated me-1"></i> Tra cứu vé
                </a>
            </div>
        </div>
    </div>

    <!-- Main Navigation Header -->
    <header class="navbar navbar-expand-lg navbar-light bg-white sticky-top shadow-sm py-2">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2 fw-bold fs-3 text-primary text-decoration-none" href="/">
                <span class="badge bg-primary text-white p-2 rounded-circle shadow-sm">
                    <i class="bi bi-bus-front-fill"></i>
                </span>
                <span>Trip<span class="text-warning">Go</span></span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCustomer" aria-controls="navbarCustomer" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarCustomer">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-lg-2">
                    <li class="nav-item">
                        <NavLink class="nav-link fw-semibold px-3" href="" Match="NavLinkMatch.All">
                            <i class="bi bi-house-door me-1"></i> Trang chủ
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link fw-semibold px-3" href="tim-chuyen">
                            <i class="bi bi-compass me-1"></i> Tìm chuyến xe
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link fw-semibold px-3" href="tra-cuu">
                            <i class="bi bi-search me-1"></i> Tra cứu vé
                        </NavLink>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-2">
                    <a href="tra-cuu" class="btn btn-outline-primary px-3 fw-bold rounded-pill">
                        <i class="bi bi-ticket-detailed me-1"></i> Kiểm tra vé đã mua
                    </a>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Dynamic Content -->
    <main class="flex-grow-1 bg-light">
        @Body
    </main>

    <!-- Professional Footer -->
    <footer class="bg-dark text-white pt-5 pb-3 mt-auto">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 fw-bold fs-3 text-primary mb-3">
                        <span class="badge bg-primary text-white p-2 rounded-circle">
                            <i class="bi bi-bus-front-fill"></i>
                        </span>
                        <span class="text-white">Trip<span class="text-warning">Go</span></span>
                    </div>
                    <p class="text-secondary small">
                        TripGo là nền tảng kết nối hành khách với hàng trăm nhà xe chất lượng cao trên toàn quốc. Đặt vé an toàn, chọn đúng chỗ ngồi, thanh toán bảo mật và tiện lợi.
                    </p>
                    <div class="d-flex gap-2">
                        <span class="badge bg-secondary p-2"><i class="bi bi-facebook fs-6"></i></span>
                        <span class="badge bg-secondary p-2"><i class="bi bi-youtube fs-6"></i></span>
                        <span class="badge bg-secondary p-2"><i class="bi bi-tiktok fs-6"></i></span>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h6 class="text-uppercase fw-bold text-warning mb-3">Tuyến đường hot</h6>
                    <ul class="list-unstyled text-secondary small d-flex flex-column gap-2">
                        <li><a href="/tim-chuyen?origin=TP. Hồ Chí Minh&dest=Đà Lạt" class="text-secondary text-decoration-none hover-link">Sài Gòn ➔ Đà Lạt</a></li>
                        <li><a href="/tim-chuyen?origin=Hà Nội&dest=Sapa" class="text-secondary text-decoration-none hover-link">Hà Nội ➔ Sapa</a></li>
                        <li><a href="/tim-chuyen?origin=TP. Hồ Chí Minh&dest=Nha Trang" class="text-secondary text-decoration-none hover-link">Sài Gòn ➔ Nha Trang</a></li>
                        <li><a href="/tim-chuyen?origin=Đà Nẵng&dest=Huế" class="text-secondary text-decoration-none hover-link">Đà Nẵng ➔ Huế</a></li>
                        <li><a href="/tim-chuyen?origin=TP. Hồ Chí Minh&dest=Vũng Tàu" class="text-secondary text-decoration-none hover-link">Sài Gòn ➔ Vũng Tàu</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="text-uppercase fw-bold text-warning mb-3">Hỗ trợ khách hàng</h6>
                    <ul class="list-unstyled text-secondary small d-flex flex-column gap-2">
                        <li><i class="bi bi-geo-alt-fill text-danger me-2"></i> Tòa nhà FPT, Khu Công nghệ cao, TP.HCM</li>
                        <li><i class="bi bi-envelope-fill text-info me-2"></i> hotro@tripgo.vn</li>
                        <li><i class="bi bi-telephone-inbound-fill text-success me-2"></i> 1900 6868 (24/7)</li>
                        <li><i class="bi bi-question-circle-fill text-warning me-2"></i> Hướng dẫn đặt vé trực tuyến</li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="text-uppercase fw-bold text-warning mb-3">Thanh toán bảo mật</h6>
                    <p class="text-secondary small">Hỗ trợ đa dạng phương thức thanh toán an toàn, tức thì:</p>
                    <div class="d-flex flex-wrap gap-2">
                        <span class="badge bg-light text-dark p-2 border">VNPAY-QR</span>
                        <span class="badge bg-light text-dark p-2 border">Ví MoMo</span>
                        <span class="badge bg-light text-dark p-2 border">VietQR</span>
                        <span class="badge bg-light text-dark p-2 border">Visa / Mastercard</span>
                    </div>
                </div>
            </div>

            <hr class="border-secondary my-3" />
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center small text-secondary">
                <div>&copy; 2026 TripGo - Nền tảng đặt vé xe trực tuyến. Dự án PRN222 Clean Architecture.</div>
                <div class="mt-2 mt-md-0">
                    <span class="me-3">Điều khoản dịch vụ</span>
                    <span>Chính sách bảo mật</span>
                </div>
            </div>
        </div>
    </footer>
</div>

<style>
    .hover-link:hover {
        color: #ffc107 !important;
        text-decoration: underline !important;
    }
</style>
