@inherits LayoutComponentBase
@inject NavigationManager NavigationManager

<div class="tg-app-shell d-flex flex-column min-vh-100">
    <!-- Main Customer Header -->
    <header class="tg-header sticky-top">
        <div class="container d-flex align-items-center justify-content-between py-2">
            <!-- Brand Logo -->
            <a href="/" class="tg-brand d-flex align-items-center gap-2 text-decoration-none">
                <div class="tg-brand-badge">
                    <svg class="tg-brand-bus" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 36px; height: 36px;">
                        <rect width="36" height="36" rx="10" fill="#FFCA28" />
                        <path d="M9 11C9 8.79086 10.7909 7 13 7H23C25.2091 7 27 8.79086 27 11V22C27 24.2091 25.2091 26 23 26H13C10.7909 26 9 24.2091 9 22V11Z" fill="#071F49" />
                        <rect x="11" y="9.5" width="14" height="6.5" rx="2" fill="white" />
                        <circle cx="13.5" cy="21.5" r="2" fill="#FFCA28" />
                        <circle cx="22.5" cy="21.5" r="2" fill="#FFCA28" />
                    </svg>
                </div>
                <span class="tg-brand-title">Trip<span class="tg-brand-accent">Go</span></span>
            </a>

            <!-- Navigation Links -->
            <nav class="d-none d-md-flex align-items-center gap-3">
                <a href="/search-trips" class="tg-nav-link @(IsNavActive("/search-trips", "/") ? "active" : "")">
                    <i class="bi bi-bus-front"></i>
                    <span>Vé xe khách</span>
                </a>
                <NavLink href="schedules" class="tg-nav-link">
                    <i class="bi bi-calendar3"></i>
                    <span>Lịch trình</span>
                </NavLink>
                <NavLink href="my-tickets" class="tg-nav-link">
                    <i class="bi bi-ticket-perforated"></i>
                    <span>Vé của tôi</span>
                </NavLink>
                <NavLink href="support" class="tg-nav-link">
                    <i class="bi bi-headset"></i>
                    <span>Thông tin hỗ trợ</span>
                </NavLink>
            </nav>

            <!-- Auth & Quick Actions -->
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="tg-hotline-btn d-none d-lg-flex" @onclick="() => isSupportOpen = true" title="Thông tin hỗ trợ">
                    <i class="bi bi-info-circle-fill text-primary"></i>
                    <span>Thông tin hỗ trợ</span>
                </button>

                <AuthorizeView Policy="@Tripgo.Web.Services.AccountPolicy.Name">
                    <Authorized>
                        <div class="position-relative">
                            <button class="btn btn-warning d-flex align-items-center gap-2 rounded-pill px-3 py-1 shadow-sm"
                                    type="button" @onclick="ToggleUserMenu">
                                <span class="tg-avatar-circle">
                                    <i class="bi bi-person-fill"></i>
                                </span>
                                <span class="d-none d-sm-inline fw-bold text-dark">@(context.User.Identity?.Name ?? "Tài khoản")</span>
                                <i class="bi bi-chevron-down small text-dark"></i>
                            </button>
                            @if (isUserMenuOpen)
                            {
                                <div class="dropdown-menu dropdown-menu-end show shadow-xl border-0 py-2 mt-2 position-absolute end-0" style="min-width: 240px; z-index: 1050; border-radius: 14px;">
                                    <div class="px-3 py-2 border-bottom mb-1 bg-light rounded-top">
                                        <div class="fw-bold text-dark text-truncate">@(context.User.Identity?.Name ?? "Khách hàng")</div>
                                        <div class="small text-muted text-truncate">
                                            @(context.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "")
                                        </div>
                                        @if (context.User.IsInRole("Admin"))
                                        {
                                            <span class="badge bg-danger mt-1">Quản trị viên</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary mt-1">Khách hàng</span>
                                        }
                                    </div>
                                    <a class="dropdown-item py-2 d-flex align-items-center gap-2" href="/account/profile" @onclick="CloseUserMenu">
                                        <i class="bi bi-person-gear text-primary fs-5"></i>
                                        <span>Tài khoản của tôi</span>
                                    </a>
                                     <a class="dropdown-item py-2 d-flex align-items-center gap-2" href="/account/login-history" @onclick="CloseUserMenu">
                                         <i class="bi bi-shield-check text-success fs-5"></i>
                                         <span>Lịch sử đăng nhập</span>
                                     </a>
                                    <a class="dropdown-item py-2 d-flex align-items-center gap-2" href="/my-tickets" @onclick="CloseUserMenu">
                                        <i class="bi bi-ticket-detailed text-success fs-5"></i>
                                        <span>Vé của tôi</span>
                                    </a>
                                    @if (context.User.IsInRole("Admin"))
                                    {
                                        <div class="dropdown-divider"></div>
                                        <a class="dropdown-item py-2 d-flex align-items-center gap-2 text-primary" href="/admin" @onclick="CloseUserMenu">
                                            <i class="bi bi-speedometer2 text-danger fs-5"></i>
                                            <span>Trang Quản trị</span>
                                        </a>
                                    }
                                    <div class="dropdown-divider"></div>
                                    <a class="dropdown-item py-2 d-flex align-items-center gap-2 text-danger fw-semibold" href="/auth/logout">
                                        <i class="bi bi-box-arrow-right fs-5"></i>
                                        <span>Đăng xuất</span>
                                    </a>
                                </div>
                            }
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <div class="d-flex align-items-center gap-2">
                            <a href="/login" class="btn btn-outline-light btn-sm fw-bold rounded-pill px-3 py-1 text-decoration-none">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                            </a>
                            <a href="/register" class="btn btn-accent btn-sm fw-bold rounded-pill px-3 py-1 text-decoration-none shadow-sm">
                                <i class="bi bi-person-plus me-1"></i> Đăng ký
                            </a>
                        </div>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-grow-1">
        @Body
    </main>

    <!-- Professional Customer Footer -->
    <footer class="tg-footer mt-auto">
        <div class="container py-5">
            <div class="row g-4 mb-4">
                <!-- Col 1: About TripGo -->
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="tg-brand-badge">
                            <svg viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 34px; height: 34px;">
                                <rect width="36" height="36" rx="9" fill="#FFCA28" />
                                <path d="M9 11C9 8.79086 10.7909 7 13 7H23C25.2091 7 27 8.79086 27 11V22C27 24.2091 25.2091 26 23 26H13C10.7909 26 9 24.2091 9 22V11Z" fill="#071F49" />
                                <rect x="11" y="9.5" width="14" height="6.5" rx="2" fill="white" />
                                <circle cx="13.5" cy="21.5" r="2" fill="#FFCA28" />
                                <circle cx="22.5" cy="21.5" r="2" fill="#FFCA28" />
                            </svg>
                        </div>
                        <span class="fs-4 fw-bold text-white">Trip<span class="text-warning">Go</span></span>
                    </div>
                    <p class="text-white-50 small mb-3 lh-base">
                        TripGo hiện cung cấp môi trường thử nghiệm để tra cứu dữ liệu tham khảo và kiểm thử quy trình đặt chỗ. Không phát hành vé thương mại hoặc xử lý thanh toán thực.
                    </p>
                </div>

                <!-- Col 2: Useful Links -->
                <div class="col-lg-2 col-md-6 col-6">
                    <h6 class="tg-footer-title">Dịch vụ</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2 small mb-0">
                        <li><a href="/search-trips" class="tg-footer-link">Tìm vé xe khách</a></li>
                        <li><a href="/schedules" class="tg-footer-link">Lịch trình tham khảo</a></li>
                        <li><a href="/my-tickets" class="tg-footer-link">Đơn đặt chỗ sandbox</a></li>
                        <li><a href="/support" class="tg-footer-link">Thông tin hỗ trợ</a></li>
                    </ul>
                </div>

                <!-- Col 3: Search links -->
                <div class="col-lg-3 col-md-6 col-6">
                    <h6 class="tg-footer-title">Tra cứu</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2 small mb-0">
                        <li><a href="/search-trips" class="tg-footer-link">Tìm tuyến trong dữ liệu</a></li>
                        <li><a href="/schedules" class="tg-footer-link">Xem lịch trình tham khảo</a></li>
                        <li><a href="/my-tickets" class="tg-footer-link">Quản lý đơn đặt chỗ</a></li>
                        <li><a href="/support" class="tg-footer-link">Giới hạn của môi trường thử nghiệm</a></li>
                    </ul>
                </div>

                <!-- Col 4: Payment & Security Info -->
                <div class="col-lg-3 col-md-6">
                    <h6 class="tg-footer-title">Thanh toán</h6>
                    <p class="text-white-50 small mb-2">Các lựa chọn thanh toán trong quy trình chỉ mô phỏng; không kết nối cổng thanh toán hoặc thu tiền.</p>
                    <small class="text-white-50 d-block">Không nhập thông tin thẻ hoặc thông tin thanh toán thật.</small>
                </div>
            </div>

            <hr class="border-secondary border-opacity-25 my-4" />
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center small text-white-50 gap-2">
                <div>&copy; 2026 TripGo. Môi trường thử nghiệm đặt chỗ và lịch trình tham khảo.</div>
                <div class="d-flex align-items-center gap-3">
                    <a href="/support" class="text-white-50 text-decoration-none hover-primary">Thông tin hỗ trợ</a>
                    <a href="/admin" class="text-white-50 text-decoration-none" title="Khu vực quản trị"><i class="bi bi-gear-fill me-1"></i> Quản trị</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Mobile Bottom Navigation Bar (Visible only on mobile screens < 768px) -->
    <nav class="tg-mobile-nav d-md-none position-fixed bottom-0 start-0 end-0 py-1 px-2 d-flex justify-content-around align-items-center" style="z-index: 1040;">
        <a href="search-trips" class="tg-mobile-nav-item d-flex flex-column align-items-center text-decoration-none py-1 px-2 @(IsNavActive("/search-trips", "/") ? "active" : "")">
            <i class="bi bi-bus-front fs-5"></i>
            <span style="font-size: 0.72rem; font-weight: 600;">Vé xe</span>
        </a>
        <NavLink href="schedules" class="tg-mobile-nav-item d-flex flex-column align-items-center text-decoration-none py-1 px-2">
            <i class="bi bi-calendar3 fs-5"></i>
            <span style="font-size: 0.72rem; font-weight: 600;">Lịch trình</span>
        </NavLink>
        <NavLink href="my-tickets" class="tg-mobile-nav-item d-flex flex-column align-items-center text-decoration-none py-1 px-2">
            <i class="bi bi-ticket-perforated fs-5"></i>
            <span style="font-size: 0.72rem; font-weight: 600;">Vé của tôi</span>
        </NavLink>
        <AuthorizeView Policy="@Tripgo.Web.Services.AccountPolicy.Name">
            <Authorized>
                <NavLink href="account/profile" class="tg-mobile-nav-item d-flex flex-column align-items-center text-decoration-none py-1 px-2">
                    <i class="bi bi-person-circle fs-5"></i>
                    <span style="font-size: 0.72rem; font-weight: 600;">Tài khoản</span>
                </NavLink>
            </Authorized>
            <NotAuthorized>
                <NavLink href="login" class="tg-mobile-nav-item d-flex flex-column align-items-center text-decoration-none py-1 px-2">
                    <i class="bi bi-box-arrow-in-right fs-5"></i>
                    <span style="font-size: 0.72rem; font-weight: 600;">Đăng nhập</span>
                </NavLink>
            </NotAuthorized>
        </AuthorizeView>
    </nav>

    <!-- Global Support Drawer -->
    <SupportDrawer IsOpen="@isSupportOpen" OnClose="() => isSupportOpen = false" />
</div>

<style>
    .tg-app-shell {
        background-color: var(--tg-bg, #F8FAFD);
        color: var(--tg-text, #0F172A);
        padding-bottom: 60px;
    }

    @@media (min-width: 768px) {
        .tg-app-shell {
            padding-bottom: 0;
        }
    }

    .tg-header {
        background: linear-gradient(90deg, #071F49 0%, #0A2E6B 50%, #0F3F94 100%) !important;
        box-shadow: 0 4px 20px rgba(7, 31, 73, 0.2);
        border-bottom: 1px solid rgba(255, 255, 255, 0.12);
        z-index: 1030;
    }

    .tg-nav-link {
        color: rgba(255, 255, 255, 0.85);
        text-decoration: none;
        font-size: 0.94rem;
        font-weight: 600;
        padding: 8px 14px;
        border-radius: 9999px;
        transition: all 150ms ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .tg-nav-link:hover {
        color: #ffffff;
        background-color: rgba(255, 255, 255, 0.14);
        transform: translateY(-1px);
    }

    .tg-nav-link.active {
        color: #ffffff !important;
        background: rgba(255, 255, 255, 0.2) !important;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    }

    .tg-hotline-btn {
        background: #ffffff;
        color: #071F49;
        border: none;
        border-radius: 9999px;
        padding: 7px 16px;
        font-size: 0.85rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 6px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
        transition: all 150ms ease;
    }

    .tg-hotline-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.2);
        background-color: #F8FAFC;
    }

    .tg-footer {
        background: #071F49 !important;
        color: #ffffff !important;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .tg-footer-title {
        color: #ffffff !important;
        font-size: 0.9rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        margin-bottom: 1.25rem;
    }

    .tg-footer-link {
        color: rgba(255, 255, 255, 0.72) !important;
        text-decoration: none;
        font-size: 0.88rem;
        transition: color 150ms, transform 150ms;
        display: inline-block;
    }

    .tg-footer-link:hover {
        color: #FFCA28 !important;
        transform: translateX(3px);
    }

    .tg-badge-pill {
        background: rgba(255, 255, 255, 0.1) !important;
        border: 1px solid rgba(255, 255, 255, 0.2) !important;
        color: rgba(255, 255, 255, 0.9) !important;
        padding: 6px 12px;
        border-radius: 9999px;
        font-size: 0.78rem;
        font-weight: 600;
    }

    .tg-avatar-circle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 24px;
        height: 24px;
        background: rgba(0, 0, 0, 0.12);
        border-radius: 50%;
        font-size: 0.9rem;
    }
</style>

@code {
    private bool isSupportOpen = false;
    private bool isUserMenuOpen = false;

    private bool IsNavActive(params string[] paths)
    {
        try
        {
            var uri = new Uri(NavigationManager.Uri);
            var currentPath = uri.AbsolutePath.TrimEnd('/').ToLowerInvariant();
            if (string.IsNullOrEmpty(currentPath)) currentPath = "/";

            foreach (var p in paths)
            {
                var normalized = p.TrimEnd('/').ToLowerInvariant();
                if (string.IsNullOrEmpty(normalized)) normalized = "/";
                if (normalized == "/" && currentPath == "/") return true;
                if (normalized != "/" && currentPath.StartsWith(normalized)) return true;
            }
        }
        catch
        {
            // fallback
        }
        return false;
    }

    private void ToggleUserMenu()
    {
        isUserMenuOpen = !isUserMenuOpen;
    }

    private void CloseUserMenu()
    {
        isUserMenuOpen = false;
    }
}
