{
  "Auth": {
    "TrustedProxies": [],
    "Security": {
      "LoginFailureLimit": 5,
      "LoginLockoutMinutes": 5,
      "LoginRequestLimit": 30,
      "LoginRequestWindowMinutes": 5,
      "LoginIpRequestLimit": 100,
      "PasswordResetRequestLimit": 3,
      "PasswordResetIpRequestLimit": 10,
      "PasswordResetWindowMinutes": 15,
      "PasswordResetTokenLifetimeMinutes": 15,
      "MaximumRateLimitEntries": 10000
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\MSSQLSERVER01;Database=TripgoDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true;"
  },
  "ApplyMigrationsOnStartup": false,
  "Workers": {
    "BookingExpiration": {
      "Enabled": false,
      "TargetDatabase": ""
    },
    "BookingConfirmationEmail": {
      "Enabled": false,
      "TargetDatabase": ""
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}