@model TripGo.Models.Trip
@{
    ViewData["Title"] = "Chọn Giường";
    var bookedSeats = ViewBag.BookedSeats as List<string> ?? new List<string>();
    string[] floorA = { "A01", "A02", "A03", "A04", "A05", "A06", "A07", "A08", "A09" };
    string[] floorB = { "B01", "B02", "B03", "B04", "B05", "B06", "B07", "B08", "B09" };
}

<div class="container py-4">
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Sơ Đồ Chọn Ghế - Tuyến: @Model.Route?.Origin đi @Model.Route?.Destination</h4>
        </div>
        <div class="card-body">
            <p><strong>Giờ chạy:</strong> @Model.DepartureTime.ToString("HH:mm - dd/MM/yyyy") | <strong>Giá vé:</strong> <span class="text-danger fw-bold">@Model.Price.ToString("N0") đ/vé</span></p>

            <form asp-controller="Booking" asp-action="Checkout" method="post">
                <input type="hidden" name="tripId" value="@Model.TripId" />

                <div class="row g-4 justify-content-center my-3">
                    <!-- Tầng Dưới A -->
                    <div class="col-md-5 border p-3 rounded bg-light">
                        <h5 class="text-center text-primary mb-3">TẦNG DƯỚI (DÃY A)</h5>
                        <div class="row g-2">
                            @foreach (var s in floorA)
                            {
                                bool isBooked = bookedSeats.Contains(s);
                                <div class="col-4 text-center">
                                    <input type="checkbox" class="btn-check" id="@s" name="selectedSeats" value="@s" @(isBooked ? "disabled" : "") autocomplete="off">
                                    <label class="btn @(isBooked ? "btn-secondary text-decoration-line-through" : "btn-outline-primary") w-100 py-3 fw-bold" for="@s">
                                        @s
                                    </label>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Tầng Trên B -->
                    <div class="col-md-5 border p-3 rounded bg-light">
                        <h5 class="text-center text-success mb-3">TẦNG TRÊN (DÃY B)</h5>
                        <div class="row g-2">
                            @foreach (var s in floorB)
                            {
                                bool isBooked = bookedSeats.Contains(s);
                                <div class="col-4 text-center">
                                    <input type="checkbox" class="btn-check" id="@s" name="selectedSeats" value="@s" @(isBooked ? "disabled" : "") autocomplete="off">
                                    <label class="btn @(isBooked ? "btn-secondary text-decoration-line-through" : "btn-outline-success") w-100 py-3 fw-bold" for="@s">
                                        @s
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
                    <button type="submit" class="btn btn-warning px-5 py-2 fw-bold text-dark fs-5 shadow">TIẾP TỤC ĐẶT VÉ</button>
                </div>
            </form>
        </div>
    </div>
</div>