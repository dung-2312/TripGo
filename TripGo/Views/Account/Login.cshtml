@model TripGo.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập TripGo";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h4 class="mb-0">ĐĂNG NHẬP</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Login" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label class="form-label">Email hoặc Số điện thoại</label>
                            <input asp-for="AccountIdentifier" class="form-control" placeholder="Nhập email hoặc sđt" />
                            <span asp-validation-for="AccountIdentifier" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Mật khẩu</label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="Nhập mật khẩu" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2">Đăng Nhập</button>
                    </form>
                    <div class="mt-3 text-center">
                        <span>Chưa có tài khoản? </span><a asp-action="Register">Đăng ký ngay</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>