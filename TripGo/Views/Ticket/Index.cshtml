@model IEnumerable<TripGo.Models.Booking>
@{
    ViewData["Title"] = "Tra Cứu Vé Xe";
}

<div class="container py-4">
    <h3 class="mb-3"><i class="bi bi-search"></i> TRA CỨU THÔNG TIN VÉ XE</h3>

    <form method="get" asp-action="Index" class="row g-2 mb-4">
        <div class="col-md-6">
            <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control form-control-lg" placeholder="Nhập Mã vé (VD: TG2026...) hoặc Số điện thoại" required />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary btn-lg w-100">Tìm Kiếm</button>
        </div>
    </form>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Mã Vé</th>
                        <th>Hành Khách</th>
                        <th>Số ĐT</th>
                        <th>Các Ghế</th>
                        <th>Tổng Tiền</th>
                        <th>Trạng Thái</th>
                        <th>Ngày Đặt</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        <tr>
                            <td><strong class="text-primary">@b.BookingCode</strong></td>
                            <td>@b.CustomerName</td>
                            <td>@b.CustomerPhone</td>
                            <td>@string.Join(", ", b.BookingSeats?.Select(s => s.SeatCode) ?? new List<string>())</td>
                            <td class="text-danger fw-bold">@b.TotalAmount.ToString("N0") đ</td>
                            <td><span class="badge bg-success">@b.PaymentStatus</span></td>
                            <td>@b.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>